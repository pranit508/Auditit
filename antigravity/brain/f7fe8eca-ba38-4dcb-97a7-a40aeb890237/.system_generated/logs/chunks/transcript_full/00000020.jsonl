{"step_index":1171,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:49:44Z","content":"Created At: 2026-11-03T00:19:44+05:30\nCompleted At: 2026-11-03T00:19:44+05:30\nShowing lines 1-100 of 272\n1: // Multimodal AI & Real-Time Document Extraction Pipeline for AUDIT IT\n2: // RULE: \"AI reads, code calculates. Do NOT trust the AI to do math.\"\n3: \n4: import { sanitizeInvoiceData } from \"./privacyMasker.js\";\n5: import { parseInvoiceText, isLikelyInvoice } from \"./invoiceTextParser.js\";\n6: import { cleanExtractedItems, sanitizeAndCleanInvoice } from \"./itemCleaner.js\";\n7: \n8: const DEFAULT_API_KEY = \"AQ.Ab8RN6LhTNa6kIQRpd_OijgrXNfmwLOw7rcxiMN8aWW-_U7mPw\";\n9: \n10: const GEMINI_SYSTEM_INSTRUCTION = `You are a strict GST Invoice extractor. \n11: RULES FOR LINE ITEMS:\n12: - Extract items ONLY from the central itemized table bounded between the table header (S.No, Description, HSN, Qty, Rate, Amount) and the Subtotal row.\n13: - NEVER extract text from the header or footer as line items:\n14:   * DO NOT extract addresses or cities (e.g. 'Mumbai, Maharashtra').\n15:   * DO NOT extract PAN, GSTIN, or buyer details (e.g. 'PAN : 26CORPP').\n16:   * DO NOT extract bank account or payment details (e.g. 'Acc. Number 271').\n17: - Each valid line item MUST have a legitimate product name, quantity > 0, unit rate > 0, and total amount.\n18: \n19: GRAND TOTAL:\n20: - Extract the final payable Grand Total printed at the bottom of the bill (e.g., '4,490.00' / 'FOUR THOUSAND FOUR HUNDRED AND NINETY'). Do NOT extract partial account numbers or phone numbers as the grand total.\n21: \n22: NUMERIC INSTRUCTIONS:\n23: - Never discard digits before commas! '2,535.00' must be extracted as '2,535.00'. '1,270.00' must be extracted as '1,270.00'. '4,490.00' must be extracted as '4,490.00'.\n24: - If you are unsure about the digits before the comma, read the 'Amount in Words' printed on the bill (e.g. 'FOUR THOUSAND FOUR HUNDRED AND NINETY RUPEES ONLY') to confirm the thousands digit.\n25: - All numbers and rates must be extracted as strings (e.g. \"2,535.00\", \"1\", \"4,490.00\").\n26: \n27: Return ONLY a valid JSON object matching this schema:\n28: {\n29:   \"vendor_name\": string or null,\n30:   \"gstin\": string or null,\n31:   \"invoice_number\": string or null,\n32:   \"date\": string or null,\n33:   \"items\": [\n34:     {\n35:       \"description\": string,\n36:       \"quantity\": string,\n37:       \"unit_rate\": string,\n38:       \"total_amount\": string\n39:     }\n40:   ],\n41:   \"subtotal\": string or null,\n42:   \"cgst\": string or null,\n43:   \"sgst\": string or null,\n44:   \"igst\": string or null,\n45:   \"declared_total\": string or null\n46: }\n47: `;\n48: \n49: /**\n50:  * Extracts structured JSON from an uploaded invoice image/PDF.\n51:  * Prioritizes:\n52:  * 1. Live Multimodal Gemini API (if key configured)\n53:  * 2. In-browser Client-side PDF.js (for PDFs)\n54:  * 3. In-browser Client-side Tesseract.js OCR (for images)\n55:  * 4. Document-aware parser (zero fake/mock items)\n56:  */\n57: export async function extractInvoiceFromDocument(file, apiKey = null, onProgress = null) {\n58:   const effectiveKey = (apiKey && apiKey.trim().length > 10) ? apiKey.trim() : DEFAULT_API_KEY;\n59:   const mimeType = file.type || \"image/jpeg\";\n60:   const objectUrl = URL.createObjectURL(file);\n61: \n62:   // 1. Prioritize FastAPI + Google GenAI (/api/analyze-bill) backend endpoint\n63:   try {\n64:     if (onProgress) onProgress(\"Uploading bill to FastAPI backend (Gemini 2.5 Flash)...\");\n65:     const formData = new FormData();\n66:     formData.append(\"file\", file);\n67: \n68:     const headers = {\n69:       \"x-api-key\": effectiveKey\n70:     };\n71: \n72:     const backendResp = await fetch(\"/api/analyze-bill\", {\n73:       method: \"POST\",\n74:       headers,\n75:       body: formData\n76:     });\n77: \n78:     if (backendResp.ok) {\n79:       const rawText = await backendResp.text();\n80:       let parsed = null;\n81:       try {\n82:         parsed = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n83:         if (typeof parsed === \"string\") {\n84:           parsed = JSON.parse(parsed);\n85:         }\n86:       } catch (e) {\n87:         console.warn(\"Could not parse backend JSON:\", e);\n88:       }\n89: \n90:       if (parsed && typeof parsed === \"object\") {\n91:         parsed.uploaded_file_url = objectUrl;\n92:         parsed.file_type = mimeType;\n93:         parsed.file_name = file.name;\n94: \n95:         // Map ExtractedInvoice schema to app schema\n96:         if (parsed.invoice_number && !parsed.invoice_no) {\n97:           parsed.invoice_no = parsed.invoice_number;\n98:         }\n99:         if (parsed.declared_total !== undefined && parsed.total_declared === undefined) {\n100:           parsed.total_declared = parsed.declared_total;"}
