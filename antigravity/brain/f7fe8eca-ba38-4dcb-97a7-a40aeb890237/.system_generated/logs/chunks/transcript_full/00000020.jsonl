{"step_index":1175,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:49:51Z","content":"Created At: 2026-11-03T00:19:51+05:30\nCompleted At: 2026-11-03T00:19:51+05:30\nShowing lines 161-200 of 272\n161:           cleaned.uploaded_file_url = objectUrl;\n162:           cleaned.file_type = mimeType;\n163:           cleaned.file_name = file.name;\n164:           return sanitizeInvoiceData(cleaned);\n165:         }\n166:       }\n167:     } catch (err) {\n168:       console.warn(\"Gemini multimodal call failed; continuing with client-side OCR:\", err);\n169:     }\n170:   }\n171: \n172:   // 2. Client-side Real OCR for PDFs\n173:   if (mimeType.includes(\"pdf\") && window.pdfjsLib) {\n174:     if (onProgress) onProgress(\"Extracting text from PDF document...\");\n175:     try {\n176:       const pdfText = await extractTextFromPdf(file);\n177:       if (pdfText && pdfText.trim().length > 10) {\n178:         const parsed = parseInvoiceText(pdfText, file.name);\n179:         parsed.uploaded_file_url = objectUrl;\n180:         parsed.file_type = mimeType;\n181:         parsed.file_name = file.name;\n182:         return sanitizeInvoiceData(parsed);\n183:       }\n184:     } catch (err) {\n185:       console.warn(\"PDF.js text extraction error:\", err);\n186:     }\n187:   }\n188: \n189:   // 3. Client-side Real OCR for Images using Tesseract.js\n190:   if (window.Tesseract && (mimeType.startsWith(\"image/\") || !mimeType.includes(\"pdf\"))) {\n191:     if (onProgress) onProgress(\"Running on-device OCR on bill image...\");\n192:     try {\n193:       const ocrResult = await window.Tesseract.recognize(file, \"eng\", {\n194:         logger: m => {\n195:           if (onProgress && m.status === \"recognizing text\" && m.progress) {\n196:             onProgress(`Reading bill text: ${Math.round(m.progress * 100)}%`);\n197:           }\n198:         }\n199:       });\n200: "}
