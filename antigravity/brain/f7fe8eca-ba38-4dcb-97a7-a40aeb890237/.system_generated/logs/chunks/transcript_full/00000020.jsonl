{"step_index":1177,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:49:54Z","content":"Created At: 2026-11-03T00:19:54+05:30\nCompleted At: 2026-11-03T00:19:54+05:30\nShowing lines 180-260 of 293\n180:     }\n181: \n182:     // Clean description of trailing unit words\n183:     const descClean = desc.replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, \"\").trim();\n184:     if (descClean.length >= 3) {\n185:       desc = descClean;\n186:       it.description = desc;\n187:     }\n188: \n189:     // Quantity and Rate sanity with parseInr\n190:     const rawQty = it.quantity !== undefined ? it.quantity : it.qty;\n191:     let qty = rawQty !== undefined && rawQty !== null && String(rawQty).trim() !== \"\" ? parseInr(rawQty) : 1.0;\n192:     if (qty <= 0) qty = 1.0;\n193: \n194:     const rawRate = it.unit_rate !== undefined ? it.unit_rate : it.rate;\n195:     let rate = parseInr(rawRate);\n196: \n197:     const rawBilled = it.total_amount !== undefined ? it.total_amount : it.amount;\n198:     let billed = rawBilled !== undefined && rawBilled !== null && String(rawBilled).trim() !== \"\" ? parseInr(rawBilled) : (qty * rate);\n199: \n200:     // Column swap fallback\n201:     if (billed > 0 && qty === billed && (rate === 1 || rate === 2)) {\n202:       qty = 1.0;\n203:       rate = billed;\n204:     }\n205: \n206:     it.quantity = qty;\n207:     it.qty = qty;\n208:     it.unit_rate = rate;\n209:     it.rate = rate;\n210:     it.total_amount = billed;\n211:     it.amount = billed;\n212:     cleanItems.push(it);\n213:   }\n214: \n215:   res.items = cleanItems;\n216: \n217:   // 3. Ensure numeric fields strip commas cleanly via parseInr\n218:   [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"].forEach(key => {\n219:     if (res[key] !== undefined && res[key] !== null && String(res[key]).trim() !== \"\" && String(res[key]).toLowerCase() !== \"null\") {\n220:       res[key] = parseInr(res[key]);\n221:     }\n222:   });\n223: \n224:   // 4. SUB-TOTAL CALCULATION:\n225:   // Do not trust random OCR numbers near the bank details for Subtotal.\n226:   // Calculate the Subtotal deterministically from the extracted items:\n227:   // subtotal = sum(item.quantity * item.unit_rate for item in items)\n228:   // For this bill: 2535 + 1270 = 3805.00.\n229:   let calculatedSubtotal = 0;\n230:   if (cleanItems.length > 0) {\n231:     calculatedSubtotal = Math.round(cleanItems.reduce((acc, it) => acc + (it.quantity * it.unit_rate), 0) * 100) / 100;\n232:     res.subtotal = calculatedSubtotal;\n233:     res.calculated_subtotal = calculatedSubtotal;\n234:   } else {\n235:     calculatedSubtotal = Number(res.subtotal) || 0;\n236:   }\n237: \n238:   // 5. GRAND TOTAL SANITY CHECK:\n239:   // Grand Total must be approximately (Subtotal + Total Tax).\n240:   // Here, 3805 + 684.90 = 4489.90 (~4490).\n241:   // If the OCR extracted '774' or '585132', reject them because they are bank/account/IFSC digits.\n242:   const cgst = Number(res.cgst) || 0;\n243:   const sgst = Number(res.sgst) || 0;\n244:   const igst = Number(res.igst) || 0;\n245:   const totalTax = Math.round((cgst + sgst + igst) * 100) / 100;\n246:   const expectedTotal = Math.round((calculatedSubtotal + totalTax) * 100) / 100;\n247: \n248:   // Cross-check against printed 'Total in words' line if present\n249:   let wordTotal = 0;\n250:   const rawOcr = String(res.raw_ocr_text || res.raw_text || res.notes || \"\");\n251:   for (const candidateText of [rawOcr, String(res.notes || \"\"), String(res.amount_in_words || \"\"), String(res.total_in_words || \"\")]) {\n252:     if (candidateText) {\n253:       for (const line of candidateText.split(/\\r?\\n/)) {\n254:         if (/(?:total|amount|rupees)\\s+(?:in\\s+words|in\\s+word)/i.test(line) || /rupees\\s+[a-z\\s]+only/i.test(line)) {\n255:           const wt = parseWordsToNumber(line);\n256:           if (wt > 0) {\n257:             wordTotal = wt;\n258:             break;\n259:           }\n260:         }"}
