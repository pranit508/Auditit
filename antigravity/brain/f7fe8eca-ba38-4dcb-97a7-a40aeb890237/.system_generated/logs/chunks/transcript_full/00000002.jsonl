== \"REVIEW_NEEDED\";\n\n  const { audit_summary, calculated_tax, ai_suggestions } = taxData || {\n    audit_summary: {\n      total_turnover: 3600000,\n      deemed_profit: 244800,\n      eligible_itc: audit.gstinValid ? audit.totalTax : 0,\n      disallowed_itc: !audit.gstinValid ? audit.totalTax : 0,\n      invoices_missing_gstin: audit.gstinValid ? 0 : 1\n    },\n    calculated_tax: {\n      recommended_form: \"ITR-4 (Presumptive Scheme - Sec 44AD)\",\n      deemed_net_profit: 244800,\n      estimated_tax_liability: 0,\n      tax_regime: \"New Regime (Section 115BAC)\"\n    },\n    ai_suggestions: {\n      suggestions: [\n        \"Recommended ITR Form: File ITR-4 Sugam under Section 44AD presumptive scheme because your retail turnover is within ₹2-3 Crores, allowing you to declare deemed profit without maintaining formal books.\",\n        audit.gstinValid \n          ? `GST ITC Opportunity / Risk: You have ${formatRupees(audit.totalTax)} in eligible Input Tax Credit from this bill to directly offset your GST liability.`\n          : `GST ITC Opportunity / Risk: Missing supplier GSTIN blocks ${formatRupees(audit.totalTax)} in Input Tax Credit. Request a valid GSTIN bill to avoid higher tax outgo.`,\n        \"Advance Tax & Action Item: Remind yourself to pay 100% of your advance tax by March 15 to avoid penal interest under Section 234B/234C.\"\n      ],\n      disclaimer: \"Not tax advice; verify with your CA.\",\n      isAiGenerated: false\n    }\n  };\n\n  container.innerHTML = `\n    <div class=\"space-y-4\">\n\n      <!-- VERDICT HEADER BANNER -->\n      <div class=\"rounded-xl p-4 sm:p-5 border transition-all ${\n        isOvercharge \n          ? 'bg-rose-50/90 border-rose-200 text-rose-950 shadow-sm'\n          : isWarning\n          ? 'bg-amber-50/90 border-amber-200 text-amber-950 shadow-sm'\n          : 'bg-emerald-50/90 border-emerald-200 text-emerald-950 shadow-sm'\n      }\">\n        <div class=\"flex items-start justify-between\">\n          <div class=\"flex items-center space-x-3\">\n            <div class=\"w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg ${\n              isOvercharge ? 'bg-rose-600 text-white shadow-rose-200 shadow' : isWarning ? 'bg-amber-500 text-white' : 'bg-emerald-600 text-white shadow-emerald-200 shadow'\n            }\">\n              ${isOvercharge ? '!' : isWarning ? '?' : '✓'}\n            </div>\n            <div>\n              <div class=\"text-xs uppercase tracking-wider font-bold ${\n                isOvercharge ? 'text-rose-700' : isWarning ? 'text-amber-700' : 'text-emerald-700'\n              }\">Audit Verdict / अंतिम परिणाम</div>\n              <h3 class=\"text-lg sm:text-xl font-extrabold tracking-tight\">\n                ${audit.statusText}\n              </h3>\n            </div>\n          </div>\n\n          <div class=\"text-right\">\n            <span class=\"inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${\n              isOvercharge ? 'bg-rose-100 text-rose-800' : isWarning ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'\n            }\">\n              ${audit.status}\n            </span>\n          </div>\n        </div>\n\n        <!-- Discrepancy Difference Callout -->\n        ${isOvercharge ? `\n          <div class=\"mt-3.5 pt-3 border-t border-rose-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n            <p class=\"text-xs text-rose-800 font-medium leading-relaxed\">\n              <strong>Calculated vs Declared Difference:</strong> You are being billed <span class=\"underline decoration-rose-500 font-bold\">${formatRupees(Math.abs(audit.totalDiff))}</span> more than the verified sum of goods and taxes.\n            </p>\n            <button id=\"btn-quick-copy\" class=\"shrink-0 inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white shadow transition-all active:scale-95\">\n              <span>📋 Copy Dispute Note</span>\n            </button>\n          </div>\n        ` : ''}\n\n        ${isClean ? `\n          <div class=\"mt-2.5 pt-2 border-t border-emerald-200/80 text-xs text-emerald-800 font-medium\">\n            ✅ Every line item (Qty × Rate) and GST amount matches the declared grand total perfectly. Safe to clear payment.\n          </div>\n        ` : ''}\n\n        ${isWarning ? `\n          <div class=\"mt-2.5 pt-2 border-t border-amber-200/80 text-xs text-amber-800 font-medium\">\n            ⚠️ Some fields require your verification (e.g. missing GSTIN or unreadable numbers) before claiming tax credits.\n          </div>\n        ` : ''}\n      </div>\n\n      <!-- THREE-METRIC COMPARISON CARD -->\n      <div class=\"grid grid-cols-3 gap-2.5 sm:gap-3\">\n        <div class=\"bg-white p-3 sm:p-3.5 rounded-xl border border-slate-200 shadow-sm text-center\">\n          <span class=\"text-[10px] font-semibold text-slate-400 uppercase tracking-wider block\">Billed on Invoice</span>\n          <span class=\"text-sm sm:text-base font-extrabold font-mono text-slate-800 block mt-0.5\">\n            ${formatRupees(audit.total_declared)}\n          </span>\n          <span class=\"text-[9px] text-slate-400\">परचे पर कुल</span>\n        </div>\n\n        <div class=\"bg-white p-3 sm:p-3.5 rounded-xl border border-slate-200 shadow-sm text-center\">\n          <span class=\"text-[10px] font-semibold text-emerald-600 uppercase tracking-wider block\">Verified Total</span>\n          <span class=\"text-sm sm:text-base font-extrabold font-mono text-emerald-700 block mt-0.5\">\n            ${formatRupees(audit.calculated_total)}\n          </span>\n          <span class=\"text-[9px] text-slate-400\">सत्यापित योग</span>\n        </div>\n\n        <div class=\"bg-white p-3 sm:p-3.5 rounded-xl border ${audit.hasTotalDiscrepancy ? 'border-rose-200 bg-rose-50/30' : 'border-slate-200'} shadow-sm text-center\">\n          <span class=\"text-[10px] font-semibold ${audit.hasTotalDiscrepancy ? 'text-rose-600' : 'text-slate-500'} uppercase tracking-wider block\">Difference</span>\n          <span class=\"text-sm sm:text-base font-extrabold font-mono ${audit.hasTotalDiscrepancy ? 'text-rose-600' : 'text-slate-700'} block mt-0.5\">\n            ${audit.totalDiff > 0 ? '+' : ''}${formatRupees(audit.totalDiff)}\n          </span>\n          <span class=\"text-[9px] text-slate-400\">${audit.hasTotalDiscrepancy ? 'Overcharge' : 'No diff'}</span>\n        </div>\n      </div>\n\n      <!-- EDITABLE LINE-ITEMS AUDIT TABLE -->\n      <div class=\"bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden\">\n        <div class=\"px-4 py-3 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between\">\n          <div class=\"flex items-center space-x-2\">\n            <span class=\"text-xs font-bold text-slate-700 uppercase tracking-wider\">Item Breakdown & Math Check</span>\n            <span class=\"text-[10px] px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 font-mono font-semibold\">${invoice.items.length} items</span>\n          </div>\n          <span class=\"text-[11px] text-slate-500 font-medium\">Click any value to edit & recalculate</span>\n        </div>\n\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr class=\"bg-slate-100/60 text-slate-500 font-semibold uppercase text-[10px] border-b border-slate-200\">\n                <th class=\"py-2 pl-3\">Item Name</th>\n                <th class=\"py-2 text-right w-16\">Qty</th>\n                <th class=\"py-2 text-right w-20\">Rate (₹)</th>\n                <th class=\"py-2 text-right w-24\">Billed (₹)</th>\n                <th class=\"py-2 text-right w-24\">Verified (₹)</th>\n                <th class=\"py-2 pr-3 text-center w-20\">Status</th>\n              </tr>\n            </thead>\n            <tbody class=\"divide-y divide-slate-100\">\n              ${audit.lineItemAudit.map((item, idx) => {\n                const isSelected = selectedItemId === (item.id || idx.toString());\n                const isErr = item.isMathError;\n                const isBlurry = item.is_blurry;\n\n                return `\n                  <tr class=\"transition-colors ${\n                    isErr \n                      ? 'bg-rose-50/60 hover:bg-rose-100/50' \n                      : isBlurry \n                      ? 'bg-amber-50/60 hover:bg-amber-100/50' \n                      : isSelected \n                      ? 'bg-indigo-50/60 hover:bg-indigo-100/50' \n                      : 'hover:bg-slate-50'\n                  }\" id=\"scorecard-row-${item.id || idx}\">\n                    \n                    <td class=\"py-2.5 pl-3\">\n                      <div class=\"font-semibold text-slate-800\">${item.description}</div>\n                      ${item.hsn ? `<span class=\"text-[10px] font-mono text-slate-400\">HSN: ${item.hsn}</span>` : ''}\n                      ${isBlurry ? `<div class=\"text-[10px] text-amber-700 font-medium mt-0.5\">⚠️ Unclear rate on bill</div>` : ''}\n                      ${isErr ? `<div class=\"text-[10px] text-rose-700 font-medium mt-0.5\">⚠️ Formula: ${item.qty} × ${formatRupees(item.rate)} = ${formatRupees(item.calculatedAmount)}</div>` : ''}\n                    </td>\n\n                    <!-- Editable Qty -->\n                    <td class=\"py-2.5 text-right font-mono\">\n                      <input \n                        type=\"number\" \n                        step=\"1\"\n                        min=\"0\"\n                        value=\"${item.qty}\"\n                        class=\"w-14 text-right px-1.5 py-1 rounded border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 font-mono text-xs bg-white text-slate-800\"\n                        data-action=\"edit-qty\"\n                        data-index=\"${idx}\"\n                        title=\"Click to edit quantity\"\n                      />\n                    </td>\n\n                    <!-- Editable Rate -->\n                    <td class=\"py-2.5 text-right font-mono\">\n                      <input \n                        type=\"number\" \n                        step=\"0.01\"\n                        min=\"0\"\n                        value=\"${item.rate}\"\n                        class=\"w-20 text-right px-1.5 py-1 rounded border ${isBlurry ? 'border-amber-400 bg-amber-50' : 'border-slate-300'} focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 font-mono text-xs text-slate-800\"\n                        data-action=\"edit-rate\"\n                        data-index=\"${idx}\"\n                        title=\"Click to edit rate\"\n                      />\n                    </td>\n\n                    <!-- Billed Amount (Can also be adjusted if OCR misread) -->\n                    <td class=\"py-2.5 text-right font-mono font-medium ${isErr ? 'text-rose-600 font-bold' : 'text-slate-700'}\">\n                      <input \n                        type=\"number\" \n                        step=\"0.01\"\n                        min=\"0\"\n                        value=\"${item.declaredAmount}\"\n                        class=\"w-20 text-right px-1.5 py-1 rounded border ${isErr ? 'border-rose-300 bg-rose-50/50 text-rose-700 font-bold' : 'border-slate-300 text-slate-800'} font-mono text-xs\"\n                        data-action=\"edit-amount\"\n                        data-index=\"${idx}\"\n                        title=\"Click to edit billed amount\"\n                      />\n                    </td>\n\n                    <!-- Verified Calculated Amount -->\n                    <td class=\"py-2.5 text-right font-mono font-bold ${isErr ? 'text-emerald-700' : 'text-slate-900'}\">\n                      ${formatRupees(item.calculatedAmount)}\n                    </td>\n\n                    <!-- Status Pill -->\n                    <td class=\"py-2.5 pr-3 text-center\">\n                      ${isErr ? `\n                        <span class=\"inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-100 text-rose-700 border border-rose-200\">\n                          -₹${Math.abs(item.diff).toFixed(0)}\n                        </span>\n                      ` : isBlurry ? `\n                        <span class=\"inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-700 border border-amber-200\">\n                          Check\n                        </span>\n                      ` : `\n                        <span class=\"inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200\">\n                          Match\n                        </span>\n                      `}\n                    </td>\n\n                  </tr>\n                `;\n              }).join(\"\")}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- COMPLIANCE & CHECKLIST SUMMARY -->\n      <div class=\"bg-white rounded-xl border border-slate-200 p-4 shadow-sm space-y-3\">\n        <h4 class=\"text-xs font-bold text-slate-700 uppercase tracking-wider\">Compliance & Header Checks</h4>\n        \n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n          <!-- GSTIN Check -->\n          <div class=\"flex items-center space-x-2 p-2 rounded-lg ${audit.gstinValid ? 'bg-emerald-50 text-emerald-900' : 'bg-amber-50 text-amber-900'}\">\n            <span class=\"font-bold text-sm\">${audit.gstinValid ? '✓' : '⚠️'}</span>\n            <div>\n              <div class=\"font-semibold\">Supplier GSTIN</div>\n              <div class=\"text-[11px] text-slate-600 font-mono\">${invoice.gstin || \"Not provided / Blank\"}</div>\n            </div>\n          </div>\n\n          <!-- GST Split Check -->\n          <div class=\"flex items-center space-x-2 p-2 rounded-lg bg-slate-50 text-slate-800\">\n            <span class=\"font-bold text-sm text-emerald-600\">✓</span>\n            <div>\n              <div class=\"font-semibold\">Tax Breakdown</div>\n              <div class=\"text-[11px] text-slate-500 font-mono\">\n                ${invoice.cgst > 0 ? `CGST: ${formatRupees(invoice.cgst)} + SGST: ${formatRupees(invoice.sgst)}` : `IGST: ${formatRupees(invoice.igst)}`}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Issues List -->\n        ${audit.issues.length > 0 ? `\n          <div class=\"mt-3 pt-3 border-t border-slate-100 space-y-1.5\">\n            <span class=\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block\">Detailed Observations (${audit.issues.length})</span>\n            ${audit.issues.map(iss => `\n              <div class=\"flex items-start space-x-2 text-xs py-1\">\n                <span class=\"shrink-0 mt-0.5 text-xs ${iss.type === 'ERROR' ? 'text-rose-600 font-bold' : 'text-amber-500 font-bold'}\">\n                  ${iss.type === 'ERROR' ? '●' : '▲'}\n                </span>\n                <div>\n                  <span class=\"font-semibold text-slate-800\">${iss.title}</span>\n                  <p class=\"text-[11px] text-slate-500\">${iss.description}</p>\n                </div>\n              </div>\n            `).join(\"\")}\n          </div>\n        ` : ''}\n      </div>\n\n      <!-- ========================================== -->\n      <!-- UI DASHBOARD ADDITION: TAX & ITR INSIGHTS -->\n      <!-- ========================================== -->\n      <div class=\"bg-gradient-to-br from-slate-900 via-slate-850 to-slate-900 rounded-2xl border border-slate-800 p-4 sm:p-5 shadow-md text-white space-y-4\">\n        \n        <!-- Header -->\n        <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-800/80 pb-3\">\n          <div class=\"flex items-center space-x-2.5\">\n            <div class=\"w-8 h-8 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold text-sm\">\n              ₹\n            </div>\n            <div>\n              <h4 class=\"text-xs sm:text-sm font-extrabold tracking-tight text-white flex items-center space-x-2\">\n                <span>Tax & ITR Insights</span>\n                <span class=\"text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n                  Sec 44AD Presumptive\n                </span>\n              </h4>\n              <p class=\"text-[10px] text-slate-400\">Deterministic Tax Calculation & Gemini 2.5 Flash Advisory</p>\n            </div>\n          </div>\n\n          <div class=\"flex items-center space-x-2\">\n            <span class=\"text-[10px] font-mono text-slate-400 hidden sm:inline\">Turnover Basis: ₹36,00,000</span>\n            <button \n              id=\"btn-refresh-tax-ai\" \n              class=\"px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-semibold border border-slate-700 transition-all flex items-center space-x-1\"\n              title=\"Refresh suggestions using Gemini 2.5 Flash\"\n            >\n              <span>✨ Gemini 2.5 Flash</span>\n            </button>\n          </div>\n        </div>\n\n        <!-- 3 REQUIRED PILLS -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-2.5\">\n          \n          <!-- Pill 1: Recommended Form -->\n          <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n            <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 1 • Recommended Form</span>\n            <div class=\"mt-1 font-bold text-xs text-emerald-300\">\n              ${calculated_tax.recommended_form}\n            </div>\n            <span class=\"text-[9px] text-slate-400 mt-1 block\">Presumptive Scheme under Sec 44AD</span>\n          </div>\n\n          <!-- Pill 2: Deemed Net Profit -->\n          <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n            <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 2 • Deemed Net Profit</span>\n            <div class=\"mt-1 font-extrabold text-sm font-mono text-white\">\n              ${formatRupees(calculated_tax.deemed_net_profit)}\n            </div>\n            <span class=\"text-[9px] text-slate-400 mt-1 block\">Calculated at 6% digital / 8% cash</span>\n          </div>\n\n          <!-- Pill 3: Estimated Tax Liability -->\n          <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n            <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 3 • Estimated Tax Liability</span>\n            <div class=\"mt-1 font-extrabold text-sm font-mono text-emerald-400\">\n              ${formatRupees(calculated_tax.estimated_tax_liability)}\n            </div>\n            <span class=\"text-[9px] text-slate-400 mt-1 block\">Computed via New Regime (Sec 115BAC)</span>\n          </div>\n\n        </div>\n\n        <!-- ADVISORY CALLOUT BOX -->\n        <div class=\"bg-emerald-950/40 rounded-xl p-3.5 border border-emerald-500/30 text-emerald-100 flex items-start space-x-3\">\n          <div class=\"w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5\">\n            🛡️\n          </div>\n          <div class=\"text-xs leading-relaxed\">\n            <strong class=\"text-emerald-300 block mb-0.5\">Advisory Callout: How Keeping Supplier GSTINs Verified Saves Cash</strong>\n            <p class=\"text-[11px] text-slate-300\">\n              Every single rupee of GST shown on your purchase invoices can directly offset your GST tax liability via <strong>Input Tax Credit (ITC)</strong>. \n              However, Indian tax laws (Section 16 of the CGST Act) mandate that ITC is strictly disallowed if your supplier does not have an active, verified GSTIN. \n              Always verify supplier GSTINs on AUDIT IT before making payments to protect your ITC and avoid paying tax twice!\n            </p>\n          </div>\n        </div>\n\n        <!-- 3 CONCISE BULLET POINTS FROM GEMINI 2.5 FLASH -->\n        <div class=\"bg-slate-800/50 rounded-xl p-3.5 border border-slate-800 space-y-2\">\n          <div class=\"flex items-center justify-between text-[11px] font-bold text-slate-300\">\n            <span>Gemini 2.5 Flash Tax Preparation Summary:</span>\n            ${ai_suggestions.isAiGenerated \n              ? `<span class=\"text-[10px] text-emerald-400 font-mono\">● Live Gemini 2.5 Flash</span>` \n              : `<span class=\"text-[10px] text-slate-400 font-mono\">Standard Rule Engine</span>`\n            }\n          </div>\n\n          <ul class=\"space-y-2 text-xs text-slate-200\">\n            ${ai_suggestions.suggestions.map((bullet, idx) => `\n              <li class=\"flex items-start space-x-2\">\n                <span class=\"w-4 h-4 rounded-full bg-slate-700 text-slate-300 flex items-center justify-center shrink-0 text-[10px] font-bold mt-0.5\">\n                  ${idx + 1}\n                </span>\n                <span class=\"text-[11px] leading-relaxed text-slate-300\">${bullet}</span>\n              </li>\n            `).join(\"\")}\n          </ul>\n\n          <!-- Mandatory Disclaimer -->\n          <div class=\"pt-2 border-t border-slate-800/80 text-[10px] text-slate-400 italic\">\n            ⚖️ ${ai_suggestions.disclaimer}\n          </div>\n        </div>\n\n      </div>\n\n      <!-- ACTION BUTTONS -->\n      <div class=\"flex flex-col sm:flex-row items-center gap-2.5 pt-2\">\n        <button id=\"btn-copy-discrepancy\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all active:scale-95\">\n          <span>📋 Copy Dispute Note</span>\n        </button>\n\n        <button id=\"btn-open-ca-slip\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n          <span>📑 Download / Print CA Slip</span>\n        </button>\n\n        <button id=\"btn-back-dashboard\" class=\"w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition-all\">\n          <span>← Back</span>\n        </button>\n      </div>\n\n    </div>\n  `;\n\n  // Attach event handlers\n  const btnQuickCopy = container.querySelector(\"#btn-quick-copy\");\n  if (btnQuickCopy && onCopyNote) {\n    btnQuickCopy.addEventListener(\"click\", onCopyNote);\n  }\n\n  const btnCopy = container.querySelector(\"#btn-copy-discrepancy\");\n  if (btnCopy && onCopyNote) {\n    btnCopy.addEventListener(\"click\", onCopyNote);\n  }\n\n  const btnCaSlip = container.querySelector(\"#btn-open-ca-slip\");\n  if (btnCaSlip && onOpenCaSlip) {\n    btnCaSlip.addEventListener(\"click\", onOpenCaSlip);\n  }\n\n  const btnBack = container.querySelector(\"#btn-back-dashboard\");\n  if (btnBack && onBack) {\n    btnBack.addEventListener(\"click\", onBack);\n  }\n\n  const btnRefreshTax = container.querySelector(\"#btn-refresh-tax-ai\");\n  if (btnRefreshTax && onRefreshTaxAi) {\n    btnRefreshTax.addEventListener(\"click\", onRefreshTaxAi);\n  }\n\n  // Handle inline edits\n  container.querySelectorAll(\"input[data-action]\").forEach(input => {\n    input.addEventListener(\"change\", (e) => {\n      const idx = parseInt(e.target.getAttribute(\"data-index\"), 10);\n      const action = e.target.getAttribute(\"data-action\");\n      const val = parseFloat(e.target.value) || 0;\n\n      if (onUpdateItem) {\n        onUpdateItem(idx, action, val);\n      }\n    });\n  });\n}\n","Overwrite":true,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/components/AuditScorecard.js"}}]}
