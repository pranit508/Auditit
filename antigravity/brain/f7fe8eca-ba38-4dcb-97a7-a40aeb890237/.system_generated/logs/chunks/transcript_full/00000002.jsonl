ctor(\"#viewer-column\");\n128:     const scoreCol = container.querySelector(\"#scorecard-column\");\n129: \n130:     if (activeMobileTab === \"bill\") {\n131:       tabBill.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all text-center bg-white text-slate-900 shadow-sm\";\n132:       tabAudit.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all text-center text-slate-600 hover:text-slate-900\";\n133:       viewerCol.classList.remove(\"hidden\");\n134:       scoreCol.classList.add(\"hidden\");\n135:     } else {\n136:       tabBill.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all text-center text-slate-600 hover:text-slate-900\";\n137:       tabAudit.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all text-center bg-white text-slate-900 shadow-sm\";\n138:       viewerCol.classList.add(\"hidden\");\n139:       scoreCol.classList.remove(\"hidden\");\n140:     }\n141:   }\n142: \n143:   // Mobile Tab Listeners\n144:   const tabBill = container.querySelector(\"#tab-toggle-bill\");\n145:   const tabAudit = container.querySelector(\"#tab-toggle-audit\");"}
