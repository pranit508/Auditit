otal) : expectedTotal;\n  }","Target":"  // Compute subtotal if missing\n  const calculatedItemsSum = round2(itemsToUse.reduce((acc, it) => acc + (it.amount || 0), 0));\n  if (!subtotal) {\n    subtotal = calculatedItemsSum;\n  }\n\n  // Compute total_declared if missing\n  if (!total_declared) {\n    total_declared = round2(subtotal + cgst + sgst + igst);\n  }"}}]}
