= await backendResp.text();\n82:       let parsed = null;\n83:       try {\n84:         parsed = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n85:         if (typeof parsed === \"string\") {\n86:           parsed = JSON.parse(parsed);\n87:         }\n88:       } catch (e) {\n89:         console.warn(\"Could not parse backend JSON:\", e);\n90:       }"}
