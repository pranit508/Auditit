{"step_index":871,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:12:36Z","content":"Created At: 2026-11-02T23:42:36+05:30\nCompleted At: 2026-11-02T23:42:36+05:30\nShowing lines 70-180 of 229\n70:             item[\"rate\"] = amt_num\n71:             item[\"total_amount\"] = amt_num\n72:             item[\"amount\"] = amt_num\n73: \n74:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n75:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n76:         if desc_clean and len(desc_clean) >= 3:\n77:             item[\"description\"] = desc_clean\n78: \n79:         cleaned.append(item)\n80: \n81:     return cleaned\n82: \n83: def sanitize_invoice_data(data: dict) -> dict:\n84:     \"\"\"\n85:     Sanitizes extracted invoice data immediately before sending it to the frontend.\n86:     Enforces MANDATORY RULES:\n87:     1. Clean Supplier Name (Remove phone/email artifacts)\n88:     2. Filter out non-items from the items list (address words, short desc, non-positive qty/rate, corrupt totals)\n89:     \"\"\"\n90:     if not isinstance(data, dict):\n91:         return data\n92: \n93:     # 1. Clean Supplier Name (Remove phone/email artifacts)\n94:     supplier = data.get(\"vendor_name\", \"\") or data.get(\"supplier_name\", \"\") or \"\"\n95:     supplier_cleaned = re.sub(r'(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+', '', supplier, flags=re.IGNORECASE).strip()\n96:     # Strip any trailing punctuation (commas, hyphens, colons) left behind\n97:     supplier_cleaned = re.sub(r'[\\s,\\-–—:|]+$', '', supplier_cleaned).strip()\n98:     data[\"vendor_name\"] = supplier_cleaned if supplier_cleaned else \"Supplier Name Unclear\"\n99:     data[\"supplier_name\"] = data[\"vendor_name\"]\n100: \n101:     # 2. Filter out non-items from the items list\n102:     filtered_items = []\n103:     \n104:     # Common address/metadata keywords that accidentally end up as descriptions\n105:     address_words = [\n106:         \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n107:         \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", \n108:         \"hundred\", \"only\", \"rupees\", \"bank\", \"ifsc\", \"a/c\", \"ac no\", \"phone\"\n109:     ]\n110: \n111:     gstin_pattern = re.compile(r'\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b', re.IGNORECASE)\n112:     phone_pattern = re.compile(r'(\\+?91[\\-\\s]?)?[6-9]\\d{9}')\n113:     pan_pattern = re.compile(r'\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b', re.IGNORECASE)\n114: \n115:     for item in data.get(\"items\", []):\n116:         if not isinstance(item, dict):\n117:             continue\n118: \n119:         desc = (item.get(\"description\") or \"\").strip()\n120:         desc_lower = desc.lower()\n121: \n122:         # Reject if description matches address/words or is too short\n123:         if any(word in desc_lower for word in address_words) or len(desc) < 3:\n124:             continue\n125: \n126:         # Reject GSTIN strings, PAN strings, or phone numbers\n127:         if gstin_pattern.search(desc) or phone_pattern.search(desc) or pan_pattern.search(desc):\n128:             continue\n129: \n130:         # Reject single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n131:         if re.match(r'^[A-Za-z0-9]{7,16}$', desc) and any(c.isdigit() for c in desc) and any(c.isalpha() for c in desc):\n132:             continue\n133: \n134:         # Reject if total amount matches common pin codes (e.g. 131001) or is clearly corrupt\n135:         raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\", 0)\n136:         raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n137:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n138: \n139:         try:\n140:             billed = float(raw_billed or 0)\n141:             qty = float(raw_qty or 0)\n142:             rate = float(raw_rate or 0)\n143:         except (ValueError, TypeError):\n144:             continue\n145: \n146:         # Quantity and rate must be positive\n147:         if qty <= 0 or rate <= 0:\n148:             continue\n149: \n150:         # If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n151:         if billed > (qty * rate * 10) and billed > 100000:\n152:             continue\n153: \n154:         # Post-Processing Column Swap Fallback:\n155:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n156:         # it means qty and rate were misaligned. Swap them:\n157:         if billed > 0 and qty == billed and rate in [1, 2, 1.0, 2.0]:\n158:             qty = 1.0\n159:             rate = billed\n160: \n161:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n162:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n163:         if desc_clean and len(desc_clean) >= 3:\n164:             desc = desc_clean\n165: \n166:         # Normalize fields for seamless compatibility\n167:         normalized = dict(item)\n168:         normalized[\"quantity\"] = qty\n169:         normalized[\"qty\"] = qty\n170:         normalized[\"unit_rate\"] = rate\n171:         normalized[\"rate\"] = rate\n172:         normalized[\"total_amount\"] = billed if billed > 0 else round(qty * rate, 2)\n173:         normalized[\"amount\"] = normalized[\"total_amount\"]\n174:         normalized[\"description\"] = desc\n175: \n176:         filtered_items.append(normalized)\n177: \n178:     data[\"items\"] = filtered_items\n179:     return data\n180: "}
