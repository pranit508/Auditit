                     response_mime_type=\"application/json\",\n123:                     response_schema=ExtractedInvoice,\n124:                     temperature=0.0\n125:                 )\n126:             )\n127:             return Response(content=response.text, media_type=\"application/json\")\n128:         except Exception as err:\n129:             last_err = err\n130:             err_str = str(err)\n131:             # If 404 not found (model retired by Google) or 503 spike, try next candidate\n132:             if \"404\" in err_str or \"503\" in err_str or \"not found\" in err_str.lower():\n133:                 print(f\"[AUDIT IT] Model {model_name} unavailable ({err_str[:80]}), trying next...\")\n134:                 continue\n135:             else:\n136:                 break\n137: \n138:     print(f\"[AUDIT IT] GenAI generate_content error: {last_err}\")\n139:     return JSONResponse(\n140:         status_code=500,"}
