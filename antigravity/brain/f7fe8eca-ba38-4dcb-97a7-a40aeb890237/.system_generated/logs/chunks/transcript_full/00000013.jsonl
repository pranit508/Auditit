{"step_index":804,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:01:31Z","content":"Created At: 2026-11-02T23:31:31+05:30\nCompleted At: 2026-11-02T23:31:31+05:30\nShowing lines 1-100 of 124\n1: // Client-side Privacy & Redaction Engine for AUDIT IT\n2: \n3: /**\n4:  * Masks Indian Bank Account Numbers (keeps last 4 digits visible)\n5:  * e.g., \"50100239482910\" -> \"•••• •••• •••• 2910\"\n6:  */\n7: export function maskBankAccount(accountNumber) {\n8:   if (!accountNumber) return \"\";\n9:   const cleaned = accountNumber.toString().replace(/\\s+/g, \"\");\n10:   if (cleaned.length <= 4) return \"••••\" + cleaned;\n11:   const lastFour = cleaned.slice(-4);\n12:   return \"•••• •••• •••• \" + lastFour;\n13: }\n14: \n15: /**\n16:  * Masks IFSC Codes (keeps bank prefix, masks branch code)\n17:  * e.g., \"HDFC0001234\" -> \"HDFC••••••\"\n18:  */\n19: export function maskIFSC(ifsc) {\n20:   if (!ifsc) return \"\";\n21:   const cleaned = ifsc.trim().toUpperCase();\n22:   if (cleaned.length < 5) return \"••••••\";\n23:   return cleaned.slice(0, 4) + \"••••••\";\n24: }\n25: \n26: /**\n27:  * Masks phone numbers (keeps last 3 digits)\n28:  * e.g., \"+91 9876543210\" -> \"+91 •••••••210\"\n29:  */\n30: export function maskPhone(phone) {\n31:   if (!phone) return \"\";\n32:   const cleaned = phone.replace(/[^\\d+]/g, \"\");\n33:   if (cleaned.length < 5) return \"•••••\";\n34:   return cleaned.slice(0, 3) + \" •••••••\" + cleaned.slice(-3);\n35: }\n36: \n37: /**\n38:  * Pre-processes any raw text or object to ensure sensitive financial identifiers\n39:  * are sanitized before UI display or downstream AI requests.\n40:  * Enforces MANDATORY RULES:\n41:  * 1. SUPPLIER NAME: Extract ONLY business trade name; remove phone/email artifacts.\n42:  * 2. WHAT IS A LINE ITEM: Product/part/material/service with qty > 0 and rate > 0.\n43:  * 3. FORBIDDEN LINE ITEMS: Street addresses, plots, industrial areas, GSTIN/PAN strings,\n44:  *    pincodes, telephone numbers, amount in words, bank details.\n45:  */\n46: export function sanitizeInvoiceData(rawInvoice) {\n47:   if (!rawInvoice || typeof rawInvoice !== \"object\") return rawInvoice;\n48:   const sanitized = JSON.parse(JSON.stringify(rawInvoice));\n49: \n50:   // 1. Clean Supplier Name (Remove phone/email artifacts)\n51:   const supplier = sanitized.vendor_name || sanitized.supplier_name || \"\";\n52:   let supplierCleaned = supplier.replace(/(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+/gi, \"\").trim();\n53:   supplierCleaned = supplierCleaned.replace(/[\\s,\\-–—:|]+$/, \"\").trim();\n54:   sanitized.vendor_name = supplierCleaned || \"Supplier Name Unclear\";\n55:   sanitized.supplier_name = sanitized.vendor_name;\n56: \n57:   // 2. Filter out non-items from the items list\n58:   if (Array.isArray(sanitized.items)) {\n59:     const addressWords = [\n60:       \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n61:       \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", \n62:       \"hundred\", \"only\", \"rupees\", \"bank\", \"ifsc\", \"a/c\", \"ac no\", \"phone\"\n63:     ];\n64: \n65:     const GSTIN_PATTERN = /\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n66:     const PHONE_PATTERN = /(\\+?91[\\-\\s]?)?[6-9]\\d{9}/;\n67:     const PAN_PATTERN = /\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b/i;\n68: \n69:     sanitized.items = sanitized.items.filter(item => {\n70:       if (!item || typeof item !== \"object\") return false;\n71: \n72:       const desc = (item.description || item.item_name || \"\").trim();\n73:       const descLower = desc.toLowerCase();\n74: \n75:       // Reject if description matches address/words or is too short\n76:       if (addressWords.some(word => descLower.includes(word)) || desc.length < 3) {\n77:         return false;\n78:       }\n79: \n80:       // Reject GSTIN strings, PAN strings, or phone numbers\n81:       if (GSTIN_PATTERN.test(desc) || PHONE_PATTERN.test(desc) || PAN_PATTERN.test(desc)) {\n82:         return false;\n83:       }\n84: \n85:       // Reject single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n86:       if (/^[A-Za-z0-9]{7,16}$/.test(desc) && /\\d/.test(desc) && /[A-Za-z]/.test(desc)) {\n87:         return false;\n88:       }\n89: \n90:       const billed = Number(item.total_amount !== undefined ? item.total_amount : item.amount) || 0;\n91:       const qty = Number(item.quantity !== undefined ? item.quantity : item.qty) || 0;\n92:       const rate = Number(item.unit_rate !== undefined ? item.unit_rate : item.rate) || 0;\n93: \n94:       // Quantity and rate must be positive\n95:       if (qty <= 0 || rate <= 0) return false;\n96: \n97:       // If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n98:       if (billed > (qty * rate * 10) && billed > 100000) return false;\n99: \n100:       // Normalize properties"}
