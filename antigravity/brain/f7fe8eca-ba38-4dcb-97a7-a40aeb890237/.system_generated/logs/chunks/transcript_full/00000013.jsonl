{"step_index":814,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:02:03Z","content":"Created At: 2026-11-02T23:32:03+05:30\nCompleted At: 2026-11-02T23:32:04+05:30\nShowing lines 1-140 of 211\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: AUDIT IT - Retail Bill Verification Engine\n4: FastAPI + Google GenAI Server\n5: \"\"\"\n6: \n7: import os\n8: import sys\n9: import json\n10: from typing import List, Optional\n11: \n12: import uvicorn\n13: from fastapi import FastAPI, UploadFile, File, Header\n14: from fastapi.responses import Response, JSONResponse\n15: from fastapi.middleware.cors import CORSMiddleware\n16: from fastapi.staticfiles import StaticFiles\n17: from pydantic import BaseModel\n18: from google import genai\n19: from google.genai import types\n20: \n21: # Default Gemini API key provided by user\n22: DEFAULT_GEMINI_API_KEY = \"AQ.Ab8RN6LhTNa6kIQRpd_OijgrXNfmwLOw7rcxiMN8aWW-_U7mPw\"\n23: \n24: # Ensure workspace root is in python path\n25: SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\n26: sys.path.insert(0, SCRIPT_DIR)\n27: from utils.clean_items import clean_extracted_items, sanitize_invoice_data\n28: \n29: # Initialize Google GenAI Client\n30: client = None\n31: active_key = os.environ.get(\"GEMINI_API_KEY\") or DEFAULT_GEMINI_API_KEY\n32: if active_key:\n33:     try:\n34:         client = genai.Client(api_key=active_key)\n35:     except Exception as e:\n36:         print(f\"[AUDIT IT] Warning: Failed to init default GenAI client: {e}\")\n37: \n38: # Exact Pydantic Schemas (No is_valid_bill or gatekeeper rejection fields)\n39: class InvoiceItem(BaseModel):\n40:     description: str\n41:     quantity: float\n42:     unit_rate: float\n43:     total_amount: float\n44: \n45: class ExtractedInvoice(BaseModel):\n46:     vendor_name: Optional[str] = None\n47:     gstin: Optional[str] = None\n48:     invoice_number: Optional[str] = None\n49:     date: Optional[str] = None\n50:     items: List[InvoiceItem] = []\n51:     subtotal: Optional[float] = None\n52:     cgst: Optional[float] = None\n53:     sgst: Optional[float] = None\n54:     igst: Optional[float] = None\n55:     declared_total: Optional[float] = None\n56: \n57: app = FastAPI(title=\"AUDIT IT - Bill Verification API\")\n58: \n59: # Enable CORS for local development and cross-origin requests\n60: app.add_middleware(\n61:     CORSMiddleware,\n62:     allow_origins=[\"*\"],\n63:     allow_credentials=True,\n64:     allow_methods=[\"*\"],\n65:     allow_headers=[\"*\"],\n66: )\n67: \n68: def get_genai_client(custom_api_key: Optional[str] = None) -> Optional[genai.Client]:\n69:     \"\"\"Retrieve or instantiate a Google GenAI Client.\"\"\"\n70:     key = custom_api_key or os.environ.get(\"GEMINI_API_KEY\") or DEFAULT_GEMINI_API_KEY\n71:     if key and key.strip():\n72:         try:\n73:             return genai.Client(api_key=key.strip())\n74:         except Exception as err:\n75:             print(f\"[AUDIT IT] Error initializing client with key: {err}\")\n76:     global client\n77:     if client:\n78:         return client\n79:     return None\n80: \n81: @app.post(\"/api/analyze-bill\")\n82: async def analyze_bill(\n83:     file: UploadFile = File(...),\n84:     x_api_key: Optional[str] = Header(None, alias=\"x-api-key\")\n85: ):\n86:     contents = await file.read()\n87:     mime_type = file.content_type or \"image/jpeg\"\n88:     \n89:     # Prompt with table column alignment instructions\n90:     prompt = \"\"\"Extract the invoice details from this image/document into JSON:\n91:  - vendor_name: (string)\n92:  - gstin: (string or null)\n93:  - invoice_number: (string or null)\n94:  - items: list of {description, quantity, unit_rate, total_amount}\n95:  - subtotal: (number)\n96:  - cgst: (number)\n97:  - sgst: (number)\n98:  - igst: (number)\n99:  - declared_total: (number)\n100:  If any field is missing or unclear, leave it null. Do not include addresses or phone numbers as line items.\n101: \n102: TABLE COLUMN ALIGNMENT INSTRUCTIONS:\n103: - Carefully identify the table header row to locate column boundaries (S.No, Description, HSN/SAC, Quantity, Unit, Rate/Price, Amount).\n104: - CROSS-CHECK MATH INTERNALLY: For each row, verify that (quantity * unit_rate) roughly equals the row total amount. \n105:   * If quantity * rate does not equal the row amount, you likely swapped the Quantity and Rate columns, or confused the Item Code/HSN/S.No with Quantity. \n106:   * Never set Rate to trivial numbers like 1 or 2 when the item is an expensive product like a 'Tool Kit', unless that is explicitly the printed unit rate.\n107: - Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description.\"\"\"\n108: \n109:     genai_client = get_genai_client(x_api_key)\n110:     if not genai_client:\n111:         return JSONResponse(\n112:             status_code=400,\n113:             content={\"error\": \"Gemini API key is required.\"}\n114:         )\n115: \n116:     # Call Gemini (primary: gemini-2.5-flash; fallback to gemini-3.5-flash if 404/unavailable)\n117:     models_to_try = ['gemini-2.5-flash', 'gemini-3.5-flash', 'gemini-3.8-flash']\n118:     last_err = None\n119: \n120:     for model_name in models_to_try:\n121:         try:\n122:             response = genai_client.models.generate_content(\n123:                 model=model_name,\n124:                 contents=[\n125:                     types.Part.from_bytes(data=contents, mime_type=mime_type),\n126:                     prompt\n127:                 ],\n128:                 config=types.GenerateContentConfig(\n129:                     response_mime_type=\"application/json\",\n130:                     response_schema=ExtractedInvoice,\n131:                     temperature=0.0\n132:                 )\n133:             )\n134:             # Post-Processing Column Swap Fallback (Python)\n135:             try:\n136:                 parsed = json.loads(response.text)\n137:                 items = parsed.get(\"items\", [])\n138:                 for item in items:\n139:                     qty = item.get('quantity', 0)\n140:                     rate = item.get('unit_rate', 0)"}
