{"step_index":816,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:02:10Z","content":"Created At: 2026-11-02T23:32:10+05:30\nCompleted At: 2026-11-02T23:32:10+05:30\nShowing lines 140-211 of 211\n140:                     rate = item.get('unit_rate', 0)\n141:                     total = item.get('total_amount', 0)\n142:                     \n143:                     # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n144:                     # it means qty and rate were misaligned. Swap them:\n145:                     if total > 0 and qty == total and rate in [1, 2, 1.0, 2.0]:\n146:                         item['quantity'] = 1.0\n147:                         item['unit_rate'] = total\n148: \n149:                 sanitized = sanitize_invoice_data(parsed)\n150:                 return Response(content=json.dumps(sanitized), media_type=\"application/json\")\n151:             except Exception as e:\n152:                 print(f\"[AUDIT IT] Post-processing note: {e}\")\n153:                 return Response(content=response.text, media_type=\"application/json\")\n154:         except Exception as err:\n155:             last_err = err\n156:             err_str = str(err)\n157:             # If 404 not found (model retired by Google) or 503 spike, try next candidate\n158:             if \"404\" in err_str or \"503\" in err_str or \"not found\" in err_str.lower():\n159:                 print(f\"[AUDIT IT] Model {model_name} unavailable ({err_str[:80]}), trying next...\")\n160:                 continue\n161:             else:\n162:                 break\n163: \n164:     print(f\"[AUDIT IT] GenAI generate_content error: {last_err}\")\n165:     return JSONResponse(\n166:         status_code=500,\n167:         content={\"error\": f\"Gemini extraction failed: {str(last_err)}\"}\n168:     )\n169: \n170: @app.post(\"/api/clean-items\")\n171: async def clean_items_endpoint(data: dict):\n172:     raw_items = data.get(\"items\", [])\n173:     cleaned = clean_extracted_items(raw_items)\n174:     return {\"success\": True, \"items\": cleaned, \"count\": len(cleaned)}\n175: \n176: @app.post(\"/api/process-invoice\")\n177: @app.post(\"/api/sanitize-invoice\")\n178: @app.post(\"/api/extract-invoice\")\n179: async def process_invoice_endpoint(data: dict):\n180:     extracted_data = data.get(\"extracted_data\") or data.get(\"invoice\") or data\n181:     sanitized_data = sanitize_invoice_data(extracted_data)\n182:     calculated_subtotal = round(sum(\n183:         float(it.get(\"quantity\") or it.get(\"qty\") or 1) * \n184:         float(it.get(\"unit_rate\") or it.get(\"rate\") or 0)\n185:         for it in sanitized_data.get(\"items\", [])\n186:     ), 2)\n187:     sanitized_data[\"calculated_subtotal\"] = calculated_subtotal\n188:     if not sanitized_data.get(\"subtotal\") or sanitized_data.get(\"subtotal\") == 0:\n189:         sanitized_data[\"subtotal\"] = calculated_subtotal\n190: \n191:     return {\n192:         \"success\": True,\n193:         \"extracted_data\": sanitized_data,\n194:         \"invoice\": sanitized_data\n195:     }\n196: \n197: # Mount static files to serve the frontend web application\n198: app.mount(\"/\", StaticFiles(directory=SCRIPT_DIR, html=True), name=\"static\")\n199: \n200: def run(port: int = 3000):\n201:     print(\"\\n\" + \"=\"*56)\n202:     print(\"  🚀 AUDIT IT - FastAPI + Google GenAI Server\")\n203:     print(f\"  Serving on: http://localhost:{port}\")\n204:     print(f\"  Model:      gemini-2.5-flash / gemini-3.5-flash\")\n205:     print(f\"  Root Dir:   {SCRIPT_DIR}\")\n206:     print(\"=\"*56 + \"\\n\")\n207:     uvicorn.run(app, host=\"0.0.0.0\", port=port, log_level=\"info\")\n208: \n209: if __name__ == \"__main__\":\n210:     port = int(sys.argv[1]) if len(sys.argv) > 1 else 3000\n211:     run(port)"}
