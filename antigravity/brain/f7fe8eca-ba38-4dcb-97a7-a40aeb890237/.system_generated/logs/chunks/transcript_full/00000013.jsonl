{"step_index":808,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:01:38Z","content":"Created At: 2026-11-02T23:31:38+05:30\nCompleted At: 2026-11-02T23:31:38+05:30\nShowing lines 1-100 of 104\n1: // AUDIT IT - Strict Item Cleaner & Metadata Exclusion Filter\n2: // CRITICAL RULES:\n3: // 1. HEADER VS TABLE SEPARATION: Metadata (GSTIN, Phone, Address, Bank details) must NEVER be extracted as line items.\n4: // 2. EXCLUSION RULES: Purge phone numbers, GSTIN patterns, and metadata labels.\n5: \n6: // Pattern matching GSTIN (15 characters: 2 digits, 5 letters, 4 digits, 1 letter, 1 digit/letter, Z, 1 digit/letter)\n7: const GSTIN_PATTERN = /\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n8: \n9: // Pattern matching Indian phone numbers (10 digits, optional +91 prefix)\n10: const PHONE_PATTERN = /(\\+?91[\\-\\s]?)?[6-9]\\d{9}/;\n11: \n12: // Common metadata and address keywords that should never be product names\n13: const FORBIDDEN_KEYWORDS = [\n14:   \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n15:   \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", \n16:   \"hundred\", \"only\", \"rupees\", \"bank\", \"ifsc\", \"a/c\", \"ac no\", \"phone\",\n17:   \"gst no\", \"contact\", \"mobile\", \"tel\", \"pan no\", \"invoice no\",\n18:   \"tax invoice\", \"bill to\", \"ship to\", \"address\", \"state code\",\n19:   \"reverse charge\", \"e-way bill\", \"transport\", \"vehicle no\",\n20:   \"cash memo\", \"challan\", \"original for recipient\", \"date\"\n21: ];\n22: \n23: // Pattern matching Indian PAN (5 letters, 4 digits, 1 letter)\n24: const PAN_PATTERN = /\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b/i;\n25: \n26: /**\n27:  * Purges metadata, phone numbers, and GSTIN strings from extracted items array\n28:  * @param {Array} items - Raw items array extracted by AI or OCR\n29:  * @returns {Array} Cleaned items strictly containing genuine products/services\n30:  */\n31: export function cleanExtractedItems(items) {\n32:   if (!Array.isArray(items)) return [];\n33:   const cleaned = [];\n34: \n35:   for (const item of items) {\n36:     if (!item || typeof item !== \"object\") continue;\n37: \n38:     const desc = (item.description || item.item_name || \"\").trim();\n39:     const descLower = desc.toLowerCase();\n40: \n41:     // 1. Skip if the description is too short or contains GSTIN, PAN, or phone numbers\n42:     if (desc.length < 3 || GSTIN_PATTERN.test(desc) || PHONE_PATTERN.test(desc) || PAN_PATTERN.test(desc)) {\n43:       console.warn(\"[AUDIT IT] Purged metadata/address item (Pattern or short length):\", desc);\n44:       continue;\n45:     }\n46: \n47:     // Skip single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n48:     if (/^[A-Za-z0-9]{7,16}$/.test(desc) && /\\d/.test(desc) && /[A-Za-z]/.test(desc)) {\n49:       console.warn(\"[AUDIT IT] Purged single-token alphanumeric tax ID:\", desc);\n50:       continue;\n51:     }\n52: \n53:     // 2. Skip if the description matches address/metadata keywords\n54:     if (FORBIDDEN_KEYWORDS.some(keyword => descLower.includes(keyword))) {\n55:       console.warn(\"[AUDIT IT] Purged metadata item (Forbidden keyword detected):\", desc);\n56:       continue;\n57:     }\n58: \n59:     // 3. Skip invalid items with zero/negative rates or quantities\n60:     let qty = Number(item.quantity !== undefined ? item.quantity : item.qty);\n61:     let rate = Number(item.unit_rate !== undefined ? item.unit_rate : item.rate);\n62:     const billed = Number(item.total_amount !== undefined ? item.total_amount : item.amount);\n63: \n64:     // Post-Processing Column Swap Fallback:\n65:     // If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n66:     // it means qty and rate were misaligned. Swap them:\n67:     if (billed > 0 && qty === billed && (rate === 1 || rate === 2)) {\n68:       console.info(\"[AUDIT IT] Column swap detected: qty=\" + qty + \", rate=\" + rate + \", total=\" + billed + \" -> swapping to qty=1.0, rate=\" + billed);\n69:       qty = 1.0;\n70:       rate = billed;\n71:     }\n72: \n73:     // Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n74:     const descClean = desc.replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, \"\").trim();\n75:     const finalDesc = descClean.length >= 3 ? descClean : desc;\n76: \n77:     if (isNaN(qty) || isNaN(rate) || qty <= 0 || rate <= 0) {\n78:       console.warn(\"[AUDIT IT] Purged item with non-positive qty or rate:\", item);\n79:       continue;\n80:     }\n81: \n82:     // 4. Reject if total amount matches corrupt pincode/number (billed > qty * rate * 10 and billed > 100000)\n83:     if (!isNaN(billed) && billed > (qty * rate * 10) && billed > 100000) {\n84:       console.warn(\"[AUDIT IT] Purged item with corrupt pincode total amount:\", item);\n85:       continue;\n86:     }\n87: \n88:     // Normalize property names for consistency (qty, rate, amount)\n89:     const normalizedItem = {\n90:       ...item,\n91:       quantity: qty,\n92:       qty: qty,\n93:       unit_rate: rate,\n94:       rate: rate,\n95:       total_amount: isNaN(billed) || billed <= 0 ? (qty * rate) : billed,\n96:       amount: isNaN(billed) || billed <= 0 ? (qty * rate) : billed,\n97:       description: finalDesc\n98:     };\n99: \n100:     cleaned.push(normalizedItem);"}
