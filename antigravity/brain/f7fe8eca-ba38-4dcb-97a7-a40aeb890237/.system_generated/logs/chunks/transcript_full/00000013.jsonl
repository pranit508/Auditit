{"step_index":818,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:02:15Z","content":"Created At: 2026-11-02T23:32:15+05:30\nCompleted At: 2026-11-02T23:32:15+05:30\nShowing lines 1-100 of 212\n1: \"\"\"\n2: AUDIT IT - Item Cleaning & Exclusion Filter\n3: Enforces strict Header vs Table separation and purges metadata from line items.\n4: \"\"\"\n5: \n6: import re\n7: \n8: def clean_extracted_items(items: list) -> list:\n9:     \"\"\"\n10:     Purges metadata, phone numbers, and GSTIN strings from extracted items array.\n11:     Ensures any item containing phone numbers, GSTIN strings, or metadata keywords\n12:     is purged before passing the items to the total recalculation logic.\n13:     \"\"\"\n14:     cleaned = []\n15:     \n16:     # Pattern matching GSTIN (15 characters: 2 digits, 5 letters, 4 digits, 1 letter, 1 digit/letter, Z, 1 digit/letter)\n17:     gstin_pattern = re.compile(r'\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b', re.IGNORECASE)\n18:     # Pattern matching Indian phone numbers (10 digits, optional +91 prefix)\n19:     phone_pattern = re.compile(r'(\\+?91[\\-\\s]?)?[6-9]\\d{9}')\n20:     \n21:     # Common metadata keywords that should never be product names\n22:     forbidden_keywords = [\n23:         \"gstin\", \"gst no\", \"contact\", \"phone\", \"mobile\", \"tel\", \n24:         \"pan no\", \"bank\", \"ifsc\", \"account no\", \"invoice no\",\n25:         \"tax invoice\", \"bill to\", \"ship to\", \"address\", \"state code\",\n26:         \"reverse charge\", \"e-way bill\", \"transport\", \"vehicle no\",\n27:         \"cash memo\", \"challan\", \"original for recipient\", \"date\"\n28:     ]\n29: \n30:     for item in items:\n31:         if not item or not isinstance(item, dict):\n32:             continue\n33: \n34:         desc = item.get(\"description\", \"\").strip()\n35:         desc_lower = desc.lower()\n36: \n37:         # 1. Skip if the description contains GSTIN patterns or phone numbers\n38:         if gstin_pattern.search(desc) or phone_pattern.search(desc):\n39:             continue\n40: \n41:         # 2. Skip if the description is just a metadata label\n42:         if any(keyword in desc_lower for keyword in forbidden_keywords):\n43:             continue\n44: \n45:         # 3. Skip invalid items with zero/negative rates or quantities\n46:         qty = item.get(\"quantity\") if \"quantity\" in item else item.get(\"qty\", 0)\n47:         rate = item.get(\"unit_rate\") if \"unit_rate\" in item else item.get(\"rate\", 0)\n48:         amount = item.get(\"amount\", 0)\n49: \n50:         # Ensure numeric values\n51:         try:\n52:             qty_num = float(qty) if qty is not None else 0\n53:             rate_num = float(rate) if rate is not None else 0\n54:             amt_num = float(amount) if amount is not None else 0\n55:         except (ValueError, TypeError):\n56:             continue\n57: \n58:         if (qty_num <= 0) or (rate_num <= 0 and amt_num <= 0):\n59:             continue\n60: \n61:         # Post-Processing Column Swap Fallback:\n62:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n63:         # it means qty and rate were misaligned. Swap them:\n64:         if amt_num > 0 and qty_num == amt_num and rate_num in [1.0, 2.0, 1, 2]:\n65:             qty_num = 1.0\n66:             rate_num = amt_num\n67:             item[\"quantity\"] = 1.0\n68:             item[\"qty\"] = 1.0\n69:             item[\"unit_rate\"] = amt_num\n70:             item[\"rate\"] = amt_num\n71: \n72:         cleaned.append(item)\n73: \n74:     return cleaned\n75: \n76: def sanitize_invoice_data(data: dict) -> dict:\n77:     \"\"\"\n78:     Sanitizes extracted invoice data immediately before sending it to the frontend.\n79:     Enforces MANDATORY RULES:\n80:     1. Clean Supplier Name (Remove phone/email artifacts)\n81:     2. Filter out non-items from the items list (address words, short desc, non-positive qty/rate, corrupt totals)\n82:     \"\"\"\n83:     if not isinstance(data, dict):\n84:         return data\n85: \n86:     # 1. Clean Supplier Name (Remove phone/email artifacts)\n87:     supplier = data.get(\"vendor_name\", \"\") or data.get(\"supplier_name\", \"\") or \"\"\n88:     supplier_cleaned = re.sub(r'(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+', '', supplier, flags=re.IGNORECASE).strip()\n89:     # Strip any trailing punctuation (commas, hyphens, colons) left behind\n90:     supplier_cleaned = re.sub(r'[\\s,\\-–—:|]+$', '', supplier_cleaned).strip()\n91:     data[\"vendor_name\"] = supplier_cleaned if supplier_cleaned else \"Supplier Name Unclear\"\n92:     data[\"supplier_name\"] = data[\"vendor_name\"]\n93: \n94:     # 2. Filter out 