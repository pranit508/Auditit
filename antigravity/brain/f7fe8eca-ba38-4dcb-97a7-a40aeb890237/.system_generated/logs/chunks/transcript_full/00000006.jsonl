a data attribute for identification, current value, and placeholder text. A notice informs the user that calculations will occur upon submitting valid inputs. The form includes submit and back-to-dashboard buttons.\n\n\nThe analysis indicates that a handler for submitting valid inputs is needed to update the invoice data. This involves collecting input values, updating the relevant invoice fields, and triggering a recalculation. Reviewing the codebase suggests adding the `onSubmitValidInputs` handler to the appropriate component and implementing a corresponding `handleSubmitValidInputs` function. This will update the invoice values and trigger the recalculation upon valid input submission.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/components/AuditScorecard.js","Replacement":"  const { \n    onUpdateItem, \n    onAddItem, \n    onDeleteItem,\n    onUpdateHeader,\n    onAutoFixMath,\n    onUpdateTaxSettings,\n    onSubmitValidInputs,\n    onCopyNote, \n    onOpenCaSlip, \n    onBack, \n    selectedItemId, \n    taxData, \n    onRefreshTaxAi \n  } = options;\n\n  // IF DOCUMENT IS NOT A VALID INVOICE (Gatekeeper Rejection)\n  if (audit.is_valid_bill === false) {\n    container.innerHTML = `\n      <div class=\"space-y-4\">\n        <div class=\"bg-rose-50 border-2 border-rose-300 rounded-2xl p-6 text-rose-950 shadow-sm space-y-4\">\n          <div class=\"flex items-start space-x-3.5\">\n            <div class=\"w-12 h-12 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold text-2xl shrink-0 shadow-sm\">\n              🛑\n            </div>\n            <div>\n              <span class=\"inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-200 text-rose-900 mb-1\">\n                Gatekeeper Rejection\n              </span>\n              <h3 class=\"text-base sm:text-lg font-black text-rose-950 tracking-tight\">\n                Not a Business Bill or Invoice\n              </h3>\n              <p class=\"text-xs text-rose-800 mt-1 leading-relaxed\">\n                ${audit.rejection_reason || \"The uploaded image or document is not a genuine commercial bill, cash memo, or tax receipt.\"}\n              </p>\n            </div>\n          </div>\n\n          <div class=\"bg-white/80 p-3.5 rounded-xl border border-rose-200 text-xs text-slate-700 space-y-2\">\n            <div class=\"font-bold text-slate-900 flex items-center space-x-1.5\">\n              <span>🛡️ Zero Hallucination Guarantee</span>\n            </div>\n            <p class=\"text-[11px] text-slate-600 leading-relaxed\">\n              AUDIT IT strictly parses commercial documents only. Because this image was rejected, \n              <strong>all financial figures have been left empty</strong> to prevent hallucinating incorrect numbers into your accounting books.\n            </p>\n            <div class=\"pt-2 border-t border-slate-100 flex flex-wrap gap-2 text-[10px] text-slate-500 font-mono\">\n              <span class=\"bg-slate-100 px-2 py-0.5 rounded\">is_valid_bill: false</span>\n              <span class=\"bg-slate-100 px-2 py-0.5 rounded\">subtotal: null</span>\n              <span class=\"bg-slate-100 px-2 py-0.5 rounded\">total_declared: null</span>\n            </div>\n          </div>\n\n          <div class=\"pt-2 flex items-center space-x-2\">\n            <button id=\"btn-back-dashboard-reject\" class=\"px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all active:scale-95\">\n              ← Upload a Genuine Bill\n            </button>\n          </div>\n        </div>\n      </div>\n    `;\n\n    const btnBackReject = container.querySelector(\"#btn-back-dashboard-reject\");\n    if (btnBackReject && onBack) {\n      btnBackReject.addEventListener(\"click\", onBack);\n    }\n    return;\n  }\n\n  // IF SOMETHING IS MISSING OR UNCLEAR: DO NOT MOVE AHEAD AND CALCULATE\n  // RULE: \"if something seems missing or is unclear in the given document then do not move ahead and calculate just simply ask the user to give valid input\"\n  if (audit.isHalted) {\n    const missingList = audit.missingOrUnclearInputs || [];\n    container.innerHTML = `\n      <div class=\"space-y-4\">\n        \n        <!-- HALT BANNER -->\n        <div class=\"bg-amber-50/95 border-2 border-amber-300 rounded-2xl p-5 sm:p-6 text-amber-950 shadow-sm space-y-4\">\n          <div class=\"flex items-start space-x-3.5\">\n            <div class=\"w-12 h-12 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-2xl shrink-0 shadow-sm\">\n              ⚠️\n            </div>\n            <div>\n              <span class=\"inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-200 text-amber-900 mb-1\">\n                Calculations Paused\n              </span>\n              <h3 class=\"text-base sm:text-lg font-black text-amber-950 tracking-tight\">\n                Valid Input Required Before Calculating\n              </h3>\n              <p class=\"text-xs text-amber-900 mt-1 leading-relaxed\">\n                Some details on this document are missing or illegible. To ensure 100% mathematical accuracy and avoid incorrect tax calculations, \n                please review your bill on the left and enter the valid numbers below:\n              </p>\n            </div>\n          </div>\n\n          <!-- MISSING / UNCLEAR FIELDS FORM -->\n          <div class=\"bg-white p-4 sm:p-5 rounded-xl border border-amber-200 shadow-xs space-y-3.5 text-xs text-slate-800\">\n            <div class=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n              <span class=\"font-bold text-slate-800 uppercase tracking-wider text-[11px]\">\n                Please Provide or Confirm ${missingList.length} Missing Detail(s):\n              </span>\n              <span class=\"text-[10px] text-amber-700 font-semibold\">Zero Guesswork</span>\n            </div>\n\n            <div class=\"space-y-3\" id=\"missing-inputs-form\">\n              ${missingList.map((m, idx) => `\n                <div class=\"p-3 rounded-lg bg-amber-50/40 border border-amber-200 space-y-1.5\" data-field-row=\"${m.field}\">\n                  <div class=\"flex items-center justify-between\">\n                    <label class=\"font-bold text-slate-900 text-xs flex items-center space-x-1.5\">\n                      <span class=\"w-4 h-4 rounded-full bg-amber-500 text-white flex items-center justify-center text-[10px] font-mono\">${idx + 1}</span>\n                      <span>${m.label}</span>\n                    </label>\n                    ${m.isGstin ? `\n                      <button type=\"button\" class=\"btn-mark-unregistered text-[10px] font-bold text-emerald-700 hover:underline\">\n                        ✓ Mark as Unregistered (No GSTIN)\n                      </button>\n                    ` : ''}\n                  </div>\n                  \n                  <p class=\"text-[11px] text-slate-500\">${m.description}</p>\n\n                  <div class=\"mt-1\">\n                    <input \n                      type=\"${m.isNumber || m.isItemRate || m.isItemQty ? 'number' : 'text'}\" \n                      ${m.isNumber || m.isItemRate ? 'step=\"0.01\"' : ''}\n                      class=\"missing-input-field w-full px-3 py-2 rounded-lg border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-xs font-mono text-slate-900 bg-white\"\n                      data-field=\"${m.field}\"\n                      data-item-index=\"${m.itemIndex !== undefined ? m.itemIndex : ''}\"\n                      value=\"${m.currentValue || ''}\"\n                      placeholder=\"${m.placeholder || 'Enter value...'}\"\n                    />\n                  </div>\n                </div>\n              `).join(\"\")}\n            </div>\n\n            <!-- Lock Explanation Notice -->\n            <div class=\"p-3 rounded-lg bg-slate-50 border border-slate-200 flex items-center space-x-2 text-[11px] text-slate-600\">\n              <span class=\"text-sm\">🔒</span>\n              <span>Calculations, discrepancies, and tax recommendations will calculate immediately after you submit valid inputs.</span>\n            </div>\n\n            <!-- Submit Button -->\n            <div class=\"pt-2 flex flex-col sm:flex-row items-center gap-2\">\n              <button \n                id=\"btn-submit-valid-inputs\" \n                class=\"w-full sm:flex-1 py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md transition-all active:scale-95 flex items-center justify-center space-x-2\"\n              >\n                <span>🚀 Confirm Inputs & Calculate Audit</span>\n              </button>\n\n              <button \n                id=\"btn-back-dashboard-halt\" \n                class=\"w-full sm:w-auto py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition-all\"\n              >\n                ← Back\n              </button>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    `;\n\n    // Handle Mark as Unregistered\n    container.querySelectorAll(\".btn-mark-unregistered\").forEach(btn => {\n      btn.addEventListener(\"click\", () => {\n        const gstinInput = container.querySelector(`input[data-field=\"gstin\"]`);\n        if (gstinInput) {\n          gstinInput.value = \"UNREGISTERED\";\n          gstinInput.classList.add(\"bg-emerald-50\", \"text-emerald-800\", \"font-bold\");\n        }\n      });\n    });\n\n    // Handle Submit\n    const btnSubmit = container.querySelector(\"#btn-submit-valid-inputs\");\n    if (btnSubmit && onSubmitValidInputs) {\n      btnSubmit.addEventListener(\"click\", () => {\n        const fields = {};\n        container.querySelectorAll(\".missing-input-field\").forEach(inp => {\n          const field = inp.getAttribute(\"data-field\");\n          const itemIdx = inp.getAttribute(\"data-item-index\");\n          const val = inp.value.trim();\n          fields[field] = { value: val, itemIndex: itemIdx !== '' ? parseInt(itemIdx, 10) : null };\n        });\n        onSubmitValidInputs(fields);\n      });\n    }\n\n    const btnBackHalt = container.querySelector(\"#btn-back-dashboard-halt\");\n    if (btnBackHalt && onBack) {\n      btnBackHalt.addEventListener(\"click\", onBack);\n    }\n    return;\n  }","Target":"  const { \n    onUpdateItem, \n    onAddItem, \n    onDeleteItem,\n    onUpdateHeader,\n    onAutoFixMath,\n    onUpdateTaxSettings,\n    onCopyNote, \n    onOpenCaSlip, \n    onBack, \n    selectedItemId, \n    taxData, \n    onRefreshTaxAi \n  } = options;\n\n  // IF DOCUMENT IS NOT A VALID INVOICE (Gatekeeper Rejection)\n  if (audit.is_valid_bill === false) {\n    container.innerHTML = `\n      <div class=\"space-y-4\">\n        <div class=\"bg-rose-50 border-2 border-rose-300 rounded-2xl p-6 text-rose-950 shadow-sm space-y-4\">\n          <div class=\"flex items-start space-x-3.5\">\n            <div class=\"w-12 h-12 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold text-2xl shrink-0 shadow-sm\">\n              🛑\n            </div>\n            <div>\n              <span class=\"inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-200 text-rose-900 mb-1\">\n                Gatekeeper Rejection\n              </span>\n              <h3 class=\"text-base sm:text-lg font-black text-rose-950 tracking-tight\">\n                Not a Business Bill or Invoice\n              </h3>\n              <p class=\"text-xs text-rose-800 mt-1 leading-relaxed\">\n                ${audit.rejection_reason || \"The uploaded image or document is not a genuine commercial bill, cash memo, or tax receipt.\"}\n              </p>\n         