  \"items\": [\n34:     {\n35:       \"description\": string,\n36:       \"hsn\": string or null,\n37:       \"qty\": number,\n38:       \"rate\": number,\n39:       \"amount\": number,\n40:       \"is_blurry\": boolean\n41:     }\n42:   ],\n43:   \"subtotal\": number or null,\n44:   \"cgst\": number or null,\n45:   \"sgst\": number or null,\n46:   \"igst\": number or null,\n47:   \"total_declared\": number or null,\n48:   \"bank_details\": {\n49:     \"bank_name\": string or null,\n50:     \"account_number\": string or null,\n51:     \"ifsc\": string or null\n52:   }\n53: }\n54: `;\n55: \n56: /**\n57:  * Extracts structured JSON from an uploaded invoice image/PDF.\n58:  * Prioritizes:\n59:  * 1. Live Multimodal Gemini API (if key configured)\n60:  * 2. In-browser Client-side PDF.js (for PDFs)"}
