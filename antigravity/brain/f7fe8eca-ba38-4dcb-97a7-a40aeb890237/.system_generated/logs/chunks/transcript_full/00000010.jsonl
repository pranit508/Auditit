{"step_index":550,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T17:07:33Z","input_tokens":2255,"cache_read_tokens":134440,"output_tokens":1718,"tool_calls":[{"name":"write_file","args":{"Content":"#!/usr/bin/env python3\n\"\"\"\nAUDIT IT - Retail Bill Verification Engine\nFastAPI + Google GenAI (gemini-2.5-flash) Server\n\"\"\"\n\nimport os\nimport sys\nimport json\nfrom typing import List, Optional\n\nimport uvicorn\nfrom fastapi import FastAPI, UploadFile, File, Header\nfrom fastapi.responses import Response, JSONResponse\nfrom fastapi.middleware.cors import CORSMiddleware\nfrom fastapi.staticfiles import StaticFiles\nfrom pydantic import BaseModel\nfrom google import genai\nfrom google.genai import types\n\n# Ensure workspace root is in python path\nSCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, SCRIPT_DIR)\nfrom utils.clean_items import clean_extracted_items, sanitize_invoice_data\n\n# Initialize Google GenAI Client\nclient = None\nif os.environ.get(\"GEMINI_API_KEY\"):\n    try:\n        client = genai.Client(api_key=os.environ[\"GEMINI_API_KEY\"])\n    except Exception as e:\n        print(f\"[AUDIT IT] Warning: Failed to init client from GEMINI_API_KEY: {e}\")\n\n# Exact Pydantic Schemas requested\nclass InvoiceItem(BaseModel):\n    description: str\n    quantity: float\n    unit_rate: float\n    total_amount: float\n\nclass ExtractedInvoice(BaseModel):\n    is_valid_bill: bool\n    vendor_name: Optional[str] = None\n    gstin: Optional[str] = None\n    invoice_number: Optional[str] = None\n    date: Optional[str] = None\n    items: List[InvoiceItem] = []\n    subtotal: Optional[float] = None\n    cgst: Optional[float] = None\n    sgst: Optional[float] = None\n    igst: Optional[float] = None\n    declared_total: Optional[float] = None\n\napp = FastAPI(title=\"AUDIT IT - Bill Verification API\")\n\n# Enable CORS for local development and cross-origin requests\napp.add_middleware(\n    CORSMiddleware,\n    allow_origins=[\"*\"],\n    allow_credentials=True,\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\ndef get_genai_client(custom_api_key: Optional[str] = None) -> Optional[genai.Client]:\n    \"\"\"Retrieve or instantiate a Google GenAI Client.\"\"\"\n    key = custom_api_key or os.environ.get(\"GEMINI_API_KEY\")\n    if key and key.strip():\n        try:\n            return genai.Client(api_key=key.strip())\n        except Exception as err:\n            print(f\"[AUDIT IT] Error initializing client with key: {err}\")\n    global client\n    if client:\n        return client\n    return None\n\n@app.post(\"/api/analyze-bill\")\nasync def analyze_bill(\n    file: UploadFile = File(...),\n    x_api_key: Optional[str] = Header(None, alias=\"x-api-key\")\n):\n    contents = await file.read()\n    mime_type = file.content_type or \"image/jpeg\"\n    \n    prompt = \"\"\"\n    Extract all billing details from this Indian tax invoice/cash bill.\n    RULES:\n    1. Extract vendor name (company title only, no phone numbers).\n    2. Extract only valid goods/services into the `items` list. DO NOT include addresses, phone numbers, or pincodes as items.\n    3. Read numeric amounts carefully. Do not invent items.\n    \"\"\"\n\n    genai_client = get_genai_client(x_api_key)\n    if not genai_client:\n        return JSONResponse(\n            status_code=400,\n            content={\n                \"error\": \"Gemini API key is required. Please set GEMINI_API_KEY in the environment or enter your key in the dashboard.\"\n            }\n        )\n\n    try:\n        response = genai_client.models.generate_content(\n            model='gemini-2.5-flash',\n            contents=[\n                types.Part.from_bytes(data=contents, mime_type=mime_type),\n                prompt\n            ],\n            config=types.GenerateContentConfig(\n                response_mime_type=\"application/json\",\n                response_schema=ExtractedInvoice,\n                temperature=0.0\n            )\n        )\n        return Response(content=response.text, media_type=\"application/json\")\n    except Exception as err:\n        print(f\"[AUDIT IT] GenAI generate_content error: {err}\")\n        return JSONResponse(\n            status_code=500,\n            content={\"error\": f\"Gemini extraction failed: {str(err)}\"}\n        )\n\n@app.post(\"/api/clean-items\")\nasync def clean_items_endpoint(data: dict):\n    raw_items = data.get(\"items\", [])\n    cleaned = clean_extracted_items(raw_items)\n    return {\"success\": True, \"items\": cleaned, \"count\": len(cleaned)}\n\n@app.post(\"/api/process-invoice\")\n@app.post(\"/api/sanitize-invoice\")\n@app.post(\"/api/extract-invoice\")\nasync def process_invoice_endpoint(data: dict):\n    extracted_data = data.get(\"extracted_data\") or data.get(\"invoice\") or data\n    sanitized_data = sanitize_invoice_data(extracted_data)\n    calculated_subtotal = round(sum(\n        float(it.get(\"quantity\") or it.get(\"qty\") or 1) * \n        float(it.get(\"unit_rate\") or it.get(\"rate\") or 0)\n        for it in sanitized_data.get(\"items\", [])\n    ), 2)\n    sanitized_data[\"calculated_subtotal\"] = calculated_subtotal\n    if not sanitized_data.get(\"subtotal\") or sanitized_data.get(\"subtotal\") == 0:\n        sanitized_data[\"subtotal\"] = calculated_subtotal\n\n    return {\n        \"success\": True,\n        \"extracted_data\": sanitized_data,\n        \"invoice\": sanitized_data\n    }\n\n# Mount static files to serve the frontend web application\napp.mount(\"/\", StaticFiles(directory=SCRIPT_DIR, html=True), name=\"static\")\n\ndef run(port: int = 3000):\n    print(\"\\n\" + \"=\"*56)\n    print(\"  🚀 AUDIT IT - FastAPI + Google GenAI Server\")\n    print(f\"  Serving on: http://localhost:{port}\")\n    print(f\"  Model:      gemini-2.5-flash\")\n    print(f\"  Root Dir:   {SCRIPT_DIR}\")\n    print(\"=\"*56 + \"\\n\")\n    uvicorn.run(app, host=\"0.0.0.0\", port=port, log_level=\"info\")\n\nif __name__ == \"__main__\":\n    port = int(sys.argv[1]) if len(sys.argv) > 1 else 3000\n    run(port)\n","Overwrite":true,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/server.py"}}]}
