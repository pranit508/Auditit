{"step_index":153,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T14:12:20Z","content":"Created At: 2026-11-02T19:42:20+05:30\nCompleted At: 2026-11-02T19:42:20+05:30\nShowing lines 1-60 of 225\n1: // AUDIT IT - Core Audit & Calculation Engine\n2: // RULE: \"AI reads, code calculates. Do NOT trust the AI to do math.\"\n3: \n4: /**\n5:  * Standard Indian GSTIN Regex (15 characters)\n6:  * 2 digits (state) + 5 letters (PAN) + 4 digits + 1 letter + 1 char + Z + 1 check digit\n7:  */\n8: export const GSTIN_REGEX = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;\n9: \n10: /**\n11:  * Round to 2 decimal places to prevent floating point inaccuracies\n12:  */\n13: export function round2(num) {\n14:   return Math.round((Number(num) + Number.EPSILON) * 100) / 100;\n15: }\n16: \n17: /**\n18:  * Formats numbers into Indian Currency format (e.g., ₹1,24,570.00)\n19:  */\n20: export function formatRupees(amount) {\n21:   if (amount === null || amount === undefined || isNaN(amount)) return \"₹0.00\";\n22:   const num = Number(amount);\n23:   const isNegative = num < 0;\n24:   const absNum = Math.abs(num);\n25: \n26:   const parts = absNum.toFixed(2).split(\".\");\n27:   let intPart = parts[0];\n28:   const decPart = parts[1];\n29: \n30:   // Indian currency grouping: last 3 digits, then groups of 2\n31:   if (intPart.length > 3) {\n32:     const lastThree = intPart.substring(intPart.length - 3);\n33:     const otherNumbers = intPart.substring(0, intPart.length - 3);\n34:     intPart = otherNumbers.replace(/\\B(?=(\\d{2})+(?!\\d))/g, \",\") + \",\" + lastThree;\n35:   }\n36: \n37:   return (isNegative ? \"-₹\" : \"₹\") + intPart + \".\" + decPart;\n38: }\n39: \n40: /**\n41:  * Recalculates and audits an entire invoice.\n42:  * Every mathematical sum is strictly computed in code.\n43:  */\n44: export function auditInvoice(invoice) {\n45:   const issues = [];\n46:   const lineItemAudit = [];\n47: \n48:   let sum_items = 0;\n49:   let hasLineItemMathError = false;\n50:   let hasBlurryFields = false;\n51: \n52:   // 1. Line Items Verification\n53:   if (!invoice.items || invoice.items.length === 0) {\n54:     issues.push({\n55:       type: \"ERROR\",\n56:       field: \"items\",\n57:       title: \"No Line Items Detected\",\n58:       description: \"Invoice contains no billable line items or goods.\"\n59:     });\n60:   } else {"}
