"\n43:   }\n44: }\n45: `;\n46: \n47: /**\n48:  * Extracts structured JSON from an uploaded invoice image/PDF.\n49:  * Uses Gemini API if an API key is available, or our smart local heuristic fallback.\n50:  */\n51: export async function extractInvoiceFromDocument(file, apiKey = null) {\n52:   const base64Data = await fileToBase64(file);\n53:   const mimeType = file.type || \"image/jpeg\";\n54:   const objectUrl = URL.createObjectURL(file);\n55: \n56:   // If user provided a Gemini API Key, make the multimodal call\n57:   if (apiKey && apiKey.trim().length > 10) {\n58:     try {\n59:       const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey.trim()}`;\n60: "}
