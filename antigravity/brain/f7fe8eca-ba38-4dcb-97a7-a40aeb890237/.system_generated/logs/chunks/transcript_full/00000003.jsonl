scription: \"Counter Supplies & Thermal Rolls\",\n168:         hsn: \"4811\",\n169:         qty: 20,\n170:         rate: 65.00,\n171:         amount: 1300.00,\n172:         is_blurry: false\n173:       }\n174:     ],\n175:     subtotal: 9300.00, // 5500 + 2500 + 1300\n176:     cgst: 465.00, // 5% GST\n177:     sgst: 465.00,\n178:     igst: 0.00,\n179:     total_declared: 10230.00, // 9300 + 930 = 10,230 (Correct sum would be 8800 + 880 = 9,680. Discrepancy = ₹550)\n180:     bank_details: {\n181:       bank_name: \"HDFC Bank Ltd\",\n182:       account_number: \"50200019283741\",\n183:       ifsc: \"HDFC0000124\",\n184:       branch: \"Main Branch\"\n185:     },\n186:     payment_terms: \"Immediate payment via UPI/NEFT\",\n187:     notes: `Scanned from uploaded document: ${fileName}`\n188:   };\n189: }"}
