 sum_items = round2(sum_items);\n108: \n109:   // 2. Tax Calculations\n110:   const cgst = Number(invoice.cgst) || 0;\n111:   const sgst = Number(invoice.sgst) || 0;\n112:   const igst = Number(invoice.igst) || 0;\n113:   const totalTax = round2(cgst + sgst + igst);\n114: \n115:   // GST Split check: In intra-state, CGST and SGST must match\n116:   if (cgst > 0 || sgst > 0) {\n117:     if (Math.abs(cgst - sgst) > 1.00) {\n118:       issues.push({\n119:         type: \"WARNING\",\n120:         field: \"gst_split\",\n121:         title: \"CGST and SGST Mismatch\",\n122:         description: `Intra-state GST requires CGST (${formatRupees(cgst)}) to equal SGST (${formatRupees(sgst)}).`\n123:       });\n124:     }\n125:     if (igst > 0) {\n126:       issues.push({\n127:         type: \"WARNING\",\n128:         field: \"gst_type\",\n129:         title: \"Conflicting GST Types\",\n130:         description: \"Invoice contains both IGST and CGST/SGST. Typically an invoice is either Intra-state or Inter-state.\"\n131:       });\n132:     }\n133:   }\n134: \n135:   // 3. Strict Grand Total Calculation\n136:   const calculated_total = round2(sum_items + totalTax);\n137:   const total_declared = Number(invoice.total_declared) || 0;\n138:   const totalDiff = round2(total_declared - calculated_total);\n139: \n140:   // 4. Discrepancy comparison rule: If they differ by more than ₹1.00\n141:   const hasTotalDiscrepancy = Math.abs(totalDiff) > 1.00;\n142: \n143:   if (hasTotalDiscrepancy) {\n144:     issues.push({\n145:       type: \"ERROR\",\n146:       field: \"total_declared\",\n147:       title: totalDiff > 0 ? \"Grand Total Overcharge Detected\" : \"Grand Total Undercharge Detected\",\n148:       description: `Bill states ${formatRupees(total_declared)}, but verified total (Items ${formatRupees(sum_items)} + Tax ${formatRupees(totalTax)}) is ${formatRupees(calculated_total)}. Difference: ${formatRupees(Math.abs(totalDiff))}.`,\n149:       diff: totalDiff,\n150:       declared: total_declared,"}
