String());\n                const isErr = item.isMathError;\n                const isBlurry = item.is_blurry;\n\n                return `\n                  <tr class=\"transition-colors ${\n                    isErr \n                      ? 'bg-rose-50/60 hover:bg-rose-100/50' \n                      : isBlurry \n                      ? 'bg-amber-50/60 hover:bg-amber-100/50' \n                      : isSelected \n                      ? 'bg-indigo-50/60 hover:bg-indigo-100/50' \n                      : 'hover:bg-slate-50'\n                  }\" id=\"scorecard-row-${item.id || idx}\">\n                    \n                    <td class=\"py-2 pl-3\">\n                      <input \n                        type=\"text\" \n                        value=\"${item.description || ''}\"\n                        placeholder=\"Item name\"\n                        class=\"w-full px-1.5 py-0.5 rounded border border-transparent hover:border-slate-300 focus:border-emerald-500 text-xs font-semibold text-slate-800 bg-transparent\"\n                        data-action=\"edit-desc\"\n                        data-index=\"${idx}\"\n                      />\n                      ${item.hsn ? `<span class=\"text-[10px] font-mono text-slate-400 block px-1.5\">HSN: ${item.hsn}</span>` : ''}\n                      ${isErr ? `<div class=\"text-[10px] text-rose-700 font-medium px-1.5 mt-0.5\">⚠️ Expected: ${item.qty} × ${formatRupees(item.rate)} = ${formatRupees(item.calculatedAmount)}</div>` : ''}\n                    </td>\n\n                    <!-- Editable Qty -->\n                    <td class=\"py-2 text-right font-mono\">\n                      <input \n                        type=\"number\" \n                        step=\"1\"\n                        min=\"0\"\n                        value=\"${item.qty}\"\n                        class=\"w-14 text-right px-1.5 py-1 rounded border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 font-mono text-xs bg-white text-slate-800\"\n                        data-action=\"edit-qty\"\n                        data-index=\"${idx}\"\n                      />\n                    </td>\n\n                    <!-- Editable Rate -->\n                    <td class=\"py-2 text-right font-mono\">\n                      <input \n                        type=\"number\" \n                        step=\"0.01\"\n                        min=\"0\"\n                        value=\"${item.rate}\"\n                        class=\"w-20 text-right px-1.5 py-1 rounded border ${isBlurry ? 'border-amber-400 bg-amber-50' : 'border-slate-300'} focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 font-mono text-xs text-slate-800\"\n                        data-action=\"edit-rate\"\n                        data-index=\"${idx}\"\n                      />\n                    </td>\n\n                    <!-- Billed Amount -->\n                    <td class=\"py-2 text-right font-mono font-medium ${isErr ? 'text-rose-600 font-bold' : 'text-slate-700'}\">\n                      <input \n                        type=\"number\" \n                        step=\"0.01\"\n                        min=\"0\"\n                        value=\"${item.declaredAmount}\"\n                        class=\"w-20 text-right px-1.5 py-1 rounded border ${isErr ? 'border-rose-300 bg-rose-50/50 text-rose-700 font-bold' : 'border-slate-300 text-slate-800'} font-mono text-xs\"\n                        data-action=\"edit-amount\"\n                        data-index=\"${idx}\"\n                      />\n                    </td>\n\n                    <!-- Verified Calculated Amount -->\n                    <td class=\"py-2 text-right font-mono font-bold ${isErr ? 'text-emerald-700' : 'text-slate-900'}\">\n                      ${formatRupees(item.calculatedAmount)}\n                    </td>\n\n                    <!-- Status Pill -->\n                    <td class=\"py-2 text-center\">\n                      ${isErr ? `\n                        <span class=\"inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-100 text-rose-700 border border-rose-200\">\n                          -₹${Math.abs(item.diff).toFixed(0)}\n                        </span>\n                      ` : isBlurry ? `\n                        <span class=\"inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-700 border border-amber-200\">\n                          Unclear\n                        </span>\n                      ` : `\n                        <span class=\"inline-block px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200\">\n                          Match\n                        </span>\n                      `}\n                    </td>\n\n                    <!-- Delete Row Button -->\n                    <td class=\"py-2 pr-2 text-center\">\n                      <button \n                        data-action=\"delete-item\" \n                        data-index=\"${idx}\"\n                        class=\"text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-slate-100 transition-colors\"\n                        title=\"Delete this line item\"\n                      >\n                        ✕\n                      </button>\n                    </td>\n\n                  </tr>\n                `;\n              }).join(\"\")}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- TAX BREAKDOWN & GST PRESETS -->\n      <div class=\"bg-white rounded-xl border border-slate-200 p-3.5 shadow-sm space-y-3\">\n        <div class=\"flex items-center justify-between\">\n          <span class=\"text-[11px] font-bold text-slate-700 uppercase tracking-wider\">GST Tax Rate & Split (Real-Time Recalculation)</span>\n          <span class=\"text-xs font-mono font-bold text-emerald-700\">Total Tax: ${formatRupees(audit.totalTax)}</span>\n        </div>\n\n        <!-- Quick GST Rate Presets -->\n        <div class=\"flex flex-wrap items-center gap-1.5 text-xs\">\n          <span class=\"text-[10px] text-slate-500 font-medium\">Quick GST Rates:</span>\n          <button data-gst-preset=\"0\" class=\"px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px]\">0% (Exempt)</button>\n          <button data-gst-preset=\"5\" class=\"px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px]\">5% (Grocery/Atta)</button>\n          <button data-gst-preset=\"12\" class=\"px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px]\">12% (Standard)</button>\n          <button data-gst-preset=\"18\" class=\"px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px]\">18% (Electrical)</button>\n          <button data-gst-preset=\"28\" class=\"px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px]\">28% (Luxury)</button>\n        </div>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs pt-1\">\n          <div>\n            <label class=\"block text-[10px] font-semibold text-slate-500 mb-1\">CGST (Intra-State) ₹</label>\n            <input \n              type=\"number\" \n              step=\"0.01\" \n              id=\"input-cgst\" \n              value=\"${invoice.cgst || 0}\"\n              class=\"w-full px-2 py-1.5 rounded-lg border border-slate-300 font-mono text-xs text-right text-slate-800\"\n            />\n          </div>\n          <div>\n            <label class=\"block text-[10px] font-semibold text-slate-500 mb-1\">SGST (Intra-State) ₹</label>\n            <input \n              type=\"number\" \n              step=\"0.01\" \n              id=\"input-sgst\" \n              value=\"${invoice.sgst || 0}\"\n              class=\"w-full px-2 py-1.5 rounded-lg border border-slate-300 font-mono text-xs text-right text-slate-800\"\n            />\n          </div>\n          <div>\n            <label class=\"block text-[10px] font-semibold text-slate-500 mb-1\">IGST (Inter-State) ₹</label>\n            <input \n              type=\"number\" \n              step=\"0.01\" \n              id=\"input-igst\" \n              value=\"${invoice.igst || 0}\"\n              class=\"w-full px-2 py-1.5 rounded-lg border border-slate-300 font-mono text-xs text-right text-slate-800\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <!-- ========================================== -->\n      <!-- UI DASHBOARD ADDITION: TAX & ITR INSIGHTS -->\n      <!-- ========================================== -->\n      <div class=\"bg-gradient-to-br from-slate-900 via-slate-850 to-slate-900 rounded-2xl border border-slate-800 p-4 sm:p-5 shadow-md text-white space-y-4\">\n        \n        <!-- Header -->\n        <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-800/80 pb-3\">\n          <div class=\"flex items-center space-x-2.5\">\n            <div class=\"w-8 h-8 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold text-sm\">\n              ₹\n            </div>\n            <div>\n              <h4 class=\"text-xs sm:text-sm font-extrabold tracking-tight text-white flex items-center space-x-2\">\n                <span>Tax & ITR Insights</span>\n                <span class=\"text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n                  Sec 44AD Presumptive\n                </span>\n              </h4>\n              <p class=\"text-[10px] text-slate-400\">Deterministic Tax Calculation & Gemini 2.5 Flash Advisory</p>\n            </div>\n          </div>\n\n          <div class=\"flex items-center space-x-2\">\n            <button \n              id=\"btn-refresh-tax-ai\" \n              class=\"px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-semibold border border-slate-700 transition-all flex items-center space-x-1\"\n              title=\"Refresh suggestions using Gemini 2.5 Flash\"\n            >\n              <span>✨ Gemini 2.5 Flash</span>\n            </button>\n          </div>\n        </div>\n\n        <!-- 3 REQUIRED PILLS -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-2.5\">\n          \n          <!-- Pill 1: Recommended Form -->\n          <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n            <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 1 • Recommended Form</span>\n            <div class=\"mt-1 font-bold text-xs text-emerald-300\">\n              ${calculated_tax.recommended_form}\n            </div>\n            <span class=\"text-[9px] text-slate-400 mt-1 block\">Presumptive Scheme under Sec 44AD</span>\n          </div>\n\n          <!-- Pill 2: Deemed Net Profit -->\n          <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n            <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 2 • Deemed Net Profit</span>\n            <div class=\"mt-1 font-extrabold text-sm font-mono text-white\">\n              ${formatRupees(calculated_tax.deemed_net_profit)}\n            </div>\n            <span class=\"text-[9px] text-slate-400 mt-1 block\">${calculated_tax.profit_computation_basis}</span>\n          </div>\n\n          <!-- Pill 3: Estimated Tax Liability -->\n          <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n            <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 3 • Estimated Tax Liability</span>\n            <div class=\"mt-1 font-extrabold text-sm font-mono text-emerald-400\">\n              ${formatRupees(calculated_tax.estimated_tax_liability)}\n            </div>\n            <span class=\"text-[9px] text-slate-400 mt-1 block\">Computed via New Regime (Sec 115BAC)</span>\n          </div>\n\n        </div>\n\n        <!-- REAL-TIME SHOP TURNOVER & CASH RATIO SLIDER -->\n        <div class=\"bg-slate-800/40 rounded-xl p-3 border border-slate-700/50 space-y-2 text-xs\">\n          <div class=\"flex items-center justify-between text-[11px] text-slate-300\">\n            <span class=\"font-bold\">Adjust Digital Receipts Ratio (Sec 44AD Profit: 6% Digital vs 8% Cash):</span>\n            <span class=\"font-mono font-bold text-emerald-300\" id=\"label-digital-ratio\">${calculated_tax.digital_percent}% Digital (${calculated_tax.cash_percent}% Cash)</span>\n          </div>\n          <input \n            type=\"range\" \n            min=\"0\" \n            max=\"100\" \n            step=\"5\"\n            value=\"${calculated_tax.digital_percent}\"\n            id=\"slider-digital-ratio\"\n            class=\"w-full accent-emerald-500 cursor-pointer\"\n          />\n        </div>\n\n        <!-- ADVISORY CALLOUT BOX -->\n        <div class=\"bg-emerald-950/40 rounded-xl p-3.5 border border-emerald-500/30 text-emerald-100 flex items-start space-x-3\">\n          <div class=\"w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5\">\n            🛡️\n          </div>\n          <div class=\"text-xs leading-relaxed\">\n            <strong class=\"text-emerald-300 block mb-0.5\">Advisory Callout: How Keeping Supplier GSTINs Verified Saves Cash</strong>\n            <p class=\"text-[11px] text-slate-300\">\n              Every single rupee of GST shown on your purchase invoices can directly offset your GST tax liability via <strong>Input Tax Credit (ITC)</strong>. \n              However, Indian tax laws (Section 16 of the CGST Act) mandate that ITC is strictly disallowed if your supplier does not have an active, verified GSTIN. \n              Always verify supplier GSTINs on AUDIT IT before making payments to protect your ITC and avoid paying tax twice!\n            </p>\n          </div>\n        </div>\n\n        <!-- 3 CONCISE BULLET POINTS FROM GEMINI 2.5 FLASH -->\n        <div class=\"bg-slate-800/50 rounded-xl p-3.5 border border-slate-800 space-y-2\">\n          <div class=\"flex items-center justify-between text-[11px] font-bold text-slate-300\">\n            <span>Gemini 2.5 Flash Tax Preparation Summary:</span>\n            ${ai_suggestions.isAiGenerated \n              ? `<span class=\"text-[10px] text-emerald-400 font-mono\">● Live Gemini 2.5 Flash</span>` \n              : `<span class=\"text-[10px] text-slate-400 font-mono\">Standard Rule Engine</span>`\n            }\n          </div>\n\n          <ul class=\"space-y-2 text-xs text-slate-200\">\n            ${ai_suggestions.suggestions.map((bullet, idx) => `\n              <li class=\"flex items-start space-x-2\">\n                <span class=\"w-4 h-4 rounded-full bg-slate-700 text-slate-300 flex items-center justify-center shrink-0 text-[10px] font-bold mt-0.5\">\n                  ${idx + 1}\n                </span>\n                <span class=\"text-[11px] leading-relaxed text-slate-300\">${bullet}</span>\n              </li>\n            `).join(\"\")}\n          </ul>\n\n          <!-- Mandatory Disclaimer -->\n          <div class=\"pt-2 border-t border-slate-800/80 text-[10px] text-slate-400 italic\">\n            ⚖️ ${ai_suggestions.disclaimer}\n          </div>\n        </div>\n\n      </div>\n\n      <!-- ACTION BUTTONS -->\n      <div class=\"flex flex-col sm:flex-row items-center gap-2.5 pt-2\">\n        <button id=\"btn-copy-discrepancy\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all active:scale-95\">\n          <span>📋 Copy Dispute Note</span>\n        </button>\n\n        <button id=\"btn-share-whatsapp\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n          <span>📲 Share on WhatsApp</span>\n        </button>\n\n        <button id=\"btn-open-ca-slip\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n          <span>📑 CA Audit Slip</span>\n        </button>\n\n        <button id=\"btn-back-dashboard\" class=\"w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition-all\">\n          <span>← Back</span>\n        </button>\n      </div>\n\n    </div>\n  `;\n\n  // Attach event handlers\n  const btnQuickCopy = container.querySelector(\"#btn-quick-copy\");\n  if (btnQuickCopy && onCopyNote) {\n    btnQuickCopy.addEventListener(\"click\", onCopyNote);\n  }\n\n  const btnCopy = container.querySelector(\"#btn-copy-discrepancy\");\n  if (btnCopy && onCopyNote) {\n    btnCopy.addEventListener(\"click\", onCopyNote);\n  }\n\n  const btnShareWa = container.querySelector(\"#btn-share-whatsapp\");\n  const btnQuickWa = container.querySelector(\"#btn-quick-wa\");\n  const handleWa = () => {\n    const text = container.querySelector(\"#btn-copy-discrepancy\") ? onCopyNote(true) : \"\";\n  };\n  if (btnShareWa && onCopyNote) {\n    btnShareWa.addEventListener(\"click\", () => onCopyNote(true));\n  }\n  if (btnQuickWa && onCopyNote) {\n    btnQuickWa.addEventListener(\"click\", () => onCopyNote(true));\n  }\n\n  const btnCaSlip = container.querySelector(\"#btn-open-ca-slip\");\n  if (btnCaSlip && onOpenCaSlip) {\n    btnCaSlip.addEventListener(\"click\", onOpenCaSlip);\n  }\n\n  const btnBack = container.querySelector(\"#btn-back-dashboard\");\n  if (btnBack && onBack) {\n    btnBack.addEventListener(\"click\", onBack);\n  }\n\n  const btnRefreshTax = container.querySelector(\"#btn-refresh-tax-ai\");\n  if (btnRefreshTax && onRefreshTaxAi) {\n    btnRefreshTax.addEventListener(\"click\", onRefreshTaxAi);\n  }\n\n  const btnAddItem = container.querySelector(\"#btn-add-item\");\n  if (btnAddItem && onAddItem) {\n    btnAddItem.addEventListener(\"click\", onAddItem);\n  }\n\n  const btnAutoFix = container.querySelector(\"#btn-autofix-math\");\n  if (btnAutoFix && onAutoFixMath) {\n    btnAutoFix.addEventListener(\"click\", onAutoFixMath);\n  }\n\n  // Header real-time updates\n  const inputVendor = container.querySelector(\"#input-vendor-name\");\n  const inputGstin = container.querySelector(\"#input-gstin\");\n  const inputTotalDeclared = container.querySelector(\"#input-total-declared\");\n\n  if (inputVendor && onUpdateHeader) {\n    inputVendor.addEventListener(\"input\", (e) => onUpdateHeader(\"vendor_name\", e.target.value));\n  }\n  if (inputGstin && onUpdateHeader) {\n    inputGstin.addEventListener(\"input\", (e) => onUpdateHeader(\"gstin\", e.target.value.trim().toUpperCase()));\n  }\n  if (inputTotalDeclared && onUpdateHeader) {\n    inputTotalDeclared.addEventListener(\"input\", (e) => onUpdateHeader(\"total_declared\", parseFloat(e.target.value) || 0));\n  }\n\n  // Tax inputs (CGST, SGST, IGST)\n  const inputCgst = container.querySelector(\"#input-cgst\");\n  const inputSgst = container.querySelector(\"#input-sgst\");\n  const inputIgst = container.querySelector(\"#input-igst\");\n\n  if (inputCgst && onUpdateHeader) {\n    inputCgst.addEventListener(\"input\", (e) => onUpdateHeader(\"cgst\", parseFloat(e.target.value) || 0));\n  }\n  if (inputSgst && onUpdateHeader) {\n    inputSgst.addEventListener(\"input\", (e) => onUpdateHeader(\"sgst\", parseFloat(e.target.value) || 0));\n  }\n  if (inputIgst && onUpdateHeader) {\n    inputIgst.addEventListener(\"input\", (e) => onUpdateHeader(\"igst\", parseFloat(e.target.value) || 0));\n  }\n\n  // GST Presets\n  container.querySelectorAll(\"[data-gst-preset]\").forEach(btn => {\n    btn.addEventListener(\"click\", () => {\n      const ratePct = parseFloat(btn.getAttribute(\"data-gst-preset\")) / 100;\n      const subtotal = audit.sum_items;\n      const taxAmount = round2(subtotal * ratePct);\n      // Half CGST, Half SGST\n      const halfTax = round2(taxAmount / 2);\n      if (onUpdateHeader) {\n        onUpdateHeader(\"gst_preset\", { cgst: halfTax, sgst: halfTax, igst: 0 });\n      }\n    });\n  });\n\n  // Digital ratio slider\n  const sliderDigital = container.querySelector(\"#slider-digital-ratio\");\n  if (sliderDigital && onUpdateTaxSettings) {\n    sliderDigital.addEventListener(\"input\", (e) => {\n      const val = parseFloat(e.target.value) / 100;\n      onUpdateTaxSettings({ digitalRatio: val });\n    });\n  }\n\n  // Handle line item edits & delete\n  container.querySelectorAll(\"input[data-action]\").forEach(input => {\n    input.addEventListener(\"input\", (e) => {\n      const idx = parseInt(e.target.getAttribute(\"data-index\"), 10);\n      const action = e.target.getAttribute(\"data-action\");\n      const val = action === \"edit-desc\" ? e.target.value : (parseFloat(e.target.value) || 0);\n\n      if (onUpdateItem) {\n        onUpdateItem(idx, action, val);\n      }\n    });\n  });\n\n  container.querySelectorAll(\"button[data-action='delete-item']\").forEach(btn => {\n    btn.addEventListener(\"click\", (e) => {\n      const idx = parseInt(btn.getAttribute(\"data-index\"), 10);\n      if (onDeleteItem) {\n        onDeleteItem(idx);\n      }\n    });\n  });\n}\n","Overwrite":true,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/components/AuditScorecard.js"}}]}
