{"step_index":1093,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:42:18Z","content":"Created At: 2026-11-03T00:12:18+05:30\nCompleted At: 2026-11-03T00:12:19+05:30\nShowing lines 10-60 of 218\n10: const PHONE_PATTERN = /(\\+?91[\\-\\s]?)?[6-9]\\d{9}/;\n11: \n12: // Common metadata and address keywords that should never be product names\n13: const FORBIDDEN_KEYWORDS = [\n14:   \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n15:   \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", \n16:   \"hundred\", \"only\", \"rupees\", \"bank\", \"ifsc\", \"a/c\", \"ac no\", \"phone\",\n17:   \"gst no\", \"contact\", \"mobile\", \"tel\", \"pan no\", \"invoice no\",\n18:   \"tax invoice\", \"bill to\", \"ship to\", \"address\", \"state code\",\n19:   \"reverse charge\", \"e-way bill\", \"transport\", \"vehicle no\",\n20:   \"cash memo\", \"challan\", \"original for recipient\", \"date\"\n21: ];\n22: \n23: // Pattern matching Indian PAN (5 letters, 4 digits, 1 letter)\n24: const PAN_PATTERN = /\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b/i;\n25: \n26: /**\n27:  * Purges metadata, phone numbers, and GSTIN strings from extracted items array\n28:  * @param {Array} items - Raw items array extracted by AI or OCR\n29:  * @returns {Array} Cleaned items strictly containing genuine products/services\n30:  */\n31: export function cleanExtractedItems(items) {\n32:   if (!Array.isArray(items)) return [];\n33:   const cleaned = [];\n34: \n35:   for (const item of items) {\n36:     if (!item || typeof item !== \"object\") continue;\n37: \n38:     const desc = (item.description || item.item_name || \"\").trim();\n39:     const descLower = desc.toLowerCase();\n40: \n41:     // 1. Skip if the description is too short or contains GSTIN, PAN, or phone numbers\n42:     if (desc.length < 3 || GSTIN_PATTERN.test(desc) || PHONE_PATTERN.test(desc) || PAN_PATTERN.test(desc)) {\n43:       console.warn(\"[AUDIT IT] Purged metadata/address item (Pattern or short length):\", desc);\n44:       continue;\n45:     }\n46: \n47:     // Skip single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n48:     if (/^[A-Za-z0-9]{7,16}$/.test(desc) && /\\d/.test(desc) && /[A-Za-z]/.test(desc)) {\n49:       console.warn(\"[AUDIT IT] Purged single-token alphanumeric tax ID:\", desc);\n50:       continue;\n51:     }\n52: \n53:     // 2. Skip if the description matches address/metadata keywords\n54:     if (FORBIDDEN_KEYWORDS.some(keyword => descLower.includes(keyword))) {\n55:       console.warn(\"[AUDIT IT] Purged metadata item (Forbidden keyword detected):\", desc);\n56:       continue;\n57:     }\n58: \n59:     // 3. Skip invalid items with zero/negative rates or quantities\n60:     let qty = Number(item.quantity !== undefined ? item.quantity : item.qty);"}
