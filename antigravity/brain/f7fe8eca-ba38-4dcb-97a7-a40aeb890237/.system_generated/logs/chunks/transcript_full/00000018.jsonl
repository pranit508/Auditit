PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, \"\").trim();\n167:     if (descClean.length >= 3) {\n168:       desc = descClean;\n169:       it.description = desc;\n170:     }\n171: \n172:     // Quantity and Rate sanity with parseInr\n173:     const rawQty = it.quantity !== undefined ? it.quantity : it.qty;\n174:     let qty = rawQty !== undefined && rawQty !== null && String(rawQty).trim() !== \"\" ? parseInr(rawQty) : 1.0;\n175:     if (qty <= 0) qty = 1.0;\n176: \n177:     const rawRate = it.unit_rate !== undefined ? it.unit_rate : it.rate;\n178:     let rate = parseInr(rawRate);\n179: \n180:     const rawBilled = it.total_amount !== undefined ? it.total_amount : it.amount;\n181:     let billed = rawBilled !== undefined && rawBilled !== null && String(rawBilled).trim() !== \"\" ? parseInr(rawBilled) : (qty * rate);\n182: \n183:     // Column swap fallback\n184:     if (billed > 0 && qty === billed && (rate === 1 || rate === 2)) {\n185:       qty = 1.0;\n186:       rate = billed;\n187:     }\n188: \n189:     it.quantity = qty;\n190:     it.qty = qty;\n191:     it.unit_rate = rate;\n192:     it.rate = rate;\n193:     it.total_amount = billed;\n194:     it.amount = billed;\n195:     cleanItems.push(it);\n196:   }\n197: \n198:   res.items = cleanItems;\n199: \n200:   // 3. Ensure numeric fields strip commas cleanly via parseInr\n201:   [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"].forEach(key => {\n202:     if (res[key] !== undefined && res[key] !== null && String(res[key]).trim() !== \"\" && String(res[key]).toLowerCase() !== \"null\") {\n203:       res[key] = parseInr(res[key]);\n204:     }\n205:   });\n206: \n207:   if (res.declared_total !== undefined && res.total_declared === undefined) {\n208:     res.total_declared = res.declared_total;\n209:   } else if (res.total_declared !== undefined && res.declared_total === undefined) {\n210:     res.declared_total = res.total_declared;\n211:   }\n212: \n213:   if (res.invoice_number && !res.invoice_no) {\n214:     res.invoice_no = res.invoice_number;\n215:   }\n216: \n217:   return res;\n218: }"}
