ame Unclear\"\n183:         data[\"supplier_name\"] = data[\"vendor_name\"]\n184: \n185:     # 2. Filter garbage line items\n186:     clean_items = []\n187:     for item in data.get(\"items\", []):\n188:         if not isinstance(item, dict):\n189:             continue\n190: \n191:         desc = (item.get(\"description\") or \"\").strip()\n192:         \n193:         # Remove stray leading/trailing brackets and vertical pipes from OCR\n194:         desc = re.sub(r'^[\\[\\|\\]\\(\\)\\s]+|[\\[\\|\\]\\(\\)\\s]+$', '', desc).strip()\n195:         item[\"description\"] = desc\n196: \n197:         # Skip if description lacks at least 4 letters\n198:         if len(re.findall(r'[a-zA-Z]', desc)) < 4:\n199:             continue\n200: \n201:         # Skip if more than 20% of description is weird symbols/punctuation\n202:         symbols = re.findall(r'[~|©\\[\\]=_{}@#$%^&*]', desc)\n203:         if len(desc) > 0 and (len(symbols) / len(desc)) > 0.20:\n204:             continue\n205: \n206:         # Skip common footer/stamp terms\n207:         if any(term in desc.lower() for term in [\"signature\", \"authorised\", \"terms\", \"condition\", \"bank details\", \"e-way bill\"]):\n208:             continue\n209: \n210:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', etc.\n211:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n212:         if desc_clean and len(desc_clean) >= 3:\n213:             desc = desc_clean\n214:             item[\"description\"] = desc\n215: \n216:         # Quantity and Rate sanity with parse_inr\n217:         raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\")\n218:         qty = parse_inr(raw_qty) if raw_qty is not None and str(raw_qty).strip() != \"\" else 1.0\n219:         if qty <= 0:\n220:             qty = 1.0\n221: \n222:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\")\n223:         rate = parse_inr(raw_rate)\n224: \n225:         raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\")\n226:         billed = parse_inr(raw_billed) if raw_billed is not None and str(raw_billed).strip() != \"\" else round(qty * rate, 2)\n227: \n228:         # Post-Processing Column Swap Fallback:\n229:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n230:         # it means qty and rate were misaligned. Swap them:\n231:         if billed > 0 and qty == billed and rate in [1.0, 2.0, 1, 2]:\n232:             qty = 1.0\n233:             rate = billed\n234: \n235:         item[\"quantity\"] = qty\n236:         item[\"qty\"] = qty\n237:         item[\"unit_rate\"] = rate\n238:         item[\"rate\"] = rate\n239:         item[\"total_amount\"] = billed\n240:         item[\"amount\"] = billed\n241:         clean_items.append(item)\n242: \n243:     data[\"items\"] = clean_items\n244: \n245:     # 3. Ensure numeric fields strip commas cleanly via parse_inr\n246:     for key in [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"]:\n247:         val = data.get(key)\n248:         if val is not None and str(val).strip() != \"\" and str(val).lower() != \"null\":\n249:             data[key] = parse_inr(val)\n250: \n251:     # 4. Check for printed Grand Total in Words to correct OCR misreads (e.g. 2173.9 -> 4490.0)\n252:     raw_ocr = str(data.get(\"raw_ocr_text\") or data.get(\"raw_text\") or data.get(\"notes\") or \"\")\n253:     if raw_ocr:\n254:         for line in raw_ocr.splitlines():\n255:             if re.search(r'(?:total|amount|rupees)\\s+(?:in\\s+words|in\\s+word)', line, re.IGNORECASE) or re.search(r'rupees\\s+[a-zA-Z\\s]+only', line, re.IGNORECASE):\n256:                 word_total = parse_words_to_number(line)\n257:                 if word_total > 0:\n258:                     current_declared = data.get(\"declared_total\") or 0.0\n259:                     if current_declared == 0.0 or abs(current_declared - word_total) > 10:\n260:                         data[\"declared_total\"] = word_total\n261:                     break\n262: \n263:     # Ensure schema aliases for frontend compatibility\n264:     if data.get(\"declared_total\") is not None:\n265:         data[\"total_declared\"] = data[\"declared_total\"]\n266:     elif data.get(\"total_declared\") is not None:\n267:         data[\"declared_total\"] = data[\"total_declared\"]\n268: \n269:     if data.get(\"invoice_number\") and not data.get(\"invoice_no\"):\n270:         data[\"invoice_no\"] = data[\"invoice_number\"]\n271: \n272:     return data\n273: \n274: def sanitize_invoice_data(data: dict) -> dict:\n275:     \"\"\"\n276:     Sanitizes extracted invoice data immediately before sending it to the frontend.\n277:     Enforces MANDATORY RULES:\n278:     1. Clean Supplier Name (Remove phone/email artifacts)\n279:     2. Filter out non-items from the items list (address words, short desc, non-positive qty/rate, corrupt totals)\n280:     \"\"\""}
