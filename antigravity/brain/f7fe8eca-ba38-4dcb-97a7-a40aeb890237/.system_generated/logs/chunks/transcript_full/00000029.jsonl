{"step_index":1653,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T19:55:09Z","input_tokens":2566,"cache_read_tokens":172433,"output_tokens":847,"tool_calls":[{"name":"edit_file","args":{"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/components/AuditScorecard.js","Replacement":"  // GST Presets: Click Handler Sync with Intra-State vs Inter-State Auto-Determination\n  container.querySelectorAll(\"[data-gst-preset]\").forEach(btn => {\n    btn.addEventListener(\"click\", () => {\n      const ratePct = parseFloat(btn.getAttribute(\"data-gst-preset\")) / 100;\n      // Recalculate dynamically based on current Subtotal (e.g. 11,000)\n      const subtotal = round2(Number(invoice.subtotal) || audit.sum_items || 0);\n      const taxAmount = round2(subtotal * ratePct);\n\n      // Compare first 2 digits of Supplier GSTIN (06) and Buyer GSTIN (06)\n      const supplierGstin = (invoice.gstin || \"\").trim().toUpperCase();\n      const buyerGstin = (invoice.buyer_gstin || \"06CORPP2712A1Z1\").trim().toUpperCase();\n      const supplierState = supplierGstin ? supplierGstin.slice(0, 2) : \"06\";\n      const buyerState = buyerGstin ? buyerGstin.slice(0, 2) : \"06\";\n      const isIntraState = supplierState === buyerState;\n\n      let newCgst = 0;\n      let newSgst = 0;\n      let newIgst = 0;\n\n      if (isIntraState) {\n        // Intra-State: Set IGST strictly to 0, default split to CGST + SGST (e.g. 9% + 9% = 18%, ₹990 + ₹990 on ₹11,000)\n        newIgst = 0;\n        newCgst = round2(taxAmount / 2);\n        newSgst = round2(taxAmount / 2);\n      } else {\n        // Inter-State: Set CGST = 0, SGST = 0, and IGST = 18% (₹1,980.00 on ₹11,000)\n        newCgst = 0;\n        newSgst = 0;\n        newIgst = taxAmount;\n      }\n\n      // Update inputs immediately for instant sync\n      if (inputCgst) inputCgst.value = newCgst;\n      if (inputSgst) inputSgst.value = newSgst;\n      if (inputIgst) inputIgst.value = newIgst;\n\n      // Trigger re-audit immediately\n      if (onUpdateHeader) {\n        onUpdateHeader(\"gst_preset\", { cgst: newCgst, sgst: newSgst, igst: newIgst });\n      }\n    });\n  });","Target":"  // GST Presets\n  container.querySelectorAll(\"[data-gst-preset]\").forEach(btn => {\n    btn.addEventListener(\"click\", () => {\n      const ratePct = parseFloat(btn.getAttribute(\"data-gst-preset\")) / 100;\n      const subtotal = audit.sum_items;\n      const taxAmount = round2(subtotal * ratePct);\n      // Half CGST, Half SGST\n      const halfTax = round2(taxAmount / 2);\n      if (onUpdateHeader) {\n        onUpdateHeader(\"gst_preset\", { cgst: halfTax, sgst: halfTax, igst: 0 });\n      }\n    });\n  });"}}]}
