ata[\"sgst\"] = sgst\n        elif sgst > 0 and cgst == 0:\n            cgst = sgst\n            data[\"cgst\"] = cgst\n    else:\n        # Inter-state: CGST = 0, SGST = 0, IGST applies\n        cgst = 0.0\n        sgst = 0.0\n        data[\"cgst\"] = 0.0\n        data[\"sgst\"] = 0.0\n        if igst == 0 and calculated_subtotal > 0:\n            igst = round(calculated_subtotal * 0.18, 2)\n            data[\"igst\"] = igst\n\n    total_tax = round(cgst + sgst + igst, 2)\n    expected_total = round(calculated_subtotal + total_tax, 2)","Target":"    # 5. GRAND TOTAL SANITY CHECK:\n    # Grand Total must be approximately (Subtotal + Total Tax).\n    # If the OCR extracted '774' or '585132', reject them because they are bank/account/IFSC digits.\n    cgst = float(data.get(\"cgst\") or 0.0)\n    sgst = float(data.get(\"sgst\") or 0.0)\n    igst = float(data.get(\"igst\") or 0.0)\n    total_tax = round(cgst + sgst + igst, 2)\n    expected_total = round(calculated_subtotal + total_tax, 2)"}}]}
