47+05:30\nShowing lines 340-450 of 573\n340:     Enforces MANDATORY RULES:\n341:     1. Clean Supplier Name (Remove phone/email artifacts)\n342:     2. Filter out non-items from the items list (address words, short desc, non-positive qty/rate, corrupt totals)\n343:     \"\"\"\n344:     if not isinstance(data, dict):\n345:         return data\n346: \n347:     # 1. Clean Supplier Name (Remove phone/email artifacts)\n348:     supplier = data.get(\"vendor_name\", \"\") or data.get(\"supplier_name\", \"\") or \"\"\n349:     supplier_cleaned = re.sub(r'(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+', '', supplier, flags=re.IGNORECASE).strip()\n350:     # Strip any trailing punctuation (commas, hyphens, colons) left behind\n351:     supplier_cleaned = re.sub(r'[\\s,\\-–—:|]+$', '', supplier_cleaned).strip()\n352:     data[\"vendor_name\"] = supplier_cleaned if supplier_cleaned else \"Supplier Name Unclear\"\n353:     data[\"supplier_name\"] = data[\"vendor_name\"]\n354: \n355:     # 2. Filter out non-items from the items list\n356:     filtered_items = []\n357:     \n358:     # Common address/metadata keywords that accidentally end up as descriptions\n359:     address_words = [\n360:         \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n361:         \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", \n362:         \"hundred\", \"only\", \"rupees\", \"bank\", \"ifsc\", \"a/c\", \"ac no\", \"phone\"\n363:     ]\n364: \n365:     gstin_pattern = re.compile(r'\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b', re.IGNORECASE)\n366:     phone_pattern = re.compile(r'(\\+?91[\\-\\s]?)?[6-9]\\d{9}')\n367:     pan_pattern = re.compile(r'\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b', re.IGNORECASE)\n368: \n369:     for item in data.get(\"items\", []):\n370:         if not isinstance(item, dict):\n371:             continue\n372: \n373:         desc = (item.get(\"description\") or \"\").strip()\n374:         desc_lower = desc.lower()\n375: \n376:         # Reject if description matches address/words or is too short\n377:         if any(word in desc_lower for word in address_words) or len(desc) < 3:\n378:             continue\n379: \n380:         # Reject GSTIN strings, PAN strings, or phone numbers\n381:         if gstin_pattern.search(desc) or phone_pattern.search(desc) or pan_pattern.search(desc):\n382:             continue\n383: \n384:         # Reject single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n385:         if re.match(r'^[A-Za-z0-9]{7,16}$', desc) and any(c.isdigit() for c in desc) and any(c.isalpha() for c in desc):\n386:             continue\n387: \n388:         # Reject if total amount matches common pin codes (e.g. 131001) or is clearly corrupt\n389:         raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\", 0)\n390:         raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n391:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n392: \n393:         try:\n394:             billed = float(raw_billed or 0)\n395:             qty = float(raw_qty or 0)\n396:             rate = float(raw_rate or 0)\n397:         except (ValueError, TypeError):\n398:             continue\n399: \n400:         # Quantity and rate must be positive\n401:         if qty <= 0 or rate <= 0:\n402:             continue\n403: \n404:         # If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n405:         if billed > (qty * rate * 10) and billed > 100000:\n406:             continue\n407: \n408:         # Post-Processing Column Swap Fallback:\n409:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n410:         # it means qty and rate were misaligned. Swap them:\n411:         if billed > 0 and qty == billed and rate in [1, 2, 1.0, 2.0]:\n412:             qty = 1.0\n413:             rate = billed\n414: \n415:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n416:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n417:         if desc_clean and len(desc_clean) >= 3:\n418:             desc = desc_clean\n419: \n420:         # Normalize fields for seamless compatibility\n421:         normalized = dict(item)\n422:         normalized[\"quantity\"] = qty\n423:         normalized[\"qty\"] = qty\n424:         normalized[\"unit_rate\"] = rate\n425:         normalized[\"rate\"] = rate\n426:         normalized[\"total_amount\"] = billed if billed > 0 else round(qty * rate, 2)\n427:         normalized[\"amount\"] = normalized[\"total_amount\"]\n428:         normalized[\"description\"] = desc\n429: \n430:         filtered_items.append(normalized)\n431: \n432:     data[\"items\"] = filtered_items\n433:     return data\n434: \n435: if __name__ == \"__main__\":\n436:     # Test cases for clean_extracted_items\n437:     test_items = [\n438:         {\"description\": \"Basmati Rice 25kg\", \"qty\": 10, \"rate\": 950.0, \"amount\": 9500.0},\n439:         {\"description\": \"GSTIN: 07AAAAA0000A1Z5\", \"qty\": 1, \"rate\": 100.0, \"amount\": 100.0},\n440:         {\"description\": \"Call: +91 9876543210\", \"qty\": 1, \"rate\": 50.0, \"amount\": 50.0},\n441:         {\"description\": \"Bank IFSC SBIN0001234\", \"qty\": 1, \"rate\": 20.0, \"amount\": 20.0},\n442:         {\"description\": \"Wheat Flour Atta 50kg\", \"qty\": 5, \"rate\": 420.0, \"amount\": 2100.0},\n443:         {\"description\": \"Zero Qty Product\", \"qty\": 0, \"rate\": 50.0, \"amount\": 0.0},\n444:         # Column swap test\n445:         {\"description\": \"Heavy Duty Tool Kit NOS\", \"qty\": 535, \"rate\": 2, \"amount\": 535.0}\n446:     ]\n447:     res = clean_extracted_items(test_items)\n448:     print(\"Cleaned Items Count:\", len(res))\n449:     assert len(res) == 3, f\"Expected 3 items, got {len(res)}\"\n450:     tool_kit = [it for it in res if \"Tool Kit\" in it[\"description\"]][0]"}
{"step_index":1466,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T19:31:47Z","input_tokens":2395,"cache_read_tokens":227734,"output_tokens":5715,"thinking":"Invoice parsing requires slicing the table data based on anchor boundaries. Initial approach will focus on identifying the table structure within the text. The `invoiceTextParser.js` module seems the appropriate location for this. Further investigation needed to determine the specific slicing logic required.\n\n\nInitial approach involves segmenting the invoice text into three zones: header, line items (table), and summary/tax details. The header zone ends at the table header row, which is identified by keywords such as \"description,\" \"item,\" or \"quantity.\" The line item zone is strictly bounded by table header and footer rows and should contain item details. The summary zone starts after the table footer and includes subtotal, tax, and grand total information.\n\n\nDefined table header keywords and a footer regex to identify table boundaries within the invoice text. Implemented logic to iterate through lines, counting header keywords and assigning the header end index based on a keyword threshold. If a threshold is not reached, a fallback search is used to attempt to locate header keywords. The footer start index is assigned through matching the footer regex.\n\n\nDefined fallback logic for header detection using the footer index if the keyword threshold is not reached. This involves slicing lines to define `headerZone`, `itemZone`, and `summaryZone`. Specified strict table boundaries: only lines within the `itemZone` are passed to line item extraction; header and summary zone lines are excluded. Identified the target fields and the zones in which to extract them, including vendor name, GSTIN, invoice number, and date. The logic includes a search priority where header zone is checked first, then the summary zone or full text.\n\n\nExtracted `igst` from the summary zone. Identified and extracted `word_grand_total` by searching for specific phrases in the summary or full text, then extracted `total_declared` from the summary zone using keywords. Bank details, including `bank_name`, `account_number`, and `ifsc`, were extracted strictly from the summary zone or, if necessary, the full text.\n\nThe parsing now focuses on a right-to-left approach within the line item zone to address issues with numerical data in descriptions. Commas are cleaned as thousands separators. Starting from the end of each line, numerical tokens are extracted as billed amount, unit rate, and quantity respectively, with an optional HSN/SAC code as the fourth. The remaining tokens comprise the description and a validation check discards lines if the calculated value deviates too much from the extracted total amount.\n\n\nRefining the numeric token extraction from right to left, using a regex to capture numerical values, including Indian currency format. The process iterates through the matches, filtering to only lines with at least two numeric values. The last two tokens are parsed as amount and rate. When additional tokens exist, the logic checks for HSN codes (4-8 digits) and validates the product of quantity and rate against the total amount to determine if the third token is quantity.\n\n\nRevised numeric token extraction to account for HSN codes and varying match lengths. Improved description extraction by correctly identifying the cutoff index based on the number of matches. Added a column swap check to handle cases where quantity and amount are incorrectly assigned. Introduced a validation check to compare calculated value (quantity * rate) against the extracted total amount, considering a 5% deviation threshold for potential discounts. This validation helps to ensure the accuracy of extracted line item data.\n\n\nRethinking the validation logic to accommodate potential overcharges, a crucial feature for the audit. The previous approach of discarding lines with a deviation exceeding 5% needs adjustment; the goal is to detect and highlight discrepancies rather than blindly discarding them. Implemented a check that verifies `quantity * rate` against the total amount, with a specific focus on identifying significant deviations, while also considering reasonable unit rates and product descriptions to differentiate between legitimate discrepancies and random numerical sequences.\n\n\nImplemented a description validation that identifies genuine product descriptions and flags lines with significant calculation deviations as potential errors, rather than discarding them. This involves checking for product keywords and excluding lines with forbidden terms or short, uninformative descriptions. This logic incorporates a safeguard against both excessive and insufficient values based on the initial validation check.\n\n\nThe initial approach uses direct visual parsing with Gemini 2.5 Flash, focusing on a structured JSON output with validation checks. Specific API key format handling based on prefixes has been added, supporting both 'AQ.' and standard API key formats. The JSON schema incorporates a `declared_total` field to reflect the total on the bill. Post-processing logic includes a reconciliation step to adjust the `declared_total` if it is suspiciously low relative to the subtotal, in order to resolve the edge case where the extraction finds only parts of the expected number in total field. Also synchronizes `declared_total` and `total_declared`.\n\n\nFocusing on line item extraction and validation based on product descriptions, refining the approach to explicitly exclude non-item data. Implemented a safeguard to prevent extraction of addresses or contact details as line items. This also involves strict enforcement to ensure only the final grand total is extracted, discarding partial numerical data. The parsing now adheres to a refined rule set, treating commas as thousands separators, and focusing on accuracy.\n\n\nReconciling the extracted data involves setting defaults for missing fields: quantity, rate, and amount within the line items, and mapping variations of `invoice_number`. The Gemini API calls use 'Authorization: Bearer' for 'AQ.' keys and 'x-goog-api-key' for others, with a fallback from `gemini-2.5-flash` to `gemini-3.8-flash`.  If the API call fails, the fallback uses Tesseract.js/PDF.js and the `parseInvoiceText` function. The process employs a 3-tier parsing strategy: Table Boundary Slicing, followed by a Right-to-Left Numeric Column Parser.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":250,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/invoiceTextParser.js","StartLine":105}}]}
{"step_index":1467,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T19:32:30Z","content":"Created At: 2026-11-03T01:02:30+05:30\nCompleted At: 2026-11-03T01:02:30+05:30\nShowing lines 105-250 of 418\n105: }\n106: \n107: /**\n108:  * Parses raw text into structured Invoice JSON matching our application schema\n109:  */\n110: export function parseInvoiceText(rawText, sourceFileName = \"Uploaded Bill\") {\n111:   const lines = rawText\n112:     .split(/\\r?\\n/)\n113:     .map(l => l.trim())\n114:     .filter(l => l.length > 0);\n115: \n116:   const unreadable_fields = [];\n117: \n118:   // 2. Extract GSTIN\n119:   const gstinMatch = rawText.match(GSTIN_REGEX);\n120:   const gstin = gstinMatch ? gstinMatch[0].toUpperCase() : null;\n121:   if (!gstin) unreadable_fields.push(\"gstin\");\n122: \n123:   // 3. Extract Invoice Number\n124:   let invoice_no = null;\n125:   for (const line of lines) {\n126:     const invMatch = line.match(/(?:inv(?:oice)?|bill|memo|parcha|challan)[\\s#.:\\-_]+([A-Za-z0-9\\/-]+)/i);\n127:     if (invMatch && invMatch[1] && invMatch[1].length >= 2) {\n128:       invoice_no = invMatch[1].trim();\n129:       break;\n130:     }\n131:   }\n132:   if (!invoice_no) {\n133:     // Look for standalone alphanumeric code\n134:     const fallbackMatch = rawText.match(/\\b([A-Z]{2,4}\\/[\\d]{2,4}\\/[\\d]+)\\b/);\n135:     if (fallbackMatch) invoice_no = fallbackMatch[1];\n136:     else unreadable_fields.push(\"invoice_no\");\n137:   }\n138: \n139:   // 4. Extract Date\n140:   let date = null;\n141:   const dateMatch = rawText.match(DATE_REGEX);\n142:   if (dateMatch) {\n143:     date = dateMatch[0].trim();\n144:   } else {\n145:     unreadable_fields.push(\"date\");\n146:   }\n147: \n148:   // 5. Extract Vendor Name (usually the prominent text in the first 3 lines)\n149:   let vendor_name = null;\n150:   for (let i = 0; i < Math.min(5, lines.length); i++) {\n151:     const line = lines[i];\n152:     // Ignore generic headers like \"TAX INVOICE\", \"ORIGINAL FOR RECIPIENT\"\n153:     if (!/tax invoice|original|duplicate|retail invoice|cash memo/i.test(line) && line.length > 3) {\n154:       vendor_name = line;\n155:       break;\n156:     }\n157:   }\n158:   if (vendor_name) {\n159:     // RULE 1: Never include phone numbers, email addresses, or 'Phone: ...' in supplier_name\n160:     vendor_name = vendor_name.replace(/(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+/gi, \"\").trim();\n161:   }\n162:   if (!vendor_name || vendor_name.length < 2) {\n163:     vendor_name = sourceFileName.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \") + \" (Extracted)\";\n164:   }\n165: \n166:   // 6. Extract Line Items from table rows\n167:   const items = [];\n168:   \n169:   // Use regex pattern to capture Indian currency figures with commas: (?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)\n170:   const CURRENCY_FIGURE_REGEX = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n171: \n172:   for (let i = 0; i < lines.length; i++) {\n173:     const line = lines[i];\n174: \n175:     // Skip header lines\n176:     if (/item\\s+desc|description|particulars|qty|rate|amount|hsn/i.test(line) && /rate|amount/i.test(line)) {\n177:       continue;\n178:     }\n179:     // Skip summary lines\n180:     if (/subtotal|sub\\s+total|cgst|sgst|igst|grand\\s+total|round\\s+off|total in words|amount in words/i.test(line)) {\n181:       continue;\n182:     }\n183: \n184:     // Capture all figures matching the Indian currency regex without splitting on commas\n185:     const figures = [];\n186:     let match;\n187:     const regexClone = new RegExp(CURRENCY_FIGURE_REGEX.source, 'g');\n188:     while ((match = regexClone.exec(line)) !== null) {\n189:       if (match[1]) {\n190:         figures.push({\n191:           raw: match[1],\n192:           value: parseIndianCurrency(match[1]),\n193:           index: match.index,\n194:           length: match[0].length\n195:         });\n196:       }\n197:     }\n198: \n199:     if (figures.length >= 2) {\n200:       // Last figure is Billed Amount\n201:       const amountFig = figures[figures.length - 1];\n202:       // Second to last is Unit Rate\n203:       const rateFig = figures[figures.length - 2];\n204:       \n205:       let qty = 1.0;\n206:       let textEndIndex = rateFig.index;\n207: \n208:       if (figures.length >= 3) {\n209:         const potentialQty = figures[figures.length - 3];\n210:         // If it is an integer <= 1000 and situated right before rate\n211:         if (potentialQty.value > 0 && potentialQty.value <= 1000 && Number.isInteger(potentialQty.value)) {\n212:           qty = potentialQty.value;\n213:           textEndIndex = potentialQty.index;\n214:         }\n215:       }\n216: \n217:       // First figure might be S.No (e.g., '1' or '2' at start of line)\n218:       let textStartIndex = 0;\n219:       if (figures.length >= 3 && figures[0].index === 0 && figures[0].value <= 100) {\n220:         textStartIndex = figures[0].length;\n221:       }\n222: \n223:       // Extract description\n224:       let desc = line.slice(textStartIndex, textEndIndex)\n225:         .replace(/^[\\[\\|\\]\\(\\)\\s\\.\\-]+|[\\[\\|\\]\\(\\)\\s\\.\\-]+$/g, '')\n226:         .replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, '')\n227:         .trim();\n228: \n229:       const rate = rateFig.value;\n230:       const amount = amountFig.value > 0 ? amountFig.value : round2(qty * rate);\n231: \n232:       // Verify description and amount sanity\n233:       if (desc.length >= 3 && amount > 0 && (desc.match(/[a-zA-Z]/g) || []).length >= 4) {\n234:         // Skip metadata/forbidden lines: PAN, Acc. Number, Account, Bank, IFSC, Maharashtra, Mumbai, Delhi, Haryana\n235:         if (!/gstin|\\bpan\\b|acc\\.?\\s*(?:number|no)|account|bank|ifsc|maharashtra|mumbai|delhi|haryana|authorised|signature|terms|condition|e-way/i.test(desc)) {\n236:           items.push({\n237:             id: `item-${items.length + 1}`,\n238:             description: desc,\n239:             hsn: \"\",\n240:             qty: qty,\n241:             rate: rate,\n242:             amount: amount,\n243:             is_blurry: false\n244:           });\n245:         }\n246:       }\n247:     }\n248:   }\n249: \n250:   // 7. Extract Totals (Grand Total, Subtotal, Taxes)"}
{"step_index":1468,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T19:32:30Z","input_tokens":8093,"cache_read_tokens":230167,"output_tokens":2535,"thinking":"The current parsing method utilizes a line-by-line regex approach. This involves a top-to-bottom scan for line items by analyzing figures from left to right. Now, new parsing zones are defined to categorize document sections. These zones include a header, items, and totals which will be sliced from document lines.\n\n\nInitial parsing strategy defines zones for header, items, and summary sections within the document. The item section will use a right-to-left approach to extract numerical data as billed amount, unit rate, and quantity, with an optional HSN/SAC code. Validation includes checking the calculation of quantity multiplied by unit rate against the total amount, along with guardrails to discard lines with prohibited keywords or missing product names. Header zone extracts vendor information and invoice details; summary zone will extract tax and bank information. Keywords will be used to delimit header and footer boundaries.\n\n\nThe right-to-left parsing process identifies numerical tokens. The total amount is the rightmost number, and the unit rate is the second-to-last. Examining the tokens, I'll attempt to extract a quantity and HSN/SAC code based on the presence and structure of the preceding tokens. If a token appears before the rate, it's evaluated for both value and validity. Further, examining the regex parsing logic reveals the use of `parseIndianCurrency` to process the numerical values.\n\nAnalyzing token parsing logic for quantity and HSN/SAC code extraction reveals conditions to handle varying token counts.  Extraction logic considers if a value multiplied by the unit rate is close to the total amount, using a 5% tolerance, to determine the quantity. Description extraction logic removes sequence numbers, leading/trailing punctuation/brackets, and common unit abbreviations to isolate the product description.  A fallback mechanism is present to handle the scenario where quantity and amount are swapped, adjusting quantity and rate if the amount is positive and the quantity equals the amount when the rate is one or two.\n\n\nInitial values are set for quantity and rate when amount is the only discernible value. Validation starts with checks for positive values for all financial fields and proceeds to a calculation check that discards entries where the calculated amount deviates by more than 5% from the total, with tolerance for reasonable discrepancies.  Description validation filters out lines that contain fewer than three letters or prohibited metadata, effectively filtering out extraneous information.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":80,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/server.py","StartLine":35}}]}
{"step_index":1469,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T19:32:50Z","content":"Created At: 2026-11-03T01:02:50+05:30\nCompleted At: 2026-11-03T01:02:50+05:30\nShowing lines 35-80 of 341\n35:     try:\n36:         client = genai.Client(api_key=active_key)\n37:     except Exception as e:\n38:         print(f\"[AUDIT IT] Warning: Failed to init default GenAI client: {e}\")\n39: \n40: # String-based Pydantic Schemas to prevent commas from being split or truncated\n41: class InvoiceItem(BaseModel):\n42:     description: str\n43:     quantity: str\n44:     unit_rate: str\n45:     total_amount: str\n46: \n47: class ExtractedInvoice(BaseModel):\n48:     vendor_name: Optional[str] = None\n49:     gstin: Optional[str] = None\n50:     invoice_number: Optional[str] = None\n51:     date: Optional[str] = None\n52:     items: List[InvoiceItem] = []\n53:     subtotal: Optional[str] = None\n54:     cgst: Optional[str] = None\n55:     sgst: Optional[str] = None\n56:     igst: Optional[str] = None\n57:     declared_total: Optional[str] = None\n58: \n59: app = FastAPI(title=\"AUDIT IT - Bill Verification API\")\n60: \n61: # Enable CORS for local development and cross-origin requests\n62: app.add_middleware(\n63:     CORSMiddleware,\n64:     allow_origins=[\"*\"],\n65:     allow_credentials=True,\n66:     allow_methods=[\"*\"],\n67:     allow_headers=[\"*\"],\n68: )\n69: \n70: def get_genai_client(custom_api_key: Optional[str] = None) -> Optional[genai.Client]:\n71:     \"\"\"Retrieve or instantiate a Google GenAI Client.\"\"\"\n72:     key = custom_api_key or os.environ.get(\"GEMINI_API_KEY\") or DEFAULT_GEMINI_API_KEY\n73:     if key and key.strip():\n74:         try:\n75:             return genai.Client(api_key=key.strip())\n76:         except Exception as err:\n77:             print(f\"[AUDIT IT] Error initializing client with key: {err}\")\n78:     global client\n79:     if client:\n80:         return client"}
