{"step_index":1471,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T19:33:09Z","content":"Created At: 2026-11-03T01:03:09+05:30\nCompleted At: 2026-11-03T01:03:09+05:30\nShowing lines 90-170 of 341\n90:     Call Gemini generateContent supporting both:\n91:     1. 'AQ.' Google Cloud OAuth / Bearer Token (Authorization: Bearer AQ...)\n92:     2. 'AIzaSy' standard API keys (x-goog-api-key: AIzaSy...)\n93:     \"\"\"\n94:     contents_b64 = base64.b64encode(contents_bytes).decode(\"utf-8\")\n95:     payload = {\n96:         \"contents\": [\n97:             {\n98:                 \"parts\": [\n99:                     {\n100:                         \"inlineData\": {\n101:                             \"mimeType\": mime_type,\n102:                             \"data\": contents_b64\n103:                         }\n104:                     },\n105:                     {\n106:                         \"text\": prompt\n107:                     }\n108:                 ]\n109:             }\n110:         ],\n111:         \"generationConfig\": {\n112:             \"responseMimeType\": \"application/json\",\n113:             \"temperature\": 0.0\n114:         }\n115:     }\n116: \n117:     models_to_try = [\"gemini-2.5-flash\", \"gemini-3.8-flash\", \"gemini-3.5-flash\"]\n118:     last_err = None\n119: \n120:     for model_name in models_to_try:\n121:         if api_key.startswith(\"AQ.\"):\n122:             # Treat as Google Cloud OAuth / Bearer Token\n123:             headers = {\n124:                 \"Authorization\": f\"Bearer {api_key}\",\n125:                 \"Content-Type\": \"application/json\"\n126:             }\n127:             # Call the Gemini v1beta REST endpoint directly via httpx or requests:\n128:             url = f\"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:generateContent\"\n129:         else:\n130:             # Standard AIzaSy key passed via header or query param\n131:             headers = {\n132:                 \"x-goog-api-key\": api_key,\n133:                 \"Content-Type\": \"application/json\"\n134:             }\n135:             url = f\"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:generateContent\"\n136: \n137:         try:\n138:             async with httpx.AsyncClient(timeout=60.0) as http_client:\n139:                 resp = await http_client.post(url, headers=headers, json=payload)\n140:                 if resp.status_code == 200:\n141:                     resp_json = resp.json()\n142:                     candidates = resp_json.get(\"candidates\", [])\n143:                     if candidates and \"content\" in candidates[0]:\n144:                         parts = candidates[0][\"content\"].get(\"parts\", [])\n145:                         if parts and \"text\" in parts[0]:\n146:                             return parts[0][\"text\"]\n147:                     raise ValueError(f\"No candidate text in response: {resp.text[:200]}\")\n148:                 elif resp.status_code in [404, 503] or \"not found\" in resp.text.lower():\n149:                     print(f\"[AUDIT IT] Model {model_name} unavailable ({resp.status_code}), trying next candidate...\")\n150:                     last_err = f\"HTTP {resp.status_code}: {resp.text}\"\n151:                     continue\n152:                 else:\n153:                     last_err = f\"HTTP {resp.status_code}: {resp.text}\"\n154:                     print(f\"[AUDIT IT] Gemini REST response error ({resp.status_code}): {resp.text[:200]}\")\n155:                     if resp.status_code in [401, 403]:\n156:                         break\n157:         except Exception as exc:\n158:             last_err = exc\n159:             err_str = str(exc)\n160:             if \"404\" in err_str or \"503\" in err_str:\n161:                 continue\n162:             break\n163: \n164:     raise RuntimeError(f\"Gemini generation failed: {last_err}\")\n165: \n166: @app.post(\"/api/analyze-bill\")\n167: async def analyze_bill(\n168:     file: UploadFile = File(...),\n169:     x_api_key: Optional[str] = Header(None, alias=\"x-api-key\"),\n170:     authorization: Optional[str] = Header(None, alias=\"authorization\")"}
