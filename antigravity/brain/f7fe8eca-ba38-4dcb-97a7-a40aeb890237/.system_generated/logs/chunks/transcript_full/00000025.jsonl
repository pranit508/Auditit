ad)\n140:                 if resp.status_code == 200:\n141:                     resp_json = resp.json()\n142:                     candidates = resp_json.get(\"candidates\", [])\n143:                     if candidates and \"content\" in candidates[0]:\n144:                         parts = candidates[0][\"content\"].get(\"parts\", [])\n145:                         if parts and \"text\" in parts[0]:\n146:                             return parts[0][\"text\"]\n147:                     raise ValueError(f\"No candidate text in response: {resp.text[:200]}\")\n148:                 elif resp.status_code in [404, 503] or \"not found\" in resp.text.lower():\n149:                     print(f\"[AUDIT IT] Model {model_name} unavailable ({resp.status_code}), trying next candidate...\")\n150:                     last_err = f\"HTTP {resp.status_code}: {resp.text}\"\n151:                     continue\n152:                 else:\n153:                     last_err = f\"HTTP {resp.status_code}: {resp.text}\"\n154:                     print(f\"[AUDIT IT] Gemini REST response error ({resp.status_code}): {resp.text[:200]}\")\n155:                     if resp.status_code in [401, 403]:\n156:                         break\n157:         except Exception as exc:\n158:             last_err = exc\n159:             err_str = str(exc)\n160:             if \"404\" in err_str or \"503\" in err_str:\n161:                 continue\n162:             break\n163: \n164:     raise RuntimeError(f\"Gemini generation failed: {last_err}\")\n165: \n166: @app.post(\"/api/analyze-bill\")\n167: async def analyze_bill(\n168:     file: UploadFile = File(...),\n169:     x_api_key: Optional[str] = Header(None, alias=\"x-api-key\"),\n170:     authorization: Optional[str] = Header(None, alias=\"authorization\")\n171: ):\n172:     contents = await file.read()\n173:     mime_type = file.content_type or \"image/jpeg\"\n174: \n175:     # Extract api_key from x-api-key or Authorization Bearer header\n176:     api_key = x_api_key\n177:     if not api_key and authorization:\n178:         if authorization.lower().startswith(\"bearer \"):\n179:             api_key = authorization[7:].strip()\n180:         else:\n181:             api_key = authorization.strip()\n182:     if not api_key:\n183:         api_key = os.environ.get(\"GEMINI_API_KEY\") or DEFAULT_GEMINI_API_KEY\n184:     if api_key:\n185:         api_key = api_key.strip().strip('\"').strip(\"'\")\n186: \n187:     if not api_key:\n188:         return JSONResponse(\n189:             status_code=400,\n190:             content={\"error\": \"Gemini API key or OAuth Bearer token is required.\"}\n191:         )\n192:     \n193:     # Strict prompt with Indian GST invoice extraction rules\n194:     prompt = \"\"\"You are a strict GST Invoice extractor. \n195: RULES FOR LINE ITEMS:\n196: - Extract items ONLY from the central itemized table bounded between the table header (S.No, Description, HSN, Qty, Rate, Amount) and the Subtotal row.\n197: - NEVER extract text from the header or footer as line items:\n198:   * DO NOT extract addresses or cities (e.g. 'Mumbai, Maharashtra').\n199:   * DO NOT extract PAN, GSTIN, or buyer details (e.g. 'PAN : 26CORPP').\n200:   * DO NOT extract bank account or payment details (e.g. 'Acc. Number 271').\n201: - Each valid line item MUST have a legitimate product name, quantity > 0, unit rate > 0, and total amount.\n202: \n203: GRAND TOTAL PARSING RULES:\n204: - The Grand Total MUST be the overall final payable invoice amount, NOT a column entry, tax rate, or HSN fragment like '774'.\n205: - Logic check: Grand Total must be approximately (Subtotal + Total Tax). \n206:   Here, Subtotal is ~3,805 and IGST is ~684.90, so the Grand Total MUST be around 4,489.90 or 4,490.00.\n207: - If you see a small number like '774', it is an HSN code, partial tax, or serial number. DO NOT use it as `declared_total`.\n208: - Always look at the printed words: 'FOUR THOUSAND FOUR HUNDRED AND NINETY RUPEES' confirms the total is ~