ble_str:\n            if c == \"\\\\\" and i + 1 < len(content):\n                i += 1\n            elif c == \"\\\"\":\n                in_double_str = False\n        elif in_backtick:\n            if c == \"\\\\\" and i + 1 < len(content):\n                i += 1\n            elif c == \"`\":\n                in_backtick = False\n        else:\n            if c == \"/\" and next_c == \"/\":\n                in_line_comment = True\n                i += 1\n            elif c == \"/\" and next_c == \"*\":\n                in_block_comment = True\n                i += 1\n            elif c == \"\\'\":\n                in_single_str = True\n            elif c == \"\\\"\":\n                in_double_str = True\n            elif c == \"`\":\n                in_backtick = True\n            elif c in \"({[\":\n                stack.append((c, i))\n            elif c in \")}]\":\n                if not stack:\n                    errors.append(f\"{rel}: Unmatched closing {c} at index {i}\")\n                    break\n                top, _ = stack.pop()\n                if pairs[c] != top:\n                    errors.append(f\"{rel}: Mismatched bracket: expected match for {top}, got {c}\")\n                    break\n        i += 1\n\n    if stack:\n        errors.append(f\"{rel}: Unclosed {len(stack)} opening brackets, e.g. {stack[-1]}\")\n    else:\n        print(f\" ✓ {rel} - Brackets balanced\")\n\nif errors:\n    print(\"\\nERRORS DETECTED:\")\n    for e in errors:\n        print(\" ❌\", e)\n    sys.exit(1)\nelse:\n    print(\"\\nAll JS files passed syntax balance validation!\")\n'","WaitMsBeforeAsync":5000,"toolSummary":"Validate JS file syntax and balance"}}]}
