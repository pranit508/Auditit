{"step_index":437,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:53:56Z","content":"Created At: 2026-11-02T22:23:56+05:30\nCompleted At: 2026-11-02T22:23:56+05:30\nShowing lines 1-100 of 123\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: AUDIT IT - Local Web App Server\n4: Runs a lightweight, zero-dependency HTTP server with proper MIME types for ES Modules\n5: and backend invoice processing & cleaning APIs.\n6: \"\"\"\n7: \n8: import os\n9: import sys\n10: import json\n11: import mimetypes\n12: from http.server import HTTPServer, SimpleHTTPRequestHandler\n13: \n14: # Import strict item cleaner\n15: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n16: from utils.clean_items import clean_extracted_items\n17: \n18: PORT = 3000\n19: \n20: # Ensure ES modules (.js) have application/javascript MIME type\n21: mimetypes.add_type(\"application/javascript\", \".js\")\n22: mimetypes.add_type(\"application/javascript\", \".mjs\")\n23: mimetypes.add_type(\"text/css\", \".css\")\n24: mimetypes.add_type(\"text/html\", \".html\")\n25: mimetypes.add_type(\"application/json\", \".json\")\n26: \n27: class AuditItHandler(SimpleHTTPRequestHandler):\n28:     def end_headers(self):\n29:         # Enable CORS and disable cache during development\n30:         self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n31:         self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n32:         self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n33:         self.send_header(\"Cache-Control\", \"no-cache, no-store, must-revalidate\")\n34:         super().end_headers()\n35: \n36:     def do_OPTIONS(self):\n37:         self.send_response(200)\n38:         self.end_headers()\n39: \n40:     def do_POST(self):\n41:         \"\"\"\n42:         Backend API routes:\n43:         - /api/clean-items: Purges metadata, phone numbers, and GSTINs from items\n44:         - /api/process-invoice: Processes raw Gemini invoice response, purges metadata items, and calculates precision totals\n45:         \"\"\"\n46:         content_length = int(self.headers.get(\"Content-Length\", 0))\n47:         post_data = self.rfile.read(content_length)\n48: \n49:         try:\n50:             body = json.loads(post_data.decode(\"utf-8\")) if post_data else {}\n51:         except Exception as e:\n52:             self.send_response(400)\n53:             self.send_header(\"Content-Type\", \"application/json\")\n54:             self.end_headers()\n55:             self.wfile.write(json.dumps({\"error\": \"Invalid JSON\", \"details\": str(e)}).encode(\"utf-8\"))\n56:             return\n57: \n58:         if self.path == \"/api/clean-items\":\n59:             raw_items = body.get(\"items\", [])\n60:             cleaned = clean_extracted_items(raw_items)\n61:             self.send_response(200)\n62:             self.send_header(\"Content-Type\", \"application/json\")\n63:             self.end_headers()\n64:             self.wfile.write(json.dumps({\"success\": True, \"items\": cleaned, \"count\": len(cleaned)}).encode(\"utf-8\"))\n65:             return\n66: \n67:         elif self.path == \"/api/process-invoice\":\n68:             # Invoice processing route: apply clean_extracted_items right after extraction\n69:             invoice = body.get(\"invoice\", body)\n70:             items = invoice.get(\"items\", [])\n71:             \n72:             # Apply clean_extracted_items to response.items right after the Gemini call:\n73:             cleaned_items = clean_extracted_items(items)\n74:             invoice[\"items\"] = cleaned_items\n75: \n76:             # Recalculate subtotal from cleaned genuine items\n77:             calculated_subtotal = round(sum(\n78:                 float(it.get(\"quantity\") or it.get(\"qty\") or 1) * \n79:                 float(it.get(\"unit_rate\") or it.get(\"rate\") or 0)\n80:                 for it in cleaned_items\n81:             ), 2)\n82:             invoice[\"calculated_subtotal\"] = calculated_subtotal\n83: \n84:             self.send_response(200)\n85:             self.send_header(\"Content-Type\", \"application/json\")\n86:             self.end_headers()\n87:             self.wfile.write(json.dumps({\"success\": True, \"invoice\": invoice}).encode(\"utf-8\"))\n88:             return\n89: \n90:         else:\n91:             self.send_response(404)\n92:             self.send_header(\"Content-Type\", \"application/json\")\n93:             self.end_headers()\n94:             self.wfile.write(json.dumps({\"error\": f\"Endpoint {self.path} not found\"}).encode(\"utf-8\"))\n95: \n96:     def log_message(self, format, *args):\n97:         # Clean logging\n98:         sys.stderr.write(f\"[AUDIT IT] {self.address_string()} - {format % args}\\n\")\n99: \n100: def run(port=PORT):"}
