{"step_index":413,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:51:48Z","content":"Created At: 2026-11-02T22:21:48+05:30\nCompleted At: 2026-11-02T22:21:48+05:30\nShowing lines 1-54 of 54\n1: // Client-side Privacy & Redaction Engine for AUDIT IT\n2: \n3: /**\n4:  * Masks Indian Bank Account Numbers (keeps last 4 digits visible)\n5:  * e.g., \"50100239482910\" -> \"•••• •••• •••• 2910\"\n6:  */\n7: export function maskBankAccount(accountNumber) {\n8:   if (!accountNumber) return \"\";\n9:   const cleaned = accountNumber.toString().replace(/\\s+/g, \"\");\n10:   if (cleaned.length <= 4) return \"••••\" + cleaned;\n11:   const lastFour = cleaned.slice(-4);\n12:   return \"•••• •••• •••• \" + lastFour;\n13: }\n14: \n15: /**\n16:  * Masks IFSC Codes (keeps bank prefix, masks branch code)\n17:  * e.g., \"HDFC0001234\" -> \"HDFC••••••\"\n18:  */\n19: export function maskIFSC(ifsc) {\n20:   if (!ifsc) return \"\";\n21:   const cleaned = ifsc.trim().toUpperCase();\n22:   if (cleaned.length < 5) return \"••••••\";\n23:   return cleaned.slice(0, 4) + \"••••••\";\n24: }\n25: \n26: /**\n27:  * Masks phone numbers (keeps last 3 digits)\n28:  * e.g., \"+91 9876543210\" -> \"+91 •••••••210\"\n29:  */\n30: export function maskPhone(phone) {\n31:   if (!phone) return \"\";\n32:   const cleaned = phone.replace(/[^\\d+]/g, \"\");\n33:   if (cleaned.length < 5) return \"•••••\";\n34:   return cleaned.slice(0, 3) + \" •••••••\" + cleaned.slice(-3);\n35: }\n36: \n37: /**\n38:  * Pre-processes any raw text or object to ensure sensitive financial identifiers\n39:  * are sanitized before UI display or downstream AI requests.\n40:  */\n41: export function sanitizeInvoiceData(rawInvoice) {\n42:   const sanitized = JSON.parse(JSON.stringify(rawInvoice));\n43: \n44:   if (sanitized.bank_details) {\n45:     if (sanitized.bank_details.account_number) {\n46:       sanitized.bank_details.account_number = maskBankAccount(sanitized.bank_details.account_number);\n47:     }\n48:     if (sanitized.bank_details.ifsc) {\n49:       sanitized.bank_details.ifsc = maskIFSC(sanitized.bank_details.ifsc);\n50:     }\n51:   }\n52: \n53:   return sanitized;\n54: }"}
