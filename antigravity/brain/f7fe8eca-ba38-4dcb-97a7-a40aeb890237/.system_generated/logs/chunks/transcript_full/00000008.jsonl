            # Apply clean_extracted_items to response.items right after the Gemini call:\n            cleaned_items = clean_extracted_items(items)\n            invoice[\"items\"] = cleaned_items\n\n            # Recalculate subtotal from cleaned genuine items\n            calculated_subtotal = round(sum(\n                float(it.get(\"quantity\") or it.get(\"qty\") or 1) * \n                float(it.get(\"unit_rate\") or it.get(\"rate\") or 0)\n                for it in cleaned_items\n            ), 2)\n            invoice[\"calculated_subtotal\"] = calculated_subtotal\n\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.end_headers()\n            self.wfile.write(json.dumps({\"success\": True, \"invoice\": invoice}).encode(\"utf-8\"))\n            return"}}]}
