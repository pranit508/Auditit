/span>\n        <span>•</span>\n        <span>Strict \"AI Reads, Code Calculates\" Architecture</span>\n      </div>\n      <div class=\"text-[11px] text-slate-400\">\n        Bank details & private numbers are automatically masked on the client side.\n      </div>\n    </div>\n  </footer>\n\n  <!-- MODAL MOUNT POINT -->\n  <div id=\"modal-container\"></div>\n\n  <!-- TOAST NOTIFICATION CONTAINER -->\n  <div id=\"toast-container\" class=\"fixed bottom-4 right-4 z-50 flex flex-col space-y-2 pointer-events-none\"></div>\n\n  <!-- APP ENTRY MODULE -->\n  <script type=\"module\" src=\"./app.js\"></script>\n</body>\n</html>\n","Overwrite":true,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/index.html"}}]}
