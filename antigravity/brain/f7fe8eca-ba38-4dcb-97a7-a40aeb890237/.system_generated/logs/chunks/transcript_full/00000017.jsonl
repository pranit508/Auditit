xes. Sanity checks are in place to ensure valid descriptions and amounts are captured.\n\n\nThe updated code searches for total amounts expressed in words using a regular expression and parses them into numerical representations. It also extracts subtotals by matching specific keywords and applying the currency parsing function to any numerical figures. Tax amounts (CGST, SGST, IGST) are extracted similarly, using a regex and parsing the extracted numbers. The code appears to be designed to handle amounts formatted with commas for Indian currency.\n\n\nThe updated code now extracts and parses CGST, SGST, IGST, and grand totals from invoice lines based on keywords and regular expressions. It uses `parseIndianCurrency` to handle comma-separated numbers in Indian currency format. A check is included to determine the total based on numeric and word representations, preferring the word representation if the numeric total seems incorrect. This helps address potential OCR errors.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/invoiceTextParser.js","Replacement":"/**\n * Clean currency string to a float number:\n * Strip currency symbols and whitespace, then strip commas BEFORE converting to number\n */\nexport function parseIndianCurrency(val) {\n  if (!val) return 0;\n  // Strip currency symbols and whitespace, then strip commas BEFORE converting to number\n  const cleaned = String(val).replace(/[₹\\s]/g, '').replace(/,/g, '');\n  const num = parseFloat(cleaned);\n  return isNaN(num) ? 0 : num;\n}\n\n/**\n * Words-to-number parser for Indian invoices (e.g. 'FOUR THOUSAND FOUR HUNDRED AND NINETY' -> 4490.0)\n */\nexport function parseWordsToNumber(text) {\n  if (!text) return 0;\n  const upper = String(text).toUpperCase().replace(/[^A-Z\\s]/g, ' ');\n  const words = upper.split(/\\s+/);\n\n  const units = {\n    ZERO: 0, ONE: 1, TWO: 2, THREE: 3, FOUR: 4,\n    FIVE: 5, SIX: 6, SEVEN: 7, EIGHT: 8, NINE: 9,\n    TEN: 10, ELEVEN: 11, TWELVE: 12, THIRTEEN: 13,\n    FOURTEEN: 14, FIFTEEN: 15, SIXTEEN: 16, SEVENTEEN: 17,\n    EIGHTEEN: 18, NINETEEN: 19\n  };\n  const tens = {\n    TWENTY: 20, THIRTY: 30, FORTY: 40, FIFTY: 50,\n    SIXTY: 60, SEVENTY: 70, EIGHTY: 80, NINETY: 90\n  };\n  const multipliers = {\n    HUNDRED: 100,\n    THOUSAND: 1000,\n    LAKH: 100000,\n    LAKHS: 100000,\n    CRORE: 10000000,\n    CRORES: 10000000\n  };\n\n  let total = 0;\n  let current = 0;\n  let found = false;\n\n  for (const w of words) {\n    if (units[w] !== undefined) {\n      current += units[w];\n      found = true;\n    } else if (tens[w] !== undefined) {\n      current += tens[w];\n      found = true;\n    } else if (w === 'HUNDRED') {\n      if (current === 0) current = 1;\n      current *= 100;\n      found = true;\n    } else if (multipliers[w] !== undefined) {\n      const mult = multipliers[w];\n      if (current === 0) current = 1;\n      total += current * mult;\n      current = 0;\n      found = true;\n    }\n  }\n\n  total += current;\n  return found ? total : 0;\n}","Target":"/**\n * Clean currency string to a float number (e.g. \"₹ 1,250.50\" -> 1250.50)\n */\nfunction cleanNumber(str) {\n  if (!str) return 0;\n  const cleaned = str.replace(/[₹Rs\\.,\\s]/gi, m => (m === '.' ? '.' : ''));\n  // Handle commas as decimal separator if any\n  const normalized = str.replace(/[₹Rs\\s]/gi, '').replace(/,/g, '');\n  const num = parseFloat(normalized);\n  return isNaN(num) ? 0 : round2(num);\n}"}}]}
