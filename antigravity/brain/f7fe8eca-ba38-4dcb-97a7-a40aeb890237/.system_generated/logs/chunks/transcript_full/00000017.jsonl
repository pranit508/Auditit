{"step_index":1007,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:29:14Z","content":"Created At: 2026-11-02T23:59:14+05:30\nCompleted At: 2026-11-02T23:59:14+05:30\nShowing lines 1-100 of 274\n1: // Client-Side Invoice Text Parser\n2: // Takes raw OCR or PDF text and extracts real structured fields without hallucinating fake items\n3: \n4: import { round2 } from \"./auditEngine.js\";\n5: import { cleanExtractedItems } from \"./itemCleaner.js\";\n6: \n7: /**\n8:  * Standard Indian GSTIN Regex\n9:  */\n10: const GSTIN_REGEX = /\\b[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n11: \n12: /**\n13:  * Common Date patterns (DD/MM/YYYY, DD-MM-YYYY, DD.MM.YYYY, DD Month YYYY)\n14:  */\n15: const DATE_REGEX = /\\b(\\d{1,2})[-/\\.](\\d{1,2})[-/\\.](\\d{2,4})\\b|\\b(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s,]+(\\d{2,4})\\b/i;\n16: \n17: /**\n18:  * Clean currency string to a float number (e.g. \"₹ 1,250.50\" -> 1250.50)\n19:  */\n20: function cleanNumber(str) {\n21:   if (!str) return 0;\n22:   const cleaned = str.replace(/[₹Rs\\.,\\s]/gi, m => (m === '.' ? '.' : ''));\n23:   // Handle commas as decimal separator if any\n24:   const normalized = str.replace(/[₹Rs\\s]/gi, '').replace(/,/g, '');\n25:   const num = parseFloat(normalized);\n26:   return isNaN(num) ? 0 : round2(num);\n27: }\n28: \n29: /**\n30:  * Checks if raw text contains commercial invoice keywords\n31:  */\n32: export function isLikelyInvoice(text) {\n33:   if (!text || text.trim().length < 15) return false;\n34: \n35:   const invoiceKeywords = [\n36:     \"invoice\", \"tax invoice\", \"bill\", \"cash memo\", \"parcha\", \"challan\",\n37:     \"gst\", \"gstin\", \"subtotal\", \"total\", \"grand total\", \"qty\", \"rate\", \n38:     \"amount\", \"hsn\", \"cgst\", \"sgst\", \"igst\", \"balance\", \"payable\", \"rupees\", \"mrp\"\n39:   ];\n40: \n41:   const lower = text.toLowerCase();\n42:   let matches = 0;\n43:   for (const kw of invoiceKeywords) {\n44:     if (lower.includes(kw)) matches++;\n45:   }\n46: \n47:   // At least 2 invoice keywords or a valid GSTIN pattern must be present\n48:   return matches >= 2 || GSTIN_REGEX.test(text);\n49: }\n50: \n51: /**\n52:  * Parses raw text into structured Invoice JSON matching our application schema\n53:  */\n54: export function parseInvoiceText(rawText, sourceFileName = \"Uploaded Bill\") {\n55:   const lines = rawText\n56:     .split(/\\r?\\n/)\n57:     .map(l => l.trim())\n58:     .filter(l => l.length > 0);\n59: \n60:   const unreadable_fields = [];\n61: \n62:   // 2. Extract GSTIN\n63:   const gstinMatch = rawText.match(GSTIN_REGEX);\n64:   const gstin = gstinMatch ? gstinMatch[0].toUpperCase() : null;\n65:   if (!gstin) unreadable_fields.push(\"gstin\");\n66: \n67:   // 3. Extract Invoice Number\n68:   let invoice_no = null;\n69:   for (const line of lines) {\n70:     const invMatch = line.match(/(?:inv(?:oice)?|bill|memo|parcha|challan)[\\s#.:\\-_]+([A-Za-z0-9\\/-]+)/i);\n71:     if (invMatch && invMatch[1] && invMatch[1].length >= 2) {\n72:       invoice_no = invMatch[1].trim();\n73:       break;\n74:     }\n75:   }\n76:   if (!invoice_no) {\n77:     // Look for standalone alphanumeric code\n78:     const fallbackMatch = rawText.match(/\\b([A-Z]{2,4}\\/[\\d]{2,4}\\/[\\d]+)\\b/);\n79:     if (fallbackMatch) invoice_no = fallbackMatch[1];\n80:     else unreadable_fields.push(\"invoice_no\");\n81:   }\n82: \n83:   // 4. Extract Date\n84:   let date = null;\n85:   const dateMatch = rawText.match(DATE_REGEX);\n86:   if (dateMatch) {\n87:     date = dateMatch[0].trim();\n88:   } else {\n89:     unreadable_fields.push(\"date\");\n90:   }\n91: \n92:   // 5. Extract Vendor Name (usually the prominent text in the first 3 lines)\n93:   let vendor_name = null;\n94:   for (let i = 0; i < Math.min(5, lines.length); i++) {\n95:     const line = lines[i];\n96:     // Ignore generic headers like \"TAX INVOICE\", \"ORIGINAL FOR RECIPIENT\"\n97:     if (!/tax invoice|original|duplicate|retail invoice|cash memo/i.test(line) && line.length > 3) {\n98:       vendor_name = line;\n99:       break;\n100:     }"}
