"MISSING\" || !GSTIN_REGEX.test(g);\n40:   });\n41:   const hasGstinIssues = invalidGstinBills.length > 0;\n42:   const invalidGstinITC = round2(invalidGstinBills.reduce((sum, b) => sum + (Number(b.total_tax) || (Number(b.cgst)||0) + (Number(b.sgst)||0) + (Number(b.igst)||0)), 0));\n43: \n44:   // C. Annual Business & ITR Calculator (ITR-4 / ITR-3)\n45:   const annualTurnover = Math.max(0, Number(state.annualTurnover !== undefined ? state.annualTurnover : 3000000));\n46:   const calcMode = state.calcMode || '44AD'; // '44AD' | 'REGULAR'\n47:   const digitalShare = state.digitalShare !== undefined ? Number(state.digitalShare) : 80;\n48:   const cashShare = Math.max(0, 100 - digitalShare);\n49:   const digitalRate = state.digitalRate !== undefined ? Number(state.digitalRate) : 6.0;\n50:   const cashRate = state.cashRate !== undefined ? Number(state.cashRate) : 8.0;\n51: \n52:   // Purchase costs: auto-populated from Total Pur