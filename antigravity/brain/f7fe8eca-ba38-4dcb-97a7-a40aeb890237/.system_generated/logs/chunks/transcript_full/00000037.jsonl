board\n135:                     </button>\n136:                     <span class=\"text-xs text-slate-400 font-mono\">(${this.currentInvoice?.vendor_name || 'Current Bill'})</span>\n137:                   </div>\n138:                   <button id=\"btn-tax-ca-slip\" class=\"px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition-all flex items-center space-x-1\">\n139:                     <span>📑 CA Audit Slip</span>\n140:                   </button>\n141:                 </div>\n142: \n143:                 <div id=\"tax-and-itr-tab-mount\"></div>\n144:               </div>\n145:             `}\n146:           </div>\n147:         </div>\n148:       `;\n149: \n150:       // Top Tab Switcher listeners\n151:       const btnAudit = document.getElementById(\"top-nav-tab-audit\");\n152:       const btnTax = document.getElementById(\"top-nav-tab-tax\");\n153:       if (btnAudit) {\n154:         btnAudit.addEventListener(\"click\", () => this.setActiveTab(\"audit\"));\n155:       }\n156:       if (btnTax) {\n157:         btnTax.addEventListener(\"click\", () => this.setActiveTab(\"tax\"));\n158:       }\n159: \n160:       // Tab 2 Action buttons\n161:       const btnTaxDash = document.getElementById(\"btn-tax-back-dash\");\n162:       if (btnTaxDash) {\n163:         btnTaxDash.addEventListener(\"click\", () => this.goToDashboard());\n164:       }\n165:       const btnTaxCa = document.getElementById(\"btn-tax-ca-slip\");\n166:       if (btnTaxCa) {\n167:         btnTaxCa.addEventListener(\"click\", () => this.openCaSlipModal());\n168:       }\n169: \n170:       if (this.activeTab === 'audit') {\n171:         const workspaceMount = document.getElementById(\"review-workspace-mount\");\n172:         if (workspaceMount) {\n173:           renderReviewWorkspace(workspaceMount, this.currentInvoice, this.currentAudit, {\n174:             activeMainTab: \"audit\",\n175:             hideInternalTabs: true,\n176:             userTaxSettings: this.userTaxSettings,\n177:             onSwitchMainTab: (tab) => this.setActiveTab(tab),\n178:             taxData: this.taxData,\n179:             onRefreshTaxAi: () => this.handleRefreshTaxAi(),\n180:             onUpdateItem: (idx, action, val) => this.handleUpdateItem(idx, action, val),\n181:             onAddItem: () => this.handleAddItem(),\n182:             onDeleteItem: (idx) => this.handleDeleteItem(idx),\n183:             onUpdateHeader: (field, val) => this.handleUpdateHeader(field, val),\n184:             onAutoFixMath: () => this.handleAutoFixMath(),\n185:             onUpdateTaxSettings: (settings) => this.handleUpdateTaxSettings(settings),\n186:             onSubmitValidInputs: (fields) => this.handleSubmitValidInputs(fields),\n187:             onCopyNote: (openWhatsApp) => this.handleCopyDiscrepancyNote(openWhatsApp),\n188:             onOpenCaSlip: () => this.openCaSlipModal(),\n189:             onBack: () => this.goToDashboard()\n190:           });\n191:         }\n192:       } else {\n193:         const taxMount = document.getElementById(\"tax-and-itr-tab-mount\");\n194:         if (taxMount) {\n195:           const verifiedInvoice = {\n196:             subtotal: this.currentInvoice?.subtotal || 0,\n197:             cgst: this.currentInvoice?.cgst || 0,\n198:             sgst: this.currentInvoice?.sgst || 0,\n199:             igst: this.currentInvoice?.igst || 0,\n200:             total_declared: this.currentInvoice?.declared_total ?? this.currentInvoice?.total_declared ?? 0,\n201:             vendor_name: this.currentInvoice?.vendor_name || '',\n202:             gstin: this.currentInvoice?.gstin || '',\n203:             items: this.currentInvoice?.items || []\n204:           };\n205: \n206:           renderTaxAndITRTab(taxMount, {\n207:             verifiedInvoice,\n208:             state: this.taxTabState,\n209:             onUpdateState: (newState) => {\n210:               this.taxTabState = { ...this.taxTabState, ...newState };\n211:               this.recomputeEverything();\n212:             }\n213:           });\n214:         }\n215:       }\n216:     }\n217: \n218:     // Restore focus seamlessly if user was actively typing\n219:     if (focusInfo) {\n220:       let targetInput = null;\n221:       if (focusInfo.id) {\n222:         targetInput = document.getElementById(focusInfo.id);\n223:       } else if (focusInfo.action && focusInfo.index !== null) {\n224:         targetInput = document.querySelector(`input[data-action=\"${focusInfo.action}\"][data-index=\"${focusInfo.index}\"]`);\n225:       }\n226:       if (targetInput) {\n227:         targetInput.focus();\n228:         if (targetInput.setSelectionRange && focusInfo.selectionStart !== null) {\n229:           try {\n230:             targetInput.setSelectionRange(focusInfo.selectionStart, focusInfo.selectionEnd);\n231:           } catch (_) {}\n232:         }\n233:       }\n234:     }\n235:   }\n236: \n237:   async loadSample(sampleKey) {\n238:     const rawSample = SAMPLE_INVOICES[sampleKey];\n239:     if (!rawSample) return;\n240: \n241:     // Deep copy to allow editing without mutating original sample\n242:     this.currentInvoice = JSON.parse(JSON.stringify(rawSample));\n243:     this.currentAudit = auditInvoice(this.currentInvoice);\n244: \n245:     // Compute code-calculated tax & deemed profit under Sec 44AD\n246:     const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n247:     const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n248:     \n249:     this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n250:     this.activeTab = \"audit\";"}
