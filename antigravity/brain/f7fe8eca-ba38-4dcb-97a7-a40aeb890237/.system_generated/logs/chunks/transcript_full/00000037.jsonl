ing();\n455:   }\n456: \n457:   handleAutoFixMath() {\n458:     if (!this.currentInvoice) return;\n459: \n460:     // Fix each item's declared amount to equal qty * rate\n461:     let newSubtotal = 0;\n462:     this.currentInvoice.items.forEach(item => {\n463:       item.amount = round2(item.qty * item.rate);\n464:       item.error_flag = false;\n465:       newSubtotal += item.amount;\n466:     });\n467: \n468:     this.currentInvoice.subtotal = round2(newSubtotal);\n469:     const totalTax = round2((this.currentInvoice.cgst || 0) + (this.currentInvoice.sgst || 0) + (this.currentInvoice.igst || 0));\n470:     this.currentInvoice.total_declared = round2(this.currentInvoice.subtotal + totalTax);\n471: \n472:     this.recomputeEverything();\n473:     this.showToast(\"Auto-corrected all math discrepancies to verified total!\", \"success\");\n474:   }\n475: \n476:   handleUpdateTaxSettings(settings) {\n477:     this.userTaxSettings = { ...this.userTaxSettings, ...settings };\n478:     this.recomputeEverything();\n479:   }\n480: \n481:   handleSubmitValidInputs(fields) {\n482:     if (!this.currentInvoice) return;\n483: \n484:     Object.keys(fields).forEach(key => {\n485:       const { value, itemIndex } = fields[key];\n486: \n487:       if (key === \"gstin\") {\n488:         if (value.toUpperCase() === \"UNREGISTERED\") {\n489:           this.currentInvoice.is_unregistered_vendor = true;\n490:           this.currentInvoice.gstin = \"\";\n491:         } else {\n492:           this.currentInvoice.gstin = value.toUpperCase();\n493:           this.currentInvoice.is_unregistered_vendor = false;\n494:         }\n495:       } else if (key === \"vendor_name\") {\n496:         this.currentInvoice.vendor_name = value;\n497:       } else if (key === \"invoice_no\") {\n498:         this.currentInvoice.invoice_no = value;\n499:       } else if (key === \"total_declared\") {\n500:         this.currentInvoice.total_declared = parseFloat(value) || 0;\n501:       } else if (key.startsWith(\"item_rate_\") && itemIndex !== null) {\n502:         if (this.currentInvoice.items[itemIndex]) {\n503:           const rateVal = parseFloat(value) || 0;\n504:           this.currentInvoice.items[itemIndex].rate = rateVal;\n505:           this.currentInvoice.items[itemIndex].is_blurry = false;\n506:           this.currentInvoice.items[itemIndex].amount = round2(this.currentInvoice.items[itemIndex].qty * rateVal);\n507:         }\n508:       } else if (key.startsWith(\"item_qty_\") && itemIndex !== null) {\n509:         if (this.currentInvoice.items[itemIndex]) {\n510:           const qtyVal = parseFloat(value) || 1;\n511:           this.currentInvoice.items[itemIndex].qty = qtyVal;\n512:           this.currentInvoice.items[itemIndex].amount = round2(qtyVal * this.currentInvoice.items[itemIndex].rate);\n513:         }\n514:       }\n515:     });\n516: \n517:     this.currentInvoice.inputs_validated = true;\n518:     this.recomputeEverything();\n519:     this.showToast(\"Valid inputs confirmed! Calculations completed.\", \"success\");\n520:   }\n521: \n522:   recomputeEverything() {\n523:     // 1. Audit invoice strictly in code\n524:     this.currentAudit = auditInvoice(this.currentInvoice);\n525: \n526:     // 2. Recompute tax metrics strictly in code\n527:     const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n528:     \n529:     // Retain current AI suggestions text while updating dynamic numbers\n530:     const prevAi = this.taxData ? this.taxData.ai_suggestions : null;\n531:     const ai_suggestions = prevAi || {\n532:       suggestions: [\n533:         \"Recommended ITR Form: File ITR-4 Sugam under Sec 44AD presumptive scheme.\",\n534:         this.currentAudit.gstinValid ? \"GST ITC: 100% eligible Input Tax Credit.\" : \"GST ITC: Warning - missing GSTIN.\",\n535:         \"Advance Tax: Pay by March 15 to prevent interest.\"\n536:       ],\n537:       disclaimer: \"Not tax advice; verify with your CA.\",\n538:       isAiGenerated: false\n539:     };\n540: \n541:     this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n542:     this.render();\n543:   }\n544: \n545:   async handleRefreshTaxAi() {\n546:     if (!this.taxData) return;\n547:     this.showToast(\"Invoking Gemini 2.5 Flash for tax preparation suggestions...\", \"info\");\n548:     \n549:     const { audit_summary, calculated_tax } = this.taxData;\n550:     const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);"}
