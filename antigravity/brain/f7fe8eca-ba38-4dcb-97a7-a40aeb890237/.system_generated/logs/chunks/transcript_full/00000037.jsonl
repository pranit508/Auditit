lculated tax & deemed profit under Sec 44AD\n379:       const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n380:       const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n381:       this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n382: \n383:       this.activeTab = \"audit\";\n384:     this.activeReviewTab = \"audit\";\n385:     this.currentView = \"review\";\n386:       this.hideProcessingOverlay();\n387:       this.render();\n388:       window.scrollTo({ top: 0, behavior: \"smooth\" });\n389: \n390:       this.showToast(\"Invoice analyzed by Gemini 2.5 Flash successfully!\", \"success\");\n391:     } catch (err) {\n392:       this.hideProcessingOverlay();\n393:       this.showToast(\"Could not process invoice: \" + err.message, \"error\");\n394:     }\n395:   }\n396: \n397:   handleUpdateItem(index, action, value) {\n398:     if (!this.currentInvoice || !this.currentInvoice.items[index]) return;\n399: \n400:     const item = this.currentInvoice.items[index];"}
