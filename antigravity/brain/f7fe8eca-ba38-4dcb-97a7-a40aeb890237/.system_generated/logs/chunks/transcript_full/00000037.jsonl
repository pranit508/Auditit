IVE\", // \"PRESUMPTIVE\" | \"REGULAR\"\n36:       annualRevenue: 3600000,\n37:       annualTurnover: 3600000,\n38:       cogs: 2500000,\n39:       operatingExpenses: 300000,\n40:       digitalRatio: 0.60,\n41:       digitalPercent: 60,\n42:       cashPercent: 40,\n43:       digitalProfitRate: 6,\n44:       cashProfitRate: 8,\n45:       sec80c: 150000,\n46:       sec80d: 25000,\n47:       otherDeductionsOld: 50000,\n48:       newRegimeStdDeduction: 75000,\n49:       isBusinessResale: true,\n50:       grossOutputGst: 50000\n51:     };\n52:     this.isProcessing = false;\n53:     const defaultKey = \"AQ.Ab8RN6LhTNa6kIQRpd_OijgrXNfmwLOw7rcxiMN8aWW-_U7mPw\";\n54:     this.apiKey = localStorage.getItem(\"audit_it_gemini_api_key\") || defaultKey;\n55:     if (!localStorage.getItem(\"audit_it_gemini_api_key\")) {\n56:       try { localStorage.setItem(\"audit_it_gemini_api_key\", defaultKey); } catch (_) {}\n57:     }\n58: \n59:     this.mainMount = document.getElementById(\"app-main\");\n60:     this.modalMount = document.getElementById(\"modal-container\");\n61:     this.toastMount = document.getElementById(\"toast-container\");\n62: \n63:     this.init();\n64:   }\n65: \n66:   init() {\n67:     this.render();\n68:   }\n69: \n70:   render() {\n71:     // Save active element focus and selection\n72:     const activeEl = document.activeElement;\n73:     let focusInfo = null;\n74:     if (activeEl && (activeEl.tagName === \"INPUT\" || activeEl.tagName === \"TEXTAREA\")) {\n75:       focusInfo = {\n76:         id: activeEl.id,\n77:         action: activeEl.getAttribute(\"data-action\"),\n78:         index: activeEl.getAttribute(\"data-index\"),\n79:         selectionStart: activeEl.selectionStart,\n80:         selectionEnd: activeEl.selectionEnd\n81:       };\n82:     }\n83: \n84:     if (this.currentView === \"dashboard\") {\n85:       renderDashboardHero(this.mainMount, {\n86:         hasApiKey: !!this.apiKey,\n87:         onSelectSample: (sampleKey) => this.loadSample(sampleKey),\n88:         onFileUpload: (file) => this.handleFileUpload(file),\n89:         onCreateManualBill: () => this.createManualBill(),\n90:         onOpenApiKeyModal: () => this.openApiKeyModal()\n91:       });\n92:     } else if (this.currentView === \"review\") {\n93:       this.mainMount.innerHTML = `\n94:         <div id=\"review-main-wrapper\" class=\"w-full\">\n95:           <!-- TOP NAVIGATION SWITCHER BAR -->\n96:           <div class=\"flex items-center gap-2 border-b border-slate-200 px-4 sm:px-6 pt-3 bg-white sticky top-16 z-30 shadow-sm\">\n97:             <button\n98:               type=\"button\"\n99:               id=\"top-nav-tab-audit\"\n100:               class=\"pb-3 px-4 text-sm font-semibold flex items-center gap-2 border-b-2 transition-colors ${"}
