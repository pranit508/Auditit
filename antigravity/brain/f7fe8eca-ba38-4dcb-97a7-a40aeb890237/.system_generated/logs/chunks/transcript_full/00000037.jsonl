.showToast(\"Gemini key cleared; local mode active\", \"info\");\n593:       }\n594:       this.modalMount.innerHTML = \"\";\n595:       this.render();\n596:     }, () => {\n597:       this.modalMount.innerHTML = \"\";\n598:     });\n599:   }\n600: \n601:   goToDashboard() {\n602:     this.currentView = \"dashboard\";\n603:     this.activeTab = \"audit\";\n604:     this.activeReviewTab = \"audit\";\n605:     this.render();\n606:     window.scrollTo({ top: 0, behavior: \"smooth\" });\n607:   }\n608: \n609:   setActiveTab(tab) {\n610:     this.activeTab = tab;\n611:     this.activeReviewTab = tab;\n612:     this.render();\n613:   }\n614: \n615:   showProcessingOverlay(fileName) {\n616:     this.modalMount.innerHTML = `\n617:       <div class=\"fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4\">\n618:         <div class=\"bg-white rounded-2xl p-6 sm:p-8 max-w-sm w-full text-center shadow-2xl\">\n619:           <div class=\"w-16 h-16 mx-auto mb-4 relative flex items-center justify-center\">\n620:             <div class=\"absolute inset-0 rounded-full border-4 border-slate-200 border-t-emerald-600 animate-spin\"></div>\n621:             <span class=\"text-xl\">🔍</span>\n622:           </div>\n623:           <h3 class=\"text-base font-bold text-slate-900\">Auditing Invoice</h3>\n624:           <p class=\"text-xs text-slate-500 mt-1 font-mono truncate\">${fileName}</p>\n625:           <div id=\"upload-progress-text\" class=\"mt-2 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200\">\n626:             Scanning document & reading text...\n627:           </div>\n628:           \n629:           <div class=\"mt-4 space-y-2 text-left bg-slate-50 p-3 rounded-lg border border-slate-200 text-[11px] text-slate-600\">\n630:             <div class=\"flex items-center space-x-2\">\n631:               <span class=\"text-emerald-600 font-bold\">✓</span>\n632:               <span>Masking bank accounts & phone numbers</span>\n633:             </div>\n634:             <div class=\"flex items-center space-x-2\">\n635:               <span class=\"text-emerald-600 font-bold\">✓</span>\n636:               <span>Extracting vendor & GSTIN details</span>\n637:             </div>\n638:             <div class=\"flex items-center space-x-2 text-emerald-800 font-semibold\">\n639:               <span class=\"animate-pulse\">●</span>\n640:               <span>Code recalculating Qty × Rate and GST</span>\n641:             </div>\n642:           </div>\n643:         </div>\n644:       </div>\n645:     `;\n646:   }\n647: \n648:   hideProcessingOverlay() {\n649:     this.modalMount.innerHTML = \"\";\n650:   }\n651: \n652:   showToast(message, type = \"info\") {\n653:     const toast = document.createElement(\"div\");\n654:     const bgClass = type === \"success\" \n655:       ? \"bg-emerald-700 text-white\" \n656:       : type === \"error\" \n657:       ? \"bg-rose-700 text-white\" \n658:       : \"bg-slate-900 text-white\";\n659: \n660:     toast.className = `transform transition-all duration-300 ease-out translate-y-2 opacity-0 pointer-events-auto px-4 py-2.5 rounded-xl shadow-lg text-xs font-semibold flex items-center space-x-2 ${bgClass}`;\n661:     toast.innerHTML = `\n662:       <span>${type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ'}</span>\n663:       <span>${message}</span>\n664:     `;\n665: \n666:     this.toastMount.appendChild(toast);\n667: \n668:     requestAnimationFrame(() => {\n669:       toast.classList.remove(\"translate-y-2\", \"opacity-0\");\n670:     });\n671: \n672:     setTimeout(() => {\n673:       toast.classList.add(\"translate-y-2\", \"opacity-0\");\n674:       setTimeout(() => toast.remove(), 300);\n675:     }, 3200);\n676:   }\n677: }\n678: \n679: // Bootstrap app on DOMContentLoaded\n680: document.addEventListener(\"DOMContentLoaded\", () => {\n681:   new AuditItApp();\n682: });"}
