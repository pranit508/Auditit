42:     }\n343:   }\n344: \n345:   // Clean extracted items to purge any metadata/GSTIN/phone lines\n346:   const itemsToUse = cleanExtractedItems(items);\n347: \n348:   // 1. SUB-TOTAL CALCULATION:\n349:   // Do not trust random OCR numbers near the bank details for Subtotal.\n350:   // Calculate the Subtotal deterministically from the extracted items:\n351:   // subtotal = sum(item.quantity * item.unit_rate for item in items)\n352:   // For this bill: 2535 + 1270 = 3805.00.\n353:   const calculatedItemsSum = round2(itemsToUse.reduce((acc, it) => acc + ((it.quantity || it.qty || 1) * (it.unit_rate || it.rate || 0)), 0));\n354:   if (calculatedItemsSum > 0) {\n355:     subtotal = calculatedItemsSum;\n356:   }\n357: \n358:   // 2. GRAND TOTAL SANITY CHECK:\n359:   // Grand Total must be approximately (Subtotal + Total Tax).\n360:   // If the OCR extracted '774' or '585132', reject them because they are bank/account/IFSC digits.\n361:   const expectedTotal = round2(subtotal + cgst + sgst + igst);\n362:   let isDeclaredSuspicious = false;\n363:   if (expectedTotal > 0) {\n364:     if (!total_declared || total_declared <= 0) {\n365:       isDeclaredSuspicious = true;\n366:     } else if (total_declared < (expectedTotal * 0.70) || total_declared > (expectedTotal * 1.50)) {\n367:       isDeclaredSuspicious = true;\n368:     }\n369:   }\n370: \n371:   if (total_declared === 774 || (subtotal > 0 && total_declared < (subtotal * 0.5))) {\n372:     isDeclaredSuspicious = true;\n373:   }\n374: \n375:   if (word_grand_total && word_grand_total > 0) {\n376:     total_declared = word_grand_total;\n377:   } else if (isDeclaredSuspicious && expectedTotal > 0) {\n378:     total_declared = Math.round(expectedTotal * 100) / 100;\n379:   }\n380: \n381:   // Bank details extraction if present\n382:   let bank_name = null;\n383:   let account_number = null;\n384:   let ifsc = null;\n385: \n386:   for (const line of lines) {\n387:     const bankMatch = line.match(/\\b(SBI|HDFC|ICICI|PNB|Axis|Bank of Baroda|Canara|Kotak)[\\w\\s]*\\b/i);\n388:     if (bankMatch && !bank_name) bank_name = bankMatch[0].trim();\n389: \n390:     const ifscMatch = line.match(/\\b[A-Z]{4}0[A-Z0-9]{6}\\b/i);\n391:     if (ifscMatch && !ifsc) ifsc = ifscMatch[0].toUpperCase();\n392: \n393:     const acMatch = line.match(/(?:a\\/c|account)[\\s#.:\\-_]+(\\d{9,18})/i);\n394:     if (acMatch && !account_number) account_number = acMatch[1];\n395:   }\n396: \n397:   return {\n398:     unreadable_fields,\n399:     vendor_name,\n400:     vendor_address: \"Address from scanned bill\",\n401:     gstin,\n402:     invoice_no,\n403:     date: date || new Date().toISOString().split(\"T\")[0],\n404:     items: itemsToUse,\n405:     subtotal,\n406:     cgst,\n407:     sgst,\n408:     igst,\n409:     total_declared,\n410:     declared_total: total_declared,\n411:     bank_details: {\n412:       bank_name: bank_name || \"Bank on File\",\n413:       account_number: account_number || \"•••• •••• •••• 1024\",\n414:       ifsc: ifsc || \"SBIN••••••\"\n415:     },\n416:     raw_ocr_text: rawText\n417:   };\n418: }"}
{"step_index":1462,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T19:31:07Z","input_tokens":2161,"cache_read_tokens":216792,"output_tokens":4563,"thinking":"I'm thinking through how to approach this.\n\n\nInitial focus is on defining the zones for data extraction based on keywords and boundary lines within the text. The logic will involve identifying the table header, line items (products/services), and summary/tax details to extract specific information from each zone. Lines will be filtered and trimmed to prepare for parsing. The table header is the initial target for detection.\n\n\nHeader detection uses keyword matching with a fallback if the primary criteria aren't met. If no strong header is found, the index defaults to a reasonable line. Footer identification starts after the header, looking for footer keywords. If the footer is not found, it is assigned the end of the text.\n\nThe text is then divided into three zones: header, item, and summary. Header zone extracts header information. The item zone contains product details. Summary zone holds total and tax information.\n\n\nVendor name is extracted from the first header line, after cleaning and filtering. GSTIN, invoice number, and date are extracted from the header lines; however, if these aren't found, they may be searched for in the whole text, but never extracted as an item. Only lines strictly within item lines are considered for the item zone, and lines without a valid product name and positive rate/amount are discarded.\n\n\nFor item lines, the strategy is right-to-left parsing of tokens. Commas will be treated strictly as thousand separators and removed from numbers. The last three numeric tokens are identified as billed amount, unit rate, and quantity, respectively. An optional fourth numeric token is considered the HSN/SAC code. The remaining text is treated as the description. A validation step will ensure the billed amount is within a 5% margin of the product of quantity and unit rate, to ensure data integrity.\n\n\nThe right-to-left parsing approach correctly identifies numeric tokens, avoiding misidentification of numbers within descriptions as quantity or rate. A regular expression captures Indian numeric formats, including currency symbols and commas. This enables parsing of the billed amount, unit rate, and quantity from the last three numeric tokens, with an optional fourth token representing the HSN/SAC code. The process also includes a validation step to ensure the integrity of the extracted data by confirming that the product of the quantity and unit rate is within a 5% margin of the billed amount.\n\n\nInitial parsing focused on a right-to-left approach to identify quantity, rate, and amount within item lines. Revised the logic to handle missing HSN codes and quantity with a math cross-check for data integrity. The revised approach validates the extracted numeric values, especially where quantity might be omitted, using a 5% margin check for the billed amount. Description extraction now handles leading \"S.No\" markers and trailing unit abbreviations to get a clean product description.\n\n\nConsidering how to handle data validation where the calculated amount deviates significantly. The current check discards lines exceeding a 5% margin, but must address cases where quantity and rate columns are swapped. If the rate and amount are equal, and the quantity is either 1 or 2, a column swap is assumed and corrected by setting quantity to 1 and the rate to the amount, ensuring the validation passes.\n\nFurther, there is description validation. The description must have at least three characters, including at least three or four letters. Additionally, the description must not include metadata such as PAN, GSTIN, account numbers, bank details, or state/city names. Only validated items will then be included in the output. The primary extraction logic needs to be shifted to a multimodal vision model for direct visual layout understanding.\n\n\nThe JSON schema provides the structure for the extracted data. Checking against the existing data model, it appears that `unit_rate` is a float, which is correct. The schema will be used to structure the output and guide data extraction. Post-processing will address inconsistencies in the data. Declared totals must match and synchronization of property names will ensure data consistency.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"grep -rn \"def parse\" /Users/pranit405/.gemini/antigravity/scratch/audit-it/","WaitMsBeforeAsync":5000,"toolSummary":"Search for parse functions"}}]}
