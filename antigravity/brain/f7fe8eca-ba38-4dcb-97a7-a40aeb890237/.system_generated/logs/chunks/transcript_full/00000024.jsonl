:           parsed.total_declared = parsed.declared_total;\n105:         }\n106: \n107:         // Apply sanitizeAndCleanInvoice and item cleaning\n108:         const cleaned = sanitizeAndCleanInvoice(parsed);\n109:         if (cleaned.items && Array.isArray(cleaned.items)) {\n110:           cleaned.items = cleanExtractedItems(cleaned.items);\n111:         }\n112: \n113:         // If declared_total is suspiciously smaller than subtotal, reject the OCR hallucination:\n114:         if (Number(cleaned.subtotal || 0) > 0 && Number(cleaned.declared_total || 0) < (Number(cleaned.subtotal || 0) * 0.5)) {\n115:           const fallbackTotal = Math.round((Number(cleaned.subtotal || 0) + Number(cleaned.cgst || 0) + Number(cleaned.sgst || 0) + Number(cleaned.igst || 0)) * 100) / 100;\n116:           cleaned.declared_total = fallbackTotal;\n117:           cleaned.total_declared = fallbackTotal;\n118:         }\n119: \n120:         return sanitizeInvoiceData(cleaned);\n121:       }\n122:     } else {\n123:       const errData = await backendResp.json().catch(() => ({}));\n124:       console.warn(\"FastAPI backend returned:\", backendResp.status, errData);\n125:     }\n126:   } catch (backendErr) {\n127:     console.warn(\"FastAPI /api/analyze-bill unreachable; falling back:\", backendErr);\n128:   }\n129: \n130:   const base64Data = await fileToBase64(file);\n131: \n132:   // 2. Direct client-side Gemini Multimodal API fallback (if key configured)\n133:   if (effectiveKey && effectiveKey.trim().length > 10) {\n134:     if (onProgress) onProgress(\"Sending bill to Gemini Multimodal AI...\");\n135:     try {\n136:       const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${effectiveKey.trim()}`;\n137: \n138:       const payload = {\n139:         contents: [\n140:           {\n141:             parts: [\n142:               { text: GEMINI_SYSTEM_INSTRUCTION },\n143:               {\n144:                 inline_data: {\n145:                   mime_type: mimeType,\n146:                   data: base64Data.split(\",\")[1]\n147:                 }\n148:               }\n149:             ]\n150:           }\n151:         ],\n152:         generationConfig: {\n153:           response_mime_type: \"application/json\"\n154:         }\n155:       };\n156: \n157:       const response = await fetch(url, {\n158:         method: \"POST\",\n159:         headers: { \"Content-Type\": \"application/json\" },\n160:         body: JSON.stringify(payload)"}
