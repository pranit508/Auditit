, f'Status {resp2.status_code}: {resp2.text}'\n    data2 = resp2.json()\n    print('Resp 2 (AIzaSy via x-api-key):', data2['vendor_name'], data2['declared_total'])\n    assert data2['declared_total'] == 590.0\n    mock_rest.assert_called_with('AIzaSyGoogleApiKey123', 'image/jpeg', b'fake invoice image bytes 2', mock_rest.call_args[0][3])\n\nprint('API ENDPOINT TESTS PASSED!')\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Test analyze-bill endpoint with Bearer AQ. and x-api-key AIzaSy"}}]}
