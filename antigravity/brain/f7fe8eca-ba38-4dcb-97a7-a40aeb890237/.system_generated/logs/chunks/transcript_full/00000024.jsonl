{"step_index":1459,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T19:30:59Z","content":"Created At: 2026-11-03T01:00:59+05:30\nCompleted At: 2026-11-03T01:00:59+05:30\nShowing lines 151-300 of 418\n151:     const line = lines[i];\n152:     // Ignore generic headers like \"TAX INVOICE\", \"ORIGINAL FOR RECIPIENT\"\n153:     if (!/tax invoice|original|duplicate|retail invoice|cash memo/i.test(line) && line.length > 3) {\n154:       vendor_name = line;\n155:       break;\n156:     }\n157:   }\n158:   if (vendor_name) {\n159:     // RULE 1: Never include phone numbers, email addresses, or 'Phone: ...' in supplier_name\n160:     vendor_name = vendor_name.replace(/(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+/gi, \"\").trim();\n161:   }\n162:   if (!vendor_name || vendor_name.length < 2) {\n163:     vendor_name = sourceFileName.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \") + \" (Extracted)\";\n164:   }\n165: \n166:   // 6. Extract Line Items from table rows\n167:   const items = [];\n168:   \n169:   // Use regex pattern to capture Indian currency figures with commas: (?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)\n170:   const CURRENCY_FIGURE_REGEX = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n171: \n172:   for (let i = 0; i < lines.length; i++) {\n173:     const line = lines[i];\n174: \n175:     // Skip header lines\n176:     if (/item\\s+desc|description|particulars|qty|rate|amount|hsn/i.test(line) && /rate|amount/i.test(line)) {\n177:       continue;\n178:     }\n179:     // Skip summary lines\n180:     if (/subtotal|sub\\s+total|cgst|sgst|igst|grand\\s+total|round\\s+off|total in words|amount in words/i.test(line)) {\n181:       continue;\n182:     }\n183: \n184:     // Capture all figures matching the Indian currency regex without splitting on commas\n185:     const figures = [];\n186:     let match;\n187:     const regexClone = new RegExp(CURRENCY_FIGURE_REGEX.source, 'g');\n188:     while ((match = regexClone.exec(line)) !== null) {\n189:       if (match[1]) {\n190:         figures.push({\n191:           raw: match[1],\n192:           value: parseIndianCurrency(match[1]),\n193:           index: match.index,\n194:           length: match[0].length\n195:         });\n196:       }\n197:     }\n198: \n199:     if (figures.length >= 2) {\n200:       // Last figure is Billed Amount\n201:       const amountFig = figures[figures.length - 1];\n202:       // Second to last is Unit Rate\n203:       const rateFig = figures[figures.length - 2];\n204:       \n205:       let qty = 1.0;\n206:       let textEndIndex = rateFig.index;\n207: \n208:       if (figures.length >= 3) {\n209:         const potentialQty = figures[figures.length - 3];\n210:         // If it is an integer <= 1000 and situated right before rate\n211:         if (potentialQty.value > 0 && potentialQty.value <= 1000 && Number.isInteger(potentialQty.value)) {\n212:           qty = potentialQty.value;\n213:           textEndIndex = potentialQty.index;\n214:         }\n215:       }\n216: \n217:       // First figure might be S.No (e.g., '1' or '2' at start of line)\n218:       let textStartIndex = 0;\n219:       if (figures.length >= 3 && figures[0].index === 0 && figures[0].value <= 100) {\n220:         textStartIndex = figures[0].length;\n221:       }\n222: \n223:       // Extract description\n224:       let desc = line.slice(textStartIndex, textEndIndex)\n225:         .replace(/^[\\[\\|\\]\\(\\)\\s\\.\\-]+|[\\[\\|\\]\\(\\)\\s\\.\\-]+$/g, '')\n226:         .replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, '')\n227:         .trim();\n228: \n229:       const rate = rateFig.value;\n230:       const amount = amountFig.value > 0 ? amountFig.value : round2(qty * rate);\n231: \n232:       // Verify description and amount sanity\n233:       if (desc.length >= 3 && amount > 0 && (desc.match(/[a-zA-Z]/g) || []).length >= 4) {\n234:         // Skip metadata/forbidden lines: PAN, Acc. Number, Account, Bank, IFSC, Maharashtra, Mumbai, Delhi, Haryana\n235:         if (!/gstin|\\bpan\\b|acc\\.?\\s*(?:number|no)|account|bank|ifsc|maharashtra|mumbai|delhi|haryana|authorised|signature|terms|condition|e-way/i.test(desc)) {\n236:           items.push({\n237:             id: `item-${items.length + 1}`,\n238:             description: desc,\n239:             hsn: \"\",\n240:             qty: qty,\n241:             rate: rate,\n242:             amount: amount,\n243:             is_blurry: false\n244:           });\n245:         }\n246:       }\n247:     }\n248:   }\n249: \n250:   // 7. Extract Totals (Grand Total, Subtotal, Taxes)\n251:   let total_declared = null;\n252:   let word_grand_total = null;\n253:   let subtotal = null;\n254:   let cgst = 0;\n255:   let sgst = 0;\n256:   let igst = 0;\n257: \n258:   for (const line of lines) {\n259:     const lower = line.toLowerCase();\n260: \n261:     // 1. Look for line 'Total in words ... FOUR THOUSAND FOUR HUNDRED AND NINETY'\n262:     if (/(?:total|amount|rupees)\\s+(?:in\\s+words|in\\s+word)/i.test(line) || /rupees\\s+[a-z\\s]+only/i.test(line)) {\n263:       const parsedWordTotal = parseWordsToNumber(line);\n264:       if (parsedWordTotal > 0) {\n265:         word_grand_total = parsedWordTotal;\n266:       }\n267:     }\n268: \n269:     // 2. Subtotal: '3,805.00' must parse to 3805.0\n270:     if (/(?:sub\\s*total|taxable\\s+value|gross\\s+amount)/i.test(line)) {\n271:       const nums = [];\n272:       let m;\n273:       const r = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n274:       while ((m = r.exec(line)) !== null) {\n275:         if (m[1]) nums.push(parseIndianCurrency(m[1]));\n276:       }\n277:       if (nums.length > 0) {\n278:         subtotal = nums[nums.length - 1];\n279:       }\n280:     }\n281: \n282:     // 3. CGST\n283:     if (/cgst/i.test(line) && !/subtotal|total in words/i.test(line)) {\n284:       const nums = [];\n285:       let m;\n286:       const r = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n287:       while ((m = r.exec(line)) !== null) {\n288:         if (m[1]) nums.push(parseIndianCurrency(m[1]));\n289:       }\n290:       if (nums.length > 0) {\n291:         cgst = nums[nums.length - 1];\n292:       }\n293:     }\n294: \n295:     // 4. SGST\n296:     if (/sgst/i.test(line) && !/subtotal|total in words/i.test(line)) {\n297:       const nums = [];\n298:       let m;\n299:       const r = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n300:       while ((m = r.exec(line)) !== null) {"}
