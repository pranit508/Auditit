voice.total_declared : extractedInvoice.declared_total) || 0;\n223:       if (expTotal > 0 && (decTotal === 774 || (subtot > 0 && decTotal < (subtot * 0.5)))) {\n224:         decTotal = expTotal;\n225:         extractedInvoice.total_declared = decTotal;\n226:         extractedInvoice.declared_total = decTotal;\n227:       }\n228: \n229:       this.currentInvoice = extractedInvoice;\n230:       this.currentAudit = auditInvoice(this.currentInvoice);\n231: \n232:       // Compute code-calculated tax & deemed profit under Sec 44AD\n233:       const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n234:       const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n235:       this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n236: \n237:       this.currentView = \"review\";\n238:       this.hideProcessingOverlay();\n239:       this.render();\n240:       window.scrollTo({ top: 0, behavior: \"smooth\" });\n241: \n242:       this.showToast(\"Invoice analyzed by Gemini 2.5 Flash successfully!\", \"success\");\n243:     } catch (err) {\n244:       this.hideProcessingOverlay();\n245:       this.showToast(\"Could not process invoice: \" + err.message, \"error\");\n246:     }\n247:   }\n248: \n249:   handleUpdateItem(index, action, value) {\n250:     if (!this.currentInvoice || !this.currentInvoice.items[index]) return;"}
