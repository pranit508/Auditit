{"step_index":1554,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T19:38:54Z","input_tokens":2415,"cache_read_tokens":71671,"output_tokens":1463,"tool_calls":[{"name":"run_command","args":{"CommandLine":"cd /Users/pranit405/.gemini/antigravity/scratch/audit-it && ./venv/bin/python3 -c '\nimport asyncio\nfrom unittest.mock import AsyncMock, patch, MagicMock\nfrom fastapi.testclient import TestClient\nfrom server import app, ExtractedInvoice, InvoiceItem\n\nclient = TestClient(app)\n\n# 1. Test Pydantic ExtractedInvoice with numbers and strings\ninv1 = ExtractedInvoice(\n    vendor_name=\"Test Store\",\n    gstin=\"07AAAAA0000A1Z5\",\n    invoice_number=\"INV-101\",\n    items=[\n        InvoiceItem(description=\"Item A\", quantity=10, unit_rate=120.5, total_amount=1205.0),\n        InvoiceItem(description=\"Item B\", quantity=\"2\", unit_rate=\"2,535.00\", total_amount=\"5,070.00\")\n    ],\n    subtotal=\"6,275.00\",\n    cgst=564.75,\n    sgst=564.75,\n    declared_total=\"7,404.50\"\n)\nprint(\"1. Pydantic validation successful:\", len(inv1.items), \"items\")\n\n# 2. Test /api/process-invoice with 774 and 20 hallucination\nres_774 = client.post(\"/api/process-invoice\", json={\n    \"items\": [\n        {\"description\": \"Bosch Hand Tool Kit\", \"quantity\": 1, \"unit_rate\": 2535.0, \"total_amount\": 2535.0},\n        {\"description\": \"Taparia Tool Kit\", \"quantity\": 1, \"unit_rate\": 1270.0, \"total_amount\": 1270.0}\n    ],\n    \"subtotal\": 3805.0,\n    \"igst\": 684.9,\n    \"declared_total\": 774.0\n})\nassert res_774.status_code == 200, f\"Error: {res_774.text}\"\ndata_774 = res_774.json()[\"extracted_data\"]\nprint(\"2. 774 Reconciled declared_total:\", data_774[\"declared_total\"], \"total_declared:\", data_774[\"total_declared\"])\nassert data_774[\"declared_total\"] == 4489.9, f\"Expected 4489.9, got {data_774[\\\"declared_total\\\"]}\"\nassert data_774[\"declared_total\"] == data_774[\"total_declared\"]\n\n# 3. Test /api/process-invoice with suspiciously small total (<50% of subtotal)\nres_small = client.post(\"/api/process-invoice\", json={\n    \"items\": [\n        {\"description\": \"Industrial Motor\", \"quantity\": 1, \"unit_rate\": 10000.0, \"total_amount\": 10000.0}\n    ],\n    \"subtotal\": 10000.0,\n    \"cgst\": 900.0,\n    \"sgst\": 900.0,\n    \"declared_total\": 20.0\n})\ndata_small = res_small.json()[\"extracted_data\"]\nprint(\"3. Suspiciously small total Reconciled declared_total:\", data_small[\"declared_total\"])\nassert data_small[\"declared_total\"] == 11800.0, f\"Expected 11800.0, got {data_small[\\\"declared_total\\\"]}\"\nassert data_small[\"declared_total\"] == data_small[\"total_declared\"]\n\n# 4. Test Header Authorization Bearer AQ. vs x-goog-api-key dispatch in server\nfrom server import call_gemini_rest\n\nasync def test_bearer():\n    with patch(\"httpx.AsyncClient.post\") as mock_post:\n        mock_resp = MagicMock()\n        mock_resp.status_code = 200\n        mock_resp.json = lambda: {\n            \"candidates\": [{\"content\": {\"parts\": [{\"text\": \"{\\\"vendor_name\\\": \\\"Acme\\\", \\\"items\\\": [], \\\"subtotal\\\": 100.0, \\\"declared_total\\\": 100.0}\"}]}}]\n        }\n        mock_post.return_value = mock_resp\n\n        # Test AQ token\n        res_aq = await call_gemini_rest(\"AQ.dummy_token\", \"image/jpeg\", b\"dummy_bytes\", \"prompt\")\n        call_headers = mock_post.call_args[1][\"headers\"]\n        assert \"Authorization\" in call_headers\n        assert call_headers[\"Authorization\"] == \"Bearer AQ.dummy_token\"\n        assert \"x-goog-api-key\" not in call_headers\n        print(\"4a. Bearer token dispatch verified!\")\n\n        # Test AIzaSy key\n        res_aiza = await call_gemini_rest(\"AIzaSy_dummy_key\", \"image/jpeg\", b\"dummy_bytes\", \"prompt\")\n        call_headers_aiza = mock_post.call_args[1][\"headers\"]\n        assert \"x-goog-api-key\" in call_headers_aiza\n        assert call_headers_aiza[\"x-goog-api-key\"] == \"AIzaSy_dummy_key\"\n        assert \"Authorization\" not in call_headers_aiza\n        print(\"4b. AIzaSy key dispatch verified!\")\n\nasyncio.run(test_bearer())\nprint(\"\\n🎉 ALL PYTHON SERVER & AUDIT TESTS PASSED SUCCESSFULLY!\")\n'","WaitMsBeforeAsync":8000,"toolSummary":"Run Python server verification tests"}}]}
