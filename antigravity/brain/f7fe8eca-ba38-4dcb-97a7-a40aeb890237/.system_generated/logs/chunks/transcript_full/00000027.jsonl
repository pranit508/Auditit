/process-invoice with suspiciously small total (<50% of subtotal)\nres_small = client.post(\"/api/process-invoice\", json={\n    \"items\": [\n        {\"description\": \"Industrial Motor\", \"quantity\": 1, \"unit_rate\": 10000.0, \"total_amount\": 10000.0}\n    ],\n    \"subtotal\": 10000.0,\n    \"cgst\": 900.0,\n    \"sgst\": 900.0,\n    \"declared_total\": 20.0\n})\ndata_small = res_small.json()[\"extracted_data\"]\nprint(\"3. Suspiciously small total Reconciled declared_total:\", data_small[\"declared_total\"])\nassert data_small[\"declared_total\"] == 11800.0, \"Expected 11800.0, got \" + str(data_small[\"declared_total\"])\nassert data_small[\"declared_total\"] == data_small[\"total_declared\"]\n\n# 4. Test Header Authorization Bearer AQ. vs x-goog-api-key dispatch in server\nfrom server import call_gemini_rest\n\nasync def test_bearer():\n    with patch(\"httpx.AsyncClient.post\") as mock_post:\n        mock_resp = MagicMock()\n        mock_resp.status_code = 200\n        mock_resp.json = lambda: {\n            \"candidates\": [{\"content\": {\"parts\": [{\"text\": \"{\\\"vendor_name\\\": \\\"Acme\\\", \\\"items\\\": [], \\\"subtotal\\\": 100.0, \\\"declared_total\\\": 100.0}\"}]}}]\n        }\n        mock_post.return_value = mock_resp\n\n        # Test AQ token\n        res_aq = await call_gemini_rest(\"AQ.dummy_token\", \"image/jpeg\", b\"dummy_bytes\", \"prompt\")\n        call_headers = mock_post.call_args[1][\"headers\"]\n        assert \"Authorization\" in call_headers\n        assert call_headers[\"Authorization\"] == \"Bearer AQ.dummy_token\"\n        assert \"x-goog-api-key\" not in call_headers\n        print(\"4a. Bearer token dispatch verified!\")\n\n        # Test AIzaSy key\n        res_aiza = await call_gemini_rest(\"AIzaSy_dummy_key\", \"image/jpeg\", b\"dummy_bytes\", \"prompt\")\n        call_headers_aiza = mock_post.call_args[1][\"headers\"]\n        assert \"x-goog-api-key\" in call_headers_aiza\n        assert call_headers_aiza[\"x-goog-api-key\"] == \"AIzaSy_dummy_key\"\n        assert \"Authorization\" not in call_headers_aiza\n        print(\"4b. AIzaSy key dispatch verified!\")\n\nasyncio.run(test_bearer())\nprint(\"\\n🎉 ALL PYTHON SERVER & AUDIT TESTS PASSED SUCCESSFULLY!\")\n'","WaitMsBeforeAsync":8000,"toolSummary":"Run Python server verification tests"}}]}
