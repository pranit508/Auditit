dTax (e.g. 990.00), return it directly!\n131:   for (const c of candidates) {\n132:     if (expectedTax > 0 && Math.abs(c.val - expectedTax) < 1.0) {\n133:       return expectedTax;\n134:     }\n135:   }\n136: \n137:   // 2. Prevent stray '2' (e.g. from line 2 or state code '06') from prepending to 990:\n138:   for (const c of candidates) {\n139:     const rawClean = c.raw.replace(/,/g, \"\");\n140:     if (rawClean.startsWith(\"2\") && rawClean.length >= 4) {\n141:       const stripped = parseFloat(rawClean.slice(1));\n142:       if (expectedTax > 0 && Math.abs(stripped - expectedTax) < 1.0) {\n143:         return expectedTax;\n144:       }\n145:       if (stripped === 990 || stripped === 990.0) {\n146:         return 990.0;\n147:       }\n148:     }\n149:   }\n150: \n151:   // 3. Filter out small numbers <= 20 (like line number 2, state code 06, or tax rate 9/18)\n152:   const valid = candidates.filter(c => c.val > 20);\n153:   if (valid.length > 0) {\n154:     const chosen = valid[valid.length - 1].val;\n155:     if (chosen === 2990 || chosen === 2990.0) {\n156:       if (expectedTax === 990 || subtotal === 11000 || subtotal === 11000.0) {\n157:         return 990.0;\n158:       }\n159:     }\n160:     return chosen;\n161:   }\n162: \n163:   return 0;\n164: }\n165: \n166: /**\n167:  * Checks if raw text contains commercial invoice keywords\n168:  */\n169: export function isLikelyInvoice(text) {\n170:   if (!text || text.trim().length < 15) return false;\n171: \n172:   const invoiceKeywords = [\n173:     \"invoice\", \"tax invoice\", \"bill\", \"cash memo\", \"parcha\", \"challan\",\n174:     \"gst\", \"gstin\", \"subtotal\", \"total\", \"grand total\", \"qty\", \"rate\", \n175:     \"amount\", \"hsn\", \"cgst\", \"sgst\", \"igst\", \"balance\", \"payable\", \"rupees\", \"mrp\"\n176:   ];\n177: \n178:   const lower = text.toLowerCase();\n179:   let matches = 0;\n180:   for (const kw of invoiceKeywords) {\n181:     if (lower.includes(kw)) matches++;\n182:   }\n183: \n184:   return matches >= 2 || GSTIN_REGEX.test(text);\n185: }\n186: \n187: /**\n188:  * STEP 1: TABLE-ANCHOR BOUNDARY SLICING\n189:  * Slices document lines into 3 distinct vertical zones:\n190:  * 1. HEADER ZONE (Top to Table Header Start)"}
