iceTextStrict(billText);\n  console.log(\"Parsed subtotal:\", parsed.subtotal);\n  console.log(\"Parsed CGST:\", parsed.cgst);\n  console.log(\"Parsed SGST:\", parsed.sgst);\n  console.log(\"Parsed IGST:\", parsed.igst);\n  console.log(\"Parsed Total Declared:\", parsed.total_declared);\n\n  if (parsed.subtotal !== 11000) throw new Error(`Expected subtotal 11000, got ${parsed.subtotal}`);\n  if (parsed.cgst !== 990) throw new Error(`Expected cgst 990, got ${parsed.cgst}`);\n  if (parsed.sgst !== 990) throw new Error(`Expected sgst 990, got ${parsed.sgst}`);\n  if (parsed.igst !== 0) throw new Error(`Expected igst 0, got ${parsed.igst}`);\n  if (parsed.total_declared !== 12980) throw new Error(`Expected total_declared 12980, got ${parsed.total_declared}`);\n\n  console.log(\"\\nAll Node tests passed successfully!\");\n}).catch(e => {\n  console.error(\"Test failed:\", e);\n  process.exit(1);\n});\n'","WaitMsBeforeAsync":5000,"toolSummary":"Run Node JS parser verification tests"}}]}
