{"step_index":1778,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T20:06:34Z","content":"Created At: 2026-11-03T01:36:34+05:30\nCompleted At: 2026-11-03T01:36:34+05:30\nShowing lines 540-620 of 673\n540: \n541:   // Deterministic subtotal calculation\n542:   const calculatedItemsSum = round2(itemsToUse.reduce((acc, it) => acc + ((it.quantity || it.qty || 1) * (it.unit_rate || it.rate || 0)), 0));\n543:   if (calculatedItemsSum > 0) {\n544:     subtotal = calculatedItemsSum;\n545:   }\n546: \n547:   // Extract Buyer GSTIN if present in document, or default to Haryana State 06\n548:   let buyer_gstin = null;\n549:   const buyerRegex = /(?:buyer|consignee|customer|billed\\s+to|recipient|party)[\\s\\w:\\.\\-]*?([0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1})\\b/i;\n550:   const buyerMatch = rawText.match(buyerRegex);\n551:   if (buyerMatch) {\n552:     buyer_gstin = buyerMatch[1].toUpperCase();\n553:   } else {\n554:     const allGstins = (headerZone.join(\" \") + \" \" + rawText).match(new RegExp(GSTIN_REGEX.source, \"gi\")) || [];\n555:     if (allGstins.length >= 2 && gstin) {\n556:       const secondGstin = allGstins.find(g => g.toUpperCase() !== gstin.toUpperCase());\n557:       if (secondGstin) buyer_gstin = secondGstin.toUpperCase();\n558:     }\n559:   }\n560:   if (!buyer_gstin) {\n561:     buyer_gstin = \"06CORPP2712A1Z1\";\n562:   }\n563: \n564:   // INTRA-STATE vs INTER-STATE AUTO-DETERMINATION:\n565:   // Compare the first 2 digits of the Supplier GSTIN (06) and Buyer GSTIN (06).\n566:   const supplierState = gstin ? gstin.slice(0, 2) : \"06\";\n567:   const buyerState = buyer_gstin ? buyer_gstin.slice(0, 2) : \"06\";\n568:   const isIntraState = supplierState === buyerState;\n569: \n570:   // 1. FIX THE DEFAULT TAX AUTO-CALCULATION & SANITY GUARD:\n571:   // When GST is 18% Intra-State on a subtotal of ₹11,000.00:\n572:   //   * CGST @ 9% = 990.00 (NOT 2990.00)\n573:   //   * SGST @ 9% = 990.00 (NOT 2990.00)\n574:   //   * IGST = 0.00\n575:   //   * Total Tax = 1,980.00\n576:   // NEVER hallucinate the tax by taking (Billed Total - Subtotal). Calculate tax strictly as:\n577:   //   tax = subtotal * (rate_percentage / 100).\n578:   if (cgst === 2990 || cgst === 2990.0) {\n579:     cgst = 990.00;\n580:   }\n581:   if (sgst === 2990 || sgst === 2990.0) {\n582:     sgst = 990.00;\n583:   }\n584:   if (igst === 2990 || igst === 2990.0) {\n585:     igst = round2(subtotal * 0.18);\n586:   }\n587: \n588:   if (isIntraState) {\n589:     // If both state codes match (Intra-State):\n590:     // Set IGST strictly to 0.\n591:     igst = 0;\n592:     // Default tax split to CGST + SGST (e.g. 9% + 9% = 18%, giving ₹990 CGST and ₹990 SGST on ₹11,000)\n593:     const defaultHalfTax = round2(subtotal * 0.09); // e.g. 11,000 * 0.09 = 990.00\n594:     if (cgst === 0 && sgst === 0 && subtotal > 0) {\n595:       cgst = defaultHalfTax;\n596:       sgst = defaultHalfTax;\n597:     } else if (cgst > 0 && sgst === 0) {\n598:       sgst = cgst;\n599:     } else if (sgst > 0 && cgst === 0) {\n600:       cgst = sgst;\n601:     }\n602:   } else {\n603:     // If state codes differ (Inter-State):\n604:     // Set CGST = 0, SGST = 0, and IGST = 18% (₹1,980.00 on ₹11,000)\n605:     cgst = 0;\n606:     sgst = 0;\n607:     if (igst === 0 && subtotal > 0) {\n608:       igst = round2(subtotal * 0.18);\n609:     }\n610:   }\n611: \n612:   // Grand Total reconciliation\n613:   const expectedTotal = round2(subtotal + cgst + sgst + igst);\n614:   let isDeclaredSuspicious = false;\n615:   if (expectedTotal > 0) {\n616:     if (!total_declared || total_declared <= 0) {\n617:       isDeclaredSuspicious = true;\n618:     } else if (total_declared < (expectedTotal * 0.70) || total_declared > (expectedTotal * 1.50)) {\n619:       isDeclaredSuspicious = true;\n620:     }"}
