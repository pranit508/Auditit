toUpperCase();\n777:       const buyerGstin = (invoice.buyer_gstin || \"06CORPP2712A1Z1\").trim().toUpperCase();\n778:       const supplierState = supplierGstin ? supplierGstin.slice(0, 2) : \"06\";\n779:       const buyerState = buyerGstin ? buyerGstin.slice(0, 2) : \"06\";\n780:       const isIntraState = supplierState === buyerState;\n781: \n782:       let newCgst = 0;\n783:       let newSgst = 0;\n784:       let newIgst = 0;\n785: \n786:       if (isIntraState) {\n787:         // Intra-State: Set IGST strictly to 0, default split to CGST + SGST (e.g. 9% + 9% = 18%, ₹990 + ₹990 on ₹11,000)\n788:         newIgst = 0;\n789:         newCgst = round2(taxAmount / 2);\n790:         newSgst = round2(taxAmount / 2);\n791:       } else {\n792:         // Inter-State: Set CGST = 0, SGST = 0, and IGST = 18% (₹1,980.00 on ₹11,000)\n793:         newCgst = 0;\n794:         newSgst = 0;\n795:         newIgst = taxAmount;\n796:       }\n797: \n798:       // Update inputs immediately for instant sync\n799:       if (inputCgst) inputCgst.value = newCgst;\n800:       if (inputSgst) inputSgst.value = newSgst;\n801:       if (inputIgst) inputIgst.value = newIgst;\n802: \n803:       // Trigger re-audit immediately\n804:       if (onUpdateHeader) {\n805:         onUpdateHeader(\"gst_preset\", { cgst: newCgst, sgst: newSgst, igst: newIgst });\n806:       }\n807:     });\n808:   });\n809: \n810:   // Digital ratio slider\n811:   const sliderDigital = container.querySelector(\"#slider-digital-ratio\");\n812:   if (sliderDigital && onUpdateTaxSettings) {\n813:     sliderDigital.addEventListener(\"input\", (e) => {\n814:       const val = parseFloat(e.target.value) / 100;\n815:       onUpdateTaxSettings({ digitalRatio: val });"}
{"step_index":1762,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T20:05:29Z","input_tokens":3252,"cache_read_tokens":251469,"output_tokens":2249,"thinking":"The code snippet focuses on calculating a rate percentage based on a preset attribute and a subtotal. Specifically, it involves parsing a data attribute from a button, converting it to a floating-point number representing a percentage, and then using this percentage to recalculate a subtotal. Initial assessment suggests potential issues could arise if `btn.getAttribute(\"data-gst-preset\")` returns a value that cannot be parsed as a float, or if the subtotal calculation (`invoice.subtotal`, `invoice.calculated_subtotal`, `audit.sum_items`) yields unexpected results like NaN or non-numeric types. The final calculation is critical, so checking edge cases is key.\n\n\nThe code now factors in GSTIN (Goods and Services Tax Identification Number) and state codes to determine if a transaction is intra-state or inter-state, which dictates the tax distribution (CGST, SGST, IGST).  The logic calculates new tax components based on either a preset attribute or a rate percentage, using the `isIntraState` flag. The `onUpdateHeader` function updates the invoice's tax fields based on the selected GST preset.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/components/AuditScorecard.js","Replacement":"  // GST Presets: Click Handler Sync with Intra-State vs Inter-State Auto-Determination\n  container.querySelectorAll(\"[data-gst-preset]\").forEach(btn => {\n    btn.addEventListener(\"click\", () => {\n      const presetAttr = btn.getAttribute(\"data-gst-preset\");\n      const ratePct = parseFloat(presetAttr) / 100;\n      // Recalculate dynamically based on current Subtotal (e.g. 11,000)\n      const subtotal = round2(Number(invoice.subtotal) || Number(invoice.calculated_subtotal) || audit.sum_items || 0);\n\n      // Compare first 2 digits of Supplier GSTIN (06) and Buyer GSTIN (06)\n      const supplierGstin = (invoice.gstin || \"\").trim().toUpperCase();\n      const buyerGstin = (invoice.buyer_gstin || \"06CORPP2712A1Z1\").trim().toUpperCase();\n      const supplierState = supplierGstin ? supplierGstin.slice(0, 2) : \"06\";\n      const buyerState = buyerGstin ? buyerGstin.slice(0, 2) : \"06\";\n      const isIntraState = supplierState === buyerState;\n\n      let newCgst = 0;\n      let newSgst = 0;\n      let newIgst = 0;\n\n      if (presetAttr === \"18\" || ratePct === 0.18) {\n        if (isIntraState) {\n          // Clicking '[18% (Electrical)]' should immediately set:\n          // cgst = subtotal * 0.09;\n          // sgst = subtotal * 0.09;\n          // igst = 0;\n          newCgst = round2(subtotal * 0.09);\n          newSgst = round2(subtotal * 0.09);\n          newIgst = 0;\n        } else {\n          newCgst = 0;\n          newSgst = 0;\n          newIgst = round2(subtotal * 0.18);\n        }\n      } else {\n        const taxAmount = round2(subtotal * ratePct);\n        if (isIntraState) {\n          newIgst = 0;\n          newCgst = round2(taxAmount / 2);\n          newSgst = round2(taxAmount / 2);\n        } else {\n          newCgst = 0;\n          newSgst = 0;\n          newIgst = taxAmount;\n        }\n      }\n\n      // Update inputs immediately for instant sync\n      if (inputCgst) inputCgst.value = newCgst;\n      if (inputSgst) inputSgst.value = newSgst;\n      if (inputIgst) inputIgst.value = newIgst;\n\n      // Trigger re-audit immediately so Verified Total becomes 12,980.00\n      if (onUpdateHeader) {\n        onUpdateHeader(\"gst_preset\", { cgst: newCgst, sgst: newSgst, igst: newIgst });\n      }\n    });\n  });","Target":"  // GST Presets: Click Handler Sync with Intra-State vs Inter-State Auto-Determination\n  container.querySelectorAll(\"[data-gst-preset]\").forEach(btn => {\n    btn.addEventListener(\"click\", () => {\n      const ratePct = parseFloat(btn.getAttribute(\"data-gst-preset\")) / 100;\n      // Recalculate dynamically based on current Subtotal (e.g. 11,000)\n      const subtotal = round2(Number(invoice.subtotal) || audit.sum_items || 0);\n      const taxAmount = round2(subtotal * ratePct);\n\n      // Compare first 2 digits of Supplier GSTIN (06) and Buyer GSTIN (06)\n      const supplierGstin = (invoice.gstin || \"\").trim().toUpperCase();\n      const buyerGstin = (invoice.buyer_gstin || \"06CORPP2712A1Z1\").trim().toUpperCase();\n      const supplierState = supplierGstin ? supplierGstin.slice(0, 2) : \"06\";\n      const buyerState = buyerGstin ? buyerGstin.slice(0, 2) : \"06\";\n      const isIntraState = supplierState === buyerState;\n\n      let newCgst = 0;\n      let newSgst = 0;\n      let newIgst = 0;\n\n      if (isIntraState) {\n        // Intra-State: Set IGST strictly to 0, default split to CGST + SGST (e.g. 9% + 9% = 18%, ₹990 + ₹990 on ₹11,000)\n        newIgst = 0;\n        newCgst = round2(taxAmount / 2);\n        newSgst = round2(taxAmount / 2);\n      } else {\n        // Inter-State: Set CGST = 0, SGST = 0, and IGST = 18% (₹1,980.00 on ₹11,000)\n        newCgst = 0;\n        newSgst = 0;\n        newIgst = taxAmount;\n      }\n\n      // Update inputs immediately for instant sync\n      if (inputCgst) inputCgst.value = newCgst;\n      if (inputSgst) inputSgst.value = newSgst;\n      if (inputIgst) inputIgst.value = newIgst;\n\n      // Trigger re-audit immediately\n      if (onUpdateHeader) {\n        onUpdateHeader(\"gst_preset\", { cgst: newCgst, sgst: newSgst, igst: newIgst });\n      }\n    });\n  });"}}]}
