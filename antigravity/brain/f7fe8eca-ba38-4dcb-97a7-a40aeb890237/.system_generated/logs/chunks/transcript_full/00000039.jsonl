{"step_index":2127,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-03T08:45:14Z","input_tokens":2313,"cache_read_tokens":96539,"output_tokens":879,"tool_calls":[{"name":"run_command","args":{"CommandLine":"cd /Users/pranit405/.gemini/antigravity/scratch/audit-it && ./venv/bin/python3 -c '\nimport sys\nsys.path.insert(0, \".\")\nfrom server import app\nfrom starlette.testclient import TestClient\n\nclient = TestClient(app)\n\n# 1. Test 44AD Presumptive mode\npayload_44ad = {\n    \"calc_mode\": \"44AD\",\n    \"annual_turnover\": 3000000.0,\n    \"digital_share_percent\": 80.0,\n    \"digital_profit_rate\": 6.0,\n    \"cash_profit_rate\": 8.0,\n    \"supplier_gstin\": \"06AAAAA0000A1Z5\",\n    \"current_invoice_cgst\": 990.0,\n    \"current_invoice_sgst\": 990.0,\n    \"current_invoice_igst\": 0.0\n}\nr1 = client.post(\"/api/tax/calculate-advisory\", json=payload_44ad)\nassert r1.status_code == 200\ndata1 = r1.json()\nassert data1[\"gstin_valid\"] is True\nassert data1[\"taxable_business_income\"] == 192000.0\nassert data1[\"projected_income_tax\"] == 0.0\nassert data1[\"rebate_87a_applied\"] is True\nassert data1[\"tax_audit_required\"] is False\nassert data1[\"itr_form_suggested\"] == \"ITR-4 (Sugam)\"\nprint(\"✓ 44AD calculation verified!\")\n\n# 2. Test Regular P&L mode\npayload_reg = {\n    \"calc_mode\": \"REGULAR\",\n    \"annual_turnover\": 3000000.0,\n    \"current_invoice_subtotal\": 1800000.0,\n    \"operating_expenses\": 400000.0,\n    \"supplier_gstin\": \"06AAAAA0000A1Z5\"\n}\nr2 = client.post(\"/api/tax/calculate-advisory\", json=payload_reg)\nassert r2.status_code == 200\ndata2 = r2.json()\nassert data2[\"taxable_business_income\"] == 800000.0\nassert data2[\"itr_form_suggested\"] == \"ITR-3\"\n# 800,000 - 75,000 std ded = 725,000 net taxable.\n# Net taxable > 700,000 so rebate_87a_applied is False\nassert data2[\"rebate_87a_applied\"] is False\n# Tax calculation: up to 3L: 0, 3L-7L (400k * 0.05 = 20,000), 7L-7.25L (25k * 0.10 = 2,500) -> Base 22,500 + 4% cess (900) = 23,400.\nassert data2[\"projected_income_tax\"] == 23400.0\nprint(\"✓ Regular P&L calculation verified with New Tax Regime slabs & Sec 87A rebate!\")\n\nprint(\"\\nALL VERIFICATIONS PASSED SUCCESSFULLY!\")\n'","WaitMsBeforeAsync":5000,"toolSummary":"Run in-process test client verification"}}]}
