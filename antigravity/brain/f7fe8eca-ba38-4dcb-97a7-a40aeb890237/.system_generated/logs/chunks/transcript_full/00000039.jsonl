     });\n588: \n589:     this.currentInvoice.inputs_validated = true;\n590:     this.recomputeEverything();\n591:     this.showToast(\"Valid inputs confirmed! Calculations completed.\", \"success\");\n592:   }\n593: \n594:   recomputeEverything() {\n595:     // 1. Audit invoice strictly in code\n596:     this.currentAudit = auditInvoice(this.currentInvoice);\n597: \n598:     // 2. Recompute tax metrics strictly in code\n599:     const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n600:     \n601:     // Retain current AI suggestions text while updating dynamic numbers\n602:     const prevAi = this.taxData ? this.taxData.ai_suggestions : null;\n603:     const ai_suggestions = prevAi || {\n604:       suggestions: [\n605:         \"Recommended ITR Form: File ITR-4 Sugam under Sec 44AD presumptive scheme.\",\n606:         this.currentAudit.gstinValid ? \"GST ITC: 100% eligible Input Tax Credit.\" : \"GST ITC: Warning - missing GSTIN.\",\n607:         \"Advance Tax: Pay by March 15 to prevent interest.\"\n608:       ],\n609:       disclaimer: \"Not tax advice; verify with your CA.\",\n610:       isAiGenerated: false\n611:     };\n612: \n613:     this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n614:     this.render();\n615:   }\n616: \n617:   async handleRefreshTaxAi() {\n618:     if (!this.taxData) return;\n619:     this.showToast(\"Invoking Gemini 2.5 Flash for tax preparation suggestions...\", \"info\");\n620:     \n621:     const { audit_summary, calculated_tax } = this.taxData;\n622:     const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n623:     this.taxData.ai_suggestions = ai_suggestions;\n624:     \n625:     this.render();\n626:     this.showToast(ai_suggestions.isAiGenerated ? \"Updated via Gemini 2.5 Flash!\" : \"Tax suggestions refreshed\", \"success\");\n627:   }\n628: \n629:   handleCopyDiscrepancyNote(openWhatsApp = false) {\n630:     if (!this.currentInvoice || !this.currentAudit) return \"\";\n631:     const noteText = generateSupplierDisputeNote(this.currentInvoice, this.currentAudit);\n632: \n633:     if (openWhatsApp) {\n634:       const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(noteText)}`;\n635:       window.open(waUrl, \"_blank\");\n636:       this.showToast(\"Opening WhatsApp with dispute note...\", \"success\");\n637:       return noteText;\n638:     }\n639: \n640:     navigator.clipboard.writeText(noteText).then(() => {\n641:       this.showToast(\"Dispute Note copied! Ready to paste in WhatsApp\", \"success\");\n642:     }).catch(() => {\n643:       prompt(\"Copy your dispute note below:\", noteText);\n644:     });\n645: \n646:     return noteText;\n647:   }\n648: \n649:   openCaSlipModal() {\n650:     if (!this.currentInvoice || !this.currentAudit) return;"}
