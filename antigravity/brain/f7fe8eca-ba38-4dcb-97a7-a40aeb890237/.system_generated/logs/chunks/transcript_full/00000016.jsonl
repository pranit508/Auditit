i_client(custom_api_key: Optional[str] = None) -> Optional[genai.Client]:\n69:     \"\"\"Retrieve or instantiate a Google GenAI Client.\"\"\"\n70:     key = custom_api_key or os.environ.get(\"GEMINI_API_KEY\") or DEFAULT_GEMINI_API_KEY\n71:     if key and key.strip():\n72:         try:\n73:             return genai.Client(api_key=key.strip())\n74:         except Exception as err:\n75:             print(f\"[AUDIT IT] Error initializing client with key: {err}\")\n76:     global client\n77:     if client:\n78:         return client\n79:     return None\n80: \n81: @app.post(\"/api/analyze-bill\")\n82: async def analyze_bill(\n83:     file: UploadFile = File(...),\n84:     x_api_key: Optional[str] = Header(None, alias=\"x-api-key\")\n85: ):\n86:     contents = await file.read()\n87:     mime_type = file.content_type or \"image/jpeg\"\n88:     \n89:     # Strict prompt with Indian GST invoice extraction rules\n90:     prompt = \"\"\"You are an Indian GST Tax Invoice extractor. Your job is to extract exact numbers and text without dropping digits or inventing items.\n91: \n92: CRITICAL RULES:\n93: 1. COMMA & NUMBER HANDLING (DO NOT DROP DIGITS):\n94:    - In Indian currency notation, commas are thousands separators. NEVER drop digits before commas!\n95:    - Example: '2,535.00' is 2535.0 (Two Thousand Five Hundred Thirty-Five), NOT 535.\n96:    - Example: '1,270.00' is 1270.0 (One Thousand Two Hundred Seventy), NOT 270.\n97:    - Always verify extracted figures against the printed 'Amount/Total in Words' (e.g., 'FOUR THOUSAND FOUR HUNDRED AND NINETY RUPEES ONLY' means the total is 4490, not 2173).\n98: \n99: 2. ONLY REAL PRODUCTS/SERVICES IN LINE ITEMS:\n100:    - Extract ONLY genuine products or services from the central invoice table (e.g., 'Bosch All-in-One Metal Hand Tool Kit', 'Taparia Universal Tool Kit').\n101:    - Clean the product description: strip table borders, brackets, or leading/trailing symbols like '[', '|', ']', or unit words like 'NOS'/'PCS'.\n102:    -