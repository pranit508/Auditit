{"step_index":966,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:21:14Z","content":"Created At: 2026-11-02T23:51:14+05:30\nCompleted At: 2026-11-02T23:51:14+05:30\nShowing lines 90-190 of 403\n90:             item[\"description\"] = desc_clean\n91: \n92:         cleaned.append(item)\n93: \n94:     return cleaned\n95: \n96: def sanitize_and_clean_invoice(data: dict) -> dict:\n97:     \"\"\"\n98:     Sanitize and clean invoice data:\n99:     1. Clean supplier name of trailing symbols\n100:     2. Filter garbage line items (stamps, signatures, low letter count, excessive symbols)\n101:     3. Ensure numeric fields strip commas cleanly (e.g., '2,535.00' -> 2535.0)\n102:     \"\"\"\n103:     if not isinstance(data, dict):\n104:         return data\n105: \n106:     # 1. Clean supplier name of trailing symbols\n107:     supplier = data.get(\"vendor_name\") or data.get(\"supplier_name\") or \"\"\n108:     if supplier:\n109:         supplier_cleaned = re.sub(r'[\\s&0\\|\\[\\]\\(\\)]+$', '', str(supplier)).strip()\n110:         # Also clean phone/email prefixes if any\n111:         supplier_cleaned = re.sub(r'(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+', '', supplier_cleaned, flags=re.IGNORECASE).strip()\n112:         supplier_cleaned = re.sub(r'[\\s,\\-–—:|]+$', '', supplier_cleaned).strip()\n113:         data[\"vendor_name\"] = supplier_cleaned if supplier_cleaned else \"Supplier Name Unclear\"\n114:         data[\"supplier_name\"] = data[\"vendor_name\"]\n115: \n116:     # 2. Filter garbage line items\n117:     clean_items = []\n118:     for item in data.get(\"items\", []):\n119:         if not isinstance(item, dict):\n120:             continue\n121: \n122:         desc = (item.get(\"description\") or \"\").strip()\n123:         \n124:         # Remove stray leading/trailing brackets and vertical pipes from OCR\n125:         desc = re.sub(r'^[\\[\\|\\]\\(\\)\\s]+|[\\[\\|\\]\\(\\)\\s]+$', '', desc).strip()\n126:         item[\"description\"] = desc\n127: \n128:         # Skip if description lacks at least 4 letters\n129:         if len(re.findall(r'[a-zA-Z]', desc)) < 4:\n130:             continue\n131: \n132:         # Skip if more than 20% of description is weird symbols/punctuation\n133:         symbols = re.findall(r'[~|©\\[\\]=_{}@#$%^&*]', desc)\n134:         if len(desc) > 0 and (len(symbols) / len(desc)) > 0.20:\n135:             continue\n136: \n137:         # Skip common footer/stamp terms\n138:         if any(term in desc.lower() for term in [\"signature\", \"authorised\", \"terms\", \"condition\", \"bank details\", \"e-way bill\"]):\n139:             continue\n140: \n141:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', etc.\n142:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n143:         if desc_clean and len(desc_clean) >= 3:\n144:             desc = desc_clean\n145:             item[\"description\"] = desc\n146: \n147:         # Quantity and Rate sanity\n148:         try:\n149:             raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\")\n150:             qty = float(str(raw_qty or 1).replace(\",\", \"\").strip())\n151:         except (ValueError, TypeError):\n152:             qty = 1.0\n153: \n154:         try:\n155:             raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n156:             rate = float(str(raw_rate or 0).replace(\",\", \"\").strip())\n157:         except (ValueError, TypeError):\n158:             rate = 0.0\n159: \n160:         try:\n161:             raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\")\n162:             billed = float(str(raw_billed if raw_billed is not None else (qty * rate)).replace(\",\", \"\").strip())\n163:         except (ValueError, TypeError):\n164:             billed = round(qty * rate, 2)\n165: \n166:         # Post-Processing Column Swap Fallback:\n167:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n168:         # it means qty and rate were misaligned. Swap them:\n169:         if billed > 0 and qty == billed and rate in [1.0, 2.0, 1, 2]:\n170:             qty = 1.0\n171:             rate = billed\n172: \n173:         item[\"quantity\"] = qty\n174:         item[\"qty\"] = qty\n175:         item[\"unit_rate\"] = rate\n176:         item[\"rate\"] = rate\n177:         item[\"total_amount\"] = billed\n178:         item[\"amount\"] = billed\n179:         clean_items.append(item)\n180: \n181:     data[\"items\"] = clean_items\n182: \n183:     # 3. Ensure numeric fields strip commas cleanly\n184:     for key in [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"]:\n185:         val = data.get(key)\n186:         if val is not None and str(val).strip() != \"\" and str(val).lower() != \"null\":\n187:             try:\n188:                 data[key] = float(str(val).replace(\",\", \"\").strip())\n189:             except (ValueError, TypeError):\n190:                 pass"}
