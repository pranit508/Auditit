4: \n85:       if (parsed && typeof parsed === \"object\") {\n86:         parsed.uploaded_file_url = objectUrl;\n87:         parsed.file_type = mimeType;\n88:         parsed.file_name = file.name;\n89: \n90:         // Map ExtractedInvoice schema to app schema\n91:         if (parsed.invoice_number && !parsed.invoice_no) {\n92:           parsed.invoice_no = parsed.invoice_number;\n93:         }\n94:         if (parsed.declared_total !== undefined && parsed.total_declared === undefined) {\n95:           parsed.total_declared = parsed.declared_total;\n96:         }\n97: \n98:         // Apply item cleaning and mandatory rules\n99:         if (parsed.items && Array.isArray(parsed.items)) {\n100:           parsed.items = cleanExtractedItems(parsed.items);"}
