${formatRupees(calculatedAmount)}. Discrepancy: ${formatRupees(Math.abs(diff))}.`,\n242:           diff: diff,\n243:           declared: declaredAmount,\n244:           calculated: calculatedAmount\n245:         });\n246:       }\n247: \n248:       if (item.is_blurry) {\n249:         hasBlurryFields = true;\n250:       }\n251: \n252:       lineItemAudit.push({\n253:         ...item,\n254:         qty,\n255:         rate,\n256:         declaredAmount,\n257:         calculatedAmount,\n258:         diff,\n259:         isMathError\n260:       });\n261:     });\n262:   }\n263: \n264:   sum_items = round2(sum_items);\n265: \n266:   // Tax Calculations with strict float precision\n267:   const cgst = round2(Number(invoice.cgst) || 0);\n268:   const sgst = round2(Number(invoice.sgst) || 0);\n269:   const igst = round2(Number(invoice.igst) || 0);\n270:   const totalTax = round2(cgst + sgst + igst);\n271: \n272:   // GST Split check\n273:   if (cgst > 0 || sgst > 0) {\n274:     if (Math.abs(cgst - sgst) > 1.00) {\n275:       issues.push({\n276:         type: \"WARNING\",\n277:         field: \"gst_split\",\n278:         title: \"CGST and SGST Mismatch\",\n279:         description: `Intra-state GST requires CGST (${formatRupees(cgst)}) to equal SGST (${formatRupees(sgst)}).`\n280:       });\n281:     }\n282:   }\n283: \n284:   // Strict Grand Total Calculation\n285:   const calculated_total = round2(sum_items + totalTax);\n286:   const total_declared = round2(Number(invoice.total_declared) || 0);\n287:   const totalDiff = round2(total_declared - calculated_total);\n288: \n289:   // Discrepancy rule: If difference exceeds ₹1.00\n290:   const hasTotalDiscrepancy = Math.abs(totalDiff) > 1.00;\n291: \n292:   if (hasTotalDiscrepancy) {\n293:     issues.push({\n294:       type: \"ERROR\",\n295:       field: \"total_declared\",\n296:       title: totalDiff > 0 ? \"Grand Total Overcharge Detected\" : \"Grand Total Undercharge Detected\",\n297:       description: `Bill declared ${formatRupees(total_declared)}, but verified total (Items ${formatRupees(sum_items)} + Tax ${formatRupees(totalTax)}) is ${formatRupees(calculated_total)}. Net Variance: ${formatRupees(Math.abs(totalDiff))}.`,\n298:       diff: totalDiff,\n299:       declared: total_declared,\n300:       calculated: calculated_total\n301:     });\n302:   }\n303: \n304:   // GSTIN Verification\n305:   const gstin = (invoice.gstin || \"\").trim().toUpperCase();\n306:   const gstinValid = GSTIN_REGEX.test(gstin);\n307: \n308:   // Determine overall status verdict\n309:   let status = \"VERIFIED\";\n310:   let statusText = \"Math Verified & Valid\";\n311:   let statusColor = \"emerald\";\n312: \n313:   if (hasTotalDiscrepancy || hasLineItemMathError) {\n314:     status = \"OVERCHARGE_ERROR\";\n315:     statusText = totalDiff > 0 ? `${formatRupees(Math.abs(totalDiff))} Overcharge` : `${formatRupees(Math.abs(totalDiff))} Math Error`;\n316:     statusColor = \"rose\";\n317:   } else if (!gstinValid || hasBlurryFields || issues.some(i => i.type === \"WARNING\")) {\n318:     status = \"REVIEW_NEEDED\";\n319:     statusText = \"Review Needed\";\n320:     statusColor = \"amber\";\n321:   }\n322: \n323:   return {\n324:     status,\n325:     statusText,\n326:     statusColor,\n327:     is_valid_bill: true,\n328:     isHalted: false,\n329:     missingOrUnclearInputs: [],\n330:     sum_items,\n331:     totalTax,\n332:     calculated_total,\n333:     total_declared,\n334:     totalDiff,\n335:     hasTotalDiscrepancy,\n336:     hasLineItemMathError,\n337:     hasBlurryFields,\n338:     gstinValid,\n339:     unreadable_fields: unreadableList,\n340:     lineItemAudit,\n341:     issues\n342:   };\n343: }"}
