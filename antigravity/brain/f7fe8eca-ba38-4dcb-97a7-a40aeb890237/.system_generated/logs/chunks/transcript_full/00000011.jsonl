ll,\n262:       total_declared: null,\n263:       uploaded_file_url: objectUrl,\n264:       file_type: mimeType,\n265:       file_name: file.name\n266:     };\n267:   }\n268: \n269:   // Genuine document uploaded without OCR server: create real container linked to user's photo\n270:   const cleanDocName = file.name.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \");\n271: \n272:   const cleanExtracted = {\n273:     id: \"uploaded-\" + Date.now(),\n274:     scenarioName: `Bill: ${file.name}`,\n275:     is_valid_bill: true,\n276:     rejection_reason: null,\n277:     unreadable_fields: [\"gstin\", \"invoice_no\"],\n278:     vendor_name: cleanDocName,\n279:     vendor_address: \"Commercial Address from Scanned Bill\",\n280:     gstin: \"\","}
