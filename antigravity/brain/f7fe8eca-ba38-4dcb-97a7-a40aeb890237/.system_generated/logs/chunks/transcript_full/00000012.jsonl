ted_tax_liability: formatRupees(calculated_tax.estimated_tax_liability),\n34:     tax_regime: calculated_tax.tax_regime,\n35:     recommended_form: calculated_tax.recommended_form\n36:   }, null, 2);\n37: \n38:   const promptText = `You are a tax preparation assistant for small Indian retail shopkeepers.\n39: Given this pre-calculated financial data:\n40: ${formattedData}\n41: \n42: Provide 3 concise bullet points:\n43: 1. Recommended ITR Form: (e.g., ITR-4 Sugam under Sec 44AD vs ITR-3) with a 1-sentence reason.\n44: 2. GST ITC Opportunity / Risk: Explain how much Input Tax Credit can be claimed from audited bills and warn about unverified supplier GSTINs.\n45: 3. Advance Tax & Action Item: Remind them of the March 15 advance tax deadline.\n46: \n47: Tone: Grounded, simple English, no complex jargon. Include a clear disclaimer: 'Not tax advice; verify with your CA.'`;\n48: \n49:   // Attempt live Gemini 2.5 Flash call if key is provided\n50:   if (apiKey && apiKey.trim().length > 10) {"}
{"step_index":707,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T17:42:34Z","input_tokens":3076,"cache_read_tokens":216769,"output_tokens":778,"tool_calls":[{"name":"edit_file","args":{"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/taxSuggestions.js","Replacement":"const DEFAULT_API_KEY = \"AQ.Ab8RN6LhTNa6kIQRpd_OijgrXNfmwLOw7rcxiMN8aWW-_U7mPw\";\n\n/**\n * Calls Gemini 2.5 Flash to generate tax and ITR suggestions for small retail shopkeepers.\n * \n * @param {Object} audit_summary - Financial context (turnover, invoices, GST, missing GSTINs)\n * @param {Object} calculated_tax - Code-calculated tax liability & deemed profit under Sec 44AD\n * @param {string} [apiKey] - Google Gemini API Key\n * @returns {Promise<{ suggestions: string[], disclaimer: string, isAiGenerated: boolean }>}\n */\nexport async function generate_tax_suggestions(audit_summary, calculated_tax, apiKey = null) {\n  const effectiveKey = (apiKey && apiKey.trim().length > 10) ? apiKey.trim() : DEFAULT_API_KEY;\n\n  if (!audit_summary || !calculated_tax) {\n    return {\n      suggestions: [\n        \"Recommended ITR Form: File ITR-4 Sugam under Sec 44AD presumptive scheme without maintaining formal accounting books.\",\n        \"GST ITC Opportunity / Risk: Verified supplier GSTINs ensure 100% of input tax credit reduces your monthly GST liability.\",\n        \"Advance Tax & Action Item: Remind yourself of the March 15 advance tax payment deadline.\"\n      ],\n      disclaimer: \"Not tax advice; verify with your CA.\",\n      isAiGenerated: false\n    };\n  }","Target":"/**\n * Calls Gemini 2.5 Flash to generate tax and ITR suggestions for small retail shopkeepers.\n * \n * @param {Object} audit_summary - Financial context (turnover, invoices, GST, missing GSTINs)\n * @param {Object} calculated_tax - Code-calculated tax liability & deemed profit under Sec 44AD\n * @param {string} [apiKey] - Google Gemini API Key\n * @returns {Promise<{ suggestions: string[], disclaimer: string, isAiGenerated: boolean }>}\n */\nexport async function generate_tax_suggestions(audit_summary, calculated_tax, apiKey = null) {\n  if (!audit_summary || audit_summary.total_turnover === 0) {\n    return {\n      suggestions: [\n        \"Document was rejected by the gatekeeper: not a commercial bill or invoice.\",\n        \"Zero hallucination rule: no tax suggestions generated on non-bill media.\",\n        \"Upload a commercial purchase invoice or enter bill details manually.\"\n      ],\n      disclaimer: \"Document not eligible for tax audit.\",\n      isAiGenerated: false\n    };\n  }"}}]}
