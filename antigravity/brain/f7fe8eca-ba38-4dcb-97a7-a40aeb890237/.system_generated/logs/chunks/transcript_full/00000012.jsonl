{"step_index":690,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T17:41:36Z","content":"Created At: 2026-11-02T23:11:36+05:30\nCompleted At: 2026-11-02T23:11:36+05:30\nShowing lines 1-35 of 119\n1: // Deterministic Tax & ITR Calculator for Small Indian Retail Shopkeepers\n2: // Core Rule: \"Code does the math, deterministic calculations only\"\n3: import { round2 } from \"./auditEngine.js\";\n4: \n5: /**\n6:  * Calculates turnover, deemed profit under Sec 44AD, and estimated tax under New Regime\n7:  * @param {Object} invoice\n8:  * @param {Object} audit\n9:  * @param {Object} [settings] - Optional user overrides for turnover and digital ratio\n10:  */\n11: export function calculateTaxMetrics(invoice, audit, settings = {}) {\n12:   // If document was rejected or calculations are halted due to missing/unclear fields\n13:   if (invoice.is_valid_bill === false || audit.isHalted) {\n14:     return {\n15:       audit_summary: {\n16:         total_turnover: 0,\n17:         deemed_profit: 0,\n18:         number_of_invoices_analyzed: 0,\n19:         current_invoice_total: 0,\n20:         total_gst_paid_on_purchases: 0,\n21:         eligible_itc: 0,\n22:         invoices_missing_gstin: 0,\n23:         disallowed_itc: 0,\n24:         vendor_name: invoice.vendor_name || \"N/A\",\n25:         supplier_gstin: invoice.gstin || \"N/A\"\n26:       },\n27:       calculated_tax: {\n28:         recommended_form: audit.isHalted ? \"Calculations Paused\" : \"None (Invalid Document)\",\n29:         annual_turnover: 0,\n30:         digital_percent: 0,\n31:         cash_percent: 0,\n32:         deemed_net_profit: 0,\n33:         profit_computation_basis: audit.isHalted ? \"Waiting for user to confirm missing or unclear bill details\" : \"No financial calculations on rejected non-bill document\",\n34:         estimated_tax_liability: 0,\n35:         tax_regime: audit.isHalted ? \"Paused\" : \"N/A\","}
