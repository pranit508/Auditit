\" \n566:               class=\"px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-semibold border border-slate-700 transition-all flex items-center space-x-1\"\n567:               title=\"Refresh suggestions using Gemini 2.5 Flash\"\n568:             >\n569:               <span>✨ Gemini 2.5 Flash</span>\n570:             </button>\n571:           </div>\n572:         </div>\n573: \n574:         <!-- 3 REQUIRED PILLS -->\n575:         <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-2.5\">\n576:           \n577:           <!-- Pill 1: Recommended Form -->\n578:           <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n579:             <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 1 • Recommended Form</span>\n580:             <div class=\"mt-1 font-bold text-xs text-emerald-300\">\n581:               ${calculated_tax.recommended_form}\n582:             </div>\n583:             <span class=\"text-[9px] text-slate-400 mt-1 block\">Presumptive Scheme under Sec 44AD</span>\n584:           </div>\n585: \n586:           <!-- Pill 2: Deemed Net Profit -->\n587:           <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n588:             <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 2 • Deemed Net Profit</span>\n589:             <div class=\"mt-1 font-extrabold text-sm font-mono text-white\">\n590:               ${formatRupees(calculated_tax.deemed_net_profit)}\n591:             </div>\n592:             <span class=\"text-[9px] text-slate-400 mt-1 block\">${calculated_tax.profit_computation_basis}</span>\n593:           </div>\n594: \n595:           <!-- Pill 3: Estimated Tax Liability -->\n596:           <div class=\"bg-slate-800/80 rounded-xl p-3 border border-slate-700/80 flex flex-col justify-between\">\n597:             <span class=\"text-[9px] font-bold text-slate-400 uppercase tracking-wider block\">Pill 3 • Estimated Tax Liability</span>\n598:             <div class=\"mt-1 font-extrabold text-sm font-mono text-emerald-400\">\n599:               ${formatRupees(calculated_tax.estimated_tax_liability)}\n600:             </div>\n601:             <span class=\"text-[9px] text-slate-400 mt-1 block\">Computed via New Regime (Sec 115BAC)</span>\n602:           </div>\n603: \n604:         </div>\n605: \n606:         <!-- REAL-TIME SHOP TURNOVER & CASH RATIO SLIDER -->\n607:         <div class=\"bg-slate-800/40 rounded-xl p-3 border border-slate-700/50 space-y-2 text-xs\">\n608:           <div class=\"flex items-center justify-between text-[11px] text-slate-300\">\n609:             <span class=\"font-bold\">Adjust Digital Receipts Ratio (Sec 44AD Profit: 6% Digital vs 8% Cash):</span>\n610:             <span class=\"font-mono font-bold text-emerald-300\" id=\"label-digital-ratio\">${calculated_tax.digital_percent}% Digital (${calculated_tax.cash_percent}% Cash)</span>\n611:           </div>\n612:           <input \n613:             type=\"range\" \n614:             min=\"0\" \n615:             max=\"100\" \n616:             step=\"5\"\n617:             value=\"${calculated_tax.digital_percent}\"\n618:             id=\"slider-digital-ratio\"\n619:             class=\"w-full accent-emerald-500 cursor-pointer\"\n620:           />\n621:         </div>\n622: \n623:         <!-- ADVISORY CALLOUT BOX -->\n624:         <div class=\"bg-emerald-950/40 rounded-xl p-3.5 border border-emerald-500/30 text-emerald-100 flex items-start space-x-3\">\n625:           <div class=\"w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5\">\n626:             🛡️\n627:           </div>\n628:           <div class=\"text-xs leading-relaxed\">\n629:             <strong class=\"text-emerald-300 block mb-0.5\">Advisory Callout: How Keeping Supplier GSTINs Verified Saves Cash</strong>\n630:             <p class=\"text-[11px] text-slate-300\">\n631:               Every single rupee of GST shown on your purchase invoices can directly offset your GST tax liability via <strong>Input Tax Credit (ITC)</strong>. \n632:               However, Indian tax laws (Section 16 of the CGST Act) mandate that ITC is strictly disallowed if your supplier does not have an active, verified GSTIN. \n633:               Always verify supplier GSTINs on AUDIT IT before making payments to protect your ITC and avoid paying tax twice!\n634:             </p>\n635:           </div>\n636:         </div>\n637: \n638:         <!-- 3 CONCISE BULLET POINTS FROM GEMINI 2.5 FLASH -->\n639:         <div class=\"bg-slate-800/50 rounded-xl p-3.5 border border-slate-800 space-y-2\">\n640:           <div class=\"flex items-center justify-between text-[11px] font-bold text-slate-300\">\n641:             <span>Gemini 2.5 Flash Tax Preparation Summary:</span>\n642:             ${ai_suggestions.isAiGenerated \n643:               ? `<span class=\"text-[10px] text-emerald-400 font-mono\">● Live Gemini 2.5 Flash</span>` \n644:               : `<span class=\"text-[10px] text-slate-400 font-mono\">Standard Rule Engine</span>`\n645:             }\n646:           </div>\n647: \n648:           <ul class=\"space-y-2 text-xs text-slate-200\">\n649:             ${ai_suggestions.suggestions.map((bullet, idx) => `\n650:               <li class=\"flex items-start space-x-2\">\n651:                 <span class=\"w-4 h-4 rounded-full bg-slate-700 text-slate-300 flex items-center justify-center shrink-0 text-[10px] font-bold mt-0.5\">\n652:                   ${idx + 1}\n653:                 </span>\n654:                 <span class=\"text-[11px] leading-relaxed text-slate-300\">${bullet}</span>\n655:               </li>\n656:             `).join(\"\")}\n657:           </ul>\n658: \n659:           <!-- Mandatory Disclaimer -->\n660:           <div class=\"pt-2 border-t border-slate-800/80 text-[10px] text-slate-400 italic\">\n661:             ⚖️ ${ai_suggestions.disclaimer}\n662:           </div>\n663:         </div>\n664: \n665:       </div>\n666: \n667:       <!-- ACTION BUTTONS -->\n668:       <div class=\"flex flex-col sm:flex-row items-center gap-2.5 pt-2\">\n669:         <button id=\"btn-copy-discrepancy\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all active:scale-95\">\n670:           <span>📋 Copy Dispute Note</span>\n671:         </button>\n672: \n673:         <button id=\"btn-share-whatsapp\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n674:           <span>📲 Share on WhatsApp</span>\n675:         </button>\n676: \n677:         <button id=\"btn-open-ca-slip\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n678:           <span>📑 CA Audit Slip</span>\n679:         </button>\n680: \n681:         <button id=\"btn-back-dashboard\" class=\"w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition-all\">\n682:           <span>← Back</span>\n683:         </button>\n684:       </div>\n685: \n686:     </div>\n687:   `;\n688: \n689:   // Attach event handlers\n690:   const btnQuickCopy = container.querySelector(\"#btn-quick-copy\");"}
