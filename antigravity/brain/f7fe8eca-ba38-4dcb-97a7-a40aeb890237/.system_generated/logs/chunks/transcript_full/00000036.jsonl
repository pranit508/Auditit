         </li>\n656:             `).join(\"\")}\n657:           </ul>\n658: \n659:           <!-- Mandatory Disclaimer -->\n660:           <div class=\"pt-2 border-t border-slate-800/80 text-[10px] text-slate-400 italic\">\n661:             ⚖️ ${ai_suggestions.disclaimer}\n662:           </div>\n663:         </div>\n664: \n665:       </div>\n666: \n667:       <!-- ACTION BUTTONS -->\n668:       <div class=\"flex flex-col sm:flex-row items-center gap-2.5 pt-2\">\n669:         <button id=\"btn-copy-discrepancy\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all active:scale-95\">\n670:           <span>📋 Copy Dispute Note</span>\n671:         </button>\n672: \n673:         <button id=\"btn-share-whatsapp\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n674:           <span>📲 Share on WhatsApp</span>\n675:         </button>\n676: \n677:         <button id=\"btn-open-ca-slip\" class=\"w-full sm:flex-1 flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold shadow transition-all active:scale-95\">\n678:           <span>📑 CA Audit Slip</span>\n679:         </button>\n680: \n681:         <button id=\"btn-back-dashboard\" class=\"w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition-all\">\n682:           <span>← Back</span>\n683:         </button>\n684:       </div>\n685: \n686:     </div>\n687:   `;\n688: \n689:   // Attach event handlers\n690:   const btnQuickCopy = container.querySelector(\"#btn-quick-copy\");\n691:   if (btnQuickCopy && onCopyNote) {\n692:     btnQuickCopy.addEventListener(\"click\", onCopyNote);\n693:   }\n694: \n695:   cons