{"step_index":344,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:48Z","content":"Created At: 2026-11-02T22:13:48+05:30\nCompleted At: 2026-11-02T22:13:48+05:30\nShowing lines 1-55 of 55\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: AUDIT IT - Local Web App Server\n4: Runs a lightweight, zero-dependency HTTP server with proper MIME types for ES Modules.\n5: \"\"\"\n6: \n7: import os\n8: import sys\n9: import mimetypes\n10: from http.server import HTTPServer, SimpleHTTPRequestHandler\n11: \n12: PORT = 3000\n13: \n14: # Ensure ES modules (.js) have application/javascript MIME type\n15: mimetypes.add_type(\"application/javascript\", \".js\")\n16: mimetypes.add_type(\"application/javascript\", \".mjs\")\n17: mimetypes.add_type(\"text/css\", \".css\")\n18: mimetypes.add_type(\"text/html\", \".html\")\n19: mimetypes.add_type(\"application/json\", \".json\")\n20: \n21: class AuditItHandler(SimpleHTTPRequestHandler):\n22:     def end_headers(self):\n23:         # Enable CORS and disable cache during development\n24:         self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n25:         self.send_header(\"Cache-Control\", \"no-cache, no-store, must-revalidate\")\n26:         super().end_headers()\n27: \n28:     def log_message(self, format, *args):\n29:         # Clean logging\n30:         sys.stderr.write(f\"[AUDIT IT] {self.address_string()} - {format % args}\\n\")\n31: \n32: def run(port=PORT):\n33:     # Change working directory to the directory of this script\n34:     script_dir = os.path.dirname(os.path.abspath(__file__))\n35:     os.chdir(script_dir)\n36: \n37:     server_address = (\"\", port)\n38:     httpd = HTTPServer(server_address, AuditItHandler)\n39:     \n40:     print(\"\\n\" + \"=\"*56)\n41:     print(\"  🚀 AUDIT IT - Retail Bill Verification Engine\")\n42:     print(f\"  Serving on: http://localhost:{port}\")\n43:     print(f\"  Root Dir:   {script_dir}\")\n44:     print(\"=\"*56 + \"\\n\")\n45:     print(\"Press Ctrl+C to stop the server.\\n\")\n46: \n47:     try:\n48:         httpd.serve_forever()\n49:     except KeyboardInterrupt:\n50:         print(\"\\n[AUDIT IT] Server stopped gracefully.\")\n51:         httpd.server_close()\n52: \n53: if __name__ == \"__main__\":\n54:     port = int(sys.argv[1]) if len(sys.argv) > 1 else PORT\n55:     run(port)"}
