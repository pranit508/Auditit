.toLowerCase();\n198:     \n199:     // Grand Total matching\n200:     if (/(?:grand\\s+total|total\\s+amount|net\\s+payable|total\\s+payable|balance\\s+due|total\\s*:)/i.test(line)) {\n201:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n202:       if (nums && nums.length > 0) {\n203:         total_declared = cleanNumber(nums[nums.length - 1]);\n204:       }\n205:     }\n206: \n207:     // Subtotal matching\n208:     if (/(?:sub\\s*total|taxable\\s+value|gross\\s+amount)/i.test(line)) {\n209:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n210:       if (nums && nums.length > 0) {\n211:         subtotal = cleanNumber(nums[nums.length - 1]);\n212:       }\n213:     }\n214: \n215:     // CGST\n216:     if (/cgst/i.test(line)) {\n217:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n218:       if (nums && nums.length > 0) {\n219:         cgst = cleanNumber(nums[nums.length - 1]);\n220:       }\n221:     }\n222: \n223:     // SGST\n224:     if (/sgst/i.test(line)) {\n225:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n226:       if (nums && nums.length > 0) {\n227:         sgst = cleanNumber(nums[nums.length - 1]);\n228:       }\n229:     }\n230: \n231:     // IGST\n232:     if (/igst/i.test(line)) {\n233:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n234:       if (nums && nums.length > 0) {\n235:         igst = cleanNumber(nums[nums.length - 1]);\n236:       }\n237:     }\n238:   }\n239: \n240:   // If no items were parsed by regular expression, but lines with numbers exist"}
