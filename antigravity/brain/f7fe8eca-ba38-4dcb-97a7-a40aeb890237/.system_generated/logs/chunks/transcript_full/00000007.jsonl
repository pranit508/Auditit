{"step_index":340,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:38Z","content":"Created At: 2026-11-02T22:13:38+05:30\nCompleted At: 2026-11-02T22:13:38+05:30\nShowing lines 1-120 of 486\n1: // AUDIT IT - Main Application Controller with Real-Time Reactive Auditing\n2: import { SAMPLE_INVOICES } from \"./data/sampleInvoices.js\";\n3: import { auditInvoice, round2 } from \"./utils/auditEngine.js\";\n4: import { generateSupplierDisputeNote } from \"./utils/discrepancyNote.js\";\n5: import { extractInvoiceFromDocument } from \"./utils/aiExtractor.js\";\n6: import { calculateTaxMetrics } from \"./utils/taxCalculator.js\";\n7: import { generate_tax_suggestions } from \"./utils/taxSuggestions.js\";\n8: import { renderDashboardHero } from \"./components/DashboardHero.js\";\n9: import { renderReviewWorkspace } from \"./components/ReviewWorkspace.js\";\n10: import { renderCaSlipModal } from \"./components/CaSlipModal.js\";\n11: import { renderApiKeyModal } from \"./components/ApiKeyModal.js\";\n12: \n13: class AuditItApp {\n14:   constructor() {\n15:     this.currentView = \"dashboard\"; // \"dashboard\" | \"review\"\n16:     this.currentInvoice = null;\n17:     this.currentAudit = null;\n18:     this.taxData = null;\n19:     this.userTaxSettings = { annualTurnover: 3600000, digitalRatio: 0.60 };\n20:     this.isProcessing = false;\n21:     this.apiKey = localStorage.getItem(\"audit_it_gemini_api_key\") || \"\";\n22: \n23:     this.mainMount = document.getElementById(\"app-main\");\n24:     this.modalMount = document.getElementById(\"modal-container\");\n25:     this.toastMount = document.getElementById(\"toast-container\");\n26: \n27:     this.init();\n28:   }\n29: \n30:   init() {\n31:     this.render();\n32:   }\n33: \n34:   render() {\n35:     // Save active element focus and selection\n36:     const activeEl = document.activeElement;\n37:     let focusInfo = null;\n38:     if (activeEl && (activeEl.tagName === \"INPUT\" || activeEl.tagName === \"TEXTAREA\")) {\n39:       focusInfo = {\n40:         id: activeEl.id,\n41:         action: activeEl.getAttribute(\"data-action\"),\n42:         index: activeEl.getAttribute(\"data-index\"),\n43:         selectionStart: activeEl.selectionStart,\n44:         selectionEnd: activeEl.selectionEnd\n45:       };\n46:     }\n47: \n48:     if (this.currentView === \"dashboard\") {\n49:       renderDashboardHero(this.mainMount, {\n50:         hasApiKey: !!this.apiKey,\n51:         onSelectSample: (sampleKey) => this.loadSample(sampleKey),\n52:         onFileUpload: (file) => this.handleFileUpload(file),\n53:         onCreateManualBill: () => this.createManualBill(),\n54:         onOpenApiKeyModal: () => this.openApiKeyModal()\n55:       });\n56:     } else if (this.currentView === \"review\") {\n57:       renderReviewWorkspace(this.mainMount, this.currentInvoice, this.currentAudit, {\n58:         taxData: this.taxData,\n59:         onRefreshTaxAi: () => this.handleRefreshTaxAi(),\n60:         onUpdateItem: (idx, action, val) => this.handleUpdateItem(idx, action, val),\n61:         onAddItem: () => this.handleAddItem(),\n62:         onDeleteItem: (idx) => this.handleDeleteItem(idx),\n63:         onUpdateHeader: (field, val) => this.handleUpdateHeader(field, val),\n64:         onAutoFixMath: () => this.handleAutoFixMath(),\n65:         onUpdateTaxSettings: (settings) => this.handleUpdateTaxSettings(settings),\n66:         onSubmitValidInputs: (fields) => this.handleSubmitValidInputs(fields),\n67:         onCopyNote: (openWhatsApp) => this.handleCopyDiscrepancyNote(openWhatsApp),\n68:         onOpenCaSlip: () => this.openCaSlipModal(),\n69:         onBack: () => this.goToDashboard()\n70:       });\n71:     }\n72: \n73:     // Restore focus seamlessly if user was actively typing\n74:     if (focusInfo) {\n75:       let targetInput = null;\n76:       if (focusInfo.id) {\n77:         targetInput = document.getElementById(focusInfo.id);\n78:       } else if (focusInfo.action && focusInfo.index !== null) {\n79:         targetInput = document.querySelector(`input[data-action=\"${focusInfo.action}\"][data-index=\"${focusInfo.index}\"]`);\n80:       }\n81:       if (targetInput) {\n82:         targetInput.focus();\n83:         if (targetInput.setSelectionRange && focusInfo.selectionStart !== null) {\n84:           try {\n85:             targetInput.setSelectionRange(focusInfo.selectionStart, focusInfo.selectionEnd);\n86:           } catch (_) {}\n87:         }\n88:       }\n89:     }\n90:   }\n91: \n92:   async loadSample(sampleKey) {\n93:     const rawSample = SAMPLE_INVOICES[sampleKey];\n94:     if (!rawSample) return;\n95: \n96:     // Deep copy to allow editing without mutating original sample\n97:     this.currentInvoice = JSON.parse(JSON.stringify(rawSample));\n98:     this.currentAudit = auditInvoice(this.currentInvoice);\n99: \n100:     // Compute code-calculated tax & deemed profit under Sec 44AD\n101:     const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n102:     const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n103:     \n104:     this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n105:     this.currentView = \"review\";\n106:     this.render();\n107:     window.scrollTo({ top: 0, behavior: \"smooth\" });\n108:     this.showToast(`Loaded ${rawSample.scenarioName}`, \"info\");\n109:   }\n110: \n111:   createManualBill() {\n112:     this.currentInvoice = {\n113:       id: \"manual-\" + Date.now(),\n114:       scenarioName: \"Manual Bill Entry\",\n115:       vendor_name: \"Gupta General Traders\",\n116:       vendor_address: \"Wholesale Mandi, Shop 4B, Delhi\",\n117:       gstin: \"07AAAAA0000A1Z5\",\n118:       invoice_no: `INV-${new Date().getFullYear()}-${Math.floor(100 + Math.random() * 900)}`,\n119:       date: new Date().toISOString().split(\"T\")[0],\n120:       badge: { text: \"Manu