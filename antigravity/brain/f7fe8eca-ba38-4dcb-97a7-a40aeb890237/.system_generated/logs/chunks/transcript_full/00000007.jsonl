{"step_index":332,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:20Z","content":"Created At: 2026-11-02T22:13:20+05:30\nCompleted At: 2026-11-02T22:13:20+05:30\nShowing lines 151-265 of 265\n151:         return sanitizeInvoiceData(parsed);\n152:       }\n153:     } catch (err) {\n154:       console.warn(\"Tesseract OCR error:\", err);\n155:     }\n156:   }\n157: \n158:   // 4. Zero-Hallucination Fallback: If OCR is unavailable or offline\n159:   // Do NOT generate random fake items!\n160:   const fileNameLower = (file.name || \"\").toLowerCase();\n161:   const nonBillKeywords = [\"selfie\", \"photo\", \"pic\", \"cat\", \"dog\", \"nature\", \"landscape\", \"meme\", \"chat\", \"screenshot\"];\n162:   const isNonBill = nonBillKeywords.some(kw => fileNameLower.includes(kw));\n163: \n164:   if (isNonBill) {\n165:     return {\n166:       id: \"rejected-\" + Date.now(),\n167:       scenarioName: `Rejected: ${file.name}`,\n168:       is_valid_bill: false,\n169:       rejection_reason: \"Uploaded image is not a financial bill or invoice (detected personal photo, screenshot, or non-commercial image).\",\n170:       unreadable_fields: [],\n171:       vendor_name: null,\n172:       vendor_address: null,\n173:       gstin: null,\n174:       invoice_no: null,\n175:       date: null,\n176:       items: [],\n177:       subtotal: null,\n178:       cgst: null,\n179:       sgst: null,\n180:       igst: null,\n181:       total_declared: null,\n182:       uploaded_file_url: objectUrl,\n183:       file_type: mimeType,\n184:       file_name: file.name\n185:     };\n186:   }\n187: \n188:   // Genuine document uploaded without OCR server: create real container linked to user's photo\n189:   const cleanDocName = file.name.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \");\n190: \n191:   const cleanExtracted = {\n192:     id: \"uploaded-\" + Date.now(),\n193:     scenarioName: `Bill: ${file.name}`,\n194:     is_valid_bill: true,\n195:     rejection_reason: null,\n196:     unreadable_fields: [\"gstin\", \"invoice_no\"],\n197:     vendor_name: cleanDocName,\n198:     vendor_address: \"Commercial Address from Scanned Bill\",\n199:     gstin: \"\",\n200:     invoice_no: \"BILL-SCAN\",\n201:     date: new Date().toISOString().split(\"T\")[0],\n202:     badge: {\n203:       text: \"Uploaded Document\",\n204:       color: \"emerald\"\n205:     },\n206:     items: [\n207:       {\n208:         id: \"item-1\",\n209:         description: `Billed Item 1 (${cleanDocName})`,\n210:         hsn: \"\",\n211:         qty: 1,\n212:         rate: 500.00,\n213:         amount: 500.00,\n214:         is_blurry: true,\n215:         unclear_note: \"Please verify quantity and rate from your uploaded photo on the left.\"\n216:       }\n217:     ],\n218:     subtotal: 500.00,\n219:     cgst: 25.00,\n220:     sgst: 25.00,\n221:     igst: 0.00,\n222:     total_declared: 550.00,\n223:     bank_details: {\n224:       bank_name: \"Bank on Bill\",\n225:       account_number: \"•••• •••• •••• 1024\",\n226:       ifsc: \"SBIN••••••\"\n227:     },\n228:     uploaded_file_url: objectUrl,\n229:     file_type: mimeType,\n230:     file_name: file.name,\n231:     notes: `Scanned from user uploaded document: ${file.name}. View original photo on the left to verify numbers.`\n232:   };\n233: \n234:   return sanitizeInvoiceData(cleanExtracted);\n235: }\n236: \n237: /**\n238:  * Extracts plain text from PDF using PDF.js\n239:  */\n240: async function extractTextFromPdf(file) {\n241:   const arrayBuffer = await file.arrayBuffer();\n242:   const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;\n243:   let fullText = \"\";\n244: \n245:   for (let i = 1; i <= Math.min(3, pdf.numPages); i++) {\n246:     const page = await pdf.getPage(i);\n247:     const textContent = await page.getTextContent();\n248:     const pageStrings = textContent.items.map(item => item.str);\n249:     fullText += pageStrings.join(\" \") + \"\\n\";\n250:   }\n251: \n252:   return fullText;\n253: }\n254: \n255: /**\n256:  * Converts File to Base64\n257:  */\n258: function fileToBase64(file) {\n259:   return new Promise((resolve, reject) => {\n260:     const reader = new FileReader();\n261:     reader.onload = () => resolve(reader.result);\n262:     reader.onerror = reject;\n263:     reader.readAsDataURL(file);\n264:   });\n265: }"}
{"step_index":333,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T16:43:20Z","input_tokens":3750,"cache_read_tokens":19054,"output_tokens":721,"thinking":"The current code directly parses the raw text from the Gemini API as JSON. This structure assumes the API consistently returns valid JSON. It's likely the system prompt instructs it to return JSON; however, the parsing step could fail if the returned text is malformed or deviates from expected formatting. Examining the `sanitizeInvoiceData` function to check for data validation and potential error handling within the invoice data sanitization.\n\n\nThe parsing rules highlight a key distinction: separating header metadata from itemized table data to prevent misclassification. Specifically, GSTINs or other header information are not line items. The updated prompt will clarify these exclusion rules to ensure only valid goods or services are extracted.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":150,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/invoiceTextParser.js","StartLine":1}}]}
{"step_index":334,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:28Z","content":"Created At: 2026-11-02T22:13:28+05:30\nCompleted At: 2026-11-02T22:13:28+05:30\nShowing lines 1-150 of 329\n1: // Client-Side Invoice Text Parser\n2: // Takes raw OCR or PDF text and extracts real structured fields without hallucinating fake items\n3: \n4: import { round2 } from \"./auditEngine.js\";\n5: \n6: /**\n7:  * Standard Indian GSTIN Regex\n8:  */\n9: const GSTIN_REGEX = /\\b[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n10: \n11: /**\n12:  * Common Date patterns (DD/MM/YYYY, DD-MM-YYYY, DD.MM.YYYY, DD Month YYYY)\n13:  */\n14: const DATE_REGEX = /\\b(\\d{1,2})[-/\\.](\\d{1,2})[-/\\.](\\d{2,4})\\b|\\b(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s,]+(\\d{2,4})\\b/i;\n15: \n16: /**\n17:  * Clean currency string to a float number (e.g. \"₹ 1,250.50\" -> 1250.50)\n18:  */\n19: function cleanNumber(str) {\n20:   if (!str) return 0;\n21:   const cleaned = str.replace(/[₹Rs\\.,\\s]/gi, m => (m === '.' ? '.' : ''));\n22:   // Handle commas as decimal separator if any\n23:   const normalized = str.replace(/[₹Rs\\s]/gi, '').replace(/,/g, '');\n24:   const num = parseFloat(normalized);\n25:   return isNaN(num) ? 0 : round2(num);\n26: }\n27: \n28: /**\n29:  * Checks if raw text contains commercial invoice keywords\n30:  */\n31: export function isLikelyInvoice(text) {\n32:   if (!text || text.trim().length < 15) return false;\n33: \n34:   const invoiceKeywords = [\n35:     \"invoice\", \"tax invoice\", \"bill\", \"cash memo\", \"parcha\", \"challan\",\n36:     \"gst\", \"gstin\", \"subtotal\", \"total\", \"grand total\", \"qty\", \"rate\", \n37:     \"amount\", \"hsn\", \"cgst\", \"sgst\", \"igst\", \"balance\", \"payable\", \"rupees\", \"mrp\"\n38:   ];\n39: \n40:   const lower = text.toLowerCase();\n41:   let matches = 0;\n42:   for (const kw of invoiceKeywords) {\n43:     if (lower.includes(kw)) matches++;\n44:   }\n45: \n46:   // At least 2 invoice keywords or a valid GSTIN pattern must be present\n47:   return matches >= 2 || GSTIN_REGEX.test(text);\n48: }\n49: \n50: /**\n51:  * Parses raw text into structured Invoice JSON matching our application schema\n52:  */\n53: export function parseInvoiceText(rawText, sourceFileName = \"Uploaded Bill\") {\n54:   const lines = rawText\n55:     .split(/\\r?\\n/)\n56:     .map(l => l.trim())\n57:     .filter(l => l.length > 0);\n58: \n59:   // 1. Check validity\n60:   if (!isLikelyInvoice(rawText)) {\n61:     return {\n62:       is_valid_bill: false,\n63:       rejection_reason: \"Uploaded document does not contain commercial invoice text, GSTIN, or billing line items.\",\n64:       unreadable_fields: [],\n65:       vendor_name: null,\n66:       vendor_address: null,\n67:       gstin: null,\n68:       invoice_no: null,\n69:       date: null,\n70:       items: [],\n71:       subtotal: null,\n72:       cgst: null,\n73:       sgst: null,\n74:       igst: null,\n75:       total_declared: null,\n76:       raw_ocr_text: rawText\n77:     };\n78:   }\n79: \n80:   const unreadable_fields = [];\n81: \n82:   // 2. Extract GSTIN\n83:   const gstinMatch = rawText.match(GSTIN_REGEX);\n84:   const gstin = gstinMatch ? gstinMatch[0].toUpperCase() : null;\n85:   if (!gstin) unreadable_fields.push(\"gstin\");\n86: \n87:   // 3. Extract Invoice Number\n88:   let invoice_no = null;\n89:   for (const line of lines) {\n90:     const invMatch = line.match(/(?:inv(?:oice)?|bill|memo|parcha|challan)[\\s#.:\\-_]+([A-Za-z0-9\\/-]+)/i);\n91:     if (invMatch && invMatch[1] && invMatch[1].length >= 2) {\n92:       invoice_no = invMatch[1].trim();\n93:       break;\n94:     }\n95:   }\n96:   if (!invoice_no) {\n97:     // Look for standalone alphanumeric code\n98:     const fallbackMatch = rawText.match(/\\b([A-Z]{2,4}\\/[\\d]{2,4}\\/[\\d]+)\\b/);\n99:     if (fallbackMatch) invoice_no = fallbackMatch[1];\n100:     else unreadable_fields.push(\"invoice_no\");\n101:   }\n102: \n103:   // 4. Extract Date\n104:   let date = null;\n105:   const dateMatch = rawText.match(DATE_REGEX);\n106:   if (dateMatch) {\n107:     date = dateMatch[0].trim();\n108:   } else {\n109:     unreadable_fields.push(\"date\");\n110:   }\n111: \n112:   // 5. Extract Vendor Name (usually the prominent text in the first 3 lines)\n113:   let vendor_name = null;\n114:   for (let i = 0; i < Math.min(5, lines.length); i++) {\n115:     const line = lines[i];\n116:     // Ignore generic headers like \"TAX INVOICE\", \"ORIGINAL FOR RECIPIENT\"\n117:     if (!/tax invoice|original|duplicate|retail invoice|cash memo/i.test(line) && line.length > 3) {\n118:       vendor_name = line;\n119:       break;\n120:     }\n121:   }\n122:   if (!vendor_name) {\n123:     vendor_name = sourceFileName.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \") + \" (Extracted)\";\n124:   }\n125: \n126:   // 6. Extract Line Items from table rows\n127:   const items = [];\n128:   const itemCandidateRegex = /^(?:(\\d+)[\\.\\s]+)?([A-Za-z0-9\\s\\(\\)%\\/-]+?)\\s+(\\d+(?:\\.\\d+)?)\\s+(?:₹|Rs\\.?\\s*)?(\\d+(?:\\.\\d+)?)\\s+(?:₹|Rs\\.?\\s*)?(\\d+(?:\\.\\d+)?)$/i;\n129: \n130:   for (let i = 0; i < lines.length; i++) {\n131:     const line = lines[i];\n132: \n133:     // Skip header lines\n134:     if (/item\\s+desc|description|particulars|qty|rate|amount|hsn/i.test(line) && /rate|amount/i.test(line)) {\n135:       continue;\n136:     }\n137:     // Skip summary lines\n138:     if (/subtotal|sub\\s+total|total|cgst|sgst|igst|grand\\s+total|round\\s+off/i.test(line)) {\n139:       continue;\n140:     }\n141: \n142:     // Try standard pattern: Description Qty Rate Amount\n143:     const match = line.match(itemCandidateRegex);\n144:     if (match) {\n145:       const desc = match[2].trim();\n146:       const qty = parseFloat(match[3]) || 1;\n147:       const rate = parseFloat(match[4]) || 0;\n148:       const amount = parseFloat(match[5]) || round2(qty * rate);\n149: \n150:       if (desc.length >= 2 && amount > 0) {"}
