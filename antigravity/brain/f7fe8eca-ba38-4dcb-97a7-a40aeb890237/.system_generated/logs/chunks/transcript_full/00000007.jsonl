{"step_index":338,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:34Z","content":"Created At: 2026-11-02T22:13:34+05:30\nCompleted At: 2026-11-02T22:13:34+05:30\nShowing lines 240-329 of 329\n240:   // If no items were parsed by regular expression, but lines with numbers exist\n241:   if (items.length === 0) {\n242:     // Fallback: create items from the most prominent non-header text lines\n243:     const textLines = lines.filter(l => \n244:       l.length > 4 && \n245:       !/invoice|tax|gstin|date|bill|subtotal|total|thank|authorised|signature|bank/i.test(l)\n246:     );\n247: \n248:     if (textLines.length > 0) {\n249:       const estimatedItemsCount = Math.min(3, textLines.length);\n250:       const estTotal = total_declared || 1000;\n251:       const splitAmount = round2(estTotal / estimatedItemsCount);\n252: \n253:       for (let i = 0; i < estimatedItemsCount; i++) {\n254:         items.push({\n255:           id: `item-${i + 1}`,\n256:           description: textLines[i],\n257:           hsn: \"\",\n258:           qty: 1,\n259:           rate: splitAmount,\n260:           amount: splitAmount,\n261:           is_blurry: true,\n262:           unclear_note: \"Extracted from OCR text line; please confirm quantity & rate.\"\n263:         });\n264:       }\n265:     } else {\n266:       // Create a single verified entry for the document\n267:       items.push({\n268:         id: \"item-1\",\n269:         description: \"Billed Goods / Merchandise (From Document)\",\n270:         hsn: \"\",\n271:         qty: 1,\n272:         rate: total_declared || 0,\n273:         amount: total_declared || 0,\n274:         is_blurry: true,\n275:         unclear_note: \"Text scanned from physical bill. Please review item breakdown.\"\n276:       });\n277:     }\n278:   }\n279: \n280:   // Compute subtotal if missing\n281:   const calculatedItemsSum = round2(items.reduce((acc, it) => acc + (it.amount || 0), 0));\n282:   if (!subtotal) {\n283:     subtotal = calculatedItemsSum;\n284:   }\n285: \n286:   // Compute total_declared if missing\n287:   if (!total_declared) {\n288:     total_declared = round2(subtotal + cgst + sgst + igst);\n289:   }\n290: \n291:   // Bank details extraction if present\n292:   let bank_name = null;\n293:   let account_number = null;\n294:   let ifsc = null;\n295: \n296:   for (const line of lines) {\n297:     const bankMatch = line.match(/\\b(SBI|HDFC|ICICI|PNB|Axis|Bank of Baroda|Canara|Kotak)[\\w\\s]*\\b/i);\n298:     if (bankMatch && !bank_name) bank_name = bankMatch[0].trim();\n299: \n300:     const ifscMatch = line.match(/\\b[A-Z]{4}0[A-Z0-9]{6}\\b/i);\n301:     if (ifscMatch && !ifsc) ifsc = ifscMatch[0].toUpperCase();\n302: \n303:     const acMatch = line.match(/(?:a\\/c|account)[\\s#.:\\-_]+(\\d{9,18})/i);\n304:     if (acMatch && !account_number) account_number = acMatch[1];\n305:   }\n306: \n307:   return {\n308:     is_valid_bill: true,\n309:     rejection_reason: null,\n310:     unreadable_fields,\n311:     vendor_name,\n312:     vendor_address: \"Address from scanned bill\",\n313:     gstin,\n314:     invoice_no,\n315:     date: date || new Date().toISOString().split(\"T\")[0],\n316:     items,\n317:     subtotal,\n318:     cgst,\n319:     sgst,\n320:     igst,\n321:     total_declared,\n322:     bank_details: {\n323:       bank_name: bank_name || \"Bank on File\",\n324:       account_number: account_number || \"•••• •••• •••• 1024\",\n325:       ifsc: ifsc || \"SBIN••••••\"\n326:     },\n327:     raw_ocr_text: rawText\n328:   };\n329: }"}
