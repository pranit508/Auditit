{"step_index":1253,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:55:37Z","content":"Created At: 2026-11-03T00:25:37+05:30\nCompleted At: 2026-11-03T00:25:38+05:30\nShowing lines 60-130 of 288\n60:  */\n61: export async function extractInvoiceFromDocument(file, apiKey = null, onProgress = null) {\n62:   const effectiveKey = (apiKey && apiKey.trim().length > 10) ? apiKey.trim() : DEFAULT_API_KEY;\n63:   const mimeType = file.type || \"image/jpeg\";\n64:   const objectUrl = URL.createObjectURL(file);\n65: \n66:   // 1. Prioritize FastAPI + Google GenAI (/api/analyze-bill) backend endpoint\n67:   try {\n68:     if (onProgress) onProgress(\"Uploading bill to FastAPI backend (Gemini 2.5 Flash)...\");\n69:     const formData = new FormData();\n70:     formData.append(\"file\", file);\n71: \n72:     const headers = {\n73:       \"x-api-key\": effectiveKey\n74:     };\n75: \n76:     const backendResp = await fetch(\"/api/analyze-bill\", {\n77:       method: \"POST\",\n78:       headers,\n79:       body: formData\n80:     });\n81: \n82:     if (backendResp.ok) {\n83:       const rawText = await backendResp.text();\n84:       let parsed = null;\n85:       try {\n86:         parsed = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n87:         if (typeof parsed === \"string\") {\n88:           parsed = JSON.parse(parsed);\n89:         }\n90:       } catch (e) {\n91:         console.warn(\"Could not parse backend JSON:\", e);\n92:       }\n93: \n94:       if (parsed && typeof parsed === \"object\") {\n95:         parsed.uploaded_file_url = objectUrl;\n96:         parsed.file_type = mimeType;\n97:         parsed.file_name = file.name;\n98: \n99:         // Map ExtractedInvoice schema to app schema\n100:         if (parsed.invoice_number && !parsed.invoice_no) {\n101:           parsed.invoice_no = parsed.invoice_number;\n102:         }\n103:         if (parsed.declared_total !== undefined && parsed.total_declared === undefined) {\n104:           parsed.total_declared = parsed.declared_total;\n105:         }\n106: \n107:         // Apply sanitizeAndCleanInvoice and item cleaning\n108:         const cleaned = sanitizeAndCleanInvoice(parsed);\n109:         if (cleaned.items && Array.isArray(cleaned.items)) {\n110:           cleaned.items = cleanExtractedItems(cleaned.items);\n111:         }\n112: \n113:         // If declared_total is suspiciously smaller than subtotal, reject the OCR hallucination:\n114:         if (Number(cleaned.subtotal || 0) > 0 && Number(cleaned.declared_total || 0) < (Number(cleaned.subtotal || 0) * 0.5)) {\n115:           const fallbackTotal = Math.round((Number(cleaned.subtotal || 0) + Number(cleaned.cgst || 0) + Number(cleaned.sgst || 0) + Number(cleaned.igst || 0)) * 100) / 100;\n116:           cleaned.declared_total = fallbackTotal;\n117:           cleaned.total_declared = fallbackTotal;\n118:         }\n119: \n120:         return sanitizeInvoiceData(cleaned);\n121:       }\n122:     } else {\n123:       const errData = await backendResp.json().catch(() => ({}));\n124:       console.warn(\"FastAPI backend returned:\", backendResp.status, errData);\n125:     }\n126:   } catch (backendErr) {\n127:     console.warn(\"FastAPI /api/analyze-bill unreachable; falling back:\", backendErr);\n128:   }\n129: \n130:   const base64Data = await fileToBase64(file);"}
