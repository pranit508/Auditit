e items\n212:       extractedInvoice = sanitizeAndCleanInvoice(extractedInvoice);\n213:       if (extractedInvoice && Array.isArray(extractedInvoice.items)) {\n214:         extractedInvoice.items = cleanExtractedItems(extractedInvoice.items);\n215:       }\n216:       extractedInvoice = sanitizeInvoiceData(extractedInvoice);\n217: \n218:       this.currentInvoice = extractedInvoice;\n219:       this.currentAudit = auditInvoice(this.currentInvoice);\n220: \n221:       // Compute code-calculated tax & deemed profit under Sec 44AD\n222:       const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n223:       const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n224:       this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n225: \n226:       this.currentView = \"review\";\n227:       this.hideProcessingOverlay();\n228:       this.render();\n229:       window.scrollTo({ top: 0, behavior: \"smooth\" });\n230: \n231:       this.showToast(\"Invoice analyzed by Gemini 2.5 Flash successfully!\", \"success\");\n232:     } catch (err) {\n233:       this.hideProcessingOverlay();\n234:       this.showToast(\"Could not process invoice: \" + err.message, \"error\");\n235:     }\n236:   }\n237: \n238:   handleUpdateItem(index, action, value) {\n239:     if (!this.currentInvoice || !this.currentInvoice.items[index]) return;\n240: \n241:     const item = this.currentInvoice.items[index];\n242:     if (action === \"edit-desc\") {\n243:       item.description = value;\n244:     } else if (action === \"edit-qty\") {\n245:       item.qty = value;\n246:     } else if (action === \"edit-rate\") {\n247:       item.rate = value;\n248:       item.is_blurry = false;\n249:     } else if (action === \"edit-amount\") {\n250:       item.amount = value;"}
