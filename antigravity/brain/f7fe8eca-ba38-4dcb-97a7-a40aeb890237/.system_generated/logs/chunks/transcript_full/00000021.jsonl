 0) < (Number(cleaned.subtotal || 0) * 0.5)) {\n173:             const fallbackTotal = Math.round((Number(cleaned.subtotal || 0) + Number(cleaned.cgst || 0) + Number(cleaned.sgst || 0) + Number(cleaned.igst || 0)) * 100) / 100;\n174:             cleaned.declared_total = fallbackTotal;\n175:             cleaned.total_declared = fallbackTotal;\n176:           }\n177:           cleaned.uploaded_file_url = objectUrl;\n178:           cleaned.file_type = mimeType;\n179:           cleaned.file_name = file.name;\n180:           return sanitizeInvoiceData(cleaned);\n181:         }\n182:       }\n183:     } catch (err) {\n184:       console.warn(\"Gemini multimodal call failed; continuing with client-side OCR:\", err);\n185:     }\n186:   }\n187: \n188:   // 2. Client-side Real OCR for PDFs\n189:   if (mimeType.includes(\"pdf\") && window.pdfjsLib) {\n190:     if (onProgress) onProgress(\"Extracting text from PDF document...\");\n191:     try {\n192:       const pdfText = await extractTextFromPdf(file);\n193:       if (pdfText && pdfText.trim().length > 10) {\n194:         const parsed = parseInvoiceText(pdfText, file.name);\n195:         parsed.uploaded_file_url = objectUrl;\n196:         parsed.file_type = mimeType;\n197:         parsed.file_name = file.name;\n198:         return sanitizeInvoiceData(parsed);\n199:       }\n200:     } catch (err) {\n201:       console.warn(\"PDF.js text extraction error:\", err);\n202:     }\n203:   }\n204: \n205:   // 3. Client-side Real OCR for Images using Tesseract.js\n206:   if (window.Tesseract && (mimeType.startsWith(\"image/\") || !mimeType.includes(\"pdf\"))) {\n207:     if (onProgress) onProgress(\"Running on-device OCR on bill image...\");\n208:     try {\n209:       const ocrResult = await window.Tesseract.recognize(file, \"eng\", {\n210:         logger: m => {\n211:           if (onProgress && m.status === \"recognizing text\" && m.progress) {\n212:             onProgress(`Reading bill text: ${Math.round(m.progress * 100)}%`);\n213:           }\n214:         }\n215:       });\n216: \n217:       const extractedText = ocrResult?.data?.text || \"\";\n218:       if (extractedText.trim().length > 15) {\n219:         const parsed = parseInvoiceText(extractedText, file.name);\n220:         parsed.uploaded_file_url = objectUrl;\n221:         parsed.file_type = mimeType;\n222:         parsed.file_name = file.name;\n223:         return sanitizeInvoiceData(parsed);\n224:       }\n225:     } catch (err) {\n226:       console.warn(\"Tesseract OCR error:\", err);\n227:     }\n228:   }\n229: \n230:   // Fallback if network and OCR are offline: Return empty structure without dummy items\n231:   const cleanDocName = file.name.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \");\n232: \n233:   const cleanExtracted = {\n234:     id: \"uploaded-\" + Date.now(),\n235:     scenarioName: `Bill: ${file.name}`,\n236:     vendor_name: cleanDocName,\n237:     vendor_address: null,\n238:     gstin: null,\n239:     invoice_no: null,\n240:     date: new Date().toISOString().split(\"T\")[0],\n241:     badge: {\n242:       text: \"Uploaded Bill\",\n243:       color: \"emerald\"\n244:     },\n245:     items: [], // RULE 3: Zero dummy items - always use actual extracted items\n246:     subtotal: 0,\n247:     cgst: 0,\n248:     sgst: 0,\n249:     igst: 0,\n250:     total_declared: 0,\n251:     bank_details: null,\n252:     uploaded_file_url: objectUrl,\n253:     file_type: mimeType,\n254:     file_name: file.name\n255:   };\n256: \n257:   return sanitizeInvoiceData(cleanExtracted);\n258: }\n259: \n260: /**"}
