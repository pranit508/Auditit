 }\n290:       if (nums.length > 0) {\n291:         cgst = nums[nums.length - 1];\n292:       }\n293:     }\n294: \n295:     // 4. SGST\n296:     if (/sgst/i.test(line) && !/subtotal|total in words/i.test(line)) {\n297:       const nums = [];\n298:       let m;\n299:       const r = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n300:       while ((m = r.exec(line)) !== null) {\n301:         if (m[1]) nums.push(parseIndianCurrency(m[1]));\n302:       }\n303:       if (nums.length > 0) {\n304:         sgst = nums[nums.length - 1];\n305:       }\n306:     }\n307: \n308:     // 5. IGST\n309:     if (/igst/i.test(line) && !/subtotal|total in words/i.test(line)) {\n310:       const nums = [];\n311:       let m;\n312:       const r = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n313:       while ((m = r.exec(line)) !== null) {\n314:         if (m[1]) nums.push(parseIndianCurrency(m[1]));\n315:       }\n316:       if (nums.length > 0) {\n317:         igst = nums[nums.length - 1];\n318:       }\n319:     }\n320: \n321:     // 6. Grand Total numeric line\n322:     if (/(?:grand\\s+total|total\\s+amount|net\\s+payable|total\\s+payable|balance\\s+due|total\\s*:|कुल\\s*योग)/i.test(line)) {\n323:       if (!/(?:in\\s+words|in\\s+word|sub\\s*total)/i.test(line)) {\n324:         const nums = [];\n325:         let m;\n326:         const r = /(?:₹\\s*)?(\\d{1,3}(?:,\\d{2,3})*(?:\\.\\d{2})?)/g;\n327:         while ((m = r.exec(line)) !== null) {\n328:           if (m[1]) nums.push(parseIndianCurrency(m[1]));\n329:         }\n330:         if (nums.length > 0) {\n331:           total_declared = nums[nums.length - 1];\n332:         }\n333:       }\n334:     }\n335:   }\n336: \n337:   // Set Billed Grand Total to word total if available or if numeric OCR misread (e.g. 2173.9 vs 4490.0)\n338:   if (word_grand_total && word_grand_total > 0) {\n339:     if (!total_declared || Math.abs(total_declared - word_grand_total) > 10) {\n340:       console.info(\"[AUDIT IT] Setting Billed Grand Total to \" + word_grand_total + \" from 'Total in words' (corrected from \" + total_declared + \")\");\n341:       total_declared = word_grand_total;\n342:     }\n343:   }\n344: \n345:   // Clean extracted items to purge any metadata/GSTIN/phone lines\n346:   const itemsToUse = cleanExtractedItems(items);\n347: \n348:   // 1. SUB-TOTAL CALCULATION:\n349:   // Do not trust random OCR numbers near the bank details for Subtotal.\n350:   // Calculate the Subtotal deterministically from the extracted items:\n351:   // subtotal = sum(item.quantity * item.unit_rate for item in items)\n352:   // For this bill: 2535 + 1270 = 3805.00.\n353:   const calculatedItemsSum = round2(itemsToUse.reduce((acc, it) => acc + ((it.quantity || it.qty || 1) * (it.unit_rate || it.rate || 0)), 0));\n354:   if (calculatedItemsSum > 0) {\n355:     subtotal = calculatedItemsSum;\n356:   }\n357: \n358:   // 2. GRAND TOTAL SANITY CHECK:\n359:   // Grand Total must be approximately (Subtotal + Total Tax).\n360:   // If the OCR extracted '774' or '585132', reject them because they are bank/account/IFSC digits.\n361:   const expectedTotal = round2(subtotal + cgst + sgst + igst);\n362:   let isDeclaredSuspicious = false;\n363:   if (expectedTotal > 0) {\n364:     if (!total_declared || total_declared <= 0) {\n365:       isDeclaredSuspicious = true;\n366:     } else if (total_declared < (expectedTotal * 0.70) || total_declared > (expectedTotal * 1.50)) {\n367:       isDeclaredSuspicious = true;\n368:     }\n369:   }\n370: \n371:   if (word_grand_total && word_grand_total > 0) {\n372:     total_declared = word_grand_total;\n373:   } else if (isDeclaredSuspicious && expectedTotal > 0) {\n374:     total_declared = Math.abs(expectedTotal - Math.round(expectedTotal)) < 0.20 ? Math.round(expectedTotal) : expectedTotal;\n375:   }"}
