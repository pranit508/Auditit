{"step_index":2053,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-03T08:39:51Z","content":"Created At: 2026-11-03T14:09:51+05:30\nCompleted At: 2026-11-03T14:09:52+05:30\nShowing lines 601-750 of 902\n601:               <span class=\"text-[10px] text-slate-400 block uppercase font-sans\">Section 87A Tax Rebate</span>\n602:               <span class=\"text-base font-bold ${isRebateEligible ? 'text-emerald-600' : 'text-slate-500'}\">\n603:                 ${isRebateEligible ? `100% (- ${formatRupees(rebate87a)})` : 'None (Income > 7L)'}\n604:               </span>\n605:             </div>\n606: \n607:             <div class=\"p-2.5 rounded-lg bg-white border border-slate-200\">\n608:               <span class=\"text-[10px] text-slate-400 block uppercase font-sans\">Total Estimated Tax</span>\n609:               <span class=\"text-base font-bold ${totalTaxPayable === 0 ? 'text-emerald-700' : 'text-slate-900'}\">\n610:                 ${totalTaxPayable === 0 ? '₹0.00' : formatRupees(totalTaxPayable)}\n611:               </span>\n612:             </div>\n613:           </div>\n614: \n615:           <!-- Section 87A Banner -->\n616:           <div class=\"p-3 rounded-lg ${isRebateEligible ? 'bg-emerald-100/70 border border-emerald-300 text-emerald-950' : 'bg-slate-200/60 border border-slate-300 text-slate-800'} text-xs flex items-center justify-between\">\n617:             <span class=\"font-medium\">\n618:               ${isRebateEligible \n619:                 ? '🎉 <strong>₹0 Tax Payable:</strong> Net Taxable Income is within the statutory ₹7,00,000 New Regime ceiling, qualifying for 100% tax rebate under Section 87A.' \n620:                 : 'Standard New Regime slab rates applied.'}\n621:             </span>\n622:             <span class=\"text-[10px] font-bold px-2 py-0.5 rounded ${isRebateEligible ? 'bg-emerald-200 text-emerald-900' : 'bg-slate-300 text-slate-700'}\">\n623:               ${isRebateEligible ? 'Zero Tax' : 'Taxable'}\n624:             </span>\n625:           </div>\n626: \n627:           <!-- Section 44AB Tax Audit Check -->\n628:           <div class=\"p-3 rounded-lg bg-white border border-slate-200 text-xs flex items-center justify-between\">\n629:             <div>\n630:               <span class=\"font-bold text-slate-800\">Section 44AB Tax Audit Applicability:</span>\n631:               <span class=\"text-slate-600 block text-[11px] mt-0.5\">${auditRuleMessage}</span>\n632:             </div>\n633:             <span class=\"text-[10px] font-bold px-2.5 py-1 rounded-full ${isAuditRequired ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}\">\n634:               ${isAuditRequired ? 'Audit Required' : 'Exempt'}\n635:             </span>\n636:           </div>\n637:         </div>\n638: \n639:       </div>\n640: \n641:     </div>\n642:   `;\n643: \n644:   // Attach event handlers\n645:   setupLedgerHandlers(container, {\n646:     bills,\n647:     state,\n648:     onUpdateState,\n649:     onViewBill,\n650:     onDeleteBill,\n651:     onClearBills,\n652:     onSaveCurrentBill,\n653:     currentInvoice,\n654:     currentAudit,\n655:     totalPurchases,\n656:     totalClaimableITC,\n657:     totalCgstPool,\n658:     totalSgstPool,\n659:     totalIgstPool,\n660:     annualTurnover,\n661:     calcMode,\n662:     netTaxableProfit,\n663:     netTaxableIncome,\n664:     totalTaxPayable,\n665:     isRebateEligible\n666:   });\n667: }\n668: \n669: /**\n670:  * Binds event handlers for Tab 2 actions\n671:  */\n672: function setupLedgerHandlers(container, props) {\n673:   const {\n674:     bills,\n675:     state,\n676:     onUpdateState,\n677:     onViewBill,\n678:     onDeleteBill,\n679:     onClearBills,\n680:     onSaveCurrentBill,\n681:     totalPurchases,\n682:     totalClaimableITC,\n683:     totalCgstPool,\n684:     totalSgstPool,\n685:     totalIgstPool,\n686:     annualTurnover,\n687:     calcMode,\n688:     netTaxableProfit,\n689:     netTaxableIncome,\n690:     totalTaxPayable,\n691:     isRebateEligible\n692:   } = props;\n693: \n694:   // 1. Save Current Bill to Ledger\n695:   const btnSaveFromTab2 = container.querySelector(\"#btn-save-current-from-tab2\");\n696:   if (btnSaveFromTab2 && onSaveCurrentBill) {\n697:     btnSaveFromTab2.addEventListener(\"click\", onSaveCurrentBill);\n698:   }\n699: \n700:   const btnSaveCurrentEmpty = container.querySelector(\"#btn-save-current-empty\");\n701:   if (btnSaveCurrentEmpty && onSaveCurrentBill) {\n702:     btnSaveCurrentEmpty.addEventListener(\"click\", onSaveCurrentBill);\n703:   }\n704: \n705:   // 2. Clear All Stored Bills\n706:   const btnClearAll = container.querySelector(\"#btn-clear-all-bills\");\n707:   if (btnClearAll && onClearBills) {\n708:     btnClearAll.addEventListener(\"click\", () => {\n709:       if (confirm(\"Are you sure you want to clear all stored verified bills from the Tax Ledger?\")) {\n710:         onClearBills();\n711:       }\n712:     });\n713:   }\n714: \n715:   // 3. View / Delete individual bills\n716:   container.querySelectorAll(\"button[data-action='view-bill']\").forEach(btn => {\n717:     btn.addEventListener(\"click\", () => {\n718:       const idx = parseInt(btn.getAttribute(\"data-index\"), 10);\n719:       if (bills[idx] && onViewBill) {\n720:         onViewBill(bills[idx]);\n721:       }\n722:     });\n723:   });\n724: \n725:   container.querySelectorAll(\"button[data-action='delete-bill']\").forEach(btn => {\n726:     btn.addEventListener(\"click\", () => {\n727:       const idx = parseInt(btn.getAttribute(\"data-index\"), 10);\n728:       if (bills[idx] && onDeleteBill) {\n729:         onDeleteBill(bills[idx].id || idx);\n730:       }\n731:     });\n732:   });\n733: \n734:   // 4. Annual Turnover Input\n735:   const inputTurnover = container.querySelector(\"#input-ledger-turnover\");\n736:   if (inputTurnover && onUpdateState) {\n737:     inputTurnover.addEventListener(\"input\", (e) => {\n738:       onUpdateState({ annualTurnover: parseFloat(e.target.value) || 0 });\n739:     });\n740:   }\n741: \n742:   // 5. Scheme Toggles (44AD vs Regular)\n743:   const btn44ad = container.querySelector(\"#btn-ledger-mode-44ad\");\n744:   const btnRegular = container.querySelector(\"#btn-ledger-mode-regular\");\n745:   if (btn44ad && onUpdateState) {\n746:     btn44ad.addEventListener(\"click\", () => onUpdateState({ calcMode: '44AD' }));\n747:   }\n748:   if (btnRegular && onUpdateState) {\n749:     btnRegular.addEventListener(\"click\", () => onUpdateState({ calcMode: 'REGULAR' }));\n750:   }"}
