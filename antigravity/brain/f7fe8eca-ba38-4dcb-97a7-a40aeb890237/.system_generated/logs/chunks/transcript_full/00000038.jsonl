dEventListener(\"input\", (e) => {\n792:       onUpdateState({ operatingExpenses: parseFloat(e.target.value) || 0 });\n793:     });\n794:   }\n795: \n796:   // 8. Export CSV & Print\n797:   const btnExportCsv = container.querySelector(\"#btn-export-consolidated-csv\");\n798:   if (btnExportCsv) {\n799:     btnExportCsv.addEventListener(\"click\", () => exportConsolidatedTaxCsv({\n800:       bills,\n801:       totalPurchases,\n802:       totalClaimableITC,\n803:       totalCgstPool,\n804:       totalSgstPool,\n805:       totalIgstPool,\n806:       annualTurnover,\n807:       calcMode,\n808:       netTaxableProfit,\n809:       netTaxableIncome,\n810:       totalTaxPayable,\n811:       isRebateEligible\n812:     }));\n813:   }\n814: \n815:   const btnPrint = container.querySelector(\"#btn-print-consolidated-sheet\");\n816:   if (btnPrint) {\n817:     btnPrint.addEventListener(\"click\", () => window.print());\n818:   }\n819: }\n820: \n821: /**\n822:  * Generates and downloads a clean UTF-8 CSV containing all stored bills and ITR computation\n823:  */\n824: function exportConsolidatedTaxCsv(data) {\n825:   const {\n826:     bills,\n827:     totalPurchases,\n828:     totalClaimableITC,\n829:     totalCgstPool,\n830:     totalSgstPool,\n831:     totalIgstPool,\n832:     annualTurnover,\n833:     calcMode,\n834:     netTaxableProfit,\n835:     netTaxableIncome,\n836:     totalTaxPayable,\n837:     isRebateEligible\n838:   } = data;\n839: \n840:   const rows = [\n841:     [\"AUDIT IT - CONSOLIDATED TAX & ITC LEDGER REPORT\"],\n842:     [\"Financial Year\", \"FY 2025-26\", \"Assessment Year\", \"AY 2026-27\"],\n843:     [\"Generated On\", new Date().toLocaleString(\"en-IN\")],\n844:     [],\n845:     [\"--- ACCUMULATED LEDGER SUMMARY ---\"],\n846:     [\"Total Bills Verified\", bills.length],\n847:     [\"Total Purchase Expenditure (COGS) (₹)\", totalPurchases],\n848:     [\"Total Claimable GST ITC (₹)\", totalClaimableITC],\n849:     [\"Accumulated CGST Pool (₹)\", totalCgstPool],\n850:     [\"Accumulated SGST Pool (₹)\", totalSgstPool],\n851:     [\"Accumulated IGST Pool (₹)\", totalIgstPool],\n852:     [],\n853:     [\"--- STORED VERIFIED BILLS ---\"],\n854:     [\"Invoice No\", \"Date\", \"Supplier Name\", \"Supplier GSTIN\", \"Subtotal (₹)\", \"CGST (₹)\", \"SGST (₹)\", \"IGST (₹)\", \"Verified Total (₹)\"],\n855:     ...bills.map(b => [\n856:       b.invoice_no || \"\",\n857:       b.date || \"\",\n858:       b.vendor_name || \"\",\n859:       b.gstin || \"\",\n860:       b.subtotal || 0,\n861:       b.cgst || 0,\n862:       b.sgst || 0,\n863:       b.igst || 0,\n864:       b.verified_total || 0\n865:     ]),\n866:     [],\n867:     [\"--- ANNUAL BUSINESS ITR TAX COMPUTATION ---\"],\n868:     [\"Selected Filing Scheme\", calcMode === '44AD' ? \"Presumptive Taxation (Section 44AD - ITR-4)\" : \"Normal Business P&L (ITR-3)\"],\n869:     [\"Annual Gross Turnover / Revenue (₹)\", annualTurnover],\n870:     [\"Net Taxable Business Profit (₹)\", netTaxableProfit],\n871:     [\"Standard Deduction u/s 16/57 (₹)\", 75000],\n872:     [\"Net Taxable Income (₹)\", netTaxableIncome],\n873:     [\"Section 87A Full Rebate Status\", isRebateEligible ? \"YES (100% Tax Waiver under Sec 87A)\" : \"NO\"],\n874:     [\"TOTAL ESTIMATED INCOME TAX PAYABLE (₹)\", totalTaxPayable],\n875:     [],\n876:     [\"--- STATUTORY COMPLIANCE NOTES ---\"],\n877:     [\"Section 16 Rule\", \"Settle vendor payment within 180 days from invoice date to prevent ITC reversal.\"]\n878:   ];\n879: \n880:   const csvContent = rows\n881:     .map(row => Array.isArray(row) ? row.map(cell => `\"${String(cell).replace(/\"/g, '\"\"')}\"`).join(\",\") : \"\")\n882:     .join(\"\\r\\n\");\n883: \n884:   const blob = new Blob([\"\\uFEFF\" + csvContent], { type: \"text/csv;charset=utf-8;\" });\n885:   const url = URL.createObjectURL(blob);\n886:   const a = document.createElement(\"a\");\n887:   a.href = url;\n888:   a.download = `AUDIT_IT_Consolidated_Tax_Ledger_${new Date().toISOString().slice(0, 10)}.csv`;\n889:   document.body.appendChild(a);\n890:   a.click();\n891:   document.body.removeChild(a);\n892:   URL.revokeObjectURL(url);\n893: }\n894: \n895: // Default export\n896: export default function TaxAndITRTab(props) {\n897:   if (props && props.target) {\n898:     renderTaxAndITRTab(props.target, props);\n899:     return props.target;\n900:   }\n901:   return props;\n902: }"}
