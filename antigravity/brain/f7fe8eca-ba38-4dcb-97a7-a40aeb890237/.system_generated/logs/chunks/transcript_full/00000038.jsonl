chases across saved bills (unless custom overridden)\n53:   const purchaseCosts = state.customPurchaseCosts !== null && state.customPurchaseCosts !== undefined\n54:     ? Number(state.customPurchaseCosts)\n55:     : totalPurchases;\n56:   const operatingExpenses = Math.max(0, Number(state.operatingExpenses !== undefined ? state.operatingExpenses : 450000));\n57: \n58:   let netTaxableProfit = 0;\n59:   let digitalSales = 0;\n60:   let cashSales = 0;\n61:   let digitalProfit = 0;\n62:   let cashProfit = 0;\n63:   let totalExpensesRegular = 0;\n64: \n65:   if (calcMode === '44AD') {\n66:     digitalSales = round2(annualTurnover * (digitalShare / 100));\n67:     cashSales = round2(annualTurnover * (cashShare / 100));\n68:     digitalProfit = round2(digitalSales * (digitalRate / 100));\n69:     cashProfit = round2(cashSales * (cashProfitRate / 100 || cashRate / 100));\n70:     netTaxableProfit = round2(digitalProfit + cashProfit);\n71:   } else {\n72:     totalExpensesRegular = round2(purchaseCosts + operatingExpenses);\n73:     netTaxableProfit = Math.max(0, round2(annualTurnover - totalExpensesRegular));\n74:   }\n75: \n76:   // New Tax Regime Slabs & 87A Full Rebate\n77:   const standardDeduction = 75000;\n78:   const netTaxableIncome = Math.max(0, round2(netTaxableProfit - standardDeduction));\n79: \n80:   let baseTax = 0;\n81:   if (netTaxableIncome > 300000) {\n82:     if (netTaxableIncome <= 700000) {\n83:       baseTax = (netTaxableIncome - 300000) * 0.05;\n84:     } else if (netTaxableIncome <= 1000000) {\n85:       baseTax = 20000 + (netTaxableIncome - 700000) * 0.10;\n86:     } else if (netTaxableIncome <= 1200000) {\n87:       baseTax = 50000 + (netTaxableIncome - 1000000) * 0.15;\n88:     } else if (netTaxableIncome <= 1500000) {\n89:       baseTax = 80000 + (netTaxableIncome - 1200000) * 0.20;\n90:     } else {\n91:       baseTax = 140000 + (netTaxableIncome - 1500000) * 0.30;\n92:     }\n93:   }\n94:   baseTax = round2(baseTax);\n95: \n96:   const isRebateEligible = netTaxableIncome <= 700000;\n97:   const rebate87a = isRebateEligible ? baseTax : 0;\n98:   const taxAfterRebate = Math.max(0, round2(baseTax - rebate87a));\n99:   const cess = round2(taxAfterRebate * 0.04);\n100:   const totalTaxPayable = round2(taxAfterRebate + cess);"}
