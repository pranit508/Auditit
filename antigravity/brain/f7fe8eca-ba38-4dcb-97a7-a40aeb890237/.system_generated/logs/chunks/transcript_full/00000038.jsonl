   <th class=\"px-3 py-2.5 font-bold text-right\">Verified Total</th>\n336:                   <th class=\"px-3 py-2.5 font-bold text-center\">Actions</th>\n337:                 </tr>\n338:               </thead>\n339:               <tbody class=\"divide-y divide-slate-100\">\n340:                 ${bills.map((b, idx) => {\n341:                   const gstinUpper = (b.gstin || \"\").trim().toUpperCase();\n342:                   const isGstinValid = GSTIN_REGEX.test(gstinUpper);\n343: \n344:                   return `\n345:                     <tr class=\"hover:bg-slate-50/80 transition-colors\">\n346:                       <td class=\"px-3 py-2 font-medium text-slate-700 whitespace-nowrap\">${b.date || '—'}</td>\n347:                       <td class=\"px-3 py-2 font-bold text-indigo-700 whitespace-nowrap\">${b.invoice_no || '—'}</td>\n348:                       <td class=\"px-3 py-2 text-slate-800 font-sans max-w-[150px] truncate\" title=\"${b.vendor_name || ''}\">\n349:                         ${b.vendor_name || 'Supplier'}\n350:                       </td>\n351:                       <td class=\"px-3 py-2 whitespace-nowrap\">\n352:                         <span class=\"text-[10px] px-1.5 py-0.5 rounded font-mono ${\n353:                           isGstinValid \n354:                             ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' \n355:                             : 'bg-rose-50 text-rose-800 border border-rose-200'\n356:                         }\">\n357:                           ${b.gstin || 'MISSING'}\n358:                         </span>\n359:                       </td>\n360:                       <td class=\"px-3 py-2 text-right font-medium text-slate-700\">${formatRupees(b.subtotal)}</td>\n361:                       <td class=\"px-2 py-2 text-right text-slate-600\">${b.cgst > 0 ? formatRupees(b.cgst) : '—'}</td>\n362:                       <td class=\"px-2 py-2 text-right text-slate-600\">${b.sgst > 0 ? formatRupees(b.sgst) : '—'}</td>\n363:                       <td class=\"px-2 py-2 text-right text-slate-600\">${b.igst > 0 ? formatRupees(b.igst) : '—'}</td>\n364:                       <td class=\"px-3 py-2 text-right font-bold text-slate-900\">${formatRupees(b.verified_total)}</td>\n365:                       <td class=\"px-3 py-2 text-center whitespace-nowrap space-x-1 font-sans\">\n366:                         <button \n367:                           data-action=\"view-bill\" \n368:                           data-index=\"${idx}\"\n369:                           class=\"px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[10px] transition-all\"\n370:                           title=\"Open this bill in Tab 1 (Invoice Math Audit)\"\n371:                         >\n372:                           👁️ View\n373:                         </button>\n374:                         <button \n375:                           data-action=\"delete-bill\" \n376:                           data-index=\"${idx}\"\n377:                           class=\"px-2 py-1 rounded bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-[10px] transition-all\"\n378:                           title=\"Delete bill from ledger\"\n379:                         >\n380:                           🗑️\n381:                         </button>\n382:                       </td>\n383:                     </tr>\n384:                   `;\n385:                 }).join(\"\")}\n386:               </tbody>\n387:               <tfoot class=\"bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900\">\n388:                 <tr>\n389:                   <td colspan=\"4\" class=\"px-3 py-2 font-sans text-xs\">Total Stored Bills: ${totalBillsCount}</td>\n390:                   <td class=\"px-3 py-2 text-right text-indigo-700 font-mono\">${formatRupees(totalPurchases)}</td>\n391:                   <td class=\"px-2 py-2 text-right text-slate-700 font-mono\">${formatRupees(totalCgstPool)}</td>\n392:                   <td class=\"px-2 py-2 text-right text-slate-700 font-mono\">${formatRupees(totalSgstPool)}</td>\n393:                   <td class=\"px-2 py-2 text-right text-slate-700 font-mono\">${formatRupees(totalIgstPool)}</td>\n394:                   <td class=\"px-3 py-2 text-right text-emerald-700 font-mono\">${formatRupees(totalVerifiedBilled)}</td>\n395:                   <td></td>\n396:                 </tr>\n397:               </tfoot>\n398:             </table>\n399:           </div>\n400:         `}\n401:       </div>\n402: \n403:       <!-- SECTION C: CUSTOMIZABLE ANNUAL BUSINESS & ITR CALCULATOR (ITR-4 / ITR-3) -->\n404:       <div class=\"bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-5\">\n405:         <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3\">\n406:           <div class=\"flex items-center space-x-2\">\n407:             <span class=\"text-lg\">⚖️</span>\n408:             <div>\n409:               <h4 class=\"text-sm font-extrabold text-slate-900\">C. Annual Business & ITR Tax Planning (ITR-4 / ITR-3)</h4>\n410:               <p class=\"text-[11px] text-slate-500\">Live computation under New Tax Regime (FY 2025-26 / 2026-27)</p>\n411:             </div>\n412:           </div>\n413:           <span class=\"text-xs font-mono font-bold px-2 py-0.5 rounded bg-purple-50 text-purple-700 border border-purple-200\">\n414:             ${calcMode === '44AD' ? 'Sec 44AD Presumptive' : 'Normal Business P&L'}\n415:           </span>\n416:         </div>\n417: \n418:         <!-- Mode Toggle & Annual Turnover -->\n419:         <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n420:           <!-- Annual Turnover Input -->\n421:           <div>\n422:             <label class=\"block text-xs font-bold text-slate-700 mb-1\">\n423:               Annual Gross Sales / Turnover (₹):\n424:             </label>\n425:             <input \n426:               type=\"number\"\n427:               id=\"input-ledger-turnover\"\n428:               step=\"10000\"\n429:               value=\"${annualTurnover}\"\n430:               class=\"w-full px-3 py-2 rounded-lg border border-slate-300 font-mono text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 outline-none\"\n431:             />\n432:             <span class=\"text-[10px] text-slate-400 mt-1 block\">Expected annual retail counter sales</span>\n433:           </div>\n434: \n435:           <!-- Scheme Toggle -->\n436:           <div>\n437:             <label class=\"block text-xs font-bold text-slate-700 mb-1\">\n438:               ITR Filing Scheme:\n439:             </label>\n440:             <div class=\"grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl\">\n441:               <button \n442:                 type=\"button\"\n443:                 id=\"btn-ledger-mode-44ad\"\n444:                 class=\"py-2 px-3 rounded-lg text-xs font-bold transition-all text-center ${\n445:                   calcMode === '44AD' \n446:                     ? 'bg-white text-indigo-700 shadow-sm border border-slate-200' \n447:                     : 'text-slate-600 hover:text-slate-900'\n448:                 }\"\n449:               >\n450:                 Presumptive (Sec 44AD)"}
