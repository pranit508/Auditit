{"step_index":1733,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T20:03:36Z","content":"Created At: 2026-11-03T01:33:36+05:30\nCompleted At: 2026-11-03T01:33:37+05:30\nShowing lines 760-815 of 840\n760:   if (inputSgst && onUpdateHeader) {\n761:     inputSgst.addEventListener(\"input\", (e) => onUpdateHeader(\"sgst\", parseFloat(e.target.value) || 0));\n762:   }\n763:   if (inputIgst && onUpdateHeader) {\n764:     inputIgst.addEventListener(\"input\", (e) => onUpdateHeader(\"igst\", parseFloat(e.target.value) || 0));\n765:   }\n766: \n767:   // GST Presets: Click Handler Sync with Intra-State vs Inter-State Auto-Determination\n768:   container.querySelectorAll(\"[data-gst-preset]\").forEach(btn => {\n769:     btn.addEventListener(\"click\", () => {\n770:       const ratePct = parseFloat(btn.getAttribute(\"data-gst-preset\")) / 100;\n771:       // Recalculate dynamically based on current Subtotal (e.g. 11,000)\n772:       const subtotal = round2(Number(invoice.subtotal) || audit.sum_items || 0);\n773:       const taxAmount = round2(subtotal * ratePct);\n774: \n775:       // Compare first 2 digits of Supplier GSTIN (06) and Buyer GSTIN (06)\n776:       const supplierGstin = (invoice.gstin || \"\").trim().toUpperCase();\n777:       const buyerGstin = (invoice.buyer_gstin || \"06CORPP2712A1Z1\").trim().toUpperCase();\n778:       const supplierState = supplierGstin ? supplierGstin.slice(0, 2) : \"06\";\n779:       const buyerState = buyerGstin ? buyerGstin.slice(0, 2) : \"06\";\n780:       const isIntraState = supplierState === buyerState;\n781: \n782:       let newCgst = 0;\n783:       let newSgst = 0;\n784:       let newIgst = 0;\n785: \n786:       if (isIntraState) {\n787:         // Intra-State: Set IGST strictly to 0, default split to CGST + SGST (e.g. 9% + 9% = 18%, ₹990 + ₹990 on ₹11,000)\n788:         newIgst = 0;\n789:         newCgst = round2(taxAmount / 2);\n790:         newSgst = round2(taxAmount / 2);\n791:       } else {\n792:         // Inter-State: Set CGST = 0, SGST = 0, and IGST = 18% (₹1,980.00 on ₹11,000)\n793:         newCgst = 0;\n794:         newSgst = 0;\n795:         newIgst = taxAmount;\n796:       }\n797: \n798:       // Update inputs immediately for instant sync\n799:       if (inputCgst) inputCgst.value = newCgst;\n800:       if (inputSgst) inputSgst.value = newSgst;\n801:       if (inputIgst) inputIgst.value = newIgst;\n802: \n803:       // Trigger re-audit immediately\n804:       if (onUpdateHeader) {\n805:         onUpdateHeader(\"gst_preset\", { cgst: newCgst, sgst: newSgst, igst: newIgst });\n806:       }\n807:     });\n808:   });\n809: \n810:   // Digital ratio slider\n811:   const sliderDigital = container.querySelector(\"#slider-digital-ratio\");\n812:   if (sliderDigital && onUpdateTaxSettings) {\n813:     sliderDigital.addEventListener(\"input\", (e) => {\n814:       const val = parseFloat(e.target.value) / 100;\n815:       onUpdateTaxSettings({ digitalRatio: val });"}
