{"step_index":1739,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T20:03:56Z","content":"Created At: 2026-11-03T01:33:56+05:30\nCompleted At: 2026-11-03T01:33:56+05:30\nShowing lines 85-125 of 608\n85: }\n86: \n87: /**\n88:  * Strict tax extraction helper:\n89:  * Group 1: optional tax percentage (e.g. 9 or 9.0)\n90:  * Group 2: tax amount (e.g. 990.00 or 1,624.95)\n91:  */\n92: function extractTaxAmountFromMatch(match, line) {\n93:   if (!match) return 0;\n94:   if (line.includes(\"%\")) {\n95:     return match[2] ? parseIndianCurrency(match[2]) : 0;\n96:   }\n97:   if (match[1] && match[2]) {\n98:     if (match[2] === \"0\" || match[2] === \"00\") {\n99:       return parseIndianCurrency(match[1] + match[2]);\n100:     }\n101:     const val2 = parseIndianCurrency(match[2]);\n102:     if (val2 > 0) return val2;\n103:     return parseIndianCurrency(match[1] + match[2]);\n104:   }\n105:   if (match[2]) return parseIndianCurrency(match[2]);\n106:   if (match[1]) return parseIndianCurrency(match[1]);\n107:   return 0;\n108: }\n109: \n110: /**\n111:  * Checks if raw text contains commercial invoice keywords\n112:  */\n113: export function isLikelyInvoice(text) {\n114:   if (!text || text.trim().length < 15) return false;\n115: \n116:   const invoiceKeywords = [\n117:     \"invoice\", \"tax invoice\", \"bill\", \"cash memo\", \"parcha\", \"challan\",\n118:     \"gst\", \"gstin\", \"subtotal\", \"total\", \"grand total\", \"qty\", \"rate\", \n119:     \"amount\", \"hsn\", \"cgst\", \"sgst\", \"igst\", \"balance\", \"payable\", \"rupees\", \"mrp\"\n120:   ];\n121: \n122:   const lower = text.toLowerCase();\n123:   let matches = 0;\n124:   for (const kw of invoiceKeywords) {\n125:     if (lower.includes(kw)) matches++;"}
