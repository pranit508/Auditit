{"step_index":163,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T14:13:18Z","content":"Created At: 2026-11-02T19:43:18+05:30\nCompleted At: 2026-11-02T19:43:18+05:30\nShowing lines 1-60 of 173\n1: // Sample Invoices for AUDIT IT\n2: export const SAMPLE_INVOICES = {\n3:   sample1: {\n4:     id: \"sample1\",\n5:     scenarioName: \"Sample 1: Clean Bill\",\n6:     vendor_name: \"Sharma Wholesale Traders\",\n7:     vendor_address: \"Shop 14, Khari Baoli Spice Market, Old Delhi, Delhi - 110006\",\n8:     gstin: \"07AAAAA0000A1Z5\",\n9:     invoice_no: \"SWT/2026/0412\",\n10:     date: \"2026-10-28\",\n11:     badge: {\n12:       text: \"Math Verified\",\n13:       color: \"emerald\"\n14:     },\n15:     items: [\n16:       {\n17:         id: \"item-1\",\n18:         description: \"Sharbati Wheat Flour (Atta 50kg)\",\n19:         hsn: \"1101\",\n20:         qty: 20,\n21:         rate: 420.00,\n22:         amount: 8400.00,\n23:         is_blurry: false\n24:       },\n25:       {\n26:         id: \"item-2\",\n27:         description: \"Premium Basmati Rice (25kg)\",\n28:         hsn: \"1006\",\n29:         qty: 10,\n30:         rate: 950.00,\n31:         amount: 9500.00,\n32:         is_blurry: false\n33:       },\n34:       {\n35:         id: \"item-3\",\n36:         description: \"Toor Dal Unpolished (10kg)\",\n37:         hsn: \"0713\",\n38:         qty: 5,\n39:         rate: 1100.00,\n40:         amount: 5500.00,\n41:         is_blurry: false\n42:       }\n43:     ],\n44:     subtotal: 23400.00,\n45:     cgst: 585.00, // 2.5%\n46:     sgst: 585.00, // 2.5%\n47:     igst: 0.00,\n48:     total_declared: 24570.00,\n49:     bank_details: {\n50:       bank_name: \"State Bank of India\",\n51:       account_number: \"•••• •••• •••• 4821\",\n52:       ifsc: \"SBIN••••••\",\n53:       branch: \"Chandni Chowk, Delhi\"\n54:     },\n55:     payment_terms: \"Due on delivery - Net 7 Days\",\n56:     notes: \"Essential food grains supplied under composite G