  try {\n40:       const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey.trim()}`;\n41:       const payload = {\n42:         contents: [\n43:           {\n44:             parts: [{ text: promptText }]\n45:           }"}
