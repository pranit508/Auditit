alDiff))} Overcharge` : `${formatRupees(Math.abs(totalDiff))} Math Error`;\n202:     statusColor = \"rose\";\n203:   } else if (!gstinValid || hasBlurryFields || issues.some(i => i.type === \"WARNING\")) {\n204:     status = \"REVIEW_NEEDED\";\n205:     statusText = \"Review Needed\";\n206:     statusColor = \"amber\";\n207:   }\n208: \n209:   return {\n210:     status,\n211:     statusText,\n212:     statusColor,\n213:     sum_items,\n214:     totalTax,\n215:     calculated_total,\n216:     total_declared,\n217:     totalDiff,\n218:     hasTotalDiscrepancy,\n219:     hasLineItemMathError,\n220:     hasBlurryFields,\n221:     gstinValid,\n222:     lineItemAudit,\n223:     issues\n224:   };\n225: }"}
{"step_index":158,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T14:12:28Z","input_tokens":2504,"cache_read_tokens":148889,"output_tokens":3272,"thinking":"The audit engine needs updating to explicitly handle invalid bills. Specifically, when `invoice.is_valid_bill` is false, the engine should immediately reject the invoice. This rejection includes setting the status to \"REJECTED_INVALID_DOCUMENT,\" providing a rejection reason, and selecting an appropriate color code.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"// AUDIT IT - Core Precision Audit & Calculation Engine\n// RULE: \"AI reads, code calculates. Do NOT trust the AI to do math.\"\n\n/**\n * Standard Indian GSTIN Regex (15 characters)\n * 2 digits (state) + 5 letters (PAN) + 4 digits + 1 letter + 1 char + Z + 1 check digit\n */\nexport const GSTIN_REGEX = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;\n\n/**\n * Precise 2-decimal rounding with EPSILON to avoid binary floating-point drift\n */\nexport function round2(num) {\n  if (num === null || num === undefined || isNaN(num)) return 0;\n  return Math.round((Number(num) + Number.EPSILON) * 100) / 100;\n}\n\n/**\n * Formats numbers into Indian Currency format (e.g., ₹1,24,570.00)\n */\nexport function formatRupees(amount) {\n  if (amount === null || amount === undefined || isNaN(amount)) return \"₹0.00\";\n  const num = Number(amount);\n  const isNegative = num < 0;\n  const absNum = Math.abs(num);\n\n  const parts = absNum.toFixed(2).split(\".\");\n  let intPart = parts[0];\n  const decPart = parts[1];\n\n  // Indian currency grouping: last 3 digits, then groups of 2\n  if (intPart.length > 3) {\n    const lastThree = intPart.substring(intPart.length - 3);\n    const otherNumbers = intPart.substring(0, intPart.length - 3);\n    intPart = otherNumbers.replace(/\\B(?=(\\d{2})+(?!\\d))/g, \",\") + \",\" + lastThree;\n  }\n\n  return (isNegative ? \"-₹\" : \"₹\") + intPart + \".\" + decPart;\n}\n\n/**\n * Recalculates and strictly audits an entire invoice.\n * Every mathematical sum is strictly computed in code with precision.\n */\nexport function auditInvoice(invoice) {\n  // 1. First Check: Document Validity Gatekeeper\n  if (invoice.is_valid_bill === false) {\n    const reason = invoice.rejection_reason || \"Uploaded image is not a financial bill, cash memo, or invoice.\";\n    return {\n      status: \"REJECTED_INVALID_DOCUMENT\",\n      statusText: \"Not an Invoice (Rejected)\",\n      statusColor: \"rose\",\n      is_valid_bill: false,\n      rejection_reason: reason,\n      sum_items: 0,\n      totalTax: 0,\n      calculated_total: 0,\n      total_declared: 0,\n      totalDiff: 0,\n      hasTotalDiscrepancy: false,\n      hasLineItemMathError: false,\n      hasBlurryFields: false,\n      gstinValid: false,\n      lineItemAudit: [],\n      unreadable_fields: invoice.unreadable_fields || [],\n      issues: [\n        {\n          type: \"ERROR\",\n          field: \"document_validity\",\n          title: \"Non-Invoice Upload Detected\",\n          description: reason\n        }\n      ]\n    };\n  }\n\n  const issues = [];\n  const lineItemAudit = [];\n\n  let sum_items = 0;\n  let hasLineItemMathError = false;\n  let hasBlurryFields = false;\n\n  // 2. Unreadable / Non-Hallucinated Fields Log\n  const unreadableList = Array.isArray(invoice.unreadable_fields) ? invoice.unreadable_fields : [];\n  if (unreadableList.length > 0) {\n    unreadableList.forEach(field => {\n      issues.push({\n        type: \"WARNING\",\n        field: `unreadable_${field}`,\n        title: `Unreadable or Missing Field: ${field.replace(/_/g, ' ').toUpperCase()}`,\n        description: `This field was not present or unreadable on the physical bill. Value was set to null and not hallucinated.`\n      });\n    });\n  }\n\n  // 3. Line Items Verification with strict float precision\n  if (!invoice.items || invoice.items.length === 0) {\n    issues.push({\n      type: \"ERROR\",\n      field: \"items\",\n      title: \"No Line Items Detected\",\n      description: \"Invoice contains no billable line items or goods.\"\n    });\n  } else {\n    invoice.items.forEach((item, index) => {\n      const qty = round2(Number(item.qty) || 0);\n      const rate = round2(Number(item.rate) || 0);\n      const declaredAmount = round2(Number(item.amount) || 0);\n      const calculatedAmount = round2(qty * rate);\n\n      sum_items = round2(sum_items + calculatedAmount);\n\n      const diff = round2(declaredAmount - calculatedAmount);\n      // Precision check: anything differing by more than 50 paise is flagged\n      const isMathError = Math.abs(diff) > 0.50;\n\n      if (isMathError) {\n        hasLineItemMathError = true;\n        issues.push({\n          type: \"ERROR\",\n          field: `item-${item.id || index}`,\n          title: `Line ${index + 1} Calculation Error: ${item.description || 'Item'}`,\n          description: `Billed as ${formatRupees(declaredAmount)}, but precision formula (${qty} × ${formatRupees(rate)}) calculates ${formatRupees(calculatedAmount)}. Discrepancy: ${formatRupees(Math.abs(diff))}.`,\n          diff: diff,\n          declared: declaredAmount,\n          calculated: calculatedAmount\n        });\n      }\n\n      if (item.is_blurry) {\n        hasBlurryFields = true;\n        issues.push({\n          type: \"WARNING\",\n          field: `item-blurry-${item.id || index}`,\n          title: `Unclear / Blurry Field on Line ${index + 1}`,\n          description: item.unclear_note || `The rate or quantity for \"${item.description || 'Item'}\" could not be confirmed with 100% certainty.`\n        });\n      }\n\n      lineItemAudit.push({\n        ...item,\n        qty,\n        rate,\n        declaredAmount,\n        calculatedAmount,\n        diff,\n        isMathError\n      });\n    });\n  }\n\n  sum_items = round2(sum_items);\n\n  // 4. Tax Calculations with strict float precision\n  const cgst = round2(Number(invoice.cgst) || 0);\n  const sgst = round2(Number(invoice.sgst) || 0);\n  const igst = round2(Number(invoice.igst) || 0);\n  const totalTax = round2(cgst + sgst + igst);\n\n  // GST Split check: In intra-state, CGST and SGST must match within rounding tolerance\n  if (cgst > 0 || sgst > 0) {\n    if (Math.abs(cgst - sgst) > 1.00) {\n      issues.push({\n        type: \"WARNING\",\n        field: \"gst_split\",\n        title: \"CGST and SGST Mismatch\",\n        description: `Intra-state GST requires CGST (${formatRupees(cgst)}) to equal SGST (${formatRupees(sgst)}).`\n      });\n    }\n    if (igst > 0) {\n      issues.push({\n        type: \"WARNING\",\n        field: \"gst_type\",\n        title: \"Conflicting GST Types\",\n        description: \"Invoice contains both IGST and CGST/SGST. Commercial transactions in India are either Intra-state (CGST+SGST) or Inter-state (IGST).\"\n      });\n    }\n  }\n\n  // 5. Strict Grand Total Calculation & Precision Tolerance\n  const calculated_total = round2(sum_items + totalTax);\n  const total_declared = round2(Number(invoice.total_declared) || 0);\n  const totalDiff = round2(total_declared - calculated_total);\n\n  // Discrepancy rule: If difference exceeds ₹1.00, flag precision discrepancy\n  const hasTotalDiscrepancy = Math.abs(totalDiff) > 1.00;\n\n  if (hasTotalDiscrepancy) {\n    issues.push({\n      type: \"ERROR\",\n      field: \"total_declared\",\n      title: totalDiff > 0 ? \"Grand Total Overcharge Detected\" : \"Grand Total Undercharge Detected\",\n      description: `Bill declared ${formatRupees(total_declared)}, but verified total (Items ${formatRupees(sum_items)} + Tax ${formatRupees(totalTax)}) is ${formatRupees(calculated_total)}. Net Variance: ${formatRupees(Math.abs(totalDiff))}.`,\n      diff: totalDiff,\n      declared: total_declared,\n      calculated: calculated_total\n    });\n  }\n\n  // 6. Header & GSTIN Verification (Never Hallucinate)\n  const gstin = (invoice.gstin || \"\").trim().toUpperCase();\n  let gstinValid = false;\n  if (!gstin) {\n    issues.push({\n      type: \"WARNING\",\n      field: \"gstin\",\n      title: \"Missing Supplier GSTIN\",\n      description: \"No GSTIN found on invoice. Section 16 of CGST Act disallows Input Tax Credit (ITC) without a registered supplier GSTIN.\"\n    });\n  } else if (!GSTIN_REGEX.test(gstin)) {\n    issues.push({\n      type: \"WARNING\",\n      field: \"gstin\",\n      title: \"Invalid GSTIN Format\",\n      description: `GSTIN \"${gstin}\" does not match Indian 15-character GST structure.`\n    });\n  } else {\n    gstinValid = true;\n  }\n\n  if (!invoice.invoice_no) {\n    issues.push({\n      type: \"WARNING\",\n      field: \"invoice_no\",\n      title: \"Missing Invoice Number\",\n      description: \"Bill does not state an invoice/cash memo number.\"\n    });\n  }\n\n  if (!invoice.date) {\n    issues.push({\n      type: \"WARNING\",\n      field: \"date\",\n      title: \"Missing Invoice Date\",\n      description: \"Bill date is absent or illegible.\"\n    });\n  }\n\n  // Determine overall status verdict\n  let status = \"VERIFIED\";\n  let statusText = \"Math Verified & Valid\";\n  let statusColor = \"emerald\";\n\n  if (hasTotalDiscrepancy || hasLineItemMathError) {\n    status = \"OVERCHARGE_ERROR\";\n    statusText = totalDiff > 0 ? `${formatRupees(Math.abs(totalDiff))} Overcharge` : `${formatRupees(Math.abs(totalDiff))} Math Error`;\n    statusColor = \"rose\";\n  } else if (!gstinValid || hasBlurryFields || unreadableList.length > 0 || issues.some(i => i.type === \"WARNING\")) {\n    status = \"REVIEW_NEEDED\";\n    statusText = \"Review Needed\";\n    statusColor = \"amber\";\n  }\n\n  return {\n    status,\n    statusText,\n    statusColor,\n    is_valid_bill: true,\n    sum_items,\n    totalTax,\n    calculated_total,\n    total_declared,\n    totalDiff,\n    hasTotalDiscrepancy,\n    hasLineItemMathError,\n    hasBlurryFields,\n    gstinValid,\n    unreadable_fields: unreadableList,\n    lineItemAudit,\n    issues\n  };\n}\n","Overwrite":true,"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/auditEngine.js"}}]}
