ne_pattern = re.compile(r'(\\+?91[\\-\\s]?)?[6-9]\\d{9}')\n113:     pan_pattern = re.compile(r'\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b', re.IGNORECASE)\n114: \n115:     for item in data.get(\"items\", []):\n116:         if not isinstance(item, dict):\n117:             continue\n118: \n119:         desc = (item.get(\"description\") or \"\").strip()\n120:         desc_lower = desc.lower()\n121: \n122:         # Reject if description matches address/words or is too short\n123:         if any(word in desc_lower for word in address_words) or len(desc) < 3:\n124:             continue\n125: \n126:         # Reject GSTIN strings, PAN strings, or phone numbers\n127:         if gstin_pattern.search(desc) or phone_pattern.search(desc) or pan_pattern.search(desc):\n128:             continue\n129: \n130:         # Reject single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n131:         if re.match(r'^[A-Za-z0-9]{7,16}$', desc) and any(c.isdigit() for c in desc) and any(c.isalpha() for c in desc):\n132:             continue\n133: \n134:         # Reject if total amount matches common pin codes (e.g. 131001) or is clearly corrupt\n135:         raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\", 0)\n136:         raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n137:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n138: \n139:         try:\n140:             billed = float(raw_billed or 0)\n141:             qty = float(raw_qty or 0)\n142:             rate = float(raw_rate or 0)\n143:         except (ValueError, TypeError):\n144:             continue\n145: \n146:         # Quantity and rate must be positive\n147:         if qty <= 0 or rate <= 0:\n148:             continue\n149: \n150:         # If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n151:         if billed