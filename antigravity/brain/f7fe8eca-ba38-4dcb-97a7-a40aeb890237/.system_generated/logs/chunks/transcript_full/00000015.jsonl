{"step_index":917,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:15:15Z","content":"Created At: 2026-11-02T23:45:15+05:30\nCompleted At: 2026-11-02T23:45:15+05:30\nShowing lines 50-104 of 104\n50:       continue;\n51:     }\n52: \n53:     // 2. Skip if the description matches address/metadata keywords\n54:     if (FORBIDDEN_KEYWORDS.some(keyword => descLower.includes(keyword))) {\n55:       console.warn(\"[AUDIT IT] Purged metadata item (Forbidden keyword detected):\", desc);\n56:       continue;\n57:     }\n58: \n59:     // 3. Skip invalid items with zero/negative rates or quantities\n60:     let qty = Number(item.quantity !== undefined ? item.quantity : item.qty);\n61:     let rate = Number(item.unit_rate !== undefined ? item.unit_rate : item.rate);\n62:     const billed = Number(item.total_amount !== undefined ? item.total_amount : item.amount);\n63: \n64:     // Post-Processing Column Swap Fallback:\n65:     // If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n66:     // it means qty and rate were misaligned. Swap them:\n67:     if (billed > 0 && qty === billed && (rate === 1 || rate === 2)) {\n68:       console.info(\"[AUDIT IT] Column swap detected: qty=\" + qty + \", rate=\" + rate + \", total=\" + billed + \" -> swapping to qty=1.0, rate=\" + billed);\n69:       qty = 1.0;\n70:       rate = billed;\n71:     }\n72: \n73:     // Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n74:     const descClean = desc.replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, \"\").trim();\n75:     const finalDesc = descClean.length >= 3 ? descClean : desc;\n76: \n77:     if (isNaN(qty) || isNaN(rate) || qty <= 0 || rate <= 0) {\n78:       console.warn(\"[AUDIT IT] Purged item with non-positive qty or rate:\", item);\n79:       continue;\n80:     }\n81: \n82:     // 4. Reject if total amount matches corrupt pincode/number (billed > qty * rate * 10 and billed > 100000)\n83:     if (!isNaN(billed) && billed > (qty * rate * 10) && billed > 100000) {\n84:       console.warn(\"[AUDIT IT] Purged item with corrupt pincode total amount:\", item);\n85:       continue;\n86:     }\n87: \n88:     // Normalize property names for consistency (qty, rate, amount)\n89:     const normalizedItem = {\n90:       ...item,\n91:       quantity: qty,\n92:       qty: qty,\n93:       unit_rate: rate,\n94:       rate: rate,\n95:       total_amount: isNaN(billed) || billed <= 0 ? (qty * rate) : billed,\n96:       amount: isNaN(billed) || billed <= 0 ? (qty * rate) : billed,\n97:       description: finalDesc\n98:     };\n99: \n100:     cleaned.push(normalizedItem);\n101:   }\n102: \n103:   return cleaned;\n104: }"}
{"step_index":918,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T18:15:15Z","input_tokens":2296,"cache_read_tokens":87260,"output_tokens":2462,"thinking":"Sanitization function is being added to the item cleaner utility to handle invoice data. It will clean the supplier name, remove non-alphanumeric characters, and perform general data cleaning to ensure data consistency.\n\n\nVendor name sanitization includes removing phone-related patterns and trailing punctuation. Line items are filtered based on description content, removing items with short descriptions, excessive symbols, or common footer terms. The description cleaning process removes trailing unit words from the item description.\n\n\nDescription length is now validated to prevent extremely short descriptions after cleaning; if the cleaned description is less than three characters, the original is retained. Quantity, rate, and total amount fields are parsed, removing commas and handling potential undefined or null values. A column swap fallback is included if billed amount equals quantity and rate is 1 or 2, assuming a likely data entry error. The `subtotal`, `cgst`, `sgst`, `igst`, and `declared_total` fields are also cleaned to handle comma-separated numeric strings.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/itemCleaner.js","Replacement":"    cleaned.push(normalizedItem);\n  }\n\n  return cleaned;\n}\n\n/**\n * Sanitizes and cleans invoice data:\n * 1. Clean supplier name of trailing symbols\n * 2. Filter garbage line items (stamps, signatures, low letter count, excessive symbols)\n * 3. Ensure numeric fields strip commas cleanly (e.g. '2,535.00' -> 2535.0)\n */\nexport function sanitizeAndCleanInvoice(data) {\n  if (!data || typeof data !== \"object\") return data;\n  const res = JSON.parse(JSON.stringify(data));\n\n  // 1. Clean supplier name of trailing symbols\n  const vendor = res.vendor_name || res.supplier_name || \"\";\n  if (vendor) {\n    let vendorClean = vendor.replace(/[\\s&0\\|\\[\\]\\(\\)]+$/, \"\").trim();\n    vendorClean = vendorClean.replace(/(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+/gi, \"\").trim();\n    vendorClean = vendorClean.replace(/[\\s,\\-–—:|]+$/, \"\").trim();\n    res.vendor_name = vendorClean || \"Supplier Name Unclear\";\n    res.supplier_name = res.vendor_name;\n  }\n\n  // 2. Filter garbage line items\n  const cleanItems = [];\n  const items = Array.isArray(res.items) ? res.items : [];\n\n  for (const it of items) {\n    if (!it || typeof it !== \"object\") continue;\n\n    let desc = (it.description || it.item_name || \"\").trim();\n\n    // Remove stray leading/trailing brackets and vertical pipes from OCR\n    desc = desc.replace(/^[\\[\\|\\]\\(\\)\\s]+|[\\[\\|\\]\\(\\)\\s]+$/g, \"\").trim();\n    it.description = desc;\n\n    // Skip if description lacks at least 4 letters\n    const letters = desc.match(/[a-zA-Z]/g) || [];\n    if (letters.length < 4) continue;\n\n    // Skip if more than 20% of description is weird symbols/punctuation\n    const symbols = desc.match(/[~|©\\[\\]=_{}@#$%^&*]/g) || [];\n    if (desc.length > 0 && (symbols.length / desc.length) > 0.20) continue;\n\n    // Skip common footer/stamp terms\n    const descLower = desc.toLowerCase();\n    if ([\"signature\", \"authorised\", \"terms\", \"condition\", \"bank details\", \"e-way bill\"].some(term => descLower.includes(term))) {\n      continue;\n    }\n\n    // Clean description of trailing unit words\n    const descClean = desc.replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, \"\").trim();\n    if (descClean.length >= 3) {\n      desc = descClean;\n      it.description = desc;\n    }\n\n    // Quantity and Rate sanity\n    const rawQty = it.quantity !== undefined ? it.quantity : it.qty;\n    let qty = parseFloat(String(rawQty || 1).replace(/,/g, \"\").trim()) || 1.0;\n\n    const rawRate = it.unit_rate !== undefined ? it.unit_rate : it.rate;\n    let rate = parseFloat(String(rawRate || 0).replace(/,/g, \"\").trim()) || 0.0;\n\n    const rawBilled = it.total_amount !== undefined ? it.total_amount : it.amount;\n    let billed = parseFloat(String(rawBilled !== undefined && rawBilled !== null ? rawBilled : (qty * rate)).replace(/,/g, \"\").trim()) || (qty * rate);\n\n    // Column swap fallback\n    if (billed > 0 && qty === billed && (rate === 1 || rate === 2)) {\n      qty = 1.0;\n      rate = billed;\n    }\n\n    it.quantity = qty;\n    it.qty = qty;\n    it.unit_rate = rate;\n    it.rate = rate;\n    it.total_amount = billed;\n    it.amount = billed;\n    cleanItems.push(it);\n  }\n\n  res.items = cleanItems;\n\n  // 3. Ensure numeric fields strip commas cleanly\n  [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"].forEach(key => {\n    if (res[key] !== undefined && res[key] !== null) {\n      const parsedVal = parseFloat(String(res[key]).replace(/,/g, \"\").trim());\n      if (!isNaN(parsedVal)) {\n        res[key] = parsedVal;\n      }\n    }\n  });\n\n  if (res.declared_total !== undefined && res.total_declared === undefined) {\n    res.total_declared = res.declared_total;\n  } else if (res.total_declared !== undefined && res.declared_total === undefined) {\n    res.declared_total = res.total_declared;\n  }\n\n  if (res.invoice_number && !res.invoice_no) {\n    res.invoice_no = res.invoice_number;\n  }\n\n  return res;\n}","Target":"    cleaned.push(normalizedItem);\n  }\n\n  return cleaned;\n}"}}]}
