tor\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n214:         \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", \n215:         \"hundred\", \"only\", \"rupees\", \"bank\", \"ifsc\", \"a/c\", \"ac no\", \"phone\"\n216:     ]\n217: \n218:     gstin_pattern = re.compile(r'\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b', re.IGNORECASE)\n219:     phone_pattern = re.compile(r'(\\+?91[\\-\\s]?)?[6-9]\\d{9}')\n220:     pan_pattern = re.compile(r'\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b', re.IGNORECASE)\n221: \n222:     for item in data.get(\"items\", []):\n223:         if not isinstance(item, dict):\n224:             continue\n225: \n226:         desc = (item.get(\"description\") or \"\").strip()\n227:         desc_lower = desc.lower()\n228: \n229:         # Reject if description matches address/words or is too short\n230:         if any(word in desc_lower for word in address_words) or len(desc) < 3:\n231:             continue\n232: \n233:         # Reject GSTIN strings, PAN strings, or phone numbers\n234:         if gstin_pattern.search(desc) or phone_pattern.search(desc) or pan_pattern.search(desc):\n235:             continue\n236: \n237:         # Reject single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n238:         if re.match(r'^[A-Za-z0-9]{7,16}$', desc) and any(c.isdigit() for c in desc) and any(c.isalpha() for c in desc):\n239:             continue\n240: \n241:         # Reject if total amount matches common pin codes (e.g. 131001) or is clearly corrupt\n242:         raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\", 0)\n243:         raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n244:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n245: \n246:         try:\n247:             billed = float(raw_billed or 0)\n248:             qty = float(raw_qty or 0)\n249:             rate = float(raw_rate or 0)\n250:         except (ValueError, TypeError):\n251:             continue\n252: \n253:         # Quantity and rate must be positive\n254:         if qty <= 0 or rate <= 0:\n255:             continue\n256: \n257:         # If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n258:         if billed > (qty * rate * 10) and billed > 100000:\n259:             continue\n260: \n261:         # Post-Processing Column Swap Fallback:\n262:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n263:         # it means qty and rate were misaligned. Swap them:\n264:         if billed > 0 and qty == billed and rate in [1, 2, 1.0, 2.0]:\n265:             qty = 1.0\n266:             rate = billed\n267: \n268:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n269:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n270:         if desc_clean and len(desc_clean) >= 3:\n271:             desc = desc_clean\n272: \n273:         # Normalize fields for seamless compatibility\n274:         normalized = dict(item)\n275:         normalized[\"quantity\"] = qty\n276:         normalized[\"qty\"] = qty\n277:         normalized[\"unit_rate\"] = rate\n278:         normalized[\"rate\"] = rate\n279:         normalized[\"total_amount\"] = billed if billed > 0 else round(qty * rate, 2)\n280:         normalized[\"amount\"] = normalized[\"total_amount\"]"}
