{"step_index":1847,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T20:19:38Z","content":"Created At: 2026-11-03T01:49:38+05:30\nCompleted At: 2026-11-03T01:49:38+05:30\nCommand exited with code 0.\n\nCommand output:\n// Deterministic Tax & ITR Calculator for Small Indian Retail Shopkeepers\r\n// Core Rule: \"Code does the math, deterministic calculations only\"\r\nimport { round2 } from \"./auditEngine.js\";\r\n\r\n/**\r\n * Calculates turnover, deemed profit under Sec 44AD, and estimated tax under New Regime\r\n * @param {Object} invoice\r\n * @param {Object} audit\r\n * @param {Object} [settings] - Optional user overrides for turnover and digital ratio\r\n */\r\nexport function calculateTaxMetrics(invoice, audit, settings = {}) {\r\n  const totalGstOnBill = round2((Number(invoice.cgst) || 0) + (Number(invoice.sgst) || 0) + (Number(invoice.igst) || 0));\r\n  const isGstinValid = audit.gstinValid;\r\n\r\n  const eligibleItc = isGstinValid ? totalGstOnBill : 0;\r\n  const blockedItc = isGstinValid ? 0 : totalGstOnBill;\r\n  const missingGstinCount = isGstinValid ? 0 : 1;\r\n\r\n  // Annualized turnover: default to ₹36,00,000 or user slider value\r\n  const annualTurnover = Number(settings.annualTurnover) || 3600000;\r\n  \r\n  // Digital vs Cash ratio: default 60% digital, 40% cash\r\n  const digitalRatio = settings.digitalRatio !== undefined ? Number(settings.digitalRatio) : 0.60;\r\n  const cashRatio = round2(1 - digitalRatio);\r\n\r\n  // Section 44AD Presumptive Profit: 6% for digital turnover, 8% for cash turnover\r\n  const digitalProfit = (annualTurnover * digitalRatio) * 0.06;\r\n  const cashProfit = (annualTurnover * cashRatio) * 0.08;\r\n  const deemedProfit = round2(digitalProfit + cashProfit);\r\n\r\n  // Estimated Tax under New Tax Regime (Section 115BAC)\r\n  // Slabs:\r\n  // Up to ₹3,00,000: Nil\r\n  // ₹3,00,001 to ₹6,00,000: 5%\r\n  // ₹6,00,001 to ₹9,00,000: 10%\r\n  // ₹9,00,001 to ₹12,00,000: 15%\r\n  // ₹12,00,001 to ₹15,00,000: 20%\r\n  // Above ₹15,00,000: 30%\r\n  // Rebate under Section 87A: If total income <= ₹7,00,000, tax liability is ₹0.\r\n  let baseTax = 0;\r\n  if (deemedProfit > 700000) {\r\n    if (deemedProfit <= 600000) {\r\n      baseTax = (deemedProfit - 300000) * 0.05;\r\n    } else if (deemedProfit <= 900000) {\r\n      baseTax = 15000 + (deemedProfit - 600000) * 0.10;\r\n    } else if (deemedProfit <= 1200000) {\r\n      baseTax = 45000 + (deemedProfit - 900000) * 0.15;\r\n    } else if (deemedProfit <= 1500000) {\r\n      baseTax = 90000 + (deemedProfit - 1200000) * 0.20;\r\n    } else {\r\n      baseTax = 150000 + (deemedProfit - 1500000) * 0.30;\r\n    }\r\n  }\r\n\r\n  // 4% Health & Education Cess\r\n  const estimatedTaxLiability = round2(baseTax * 1.04);\r\n\r\n  const audit_summary = {\r\n    total_turnover: annualTurnover,\r\n    deemed_profit: deemedProfit,\r\n    number_of_invoices_analyzed: 1,\r\n    current_invoice_total: audit.calculated_total,\r\n    total_gst_paid_on_purchases: totalGstOnBill,\r\n    eligible_itc: eligibleItc,\r\n    invoices_missing_gstin: missingGstinCount,\r\n    disallowed_itc: blockedItc,\r\n    vendor_name: invoice.vendor_name || \"Supplier\",\r\n    supplier_gstin: invoice.gstin || \"MISSING\",\r\n    digital_ratio: digitalRatio,\r\n    cash_ratio: cashRatio\r\n  };\r\n\r\n  const calculated_tax = {\r\n    recommended_form: \"ITR-4 (Presumptive Scheme - Sec 44AD)\",\r\n    annual_turnover: annualTurnover,\r\n    digital_percent: Math.round(digitalRatio * 100),\r\n    cash_percent: Math.round(cashRatio * 100),\r\n    deemed_net_profit: deemedProfit,\r\n    profit_computation_basis: `Calculated at 6% digital (${Math.round(digitalRatio * 100)}%) / 8% cash (${Math.round(cashRatio * 100)}%)`,\r\n    estimated_tax_liability: estimatedTaxLiability,\r\n    tax_regime: \"New Regime (Section 115BAC)\",\r\n    rebate_87a_applied: deemedProfit <= 700000,\r\n    eligible_itc: eligibleItc,\r\n    blocked_itc: blockedItc\r\n  };\r\n\r\n  return { audit_summary, calculated_tax };\r\n}\r\n"}
