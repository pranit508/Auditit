{"step_index":1841,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T20:19:27Z","content":"Created At: 2026-11-03T01:49:27+05:30\nCompleted At: 2026-11-03T01:49:28+05:30\nShowing lines 1-150 of 209\n1: // Component: Review Workspace (Split-screen on Desktop, Segmented Toggle on Mobile)\n2: import { renderInvoiceViewer } from \"./InvoiceViewer.js\";\n3: import { renderAuditScorecard } from \"./AuditScorecard.js\";\n4: import { formatRupees } from \"../utils/auditEngine.js\";\n5: \n6: export function renderReviewWorkspace(container, invoice, audit, options = {}) {\n7:   const { \n8:     onUpdateItem, \n9:     onAddItem, \n10:     onDeleteItem,\n11:     onUpdateHeader,\n12:     onAutoFixMath,\n13:     onUpdateTaxSettings,\n14:     onSubmitValidInputs,\n15:     onCopyNote, \n16:     onOpenCaSlip, \n17:     onBack, \n18:     taxData, \n19:     onRefreshTaxAi \n20:   } = options;\n21: \n22:   let activeMobileTab = \"audit\"; // \"audit\" or \"bill\"\n23:   let selectedItemId = null;\n24: \n25:   container.innerHTML = `\n26:     <div class=\"max-w-7xl mx-auto px-4 py-4 sm:py-6\">\n27:       \n28:       <!-- Top Navigation Bar -->\n29:       <div class=\"flex items-center justify-between mb-4 pb-3 border-b border-slate-200\">\n30:         <div class=\"flex items-center space-x-3\">\n31:           <button id=\"btn-top-back\" class=\"inline-flex items-center space-x-1 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all\">\n32:             <span>← Dashboard</span>\n33:           </button>\n34:           <div>\n35:             <h2 class=\"text-sm sm:text-base font-bold text-slate-900 flex items-center space-x-2\">\n36:               <span>${invoice.vendor_name || \"Supplier Invoice\"}</span>\n37:               <span class=\"text-xs font-normal text-slate-400 font-mono\">(${invoice.invoice_no || \"No ID\"})</span>\n38:             </h2>\n39:           </div>\n40:         </div>\n41: \n42:         <div class=\"flex items-center space-x-2\">\n43:           <span class=\"hidden sm:inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold ${\n44:             audit.status === 'VERIFIED'\n45:               ? 'bg-emerald-100 text-emer\n<truncated 2586 bytes>\n  <span class=\"text-xs font-bold font-mono ${audit.hasTotalDiscrepancy ? 'text-rose-600' : 'text-emerald-700'}\">\n96:             ${audit.hasTotalDiscrepancy ? `Diff: ${formatRupees(audit.totalDiff)}` : 'Math Verified ✓'}\n97:           </span>\n98:         </div>\n99:         <div class=\"flex items-center space-x-2\">\n100:           <button id=\"btn-mobile-quick-action\" class=\"px-3 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold shadow\">\n101:             ${audit.hasTotalDiscrepancy ? '📋 Copy Dispute' : '📑 CA Slip'}\n102:           </button>\n103:         </div>\n104:       </div>\n105: \n106:     </div>\n107:   `;\n108: \n109:   // Mount children\n110:   const viewerMount = container.querySelector(\"#invoice-viewer-mount\");\n111:   const scorecardMount = container.querySelector(\"#audit-scorecard-mount\");\n112: \n113:   function renderChildren() {\n114:     renderInvoiceViewer(viewerMount, invoice, audit, {\n115:       selectedItemId,\n116:       onSelectItem: (id) => {\n117:         selectedItemId = id;\n118:         renderChildren();\n119:         // Switch to audit tab if on mobile so user sees the item\n120:         if (window.innerWidth < 1024) {\n121:           activeMobileTab = \"audit\";\n122:           updateMobileTabs();\n123:         }\n124:         // Smooth scroll to scorecard row\n125:         const row = document.getElementById(`scorecard-row-${id}`);\n126:         if (row) {\n127:           row.scrollIntoView({ behavior: \"smooth\", block: \"center\" });\n128:         }\n129:       }\n130:     });\n131: \n132:     renderAuditScorecard(scorecardMount, invoice, audit, {\n133:       selectedItemId,\n134:       taxData,\n135:       onRefreshTaxAi,\n136:       onUpdateItem,\n137:       onAddItem,\n138:       onDeleteItem,\n139:       onUpdateHeader,\n140:       onAutoFixMath,\n141:       onUpdateTaxSettings,\n142:       onSubmitValidInputs,\n143:       onCopyNote,\n144:       onOpenCaSlip,\n145:       onBack\n146:     });\n147:   }\n148: \n149:   function updateMobileTabs() {\n150:     const tabBill = container.querySelector(\"#tab-toggle-bill\");","truncated_fields":["content"]}
