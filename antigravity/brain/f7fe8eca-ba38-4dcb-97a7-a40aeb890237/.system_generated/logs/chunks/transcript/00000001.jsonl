vior: \"smooth\" });\n69:     this.showToast(`Loaded ${rawSample.scenarioName}`, \"info\");\n70:   }\n71: \n72:   async handleFileUpload(file) {\n73:     this.showProcessingOverlay(file.name);\n74: \n75:     try {\n76:       const extractedInvoice = await extractInvoiceFromDocument(file, this.apiKey);\n77:       this.currentInvoice = extractedInvoice;\n78:       this.currentAudit = auditInvoice(this.currentInvoice);\n79: \n80:       // Compute code-calculated tax & deemed profit under Sec 44AD\n81:       const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit);\n82:       const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n83:       this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n84: \n85:       this.currentView = \"review\";\n86:       this.hideProcessingOverlay();\n87:       this.render();\n88:       window.scrollTo({ top: 0, behavior: \"smooth\" });\n89:       this.showToast(\"Invoice processed and verified successfully!\", \"success\");\n90:     } catch (err) {\n91:       this.hideProcessingOverlay();\n92:       this.showToast(\"Could not process invoice: \" + err.message, \"error\");\n93:     }\n94:   }\n95: \n96:   async handleUpdateItem(index, action, value) {\n97:     if (!this.currentInvoice || !this.currentInvoice.items[index]) return;\n98: \n99:     const item = this.currentInvoice.items[index];\n100:     if (action === \"edit-qty\") {\n101:       item.qty = value;\n102:     } else if (action === \"edit-rate\") {\n103:       item.rate = value;\n104:       // If was marked blurry, clear blurry once edited\n105:       item.is_blurry = false;\n106:     } else if (action === \"edit-amount\") {\n107:       item.amount = value;\n108:     }\n109: \n110:     // Recalculate invoice audit"}
