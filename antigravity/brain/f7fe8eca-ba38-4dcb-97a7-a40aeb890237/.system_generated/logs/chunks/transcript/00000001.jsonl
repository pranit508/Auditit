 \\n    Returns:\\n        dict: Contains 'suggestions' (list of 3 bullets), 'disclaimer', and 'raw_text'.\\n    \\\"\\\"\\\"\\n    if not api_key:\\n        api_key = os.environ.get(\\\"GEMINI_API_KEY\\\", \\\"\\\")\\n\\n    # Structured context representation\\n    formatted_data = json.dumps({\\n        \\\"turnover\\\": format_rupees(audit_summary.get(\\\"total_turnover\\\")),\\n        \\\"deemed_profit\\\"\n<truncated 4903 bytes>","Overwrite":"true","Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/tax_suggestions.py\""}}],"truncated_fields":["tool_calls"]}
