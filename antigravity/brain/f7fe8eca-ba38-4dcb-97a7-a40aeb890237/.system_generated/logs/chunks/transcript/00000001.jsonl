ald-800' : audit.status === 'OVERCHARGE_ERROR' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800'\n32:           }\">\n33:             ${audit.statusText}\n34:           </span>\n35:           <button id=\"btn-top-ca-slip\" class=\"px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition-all flex items-center space-x-1\">\n36:             <span>📑 CA Audit Slip</span>\n37:           </button>\n38:         </div>\n39:       </div>\n40: \n41:       <!-- MOBILE 1-TAP SEGMENTED TOGGLE (Visible on small screens) -->\n42:       <div class=\"lg:hidden mb-4\">\n43:         <div class=\"bg-slate-200/80 p-1 rounded-xl flex\">\n44:           <button \n45:             id=\"tab-toggle-bill\" \n46:             class=\"flex-1 py-2 text-xs font-bold rounded-lg transition-all text-center ${activeMobileTab === 'bill' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900'}\"\n47:           >\n48:             📄 Original Bill\n49:           </button>\n50:           <button "}
