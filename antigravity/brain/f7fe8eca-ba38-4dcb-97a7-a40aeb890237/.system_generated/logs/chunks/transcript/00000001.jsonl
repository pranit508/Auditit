     onUpdateItem: (idx, action, val) => this.handleUpdateItem(idx, action, val),\n41:         onCopyNote: () => this.handleCopyDiscrepancyNote(),\n42:         onOpenCaSlip: () => this.openCaSlipModal(),\n43:         onBack: () => this.goToDashboard()\n44:       });\n45:     }\n46:   }\n47: \n48:   loadSample(sampleKey) {\n49:     const rawSample = SAMPLE_INVOICES[sampleKey];\n50:     if (!rawSample) return;\n51: \n52:     // Deep copy to allow editing without mutating original sample\n53:     this.currentInvoice = JSON.parse(JSON.stringify(rawSample));\n54:     this.currentAudit = auditInvoice(this.currentInvoice);\n55:     this.currentView = \"review\";\n56:     this.render();\n57:     window.scrollTo({ top: 0, behavior: \"smooth\" });\n58:     this.showToast(`Loaded ${rawSample.scenarioName}`, \"info\");\n59:   }\n60: "}
