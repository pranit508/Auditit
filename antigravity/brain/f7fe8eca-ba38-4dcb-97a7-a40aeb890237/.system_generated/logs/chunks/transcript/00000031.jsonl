{"step_index":2118,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-03T08:44:43Z","content":"Created At: 2026-11-03T14:14:43+05:30\nCompleted At: 2026-11-03T14:14:44+05:30\nShowing lines 1-50 of 96\n1: from fastapi import APIRouter\n2: from pydantic import BaseModel\n3: from typing import Optional, List\n4: import re\n5: \n6: router = APIRouter(prefix=\"/api/tax\", tags=[\"Tax & ITR\"])\n7: \n8: class TaxCalculationRequest(BaseModel):\n9:     calc_mode: str = \"44AD\"  # \"44AD\" or \"REGULAR\"\n10:     annual_turnover: float = 3000000.0\n11:     digital_share_percent: float = 80.0\n12:     digital_profit_rate: float = 6.0\n13:     cash_profit_rate: float = 8.0\n14:     operating_expenses: float = 0.0\n15:     current_invoice_subtotal: float = 0.0\n16:     current_invoice_cgst: float = 0.0\n17:     current_invoice_sgst: float = 0.0\n18:     current_invoice_igst: float = 0.0\n19:     supplier_gstin: Optional[str] = None\n20:     buyer_gstin: Optional[str] = None\n21: \n22: class TaxCalculationResponse(BaseModel):\n23:     # ITC Details\n24:     total_itc: float\n25:     is_inter_state: bool\n26:     gstin_valid: bool\n27:     itc_compliance_notes: List[str]\n28:     # Income Tax Projections\n29:     taxable_business_income: float\n30:     projected_income_tax: float\n31:     rebate_87a_applied: bool\n32:     tax_audit_required: bool\n33:     itr_form_suggested: str\n34:     compliance_message: str\n35: \n36: def validate_gstin_format(gstin: Optional[str]) -> bool:\n37:     if not gstin:\n38:         return False\n39:     # Standard 15-character Indian GSTIN pattern\n40:     pattern = r\"^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$\"\n41:     return bool(re.match(pattern, gstin.strip().upper()))\n42: \n43: @router.post(\"/calculate-advisory\", response_model=TaxCalculationResponse)\n44: def calculate_tax_advisory(req: TaxCalculationRequest):\n45:     # 1. GST ITC Verification\n46:     total_itc = round(req.current_invoice_cgst + req.current_invoice_sgst + req.current_invoice_igst, 2)\n47:     gstin_valid = validate_gstin_format(req.supplier_gstin)\n48:     \n49:     # State matching for inter-state determination\n50:     is_inter_state = False"}
