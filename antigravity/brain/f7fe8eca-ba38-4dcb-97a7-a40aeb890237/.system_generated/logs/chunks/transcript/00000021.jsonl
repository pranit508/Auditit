ame = res.vendor_name;\n141:   }\n142: \n143:   // 2. Filter garbage line items\n144:   const cleanItems = [];\n145:   const items = Array.isArray(res.items) ? res.items : [];\n146: \n147:   for (const it of items) {\n148:     if (!it || typeof it !== \"object\") continue;\n149: \n150:     let desc = (it.description || it.item_name || \"\").trim();\n151: \n152:     // Remove stray leading/trailing brackets and vertical pipes from OCR\n153:     desc = desc.replace(/^[\\[\\|\\]\\(\\)\\s]+|[\\[\\|\\]\\(\\)\\s]+$/g, \"\").trim();\n154:     it.description = desc;\n155: \n156:     // Skip if description lacks at least 4 letters\n157:     const letters = desc.match(/[a-zA-Z]/g) || [];\n158:     if (letters.length < 4) continue;\n159: \n160:     // Skip if more than 20% of description is weird symbols/punctuation"}
