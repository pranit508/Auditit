h - 4];\n229:       const raw4 = token4.raw.replace(/,/g, '');\n230:       const isHsn4 = /^\\d{4,8}$/.test(raw4);\n231: \n232:       if (isHsn4) {\n233:         hsn = raw4;\n234:         quantity = val3 > 0 ? val3 : 1.0;\n235:     \n<truncated 689 bytes>\n0:         hsn = raw3;\n251:         quantity = 1.0;\n252:         descCutoffIndex = token3.index;\n253:       } else {\n254:         quantity = val3 > 0 ? val3 : 1.0;\n255:         descCutoffIndex = token3.index;\n256:       }\n257:     }\n258:   }\n259: \n260:   // Everything remaining to the left of these numeric tokens = Description\n261:   let desc = line.slice(0, descCutoffIndex).trim();\n262: \n263:   // Strip leading S.No (e.g., '1', '1.', '1 -', '01.')\n264:   desc = desc.replace(/^\\s*\\d+[\\s\\.\\-\\|\\)\\]]+\\s*/, '');\n265: \n266:   // Strip leading/trailing punctuation and brackets ('|', '[', ']', '-', etc.)\n267:   desc = desc.replace(/^[\\[\\|\\]\\(\\)\\s\\.\\-]+|[\\[\\|\\]\\(\\)\\s\\.\\-]+$/g, '');\n268: \n269:   // Strip unit abbreviations ('NOS', 'PCS', 'NO', 'PIECES', 'PKT', 'PACKET', 'KG', 'BOX', 'SET')\n270:   desc = desc.replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, '').trim();\n271: \n272:   // Column Swap Fallback:\n273:   let finalQty = quantity;\n274:   let finalRate = unitRate;\n275:   let finalAmount = totalAmount;\n276: \n277:   if (finalAmount > 0 && finalQty === finalAmount && (finalRate === 1 || finalRate === 2)) {\n278:     finalQty = 1.0;\n279:     finalRate = finalAmount;\n280:   }\n281: \n282:   // Validation Checks:\n283:   // 1. Positive numbers check\n284:   if (finalQty <= 0 || finalRate <= 0 || finalAmount <= 0) {\n285:     return null;\n286:   }\n287: \n288:   // 2. Mathematical check: (quantity * unit_rate) vs total_amount within 5%\n289:   const expectedAmount = finalQty * finalRate;\n290:   const deviation = Math.abs(expectedAmount - finalAmount) / (finalAmount > 0 ? finalAmount : 1);\n291: \n292:   if (deviation > 0.05) {\n293:     // Check for legitimate audit scenario or known discount\n294:     const isDiscount = finalAmount < expectedAmount && finalAmount >= (expectedAmount * 0.50);\n295:     const isPlausibleAuditError = Math.abs(finalAmount - expectedAmount) <= 2000 && finalQty <= 1000 && finalRate <= 50000;\n296:     if (!isDiscount && !isPlausibleAuditError) {\n297:       return null;\n298:     }\n299:   }\n300: ","truncated_fields":["content"]}
