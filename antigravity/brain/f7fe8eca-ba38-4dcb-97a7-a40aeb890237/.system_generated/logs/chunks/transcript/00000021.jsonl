     FOURTEEN: 14, FIFTEEN: 15, SIXTEEN: 16, SEVENTEEN: 17,\n44:     EIGHTEEN: 18, NINETEEN: 19\n45:   };\n46:   const tens = {\n47:     TWENTY: 20, THIRTY: 30, FORTY: 40, FIFTY: 50,\n48:     SIXTY: 60, SEVENTY: 70, EIGHTY: 80, NINETY\n<truncated 2463 bytes>\n = 0; i < lines.length; i++) {\n125:     const lineLower = lines[i].toLowerCase();\n126:     let keywordCount = 0;\n127:     for (const kw of tableHeaderKeywords) {\n128:       if (new RegExp(`\\\\b${kw}\\\\b`, 'i').test(lineLower) || (kw === 'qty' && /\\bqty\\b|\\bquantity\\b/i.test(lineLower))) {\n129:         keywordCount++;\n130:       }\n131:     }\n132:     // Table Header row containing at least two keywords\n133:     if (keywordCount >= 2) {\n134:       headerEndIndex = i;\n135:       break;\n136:     }\n137:   }\n138: \n139:   // Fallback if header with 2 keywords wasn't found\n140:   if (headerEndIndex === -1) {\n141:     for (let i = 0; i < Math.min(10, lines.length); i++) {\n142:       const lineLower = lines[i].toLowerCase();\n143:       if ((lineLower.includes('description') || lineLower.includes('particulars')) &&\n144:           (lineLower.includes('rate') || lineLower.includes('amount') || lineLower.includes('qty'))) {\n145:         headerEndIndex = i;\n146:         break;\n147:       }\n148:     }\n149:   }\n150: \n151:   let footerStartIndex = -1;\n152:   const searchStart = headerEndIndex !== -1 ? headerEndIndex + 1 : 0;\n153:   for (let i = searchStart; i < lines.length; i++) {\n154:     const line = lines[i];\n155:     if (tableFooterRegex.test(line)) {\n156:       footerStartIndex = i;\n157:       break;\n158:     }\n159:   }\n160: \n161:   if (footerStartIndex === -1) {\n162:     footerStartIndex = lines.length;\n163:   }\n164: \n165:   const headerZone = headerEndIndex !== -1 \n166:     ? lines.slice(0, headerEndIndex) \n167:     : lines.slice(0, Math.min(5, footerStartIndex));\n168: \n169:   const itemZone = headerEndIndex !== -1 \n170:     ? lines.slice(headerEndIndex + 1, footerStartIndex) \n171:     : lines.slice(Math.min(5, footerStartIndex), footerStartIndex);\n172: \n173:   const summaryZone = lines.slice(footerStartIndex);\n174: \n175:   return { headerZone, itemZone, summaryZone, headerEndIndex, footerStartIndex };\n176: }\n177: \n178: /**\n179:  * STEP 2: RIGHT-TO-LEFT (REVERSE) NUMERIC COLUMN PARSER\n180:  * Scans tokens from right to left:","truncated_fields":["content"]}
