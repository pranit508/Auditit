 60, 'SEVENTY': 70, 'EIGHTY': 80, 'NINETY': 90\n51:     }\n52:     multipliers = {\n53:         'HUNDRED': 100,\n54:         'THOUSAND': 1000,\n55:         'LAKH': 100000,\n56:         'LAKHS': 100000,\n57:         'CRORE': 10000000,\n58: \n<truncated 2631 bytes>\n\", \"\").strip()\n120:         desc_lower = desc.lower()\n121: \n122:         # 1. Skip if the description contains GSTIN patterns or phone numbers\n123:         if gstin_pattern.search(desc) or phone_pattern.search(desc):\n124:             continue\n125: \n126:         # 2. Skip if the description contains PAN, Bank, Account, or state/city keywords\n127:         if any(keyword in desc_lower for keyword in forbidden_keywords):\n128:             continue\n129: \n130:         if re.search(r'\\bpan\\b|\\bacc(?:\\.|\\s+)?(?:no|number)\\b|\\baccount\\b|\\bbank\\b|\\bifsc\\b', desc_lower):\n131:             continue\n132: \n133:         # 3. Skip invalid items with zero/negative rates or quantities\n134:         qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n135:         rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n136:         amount = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\", 0)\n137: \n138:         # Ensure numeric values\n139:         try:\n140:             qty_num = float(qty) if qty is not None else 0\n141:             rate_num = float(rate) if rate is not None else 0\n142:             amt_num = float(amount) if amount is not None else 0\n143:         except (ValueError, TypeError):\n144:             continue\n145: \n146:         if (qty_num <= 0) or (rate_num <= 0 and amt_num <= 0):\n147:             continue\n148: \n149:         # Post-Processing Column Swap Fallback:\n150:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n151:         # it means qty and rate were misaligned. Swap them:\n152:         if amt_num > 0 and qty_num == amt_num and rate_num in [1.0, 2.0, 1, 2]:\n153:             qty_num = 1.0\n154:             rate_num = amt_num\n155:             item[\"quantity\"] = 1.0\n156:             item[\"qty\"] = 1.0\n157:             item[\"unit_rate\"] = amt_num\n158:             item[\"rate\"] = amt_num\n159:             item[\"total_amount\"] = amt_num\n160:             item[\"amount\"] = amt_num","truncated_fields":["content"]}
