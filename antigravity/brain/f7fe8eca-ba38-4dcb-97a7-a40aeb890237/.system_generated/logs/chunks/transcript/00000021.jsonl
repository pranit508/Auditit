if billed > 0 and qty == billed and rate in [1.0, 2.0, 1, 2]:\n251:             qty = 1.0\n252:             rate = billed\n253: \n254:         item[\"quantity\"] = qty\n255:         item[\"qty\"] = qty\n256:         item[\"unit_rate\"] = rate\n257:         item[\"rate\"] = rate\n258:         item[\"total_amount\"] = billed\n259:         item[\"amount\"] = billed\n260:         clean_items.append(item)","truncated_fields":["content"]}
