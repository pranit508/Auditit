\n26: NUMERIC INSTRUCTIONS:\n27: - Never discard digits before commas! '2,535.00' must be extracted as '2,535.00'. '1,270.00' must be extracted as '1,270.00'. '4,490.00' must be extracted as '4,490.00'.\n28\n<truncated 686 bytes>\nstring or null,\n46:   \"cgst\": string or null,\n47:   \"sgst\": string or null,\n48:   \"igst\": string or null,\n49:   \"declared_total\": string or null\n50: }\n51: `;\n52: \n53: /**\n54:  * Extracts structured JSON from an uploaded invoice image/PDF.\n55:  * Prioritizes:\n56:  * 1. Live Multimodal Gemini API (if key configured)\n57:  * 2. In-browser Client-side PDF.js (for PDFs)\n58:  * 3. In-browser Client-side Tesseract.js OCR (for images)\n59:  * 4. Document-aware parser (zero fake/mock items)\n60:  */\n61: export async function extractInvoiceFromDocument(file, apiKey = null, onProgress = null) {\n62:   const effectiveKey = (apiKey && apiKey.trim().length > 10) ? apiKey.trim() : DEFAULT_API_KEY;\n63:   const mimeType = file.type || \"image/jpeg\";\n64:   const objectUrl = URL.createObjectURL(file);\n65: \n66:   // 1. Prioritize FastAPI + Google GenAI (/api/analyze-bill) backend endpoint\n67:   try {\n68:     if (onProgress) onProgress(\"Uploading bill to FastAPI backend (Gemini 2.5 Flash)...\");\n69:     const formData = new FormData();\n70:     formData.append(\"file\", file);\n71: \n72:     const headers = {\n73:       \"x-api-key\": effectiveKey\n74:     };\n75:     if (effectiveKey && effectiveKey.trim().startsWith(\"AQ.\")) {\n76:       headers[\"Authorization\"] = `Bearer ${effectiveKey.trim()}`;\n77:     }\n78: \n79:     const backendResp = await fetch(\"/api/analyze-bill\", {\n80:       method: \"POST\",\n81:       headers,\n82:       body: formData\n83:     });\n84: \n85:     if (backendResp.ok) {\n86:       const rawText = await backendResp.text();\n87:       let parsed = null;\n88:       try {\n89:         parsed = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n90:         if (typeof parsed === \"string\") {\n91:           parsed = JSON.parse(parsed);\n92:         }\n93:       } catch (e) {\n94:         console.warn(\"Could not parse backend JSON:\", e);\n95:       }\n96: \n97:       if (parsed && typeof parsed === \"object\") {\n98:         parsed.uploaded_file_url = objectUrl;\n99:         parsed.file_type = mimeType;\n100:         parsed.file_name = file.name;","truncated_fields":["content"]}
