ases for frontend compatibility\n332:     if data.get(\"invoice_number\") and not data.get(\"invoice_no\"):\n333:         data[\"invoice_no\"] = data[\"invoice_number\"]\n334: \n335:     return data\n336: \n337: def sanitize_invoice_data(data: dict) -> dict:\n338:     \"\"\"\n339:     Sanitizes extracted invoice data immediately before sending it to the frontend.\n340:     Enforces MANDATORY RULES:","truncated_fields":["content"]}
