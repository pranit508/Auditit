{"step_index":326,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:09Z","content":"Created At: 2026-11-02T22:13:09+05:30\nCompleted At: 2026-11-02T22:13:09+05:30\nShowing lines 1-80 of 80\n1: \"\"\"\n2: AUDIT IT - Item Cleaning & Exclusion Filter\n3: Enforces strict Header vs Table separation and purges metadata from line items.\n4: \"\"\"\n5: \n6: import re\n7: \n8: def clean_extracted_items(items: list) -> list:\n9:     \"\"\"\n10:     Purges metadata, phone numbers, and GSTIN strings from extracted items array.\n11:     Ensures any item containing phone numbers, GSTIN strings, or metadata keywords\n12:     is purged before passing the items to the total recalculation logic.\n13:     \"\"\"\n14:     cleaned = []\n15:     \n16:     # Pattern matching GSTIN (15 characters: 2 digits, 5 letters, 4 digits, 1 letter, 1 digit/letter, Z, 1 digit/letter)\n17:     gstin_pattern = re.compile(r'\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b', re.IGNORECASE)\n18:     # Pattern matching Indian phone numbers (10 digits, optional +91 prefix)\n19:     phone_pattern = re.compile(r'(\\+?91[\\-\\s]?)?[6-9]\\d{9}')\n20:     \n21:     # Common metadata keywords that should never be product names\n22:     forbidden_keywords = [\n23:         \"gstin\", \"gst no\", \"contact\", \"phone\", \"mobile\", \"tel\", \n24:         \"pan no\", \"bank\", \"ifsc\", \"account no\", \"invoice no\",\n25:         \"tax invoice\", \"bill to\", \"ship to\", \"address\", \"state code\",\n26:         \"reverse charge\", \"e-way bill\", \"transport\", \"vehicle no\",\n27:         \"cash memo\", \"challan\", \"original for recipient\", \"date\"\n28:     ]\n29: \n30:     for item in items:\n31:         if not item or not isinstance(item, dict):\n32:             continue\n33: \n34:         desc = item.get(\"description\", \"\").strip()\n35:         desc_lower = desc.lower()\n36: \n37:         # 1. Skip if the description contains GSTIN patterns or phone numbers\n38:         if gstin_pattern.search(desc) or phone_pattern.search(desc):\n39:             continue\n40: \n41:         # 2. Skip if the description is just a metadata label\n42:         if any(keyword in desc_lower for keyword in forbidden_keywords):\n43:             continue\n44: \n45:         # 3. Skip invalid items with zero/negative rates or quantities\n46:         qty = item.get(\"quantity\") if \"quantity\" in item else item.get(\"qty\", 0)\n47:         rate = item.get(\"unit_rate\") if \"unit_rate\" in item else item.get(\"rate\", 0)\n48:         amount = item.get(\"amount\", 0)\n49: \n50:         # Ensure numeric values\n51:         try:\n52:             qty_num = float(qty) if qty is not None else 0\n53:             rate_num = float(rate) if rate is not None else 0\n54:             amt_num = float(amount) if amount is not None else 0\n55:         except (ValueError, TypeError):\n56:             continue\n57: \n58:         if (qty_num <= 0) or (rate_num <= 0 and amt_num <= 0):\n59:             continue\n60: \n61:         cleaned.append(item)\n62: \n63:     return cleaned\n64: \n65: if __name__ == \"__main__\":\n66:     # Test cases\n67:     test_items = [\n68:         {\"description\": \"Basmati Rice 25kg\", \"qty\": 10, \"rate\": 950.0, \"amount\": 9500.0},\n69:         {\"description\": \"GSTIN: 07AAAAA0000A1Z5\", \"qty\": 1, \"rate\": 100.0, \"amount\": 100.0},\n70:         {\"description\": \"Call: +91 9876543210\", \"qty\": 1, \"rate\": 50.0, \"amount\": 50.0},\n71:         {\"description\": \"Bank IFSC SBIN0001234\", \"qty\": 1, \"rate\": 20.0, \"amount\": 20.0},\n72:         {\"description\": \"Wheat Flour Atta 50kg\", \"qty\": 5, \"rate\": 420.0, \"amount\": 2100.0},\n73:         {\"description\": \"Zero Qty Product\", \"qty\": 0, \"rate\": 50.0, \"amount\": 0.0}\n74:     ]\n75:     res = clean_extracted_items(test_items)\n76:     print(\"Cleaned Items Count:\", len(res))\n77:     for r in res:\n78:         print(\" -\", r[\"description\"])\n79:     assert len(res) == 2, f\"Expected 2 items, got {len(res)}\"\n80:     print(\"All Python test cases passed successfully!\")"}
