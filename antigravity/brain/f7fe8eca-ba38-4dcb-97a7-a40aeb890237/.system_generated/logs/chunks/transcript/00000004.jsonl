{"step_index":334,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:28Z","content":"Created At: 2026-11-02T22:13:28+05:30\nCompleted At: 2026-11-02T22:13:28+05:30\nShowing lines 1-150 of 329\n1: // Client-Side Invoice Text Parser\n2: // Takes raw OCR or PDF text and extracts real structured fields without hallucinating fake items\n3: \n4: import { round2 } from \"./auditEngine.js\";\n5: \n6: /**\n7:  * Standard Indian GSTIN Regex\n8:  */\n9: const GSTIN_REGEX = /\\b[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n10: \n11: /**\n12:  * Common Date patterns (DD/MM/YYYY, DD-MM-YYYY, DD.MM.YYYY, DD Month YYYY)\n13:  */\n14: const DATE_REGEX = /\\b(\\d{1,2})[-/\\.](\\d{1,2})[-/\\.](\\d{2,4})\\b|\\b(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s,]+(\\d{2,4})\\b/i;\n15: \n16: /**\n17:  * Clean currency string to a float number (e.g. \"₹ 1,250.50\" -> 1250.50)\n18:  */\n19: function cleanNumber(str) {\n20:   if (!str) return 0;\n21:   const cleaned = str.replace(/[₹Rs\\.,\\s]/gi, m => (m === '.' ? '.' : ''));\n22:   // Handle commas as decimal separator if any\n23:   const normalized = str.replace(/[₹Rs\\s]/gi, '').replace(/,/g, '');\n24:   const num = parseFloat(normalized);\n25:   return isNaN(num) ? 0 : round2(num);\n26: }\n27: \n28: /**\n29:  * Checks if raw text contains commercial invoice keywords\n30:  */\n31: export function isLikelyInvoice(text) {\n32:   if (!text || text.trim().length < 15) return false;\n33: \n34:   const invoiceKeywords = [\n35:     \"invoice\", \"tax invoice\", \"bill\", \"cash memo\", \"parcha\", \"challan\",\n36:     \"gst\", \"gstin\", \"subtotal\", \"total\", \"grand total\", \"qty\", \"rate\", \n37:     \"amount\", \"hsn\", \"cgst\", \"sgst\", \"igst\", \"balance\", \"payable\", \"rupees\", \"mrp\"\n38:   ];\n39: \n40:   const lower = text.toLowerCase();\n41:   let matches = 0;\n42:   for (const kw of invoiceKeywords) {\n43:     if (lower.includes(kw)) matches++;\n44:   }\n45: \n46:   // At least 2 invoice keywords or a valid GSTIN pattern must be present\n47:   return matches >= 2 || GSTIN_REGEX.test(text);\n48: }\n49: \n50: /**\n51:  * Parses raw text into structured Invoice JSON matching our application schema\n52:  */\n53: export function\n<truncated 1547 bytes>\n    if (fallbackMatch) invoice_no = fallbackMatch[1];\n100:     else unreadable_fields.push(\"invoice_no\");\n101:   }\n102: \n103:   // 4. Extract Date\n104:   let date = null;\n105:   const dateMatch = rawText.match(DATE_REGEX);\n106:   if (dateMatch) {\n107:     date = dateMatch[0].trim();\n108:   } else {\n109:     unreadable_fields.push(\"date\");\n110:   }\n111: \n112:   // 5. Extract Vendor Name (usually the prominent text in the first 3 lines)\n113:   let vendor_name = null;\n114:   for (let i = 0; i < Math.min(5, lines.length); i++) {\n115:     const line = lines[i];\n116:     // Ignore generic headers like \"TAX INVOICE\", \"ORIGINAL FOR RECIPIENT\"\n117:     if (!/tax invoice|original|duplicate|retail invoice|cash memo/i.test(line) && line.length > 3) {\n118:       vendor_name = line;\n119:       break;\n120:     }\n121:   }\n122:   if (!vendor_name) {\n123:     vendor_name = sourceFileName.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \") + \" (Extracted)\";\n124:   }\n125: \n126:   // 6. Extract Line Items from table rows\n127:   const items = [];\n128:   const itemCandidateRegex = /^(?:(\\d+)[\\.\\s]+)?([A-Za-z0-9\\s\\(\\)%\\/-]+?)\\s+(\\d+(?:\\.\\d+)?)\\s+(?:₹|Rs\\.?\\s*)?(\\d+(?:\\.\\d+)?)\\s+(?:₹|Rs\\.?\\s*)?(\\d+(?:\\.\\d+)?)$/i;\n129: \n130:   for (let i = 0; i < lines.length; i++) {\n131:     const line = lines[i];\n132: \n133:     // Skip header lines\n134:     if (/item\\s+desc|description|particulars|qty|rate|amount|hsn/i.test(line) && /rate|amount/i.test(line)) {\n135:       continue;\n136:     }\n137:     // Skip summary lines\n138:     if (/subtotal|sub\\s+total|total|cgst|sgst|igst|grand\\s+total|round\\s+off/i.test(line)) {\n139:       continue;\n140:     }\n141: \n142:     // Try standard pattern: Description Qty Rate Amount\n143:     const match = line.match(itemCandidateRegex);\n144:     if (match) {\n145:       const desc = match[2].trim();\n146:       const qty = parseFloat(match[3]) || 1;\n147:       const rate = parseFloat(match[4]) || 0;\n148:       const amount = parseFloat(match[5]) || round2(qty * rate);\n149: \n150:       if (desc.length >= 2 && amount > 0) {","truncated_fields":["content"]}
