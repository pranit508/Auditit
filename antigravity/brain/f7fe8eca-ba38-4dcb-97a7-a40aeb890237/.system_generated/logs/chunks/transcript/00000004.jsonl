{"step_index":328,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:13Z","content":"Created At: 2026-11-02T22:13:13+05:30\nCompleted At: 2026-11-02T22:13:13+05:30\nShowing lines 1-71 of 71\n1: // AUDIT IT - Strict Item Cleaner & Metadata Exclusion Filter\n2: // CRITICAL RULES:\n3: // 1. HEADER VS TABLE SEPARATION: Metadata (GSTIN, Phone, Address, Bank details) must NEVER be extracted as line items.\n4: // 2. EXCLUSION RULES: Purge phone numbers, GSTIN patterns, and metadata labels.\n5: \n6: // Pattern matching GSTIN (15 characters: 2 digits, 5 letters, 4 digits, 1 letter, 1 digit/letter, Z, 1 digit/letter)\n7: const GSTIN_PATTERN = /\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n8: \n9: // Pattern matching Indian phone numbers (10 digits, optional +91 prefix)\n10: const PHONE_PATTERN = /(\\+?91[\\-\\s]?)?[6-9]\\d{9}/;\n11: \n12: // Common metadata keywords that should never be product names\n13: const FORBIDDEN_KEYWORDS = [\n14:   \"gstin\", \"gst no\", \"contact\", \"phone\", \"mobile\", \"tel\", \n15:   \"pan no\", \"bank\", \"ifsc\", \"account no\", \"invoice no\",\n16:   \"tax invoice\", \"bill to\", \"ship to\", \"address\", \"state code\",\n17:   \"reverse charge\", \"e-way bill\", \"transport\", \"vehicle no\",\n18:   \"cash memo\", \"challan\", \"original for recipient\", \"date\"\n19: ];\n20: \n21: /**\n22:  * Purges metadata, phone numbers, and GSTIN strings from extracted items array\n23:  * @param {Array} items - Raw items array extracted by AI or OCR\n24:  * @returns {Array} Cleaned items strictly containing genuine products/services\n25:  */\n26: export function cleanExtractedItems(items) {\n27:   if (!Array.isArray(items)) return [];\n28:   const cleaned = [];\n29: \n30:   for (const item of items) {\n31:     if (!item || typeof item !== \"object\") continue;\n32: \n33:     const desc = (item.description || item.item_name || \"\").trim();\n34:     const descLower = desc.toLowerCase();\n35: \n36:     // 1. Skip if the description contains GSTIN patterns or phone numbers\n37:     if (GSTIN_PATTERN.test(desc) || PHONE_PATTERN.test(desc)) {\n38:       console.warn(\"[AUDIT IT] Purged metadata item (GSTIN/Phone pattern detected):\", desc);\n39:       continue;\n40:     }\n41: \n42:     // 2. Skip if the description is just a metadata label\n43:     if (FORBIDDEN_KEYWORDS.some(keyword => descLower.includes(keyword))) {\n44:       console.warn(\"[AUDIT IT] Purged metadata item (Forbidden keyword detected):\", desc);\n45:       continue;\n46:     }\n47: \n48:     // 3. Skip invalid items with zero/negative rates or quantities\n49:     const qty = Number(item.quantity !== undefined ? item.quantity : item.qty);\n50:     const rate = Number(item.unit_rate !== undefined ? item.unit_rate : item.rate);\n51:     const amount = Number(item.amount);\n52: \n53:     // Normalize property names for consistency (qty, rate, amount)\n54:     const normalizedItem = {\n55:       ...item,\n56:       qty: isNaN(qty) ? 1 : qty,\n57:       rate: isNaN(rate) ? (amount > 0 && qty > 0 ? amount / qty : 0) : rate,\n58:       amount: isNaN(amount) ? (qty * rate) : amount,\n59:       description: desc\n60:     };\n61: \n62:     if (normalizedItem.qty <= 0 || (normalizedItem.rate <= 0 && normalizedItem.amount <= 0)) {\n63:       console.warn(\"[AUDIT IT] Purged item with non-positive qty or rate:\", item);\n64:       continue;\n65:     }\n66: \n67:     cleaned.push(normalizedItem);\n68:   }\n69: \n70:   return cleaned;\n71: }"}
