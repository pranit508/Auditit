{"step_index":330,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:43:15Z","content":"Created At: 2026-11-02T22:13:15+05:30\nCompleted At: 2026-11-02T22:13:15+05:30\nShowing lines 1-150 of 265\n1: // Multimodal AI & Real-Time Document Extraction Pipeline for AUDIT IT\n2: // RULE: \"AI reads, code calculates. Do NOT trust the AI to do math.\"\n3: \n4: import { sanitizeInvoiceData } from \"./privacyMasker.js\";\n5: import { parseInvoiceText, isLikelyInvoice } from \"./invoiceTextParser.js\";\n6: \n7: const GEMINI_SYSTEM_INSTRUCTION = `\n8: You are an invoice parsing engine for AUDIT IT.\n9: \n10: TASK:\n11: 1. Examine the provided document or image.\n12: 2. First, determine if this is a genuine business invoice, cash memo, purchase bill, or tax receipt.\n13: 3. IF IT IS NOT an invoice (e.g. it is a person's photo, landscape, screenshot of a chat, unrelated document, or random text):\n14:    - Set is_valid_bill to false.\n15:    - Set rejection_reason explaining why (e.g. \"Uploaded image is not a financial bill or invoice\").\n16:    - Leave all financial fields null or empty.\n17: 4. IF IT IS AN INVOICE:\n18:    - Set is_valid_bill to true.\n19:    - Extract the EXACT vendor name, GSTIN, invoice number, date, and line items (description, qty, rate, amount) visible on the bill.\n20:    - NEVER make up or hallucinate missing data or dummy items. If a field (like GSTIN or invoice number) is not present or unreadable, set it to null and append it to unreadable_fields.\n21:    - Extract exact declared amounts; DO NOT fix math mistakes in the extraction.\n22: \n23: Return ONLY a valid JSON object matching this schema:\n24: {\n25:   \"is_valid_bill\": boolean,\n26:   \"rejection_reason\": string or null,\n27:   \"unreadable_fields\": [\"string\"],\n28:   \"vendor_name\": string or null,\n29:   \"vendor_address\": string or null,\n30:   \"gstin\": string or null,\n31:   \"invoice_no\": string or null,\n32:   \"date\": \"YYYY-MM-DD\" or null,\n33:   \"items\": [\n34:     {\n35:       \"description\": string,\n36:       \"hsn\": string or null,\n37:       \"qty\": number,\n38:       \"rate\": number,\n39:       \"amount\": number,\n40:       \"is_blurry\": boolean\n41:     }\n42:   ],\n43:   \"\n<truncated 2065 bytes>\narts?.[0]?.text;\n103:         if (rawText) {\n104:           const parsed = JSON.parse(rawText);\n105:           parsed.uploaded_file_url = objectUrl;\n106:           parsed.file_type = mimeType;\n107:           parsed.file_name = file.name;\n108:           return sanitizeInvoiceData(parsed);\n109:         }\n110:       }\n111:     } catch (err) {\n112:       console.warn(\"Gemini multimodal call failed; continuing with client-side OCR:\", err);\n113:     }\n114:   }\n115: \n116:   // 2. Client-side Real OCR for PDFs\n117:   if (mimeType.includes(\"pdf\") && window.pdfjsLib) {\n118:     if (onProgress) onProgress(\"Extracting text from PDF document...\");\n119:     try {\n120:       const pdfText = await extractTextFromPdf(file);\n121:       if (pdfText && pdfText.trim().length > 10) {\n122:         const parsed = parseInvoiceText(pdfText, file.name);\n123:         parsed.uploaded_file_url = objectUrl;\n124:         parsed.file_type = mimeType;\n125:         parsed.file_name = file.name;\n126:         return sanitizeInvoiceData(parsed);\n127:       }\n128:     } catch (err) {\n129:       console.warn(\"PDF.js text extraction error:\", err);\n130:     }\n131:   }\n132: \n133:   // 3. Client-side Real OCR for Images using Tesseract.js\n134:   if (window.Tesseract && (mimeType.startsWith(\"image/\") || !mimeType.includes(\"pdf\"))) {\n135:     if (onProgress) onProgress(\"Running on-device OCR on bill image...\");\n136:     try {\n137:       const ocrResult = await window.Tesseract.recognize(file, \"eng\", {\n138:         logger: m => {\n139:           if (onProgress && m.status === \"recognizing text\" && m.progress) {\n140:             onProgress(`Reading bill text: ${Math.round(m.progress * 100)}%`);\n141:           }\n142:         }\n143:       });\n144: \n145:       const extractedText = ocrResult?.data?.text || \"\";\n146:       if (extractedText.trim().length > 15) {\n147:         const parsed = parseInvoiceText(extractedText, file.name);\n148:         parsed.uploaded_file_url = objectUrl;\n149:         parsed.file_type = mimeType;\n150:         parsed.file_name = file.name;","truncated_fields":["content"]}
