Name === \"TEXTAREA\")) {\n39:       focusInfo = {\n40:         id: activeEl.id,\n41:         action: activeEl.getAttribute(\"data-action\"),\n42:         index: activeEl.getAttribute(\"data-index\"),\n43:         selectionStart: activeEl.selectionStar\n<truncated 1624 bytes>\nrgetInput = document.getElementById(focusInfo.id);\n78:       } else if (focusInfo.action && focusInfo.index !== null) {\n79:         targetInput = document.querySelector(`input[data-action=\"${focusInfo.action}\"][data-index=\"${focusInfo.index}\"]`);\n80:       }\n81:       if (targetInput) {\n82:         targetInput.focus();\n83:         if (targetInput.setSelectionRange && focusInfo.selectionStart !== null) {\n84:           try {\n85:             targetInput.setSelectionRange(focusInfo.selectionStart, focusInfo.selectionEnd);\n86:           } catch (_) {}\n87:         }\n88:       }\n89:     }\n90:   }\n91: \n92:   async loadSample(sampleKey) {\n93:     const rawSample = SAMPLE_INVOICES[sampleKey];\n94:     if (!rawSample) return;\n95: \n96:     // Deep copy to allow editing without mutating original sample\n97:     this.currentInvoice = JSON.parse(JSON.stringify(rawSample));\n98:     this.currentAudit = auditInvoice(this.currentInvoice);\n99: \n100:     // Compute code-calculated tax & deemed profit under Sec 44AD\n101:     const { audit_summary, calculated_tax } = calculateTaxMetrics(this.currentInvoice, this.currentAudit, this.userTaxSettings);\n102:     const ai_suggestions = await generate_tax_suggestions(audit_summary, calculated_tax, this.apiKey);\n103:     \n104:     this.taxData = { audit_summary, calculated_tax, ai_suggestions };\n105:     this.currentView = \"review\";\n106:     this.render();\n107:     window.scrollTo({ top: 0, behavior: \"smooth\" });\n108:     this.showToast(`Loaded ${rawSample.scenarioName}`, \"info\");\n109:   }\n110: \n111:   createManualBill() {\n112:     this.currentInvoice = {\n113:       id: \"manual-\" + Date.now(),\n114:       scenarioName: \"Manual 