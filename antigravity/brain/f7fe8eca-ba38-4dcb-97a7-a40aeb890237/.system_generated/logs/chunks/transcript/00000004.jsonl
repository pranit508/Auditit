 null,\n196:     unreadable_fields: [\"gstin\", \"invoice_no\"],\n197:     vendor_name: cleanDocName,\n198:     vendor_address: \"Commercial Address from Scanned Bill\",\n199:     gstin: \"\",\n200:     invoice_no: \"BILL-SCAN\",\n201:     date: new Date().toIS\n<truncated 2 bytes>\ntring().split(\"T\")[0],\n202:     badge: {\n203:       text: \"Uploaded Document\",\n204:       color: \"emerald\"\n205:     },\n206:     items: [\n207:       {\n208:         id: \"item-1\",\n209:         description: `Billed Item 1 (${cleanDocName})`,\n210:         hsn: \"\",\n211:         qty: 1,\n212:         rate: 500.00,\n213:         amount: 500.00,\n214:         is_blurry: true,\n215:         unclear_note: \"Please verify quantity and rate from your uploaded photo on the left.\"\n216:       }\n217:     ],\n218:     subtotal: 500.00,\n219:     cgst: 25.00,\n220:     sgst: 25.00,\n221:     igst: 0.00,\n222:     total_declared: 550.00,\n223:     bank_details: {\n224:       bank_name: \"Bank on Bill\",\n225:       account_number: \"•••• •••• •••• 1024\",\n226:       ifsc: \"SBIN••••••\"\n227:     },\n228:     uploaded_file_url: objectUrl,\n229:     file_type: mimeType,\n230:     file_name: file.name,\n231:     notes: `Scanned from user uploaded document: ${file.name}. View original photo on the left to verify numbers.`\n232:   };\n233: \n234:   return sanitizeInvoiceData(cleanExtracted);\n235: }\n236: \n237: /**\n238:  * Extracts plain text from PDF using PDF.js\n239:  */\n240: async function extractTextFromPdf(file) {\n241:   const arrayBuffer = await file.arrayBuffer();\n242:   const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;\n243:   let fullText = \"\";\n244: \n245:   for (let i = 1; i <= Math.min(3, pdf.numPages); i++) {\n246:     const page = await pdf.getPage(i);\n247:     const textContent = await page.getTextContent();\n248:     const pageStrings = textContent.items.map(item => item.str);\n249:     fullText += pageStrings.join(\" \") + \"\\n\";\n250:   }\n251: \n252:   return fullText;\n253: }\n254: \n255: /**\n256:  * Converts File to Base64\n257:  */\n258: function fileToBase64(file) {\n259:   return new Promise((resolve, reject) => {\n260:     const reader = new FileReader();\n261:     reader.onload = () => resolve(reader.result);\n262:     reader.onerror = reject;\n263:     reader.readAsDataURL(file);\n264:   });\n265: }","truncated_fields":["content"]}
