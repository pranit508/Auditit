apiKey] - Google Gemini API Key\\n * @returns {Promise<{ suggestions: string[], disclaimer: string, isAiGenerated: boolean }>}\\n */\\nexport async function generate_tax_suggestions(audit_summary, calculated_tax, apiKey = null) {\\n  if (!audit_summary || audit_summary.total_turnover === 0) {\\n    return {\\n      suggestions: [\\n        \\\"Document was rejected by the gatekeeper: not a commercial bill or invoice.\\\",\\n        \\\"Zero hallucination rule: no tax suggestions generated on non-bill media.\\\",\\n        \\\"Upload a commercial purchase invoice or enter bill details manually.\\\"\\n      ],\\n      disclaimer: \\\"Document not eligible for tax audit.\\\",\\n      isAiGenerated: false\\n    };\\n  }\""}}]}
