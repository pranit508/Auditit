 });\n223: \n224:   // 4. SUB-TOTAL CALCULATION:\n225:   // Do not trust random OCR numbers near the bank details for Subtotal.\n226:   // Calculate the Subtotal deterministically from the extracted items:\n227:   // subtotal = sum(item.quantity * item.unit_rate for item in items)\n228:   // For this bill: 2535 + 1270 = 3805.00.\n229:   let calculatedSubtotal = 0;\n230:   if (cleanItems.length > 0) {\n231:     calculatedSubtotal = Math.round(cleanItems.reduce((acc, it) => acc + (it.quantity * it.unit_rate), 0) * 100) / 100;\n232:     res.subtotal = calculatedSubtotal;\n233:     res.calculated_subtotal = calculatedSubtotal;\n234:   } else {\n235:     calculatedSubtotal = Number(res.subtotal) || 0;\n236:   }\n237: \n238:   // 5. GRAND TOTAL SANITY CHECK:\n239:   // Grand Total must be approximately (Subtotal + Total Tax).\n240:   // Here, 3805 + 684.90 = 4489.90 (~4490).\n241:   // If the OCR extracted '774' or '585132', reject them because they are bank/account/IFSC digits.\n242:   const cgst = Number(res.cgst) || 0;\n243:   const sgst = Number(res.sgst) || 0;\n244:   const igst = Number(res.igst) || 0;\n245:   const totalTax = Math.round((cgst + sgst + igst) * 100) / 100;\n246:   const expectedTotal = Math.round((calculatedSubtotal + totalTax) * 100) / 100;\n247: \n248:   // Cross-check against printed 'Total in words' line if present\n249:   let wordTotal = 0;\n250:   const rawOcr = String(res.raw_ocr_text || res.raw_text || res.notes || \"\");\n251:   for (const candidateText of [rawOcr, String(res.notes || \"\"), String(res.amount_in_words || \"\"), String(res.total_in_words || \"\")]) {\n252:     if (candidateText) {\n253:       for (const line of candidateText.split(/\\r?\\n/)) {\n254:         if (/(?:total|amount|rupees)\\s+(?:in\\s+words|in\\s+word)/i.test(line) || /rupees\\s+[a-z\\s]+only/i.test(line)) {\n255:           const wt = parseWordsToNumber(line);\n256:           if (wt > 0) {\n257:             wordTotal = wt;\n258:             break;\n259:           }\n260:         }"}
