{"step_index":1169,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:49:37Z","content":"Created At: 2026-11-03T00:19:37+05:30\nCompleted At: 2026-11-03T00:19:37+05:30\nShowing lines 260-330 of 568\n260:         clean_items.append(item)\n261: \n262:     data[\"items\"] = clean_items\n263: \n264:     # 3. Ensure numeric fields strip commas cleanly via parse_inr\n265:     for key in [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"]:\n266:         val = data.get(key)\n267:         if val is not None and str(val).strip() != \"\" and str(val).lower() != \"null\":\n268:             data[key] = parse_inr(val)\n269: \n270:     # 4. SUB-TOTAL CALCULATION:\n271:     # Do not trust random OCR numbers near bank details for Subtotal.\n272:     # Calculate the Subtotal deterministically from the extracted items:\n273:     # subtotal = sum(item.quantity * item.unit_rate for item in items)\n274:     if clean_items:\n275:         calculated_subtotal = round(sum(it[\"quantity\"] * it[\"unit_rate\"] for it in clean_items), 2)\n276:         data[\"subtotal\"] = calculated_subtotal\n277:         data[\"calculated_subtotal\"] = calculated_subtotal\n278:     else:\n279:         calculated_subtotal = float(data.get(\"subtotal\") or 0.0)\n280: \n281:     # 5. GRAND TOTAL SANITY CHECK:\n282:     # Grand Total must be approximately (Subtotal + Total Tax).\n283:     # If the OCR extracted '774' or '585132', reject them because they are bank/account/IFSC digits.\n284:     cgst = float(data.get(\"cgst\") or 0.0)\n285:     sgst = float(data.get(\"sgst\") or 0.0)\n286:     igst = float(data.get(\"igst\") or 0.0)\n287:     total_tax = round(cgst + sgst + igst, 2)\n288:     expected_total = round(calculated_subtotal + total_tax, 2)\n289: \n290:     # Check for printed Grand Total in Words line (e.g. 'FOUR THOUSAND FOUR HUNDRED AND NINETY')\n291:     word_total = 0.0\n292:     raw_ocr = str(data.get(\"raw_ocr_text\") or data.get(\"raw_text\") or data.get(\"notes\") or \"\")\n293:     for candidate_text in [raw_ocr, str(data.get(\"notes\") or \"\"), str(data.get(\"amount_in_words\") or \"\"), str(data.get(\"total_in_words\") or \"\")]:\n294:         if candidate_text:\n295:             for line in candidate_text.splitlines():\n296:                 if re.search(r'(?:total|amount|rupees)\\s+(?:in\\s+words|in\\s+word)', line, re.IGNORECASE) or re.search(r'rupees\\s+[a-zA-Z\\s]+only', line, re.IGNORECASE):\n297:                     wt = parse_words_to_number(line)\n298:                     if wt > 0:\n299:                         word_total = wt\n300:                         break\n301:         if word_total > 0:\n302:             break\n303: \n304:     current_declared = float(data.get(\"declared_total\") or 0.0)\n305:     \n306:     # Reject bank/account/IFSC digits (e.g. 774, 585132) if wildly outside expected total\n307:     is_declared_suspicious = False\n308:     if expected_total > 0:\n309:         if current_declared <= 0:\n310:             is_declared_suspicious = True\n311:         elif current_declared < (expected_total * 0.70) or current_declared > (expected_total * 1.50):\n312:             is_declared_suspicious = True\n313: \n314:     if word_total > 0:\n315:         # Cross-check against printed words confirms grand total\n316:         data[\"declared_total\"] = word_total\n317:         data[\"total_declared\"] = word_total\n318:     elif is_declared_suspicious and expected_total > 0:\n319:         final_total = round(expected_total) if abs(expected_total - round(expected_total)) < 0.20 else expected_total\n320:         data[\"declared_total\"] = final_total\n321:         data[\"total_declared\"] = final_total\n322:     else:\n323:         data[\"total_declared\"] = current_declared if current_declared > 0 else expected_total\n324:         data[\"declared_total\"] = data[\"total_declared\"]\n325: \n326:     # Ensure schema aliases for frontend compatibility\n327:     if data.get(\"invoice_number\") and not data.get(\"invoice_no\"):\n328:         data[\"invoice_no\"] = data[\"invoice_number\"]\n329: \n330:     return data"}
{"step_index":1170,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T18:49:37Z","input_tokens":3556,"cache_read_tokens":20331,"output_tokens":615,"thinking":"The code checks for discrepancies between the declared total and the subtotal, rejecting the OCR result if the declared total is less than half the subtotal. If a discrepancy exists, it calculates a new declared total based on the subtotal plus taxes. This is intended to address potential OCR errors that might underestimate the total.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":"100","Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/aiExtractor.js\"","StartLine":"1"}}]}
{"step_index":1171,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:49:44Z","content":"Created At: 2026-11-03T00:19:44+05:30\nCompleted At: 2026-11-03T00:19:44+05:30\nShowing lines 1-100 of 272\n1: // Multimodal AI & Real-Time Document Extraction Pipeline for AUDIT IT\n2: // RULE: \"AI reads, code calculates. Do NOT trust the AI to do math.\"\n3: \n4: import { sanitizeInvoiceData } from \"./privacyMasker.js\";\n5: import { parseInvoiceText, isLikelyInvoice } from \"./invoiceTextParser.js\";\n6: import { cleanExtractedItems, sanitizeAndCleanInvoice } from \"./itemCleaner.js\";\n7: \n8: const DEFAULT_API_KEY = \"AQ.Ab8RN6LhTNa6kIQRpd_OijgrXNfmwLOw7rcxiMN8aWW-_U7mPw\";\n9: \n10: const GEMINI_SYSTEM_INSTRUCTION = `You are a strict GST Invoice extractor. \n11: RULES FOR LINE ITEMS:\n12: - Extract items ONLY from the central itemized table bounded between the table header (S.No, Description, HSN, Qty, Rate, Amount) and the Subtotal row.\n13: - NEVER extract text from the header or footer as line items:\n14:   * DO NOT extract addresses or cities (e.g. 'Mumbai, Maharashtra').\n15:   * DO NOT extract PAN, GSTIN, or buyer details (e.g. 'PAN : 26CORPP').\n16:   * DO NOT extract bank account or payment details (e.g. 'Acc. Number 271').\n17: - Each valid line item MUST have a legitimate product name, quantity > 0, unit rate > 0, and total amount.\n18: \n19: GRAND TOTAL:\n20: - Extract the final payable Grand Total printed at the bottom of the bill (e.g., '4,490.00' / 'FOUR THOUSAND FOUR HUNDRED AND NINETY'). Do NOT extract partial account numbers or phone numbers as the grand total.\n21: \n22: NUMERIC INSTRUCTIONS:\n23: - Never discard digits before commas! '2,535.00' must be extracted as '2,535.00'. '1,270.00' must be extracted as '1,270.00'. '4,490.00' must be extracted as '4,490.00'.\n24: - If you are unsure about the digits before the comma, read the 'Amount in Words' printed on the bill (e.g. 'FOUR THOUSAND FOUR HUNDRED AND NINETY RUPEES ONLY') to confirm the thousands digit.\n25: - All numbers and rates must be extracted as strings (e.g. \"2,535.00\", \"1\", \"4,490.00\").\n26: \n27: Return ONLY a valid JSON object matching this schema:\n28: {\n29:  \n<truncated 526 bytes>\n from an uploaded invoice image/PDF.\n51:  * Prioritizes:\n52:  * 1. Live Multimodal Gemini API (if key configured)\n53:  * 2. In-browser Client-side PDF.js (for PDFs)\n54:  * 3. In-browser Client-side Tesseract.js OCR (for images)\n55:  * 4. Document-aware parser (zero fake/mock items)\n56:  */\n57: export async function extractInvoiceFromDocument(file, apiKey = null, onProgress = null) {\n58:   const effectiveKey = (apiKey && apiKey.trim().length > 10) ? apiKey.trim() : DEFAULT_API_KEY;\n59:   const mimeType = file.type || \"image/jpeg\";\n60:   const objectUrl = URL.createObjectURL(file);\n61: \n62:   // 1. Prioritize FastAPI + Google GenAI (/api/analyze-bill) backend endpoint\n63:   try {\n64:     if (onProgress) onProgress(\"Uploading bill to FastAPI backend (Gemini 2.5 Flash)...\");\n65:     const formData = new FormData();\n66:     formData.append(\"file\", file);\n67: \n68:     const headers = {\n69:       \"x-api-key\": effectiveKey\n70:     };\n71: \n72:     const backendResp = await fetch(\"/api/analyze-bill\", {\n73:       method: \"POST\",\n74:       headers,\n75:       body: formData\n76:     });\n77: \n78:     if (backendResp.ok) {\n79:       const rawText = await backendResp.text();\n80:       let parsed = null;\n81:       try {\n82:         parsed = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n83:         if (typeof parsed === \"string\") {\n84:           parsed = JSON.parse(parsed);\n85:         }\n86:       } catch (e) {\n87:         console.warn(\"Could not parse backend JSON:\", e);\n88:       }\n89: \n90:       if (parsed && typeof parsed === \"object\") {\n91:         parsed.uploaded_file_url = objectUrl;\n92:         parsed.file_type = mimeType;\n93:         parsed.file_name = file.name;\n94: \n95:         // Map ExtractedInvoice schema to app schema\n96:         if (parsed.invoice_number && !parsed.invoice_no) {\n97:           parsed.invoice_no = parsed.invoice_number;\n98:         }\n99:         if (parsed.declared_total !== undefined && parsed.total_declared === undefined) {\n100:           parsed.total_declared = parsed.declared_total;","truncated_fields":["content"]}
