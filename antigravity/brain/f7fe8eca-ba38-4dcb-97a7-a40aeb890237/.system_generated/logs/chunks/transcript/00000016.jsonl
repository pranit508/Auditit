hod: \"POST\",\n148:         headers: { \"Content-Type\": \"application/json\" },\n149:         body: JSON.stringify(payload)\n150:       });\n151: \n152:       if (response.ok) {\n153:         const result = await response.json();\n154:         const rawText = result.candidates?.[0]?.content?.parts?.[0]?.text;\n155:         if (rawText) {\n156:           const parsed = JSON.parse(rawText);\n157:           const cleaned = sanitizeAndCleanInvoice(parsed);\n158:           if (cleaned.items && Array.isArray(cleaned.items)) {\n159:             cleaned.items = cleanExtractedItems(cleaned.items);\n160:           }"}
