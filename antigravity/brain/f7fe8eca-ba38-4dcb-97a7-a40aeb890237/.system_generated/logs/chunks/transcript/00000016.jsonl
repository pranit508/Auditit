{"step_index":1167,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:49:33Z","content":"Created At: 2026-11-03T00:19:33+05:30\nCompleted At: 2026-11-03T00:19:33+05:30\nShowing lines 180-260 of 568\n180: \n181:     # 1. Clean supplier name of trailing symbols\n182:     supplier = data.get(\"vendor_name\") or data.get(\"supplier_name\") or \"\"\n183:     if supplier:\n184:         supplier_cleaned = re.sub(r'[\\s&0\\|\\[\\]\\(\\)]+$', '', str(supplier)).strip()\n185:         # Also clean phone/email prefixes if any\n186:         supplier_cleaned = re.sub(r'(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+', '', supplier_cleaned, flags=re.IGNORECASE).strip()\n187:         supplier_cleaned = re.sub(r'[\\s,\\-–—:|]+$', '', supplier_cleaned).strip()\n188:         data[\"vendor_name\"] = supplier_cleaned if supplier_cleaned else \"Supplier Name Unclear\"\n189:         data[\"supplier_name\"] = data[\"vendor_name\"]\n190: \n191:     # 2. Filter garbage line items\n192:     clean_items = []\n193:     for item in data.get(\"items\", []):\n194:         if not isinstance(item, dict):\n195:             continue\n196: \n197:         desc = (item.get(\"description\") or \"\").strip()\n198:         \n199:         # Remove stray leading/trailing brackets and vertical pipes from OCR\n200:         desc = re.sub(r'^[\\[\\|\\]\\(\\)\\s]+|[\\[\\|\\]\\(\\)\\s]+$', '', desc).strip()\n201:         item[\"description\"] = desc\n202: \n203:         desc_lower = desc.lower()\n204: \n205:         # Reject any item if its description contains 'PAN', 'Acc. Number', 'Account', 'Bank', 'IFSC',\n206:         # or standard state/city names like 'Maharashtra', 'Mumbai', 'Delhi', 'Haryana'.\n207:         forbidden_terms = [\n208:             \"pan\", \"acc. number\", \"acc no\", \"account\", \"bank\", \"ifsc\",\n209:             \"maharashtra\", \"mumbai\", \"delhi\", \"haryana\", \"karnataka\", \"gujarat\",\n210:             \"rajasthan\", \"punjab\", \"uttar pradesh\", \"chennai\", \"bengaluru\",\n211:             \"kolkata\", \"hyderabad\", \"ahmedabad\", \"pune\", \"buyer\", \"consignee\",\n212:             \"signature\", \"authorised\", \"terms\", \"condition\", \"bank details\", \"e-way bill\"\n213:         ]\n214:         if any(term in desc_lower for term i\n<truncated 225 bytes>\niption lacks at least 4 letters\n221:         if len(re.findall(r'[a-zA-Z]', desc)) < 4:\n222:             continue\n223: \n224:         # Skip if more than 20% of description is weird symbols/punctuation\n225:         symbols = re.findall(r'[~|©\\[\\]=_{}@#$%^&*]', desc)\n226:         if len(desc) > 0 and (len(symbols) / len(desc)) > 0.20:\n227:             continue\n228: \n229:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', etc.\n230:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n231:         if desc_clean and len(desc_clean) >= 3:\n232:             desc = desc_clean\n233:             item[\"description\"] = desc\n234: \n235:         # Quantity and Rate sanity with parse_inr\n236:         raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\")\n237:         qty = parse_inr(raw_qty) if raw_qty is not None and str(raw_qty).strip() != \"\" else 1.0\n238:         if qty <= 0:\n239:             qty = 1.0\n240: \n241:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\")\n242:         rate = parse_inr(raw_rate)\n243: \n244:         raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\")\n245:         billed = parse_inr(raw_billed) if raw_billed is not None and str(raw_billed).strip() != \"\" else round(qty * rate, 2)\n246: \n247:         # Post-Processing Column Swap Fallback:\n248:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n249:         # it means qty and rate were misaligned. Swap them:\n250:         if billed > 0 and qty == billed and rate in [1.0, 2.0, 1, 2]:\n251:             qty = 1.0\n252:             rate = billed\n253: \n254:         item[\"quantity\"] = qty\n255:         item[\"qty\"] = qty\n256:         item[\"unit_rate\"] = rate\n257:         item[\"rate\"] = rate\n258:         item[\"total_amount\"] = billed\n259:         item[\"amount\"] = billed\n260:         clean_items.append(item)","truncated_fields":["content"]}
