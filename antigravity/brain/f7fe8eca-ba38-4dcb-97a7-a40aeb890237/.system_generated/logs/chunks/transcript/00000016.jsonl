lower):\n131:             continue\n132: \n133:         # 3. Skip invalid items with zero/negative rates or quantities\n134:         qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n135:         rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.\n<truncated 6 bytes>\nate\", 0)\n136:         amount = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\", 0)\n137: \n138:         # Ensure numeric values\n139:         try:\n140:             qty_num = float(qty) if qty is not None else 0\n141:             rate_num = float(rate) if rate is not None else 0\n142:             amt_num = float(amount) if amount is not None else 0\n143:         except (ValueError, TypeError):\n144:             continue\n145: \n146:         if (qty_num <= 0) or (rate_num <= 0 and amt_num <= 0):\n147:             continue\n148: \n149:         # Post-Processing Column Swap Fallback:\n150:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n151:         # it means qty and rate were misaligned. Swap them:\n152:         if amt_num > 0 and qty_num == amt_num and rate_num in [1.0, 2.0, 1, 2]:\n153:             qty_num = 1.0\n154:             rate_num = amt_num\n155:             item[\"quantity\"] = 1.0\n156:             item[\"qty\"] = 1.0\n157:             item[\"unit_rate\"] = amt_num\n158:             item[\"rate\"] = amt_num\n159:             item[\"total_amount\"] = amt_num\n160:             item[\"amount\"] = amt_num\n161: \n162:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n163:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n164:         if desc_clean and len(desc_clean) >= 3:\n165:             item[\"description\"] = desc_clean\n166: \n167:         cleaned.append(item)\n168: \n169:     return cleaned\n170: \n171: def sanitize_and_clean_invoice(data: dict) -> dict:\n172:     \"\"\"\n173:     Sanitize and clean invoice data:\n174:     1. Clean supplier name of trailing symbols\n175:     2. Filter garbage line items (stamps, signatures, low letter count, excessive symbols)\n176:     3. Ensure numeric fields strip commas cleanly (e.g., '2,535.00' -> 2535.0)\n177:     \"\"\"\n178:     if not isinstance(data, dict):\n179:         return data\n180: ","truncated_fields":["content"]}
