address item (Pattern or short length):\", desc);\n44:       continue;\n45:     }\n46: \n47:     // Skip single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n48:     if (/^[A-Za-z0-9]{7,16}$/.test(desc) && /\\d/.test(desc) && /[A-Za-z]/.test(desc)) {\n49:       console.warn(\"[AUDIT IT] Purged single-token alphanumeric tax ID:\", desc);\n50:       continue;\n51:     }\n52: \n53:     // 2. Skip if the description matches address/metadata keywords\n54:     if (FORBIDDEN_KEYWORDS.some(keyword => descLower.includes(keyword))) {\n55:       console.warn(\"[AUDIT IT] Purged metadata item (Forbidden keyword detected):\", desc);\n56:       continue;\n57:     }\n58: \n59:     // 3. Skip invalid items with zero/negative rates or quantities\n60:     let qty = Number(item.quantity !== undefined ? item.quantity : item.qty);"}
