mount}`);\\n  });\\n  console.log(\\\"Subtotal:\\\", parsed.subtotal);\\n  console.log(\\\"CGST:\\\", parsed.cgst, \\\"SGST:\\\", parsed.sgst);\\n  console.log(\\\"Declared Total:\\\", parsed.declared_total);\\n  console.log(\\\"Total Declared:\\\", parsed.total_declared);\\n\\n  // Assertions\\n  if (parsed.items.length !== 4) throw new Error(\\\"Expected 4 items, got \\\" + parsed.items.length);\\n  if (parsed.declared_total === 774) throw new Error(\\\"774 was not rejected!\\\");\\n  if (parsed.declared_total !== parsed.total_declared) throw new Error(\\\"declared_total and total_declared not synchronized!\\\");\\n  if (parsed.items[0].description.includes(\\\"8544\\\")) throw new Error(\\\"HSN leaked into description!\\\");\\n  if (parsed.items[0].quantity !== 10 || parsed.items[0].unit_rate !== 1200 || parsed.items[0].total_\n<truncated 237 bytes>","WaitMsBeforeAsync":"5000","toolSummary":"\"Run Node.js parser verification test\""}}],"truncated_fields":["tool_calls"]}
