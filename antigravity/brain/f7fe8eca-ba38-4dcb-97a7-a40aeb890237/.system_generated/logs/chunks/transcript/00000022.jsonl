{"step_index":1602,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T19:49:40Z","content":"Created At: 2026-11-03T01:19:40+05:30\nCompleted At: 2026-11-03T01:19:40+05:30\nShowing lines 1-88 of 88\n1: // Deterministic Tax & ITR Calculator for Small Indian Retail Shopkeepers\n2: // Core Rule: \"Code does the math, deterministic calculations only\"\n3: import { round2 } from \"./auditEngine.js\";\n4: \n5: /**\n6:  * Calculates turnover, deemed profit under Sec 44AD, and estimated tax under New Regime\n7:  * @param {Object} invoice\n8:  * @param {Object} audit\n9:  * @param {Object} [settings] - Optional user overrides for turnover and digital ratio\n10:  */\n11: export function calculateTaxMetrics(invoice, audit, settings = {}) {\n12:   const totalGstOnBill = round2((Number(invoice.cgst) || 0) + (Number(invoice.sgst) || 0) + (Number(invoice.igst) || 0));\n13:   const isGstinValid = audit.gstinValid;\n14: \n15:   const eligibleItc = isGstinValid ? totalGstOnBill : 0;\n16:   const blockedItc = isGstinValid ? 0 : totalGstOnBill;\n17:   const missingGstinCount = isGstinValid ? 0 : 1;\n18: \n19:   // Annualized turnover: default to ₹36,00,000 or user slider value\n20:   const annualTurnover = Number(settings.annualTurnover) || 3600000;\n21:   \n22:   // Digital vs Cash ratio: default 60% digital, 40% cash\n23:   const digitalRatio = settings.digitalRatio !== undefined ? Number(settings.digitalRatio) : 0.60;\n24:   const cashRatio = round2(1 - digitalRatio);\n25: \n26:   // Section 44AD Presumptive Profit: 6% for digital turnover, 8% for cash turnover\n27:   const digitalProfit = (annualTurnover * digitalRatio) * 0.06;\n28:   const cashProfit = (annualTurnover * cashRatio) * 0.08;\n29:   const deemedProfit = round2(digitalProfit + cashProfit);\n30: \n31:   // Estimated Tax under New Tax Regime (Section 115BAC)\n32:   // Slabs:\n33:   // Up to ₹3,00,000: Nil\n34:   // ₹3,00,001 to ₹6,00,000: 5%\n35:   // ₹6,00,001 to ₹9,00,000: 10%\n36:   // ₹9,00,001 to ₹12,00,000: 15%\n37:   // ₹12,00,001 to ₹15,00,000: 20%\n38:   // Above ₹15,00,000: 30%\n39:   // Rebate under Section 87A: If total income <= ₹7,00,000, tax liability is ₹0.\n40:   let baseTax = 0;\n41:   if (deemedProfit > 700000) {\n42:     if (deemedProfit <= 600000) {\n43:       baseTax = (deemedProfit - 300000) * 0.05;\n44:     } else if (deemedProfit <= 900000) {\n45:       baseTax = 15000 + (deemedProfit - 600000) * 0.10;\n46:     } else if (deemedProfit <= 1200000) {\n47:       baseTax = 45000 + (deemedProfit - 900000) * 0.15;\n48:     } else if (deemedProfit <= 1500000) {\n49:       baseTax = 90000 + (deemedProfit - 1200000) * 0.20;\n50:     } else {\n51:       baseTax = 150000 + (deemedProfit - 1500000) * 0.30;\n52:     }\n53:   }\n54: \n55:   // 4% Health & Education Cess\n56:   const estimatedTaxLiability = round2(baseTax * 1.04);\n57: \n58:   const audit_summary = {\n59:     total_turnover: annualTurnover,\n60:     deemed_profit: deemedProfit,\n61:     number_of_invoices_analyzed: 1,\n62:     current_invoice_total: audit.calculated_total,\n63:     total_gst_paid_on_purchases: totalGstOnBill,\n64:     eligible_itc: eligibleItc,\n65:     invoices_missing_gstin: missingGstinCount,\n66:     disallowed_itc: blockedItc,\n67:     vendor_name: invoice.vendor_name || \"Supplier\",\n68:     supplier_gstin: invoice.gstin || \"MISSING\",\n69:     digital_ratio: digitalRatio,\n70:     cash_ratio: cashRatio\n71:   };\n72: \n73:   const calculated_tax = {\n74:     recommended_form: \"ITR-4 (Presumptive Scheme - Sec 44AD)\",\n75:     annual_turnover: annualTurnover,\n76:     digital_percent: Math.round(digitalRatio * 100),\n77:     cash_percent: Math.round(cashRatio * 100),\n78:     deemed_net_profit: deemedProfit,\n79:     profit_computation_basis: `Calculated at 6% digital (${Math.round(digitalRatio * 100)}%) / 8% cash (${Math.round(cashRatio * 100)}%)`,\n80:     estimated_tax_liability: estimatedTaxLiability,\n81:     tax_regime: \"New Regime (Section 115BAC)\",\n82:     rebate_87a_applied: deemedProfit <= 700000,\n83:     eligible_itc: eligibleItc,\n84:     blocked_itc: blockedItc\n85:   };\n86: \n87:   return { audit_summary, calculated_tax };\n88: }"}
