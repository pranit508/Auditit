baseTax = round2(baseTax);\n95: \n96:   const isRebateEligible = netTaxableIncome <= 700000;\n97:   const rebate87a = isRebateEligible ? baseTax : 0;\n98:   const taxAfterRebate = Math.max(0, round2(baseTax - rebate87a));\n99:   const cess = round2(taxAfterRebate * 0.04);\n100:   const totalTaxPayable = round2(taxAfterRebate + cess);","truncated_fields":["content"]}
