oice_total: 0,\\n        total_gst_paid_on_purchases: 0,\\n        eligible_itc: 0,\\n        invoices_missing_gstin: 0,\\n        disallowed_itc: 0,\\n        vendor_name: \\\"N/A\\\",\\n        supplier_gstin: \\\"N/A\\\"\\n      },\\n      calculated_tax: {\\n        recommended_form: \\\"None (Invalid Document)\\\",\\n        annual_turnover: 0,\\n        digital_percent: 0,\\n        cash_percent: 0,\\n        deemed_net_profit: 0,\\n        profit_computation_basis: \\\"No financial calculations on rejected non-bill document\\\",\\n        estimated_tax_liability: 0,\\n        tax_regime: \\\"N/A\\\",\\n        rebate_87a_applied: false,\\n        eligible_itc: 0,\\n        blocked_itc: 0\\n      }\\n    };\\n  }\""}}]}
