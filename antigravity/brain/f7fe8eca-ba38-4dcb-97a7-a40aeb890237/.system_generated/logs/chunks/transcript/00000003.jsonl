\"date\\\": \\\"YYYY-MM-DD\\\" or null,\\n  \\\"items\\\": [\\n    {\\n      \\\"description\\\": string,\\n      \\\"hsn\\\": string or null,\\n      \\\"qty\\\": number,\\n      \\\"rate\\\": number,\\n      \\\"amount\\\": number,\\n      \\\"is_blurry\\\": boolean\\n    }\\n  ],\\n  \\\"subtotal\\\": number or null,\\n  \\\"cgst\\\": number or null,\\n  \\\"sgst\\\": number or null,\\n  \\\"igst\\\": number or null,\\n  \\\"total_declared\\\": number or null,\\n  \\\"bank_details\\\": {\\n    \n<truncated 7215 bytes>","Overwrite":"true","Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/aiExtractor.js\""}}],"truncated_fields":["tool_calls"]}
