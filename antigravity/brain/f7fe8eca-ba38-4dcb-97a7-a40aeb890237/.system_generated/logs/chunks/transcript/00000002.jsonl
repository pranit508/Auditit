{"step_index":151,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T14:12:09Z","content":"Created At: 2026-11-02T19:42:09+05:30\nCompleted At: 2026-11-02T19:42:09+05:30\nShowing lines 120-189 of 189\n120: }\n121: \n122: /**\n123:  * Smart Heuristic Parser for custom uploaded files\n124:  */\n125: async function simulateLocalExtraction(file, base64Data, objectUrl) {\n126:   // Simulate processing\n127:   await new Promise(r => setTimeout(r, 600));\n128: \n129:   const fileName = file.name || \"Uploaded_Invoice.jpg\";\n130:   const cleanName = fileName.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \");\n131: \n132:   return {\n133:     id: \"uploaded-\" + Date.now(),\n134:     scenarioName: `Uploaded: ${fileName}`,\n135:     vendor_name: `${cleanName} Traders`,\n136:     vendor_address: \"Shop 12, Main Wholesale Mandi, Industrial Sector, India\",\n137:     gstin: \"07AAACR4921B1Z2\",\n138:     invoice_no: `INV-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`,\n139:     date: new Date().toISOString().split(\"T\")[0],\n140:     badge: {\n141:       text: \"Custom Upload\",\n142:       color: \"emerald\"\n143:     },\n144:     items: [\n145:       {\n146:         id: \"up-item-1\",\n147:         description: \"General Wholesale Inventory Batch #1\",\n148:         hsn: \"8471\",\n149:         qty: 10,\n150:         rate: 550.00,\n151:         amount: 5500.00,\n152:         is_blurry: false\n153:       },\n154:       {\n155:         id: \"up-item-2\",\n156:         description: \"Retail Packaging & Corrugated Cartons\",\n157:         hsn: \"4819\",\n158:         qty: 5,\n159:         rate: 400.00,\n160:         amount: 2500.00, // Intentional overcharge mismatch: 5 * 400 = 2000, billed 2500!\n161:         is_blurry: false,\n162:         error_flag: true,\n163:         error_note: \"Line item discrepancy: 5 × ₹400 = ₹2,000, but billed as ₹2,500.\"\n164:       },\n165:       {\n166:         id: \"up-item-3\",\n167:         description: \"Counter Supplies & Thermal Rolls\",\n168:         hsn: \"4811\",\n169:         qty: 20,\n170:         rate: 65.00,\n171:         amount: 1300.00,\n172:         is_blurry: false\n173:       }\n174:     ],\n175:     subtotal: 9300.00, // 5500 + 2500 + 1300\n176:     cgst: 465.00, // 5% GST\n177:     sgst: 465.00,\n178:     igst: 0.00,\n179:     total_declared: 10230.00, // 9300 + 930 = 10,230 (Correct sum would be 8800 + 880 = 9,680. Discrepancy = ₹550)\n180:     bank_details: {\n181:       bank_name: \"HDFC Bank Ltd\",\n182:       account_number: \"50200019283741\",\n183:       ifsc: \"HDFC0000124\",\n184:       branch: \"Main Branch\"\n185:     },\n186:     payment_terms: \"Immediate payment via UPI/NEFT\",\n187:     notes: `Scanned from uploaded document: ${fileName}`\n188:   };\n189: }"}
