\": number,\\n      \\\"amount\\\": number,\\n      \\\"is_blurry\\\": boolean\\n    }\\n  ],\\n  \\\"subtotal\\\": number or null,\\n  \\\"cgst\\\": number or null,\\n  \\\"sgst\\\": number or null,\\n  \\\"igst\\\": number or null,\\n  \\\"total_declared\\\": number or null,\\n  \\\"bank_details\\\": {\\n    \\\"bank_name\\\": string or null,\\n    \\\"account_number\\\": string or null,\\n    \\\"ifsc\\\": string or null\\n  }\\n}\\n`;\\n\\n/**\\n * Extracts structured JSON from an uploaded invoice image/PDF.\n<truncated 5885 bytes>","Overwrite":"true","Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/aiExtractor.js\""}}],"truncated_fields":["tool_calls"]}
