ndLine":"60","Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/aiExtractor.js\"","StartLine":"1"}}]}
{"step_index":147,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T14:12:00Z","content":"Created At: 2026-11-02T19:42:00+05:30\nCompleted At: 2026-11-02T19:42:00+05:30\nShowing lines 1-60 of 189\n1: // Multimodal AI & Real-Time Document Extraction Pipeline for AUDIT IT\n2: // RULE: \"AI reads, code calculates. Do NOT trust the AI to do math.\"\n3: \n4: import { sanitizeInvoiceData } from \"./privacyMasker.js\";\n5: \n6: const GEMINI_SYSTEM_INSTRUCTION = `\n7: You are a specialized Indian Tax Invoice Data Extractor for small retail businesses in India.\n8: Your sole job is to EXTRACT the exact numbers, words, and text visible on the bill.\n9: \n10: CRITICAL INSTRUCTION:\n11: - DO NOT FIX MATH MISTAKES. \n12: - If an item has qty 20, rate 95, but the amount printed says 2900, EXTRACT 2900 as the amount!\n13: - Do not perform any calculations yourself. Return EXACT declared numbers printed on the invoice.\n14: - If a field is blurred or unreadable, set \"is_blurry\": true.\n15: - If bank account or IFSC is visible, extract it so our client-side privacy layer can mask it.\n16: \n17: Return ONLY a valid JSON object with this exact schema:\n18: {\n19:   \"vendor_name\": \"string\",\n20:   \"vendor_address\": \"string\",\n21:   \"gstin\": \"string (or empty if missing)\",\n22:   \"invoice_no\": \"string\",\n23:   \"date\": \"YYYY-MM-DD\",\n24:   \"items\": [\n25:     {\n26:       \"description\": \"string\",\n27:       \"hsn\": \"string\",\n28:       \"qty\": number,\n29:       \"rate\": number,\n30:       \"amount\": number (exact declared amount on bill),\n31:       \"is_blurry\": boolean\n32:     }\n33:   ],\n34:   \"subtotal\": number (exact declared subtotal on bill),\n35:   \"cgst\": number,\n36:   \"sgst\": number,\n37:   \"igst\": number,\n38:   \"total_declared\": number (exact declared grand total on bill),\n39:   \"bank_details\": {\n40:     \"bank_name\": \"string\",\n41:     \"account_number\": \"string\",\n42:     \"ifsc\": \"string\"\n43:   }\n44: }\n45: `;\n46: \n47: /**\n48:  * Extracts structured JSON from an uploaded invoice image/PDF.\n49:  * Uses Gemini API if an API key is available, or our smart local heuristic fallback.\n50:  */\n51: export async function extractInvoiceFromDocument(file, apiKey = null) {\n52:   const base64Data = await fileToBase64(file);\n53:   const mimeType = file.type || \"image/jpeg\";\n54:   const objectUrl = URL.createObjectURL(file);\n55: \n56:   // If user provided a Gemini API Key, make the multimodal call\n57:   if (apiKey && apiKey.trim().length > 10) {\n58:     try {\n59:       const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey.trim()}`;\n60: "}
