{"step_index":199,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T14:15:37Z","content":"Created At: 2026-11-02T19:45:37+05:30\nCompleted At: 2026-11-02T19:45:37+05:30\nShowing lines 1-40 of 88\n1: // Deterministic Tax & ITR Calculator for Small Indian Retail Shopkeepers\n2: // Core Rule: \"Code does the math, deterministic calculations only\"\n3: import { round2 } from \"./auditEngine.js\";\n4: \n5: /**\n6:  * Calculates turnover, deemed profit under Sec 44AD, and estimated tax under New Regime\n7:  * @param {Object} invoice\n8:  * @param {Object} audit\n9:  * @param {Object} [settings] - Optional user overrides for turnover and digital ratio\n10:  */\n11: export function calculateTaxMetrics(invoice, audit, settings = {}) {\n12:   const totalGstOnBill = round2((Number(invoice.cgst) || 0) + (Number(invoice.sgst) || 0) + (Number(invoice.igst) || 0));\n13:   const isGstinValid = audit.gstinValid;\n14: \n15:   const eligibleItc = isGstinValid ? totalGstOnBill : 0;\n16:   const blockedItc = isGstinValid ? 0 : totalGstOnBill;\n17:   const missingGstinCount = isGstinValid ? 0 : 1;\n18: \n19:   // Annualized turnover: default to ₹36,00,000 or user slider value\n20:   const annualTurnover = Number(settings.annualTurnover) || 3600000;\n21:   \n22:   // Digital vs Cash ratio: default 60% digital, 40% cash\n23:   const digitalRatio = settings.digitalRatio !== undefined ? Number(settings.digitalRatio) : 0.60;\n24:   const cashRatio = round2(1 - digitalRatio);\n25: \n26:   // Section 44AD Presumptive Profit: 6% for digital turnover, 8% for cash turnover\n27:   const digitalProfit = (annualTurnover * digitalRatio) * 0.06;\n28:   const cashProfit = (annualTurnover * cashRatio) * 0.08;\n29:   const deemedProfit = round2(digitalProfit + cashProfit);\n30: \n31:   // Estimated Tax under New Tax Regime (Section 115BAC)\n32:   // Slabs:\n33:   // Up to ₹3,00,000: Nil\n34:   // ₹3,00,001 to ₹6,00,000: 5%\n35:   // ₹6,00,001 to ₹9,00,000: 10%\n36:   // ₹9,00,001 to ₹12,00,000: 15%\n37:   // ₹12,00,001 to ₹15,00,000: 20%\n38:   // Above ₹15,00,000: 30%\n39:   // Rebate under Section 87A: If total income <= ₹7,00,000, tax liability is ₹0.\n40:   let baseTax = 0;"}
{"step_index":200,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-02T14:15:37Z","input_tokens":3075,"cache_read_tokens":173281,"output_tokens":837,"thinking":"The tax calculation logic requires a safeguard against invalid invoices. Checking the invoice status, a zeroed-out tax summary is returned when the invoice is flagged as invalid. This ensures that calculations do not proceed with bad data.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/taxCalculator.js\"","Replacement":"\"export function calculateTaxMetrics(invoice, audit, settings = {}) {\\n  // If document was rejected by gatekeeper, do not calculate tax\\n  if (invoice.is_valid_bill === false) {\\n    return {\\n      audit_summary: {\\n        total_turnover: 0,\\n        deemed_profit: 0,\\n        number_of_invoices_analyzed: 0,\\n        current_invoice_total: 0,\\n        total_gst_paid_on_purchases: 0,\\n        eligible_itc: 0,\\n        invoices_missing_gstin: 0,\\n        disallowed_itc: 0,\\n        vendor_name: \\\"N/A\\\",\\n        supplier_gstin: \\\"N/A\\\"\\n      },\\n      calculated_tax: {\\n        recommended_form: \\\"None (Invalid Document)\\\",\\n        annual_turnover: 0,\\n        digital_percent: 0,\\n        cash_percent: 0,\\n        deemed_net_profit: 0,\\n        profit_computation_basis: \\\"No financial calculations on rejected non-bill document\\\",\\n        estimated_tax_liability: 0,\\n        tax_regime: \\\"N/A\\\",\\n        rebate_87a_applied: false,\\n        eligible_itc: 0,\\n        blocked_itc: 0\\n      }\\n    };\\n  }\\n\\n  const totalGstOnBill = round2((Number(invoice.cgst) || 0) + (Number(invoice.sgst) || 0) + (Number(invoice.igst) || 0));\"","Target":"\"export function calculateTaxMetrics(invoice, audit, settings = {}) {\\n  const totalGstOnBill = round2((Number(invoice.cgst) || 0) + (Number(invoice.sgst) || 0) + (Number(invoice.igst) || 0));\""}}]}
