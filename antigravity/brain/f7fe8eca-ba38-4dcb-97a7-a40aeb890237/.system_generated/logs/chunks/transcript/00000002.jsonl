{"step_index":149,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T14:12:04Z","content":"Created At: 2026-11-02T19:42:04+05:30\nCompleted At: 2026-11-02T19:42:04+05:30\nShowing lines 60-120 of 189\n60: \n61:       const payload = {\n62:         contents: [\n63:           {\n64:             parts: [\n65:               { text: GEMINI_SYSTEM_INSTRUCTION },\n66:               {\n67:                 inline_data: {\n68:                   mime_type: mimeType,\n69:                   data: base64Data.split(\",\")[1]\n70:                 }\n71:               }\n72:             ]\n73:           }\n74:         ],\n75:         generationConfig: {\n76:           response_mime_type: \"application/json\"\n77:         }\n78:       };\n79: \n80:       const response = await fetch(url, {\n81:         method: \"POST\",\n82:         headers: { \"Content-Type\": \"application/json\" },\n83:         body: JSON.stringify(payload)\n84:       });\n85: \n86:       if (response.ok) {\n87:         const result = await response.json();\n88:         const rawText = result.candidates?.[0]?.content?.parts?.[0]?.text;\n89:         if (rawText) {\n90:           const parsed = JSON.parse(rawText);\n91:           parsed.uploaded_file_url = objectUrl;\n92:           parsed.file_type = mimeType;\n93:           parsed.file_name = file.name;\n94:           return sanitizeInvoiceData(parsed);\n95:         }\n96:       }\n97:     } catch (err) {\n98:       console.warn(\"Gemini multimodal call failed; falling back to local extractor:\", err);\n99:     }\n100:   }\n101: \n102:   // Smart Real-Time Parser for uploaded bills (stores the original file preview)\n103:   const result = await simulateLocalExtraction(file, base64Data, objectUrl);\n104:   result.uploaded_file_url = objectUrl;\n105:   result.file_type = mimeType;\n106:   result.file_name = file.name;\n107:   return sanitizeInvoiceData(result);\n108: }\n109: \n110: /**\n111:  * Converts File to Base64\n112:  */\n113: function fileToBase64(file) {\n114:   return new Promise((resolve, reject) => {\n115:     const reader = new FileReader();\n116:     reader.onload = () => resolve(reader.result);\n117:     reader.onerror = reject;\n118:     reader.readAsDataURL(file);\n119:   });\n120: }"}
