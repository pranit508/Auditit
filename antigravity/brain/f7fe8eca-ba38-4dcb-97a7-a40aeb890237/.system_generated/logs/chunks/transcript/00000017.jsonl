{"step_index":1249,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:55:23Z","content":"Created At: 2026-11-03T00:25:23+05:30\nCompleted At: 2026-11-03T00:25:23+05:30\nShowing lines 70-157 of 157\n70:     ];\n71: \n72:     const GSTIN_PATTERN = /\\b\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}\\b/i;\n73:     const PHONE_PATTERN = /(\\+?91[\\-\\s]?)?[6-9]\\d{9}/;\n74:     const PAN_PATTERN = /\\b[A-Z]{5}\\d{4}[A-Z]{1}\\b/i;\n75: \n76:     sanitized.items = sanitized.items.filter(item => {\n77:       if (!item || typeof item !== \"object\") return false;\n78: \n79:       const desc = (item.description || item.item_name || \"\").trim();\n80:       const descLower = desc.toLowerCase();\n81: \n82:       // Reject if description matches address/words or is too short\n83:       if (addressWords.some(word => descLower.includes(word)) || desc.length < 3) {\n84:         return false;\n85:       }\n86: \n87:       // Reject PAN, Bank, Account patterns\n88:       if (/\\bpan\\b|\\bacc(?:\\.|\\s+)?(?:no|number)\\b|\\baccount\\b|\\bbank\\b|\\bifsc\\b/i.test(descLower)) {\n89:         return false;\n90:       }\n91: \n92:       // Reject GSTIN strings, PAN strings, or phone numbers\n93:       if (GSTIN_PATTERN.test(desc) || PHONE_PATTERN.test(desc) || PAN_PATTERN.test(desc)) {\n94:         return false;\n95:       }\n96: \n97:       // Reject single-token alphanumeric tax identifiers (e.g. BZKPALZD89, 06AAECM...)\n98:       if (/^[A-Za-z0-9]{7,16}$/.test(desc) && /\\d/.test(desc) && /[A-Za-z]/.test(desc)) {\n99:         return false;\n100:       }\n101: \n102:       let billed = Number(item.total_amount !== undefined ? item.total_amount : item.amount) || 0;\n103:       let qty = Number(item.quantity !== undefined ? item.quantity : item.qty) || 0;\n104:       let rate = Number(item.unit_rate !== undefined ? item.unit_rate : item.rate) || 0;\n105: \n106:       // Post-Processing Column Swap Fallback:\n107:       // If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n108:       // it means qty and rate were misaligned. Swap them:\n109:       if (billed > 0 && qty === billed && (rate === 1 || rate === 2)) {\n110:         qty = 1.0;\n111:         rate = billed;\n112:       }\n113: \n114:       // Quantity and rate must be positive\n115:       if (qty <= 0 || rate <= 0) return false;\n116: \n117:       // If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n118:       if (billed > (qty * rate * 10) && billed > 100000) return false;\n119: \n120:       // Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n121:       const descClean = desc.replace(/[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$/i, \"\").trim();\n122:       const finalDesc = descClean.length >= 3 ? descClean : desc;\n123: \n124:       // Normalize properties\n125:       item.quantity = qty;\n126:       item.qty = qty;\n127:       item.unit_rate = rate;\n128:       item.rate = rate;\n129:       item.total_amount = billed > 0 ? billed : Math.round(qty * rate * 100) / 100;\n130:       item.amount = item.total_amount;\n131:       item.description = finalDesc;\n132: \n133:       return true;\n134:     });\n135: \n136:     // SUB-TOTAL CALCULATION:\n137:     // Calculate the Subtotal deterministically from the extracted items:\n138:     // subtotal = sum(item.quantity * item.unit_rate for item in items)\n139:     if (sanitized.items.length > 0) {\n140:       const calcSubtotal = Math.round(sanitized.items.reduce((acc, it) => acc + (it.quantity * it.unit_rate), 0) * 100) / 100;\n141:       sanitized.subtotal = calcSubtotal;\n142:       sanitized.calculated_subtotal = calcSubtotal;\n143:     }\n144:   }\n145: \n146:   // 3. Mask bank account and IFSC details\n147:   if (sanitized.bank_details) {\n148:     if (sanitized.bank_details.account_number) {\n149:       sanitized.bank_details.account_number = maskBankAccount(sanitized.bank_details.account_number);\n150:     }\n151:     if (sanitized.bank_details.ifsc) {\n152:       sanitized.bank_details.ifsc = maskIFSC(sanitized.bank_details.ifsc);\n153:     }\n154:   }\n155: \n156:   return sanitized;\n157: }"}
