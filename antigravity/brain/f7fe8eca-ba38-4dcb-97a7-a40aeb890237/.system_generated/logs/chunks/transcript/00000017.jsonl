 0);\n208:   const totalTax = round2(cgst + sgst + igst);\n209: \n210:   // GST Split check\n211:   if (cgst > 0 || sgst > 0) {\n212:     if (Math.abs(cgst - sgst) > 1.00) {\n213:       issues.push({\n214:         type: \"WARNING\",\n215:         field: \"gst_split\",\n216:         title: \"CGST and SGST Mismatch\",\n217:         description: `Intra-state GST requires CGST (${formatRupees(cgst)}) to equal SGST (${formatRupees(sgst)}).`\n218:       });\n219:     }\n220:   }\n221: \n222:   // Strict Grand Total Calculation\n223:   const calculated_total = round2(sum_items + totalTax);\n224:   const total_declared = round2(Number(invoice.total_declared) || 0);\n225:   const totalDiff = round2(total_declared - calculated_total);\n226: \n227:   // Discrepancy rule: If difference exceeds ₹1.00\n228:   const hasTotalDiscrepancy = Math.abs(totalDiff) > 1.00;\n229: \n230:   if (hasTotalDiscrepancy) {\n231:     issues.push({\n232:       type: \"ERROR\",\n233:       field: \"total_declared\",\n234:       title: totalDiff > 0 ? \"Grand Total Overcharge Detected\" : \"Grand Total Undercharge Detected\",\n235:       description: `Bill declared ${formatRupees(total_declared)}, but verified total (Items ${formatRupees(sum_items)} + Tax ${formatRupees(totalTax)}) is ${formatRupees(calculated_total)}. Net Variance: ${formatRupees(Math.abs(totalDiff))}.`,\n236:       diff: totalDiff,\n237:       declared: total_declared,\n238:       calculated: calculated_total\n239:     });\n240:   }\n241: \n242:   // GSTIN Verification\n243:   const gstin = (invoice.gstin || \"\").trim().toUpperCase();\n244:   const gstinValid = GSTIN_REGEX.test(gstin);\n245: \n246:   // Determine overall status verdict\n247:   let status = \"VERIFIED\";\n248:   let statusText = \"Math Verified & Valid\";\n249:   let statusColor = \"emerald\";\n250: \n251:   if (hasTotalDiscrepancy || hasLineItemMathError) {\n252:     status = \"OVERCHARGE_ERROR\";\n253:     statusText = totalDiff > 0 ? `${formatRupees(Math.abs(totalDiff))} Overcharge` : `${formatRupees(Math.abs(totalDiff))} Math Error`;\n254:     statusColor = \"rose\";\n255:   } else if (!gstinValid || hasBlurryFields || issues.some(i => i.type === \"WARNING\")) {\n256:     status = \"REVIEW_NEEDED\";\n257:     statusText = \"Review Needed\";\n258:     statusColor = \"amber\";\n259:   }\n260: "}
