: \n136: /**\n137:  * Recalculates and strictly audits an entire invoice.\n138:  * If something seems missing or unclear, it pauses and prompts the user for valid inputs.\n139:  */\n140: export function auditInvoice(invoice) {\n141:   // CRITICAL BUG FIX: Gatekeeper and document rejection checks completely removed.\n142:   // Directly audit the invoice data and calculate precision metrics.\n143:   const issues = [];\n144:   const lineItemAudit = [];\n145: \n146:   let sum_items = 0;\n147:   let hasLineItemMathError = false;\n148:   let hasBlurryFields = false;\n149: \n150:   // Unreadable Fields Log (if any minor non-blocking items)\n151:   const unreadableList = Array.isArray(invoice.unreadable_fields) ? invoice.unreadable_fields : [];\n152: \n153:   // Line Items Verification with strict float precision\n154:   if (!invoice.items || invoice.items.length === 0) {\n155:     issues.push({\n156:       type: \"ERROR\",\n157:       field: \"items\",\n158:       title: \"No Line Items Detected\",\n159:       description: \"Invoice contains no billable line items or goods.\"\n160:     });"}
