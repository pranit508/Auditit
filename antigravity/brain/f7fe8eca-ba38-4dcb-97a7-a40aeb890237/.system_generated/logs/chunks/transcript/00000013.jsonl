bers[altNumbers.length - 2]);\n153: \n154:       // If last number looks like an amount (> 5)\n155:       if (lastNum > 5) {\n156:         const textPart = line.replace(/(\\d+(?:\\.\\d{1,2})?)/g, \"\").replace(/[₹Rs\\.,\\-]/gi, \"\").trim();\n157:  \n<truncated 747 bytes>\n0;\n177:   let sgst = 0;\n178:   let igst = 0;\n179: \n180:   for (const line of lines) {\n181:     const lower = line.toLowerCase();\n182:     \n183:     // Grand Total matching\n184:     if (/(?:grand\\s+total|total\\s+amount|net\\s+payable|total\\s+payable|balance\\s+due|total\\s*:)/i.test(line)) {\n185:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n186:       if (nums && nums.length > 0) {\n187:         total_declared = cleanNumber(nums[nums.length - 1]);\n188:       }\n189:     }\n190: \n191:     // Subtotal matching\n192:     if (/(?:sub\\s*total|taxable\\s+value|gross\\s+amount)/i.test(line)) {\n193:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n194:       if (nums && nums.length > 0) {\n195:         subtotal = cleanNumber(nums[nums.length - 1]);\n196:       }\n197:     }\n198: \n199:     // CGST\n200:     if (/cgst/i.test(line)) {\n201:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n202:       if (nums && nums.length > 0) {\n203:         cgst = cleanNumber(nums[nums.length - 1]);\n204:       }\n205:     }\n206: \n207:     // SGST\n208:     if (/sgst/i.test(line)) {\n209:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n210:       if (nums && nums.length > 0) {\n211:         sgst = cleanNumber(nums[nums.length - 1]);\n212:       }\n213:     }\n214: \n215:     // IGST\n216:     if (/igst/i.test(line)) {\n217:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n218:       if (nums && nums.length > 0) {\n219:         igst = cleanNumber(nums[nums.length - 1]);\n220:       }\n221:     }\n222:   }\n223: \n224:   // Clean extracted items to purge any metadata/GSTIN/phone lines\n225:   const ite