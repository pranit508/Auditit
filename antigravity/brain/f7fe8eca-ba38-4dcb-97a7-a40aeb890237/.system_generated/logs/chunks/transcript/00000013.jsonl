eflect (Quantity * Unit Rate).\n112: \n113: Extract the invoice details into JSON matching this schema:\n114: - vendor_name: (string)\n115: - gstin: (string or null)\n116: - invoice_number: (string or null)\n117: - date: (string or null)\n118: - items: list of {description, quantity, unit_rate, total_amount}\n119: - subtotal: (number or null)\n120: - cgst: (number or null)\n121: - sgst: (number or null)\n122: - igst: (number or null)\n123: - declared_total: (number or null)\n124: \"\"\"\n125: \n126:     genai_client = get_genai_client(x_api_key)\n127:     if not genai_client:\n128:         return JSONResponse(\n129:             status_code=400,\n130:             content={\"error\": \"Gemini API key is required.\"}"}
