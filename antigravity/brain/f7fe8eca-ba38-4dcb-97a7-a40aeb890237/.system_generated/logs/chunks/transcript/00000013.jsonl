{"step_index":1009,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T18:29:18Z","content":"Created At: 2026-11-02T23:59:18+05:30\nCompleted At: 2026-11-02T23:59:18+05:30\nShowing lines 100-274 of 274\n100:     }\n101:   }\n102:   if (vendor_name) {\n103:     // RULE 1: Never include phone numbers, email addresses, or 'Phone: ...' in supplier_name\n104:     vendor_name = vendor_name.replace(/(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+/gi, \"\").trim();\n105:   }\n106:   if (!vendor_name || vendor_name.length < 2) {\n107:     vendor_name = sourceFileName.replace(/\\.[^/.]+$/, \"\").replace(/[-_]/g, \" \") + \" (Extracted)\";\n108:   }\n109: \n110:   // 6. Extract Line Items from table rows\n111:   const items = [];\n112:   const itemCandidateRegex = /^(?:(\\d+)[\\.\\s]+)?([A-Za-z0-9\\s\\(\\)%\\/-]+?)\\s+(\\d+(?:\\.\\d+)?)\\s+(?:₹|Rs\\.?\\s*)?(\\d+(?:\\.\\d+)?)\\s+(?:₹|Rs\\.?\\s*)?(\\d+(?:\\.\\d+)?)$/i;\n113: \n114:   for (let i = 0; i < lines.length; i++) {\n115:     const line = lines[i];\n116: \n117:     // Skip header lines\n118:     if (/item\\s+desc|description|particulars|qty|rate|amount|hsn/i.test(line) && /rate|amount/i.test(line)) {\n119:       continue;\n120:     }\n121:     // Skip summary lines\n122:     if (/subtotal|sub\\s+total|total|cgst|sgst|igst|grand\\s+total|round\\s+off/i.test(line)) {\n123:       continue;\n124:     }\n125: \n126:     // Try standard pattern: Description Qty Rate Amount\n127:     const match = line.match(itemCandidateRegex);\n128:     if (match) {\n129:       const desc = match[2].trim();\n130:       const qty = parseFloat(match[3]) || 1;\n131:       const rate = parseFloat(match[4]) || 0;\n132:       const amount = parseFloat(match[5]) || round2(qty * rate);\n133: \n134:       if (desc.length >= 2 && amount > 0) {\n135:         items.push({\n136:           id: `item-${items.length + 1}`,\n137:           description: desc,\n138:           hsn: \"\",\n139:           qty,\n140:           rate,\n141:           amount,\n142:           is_blurry: false\n143:         });\n144:         continue;\n145:       }\n146:     }\n147: \n148:     // Alternative: Line ending with two numbers (Rate & Amount or Qty & Amount)\n149:     const altNumbers = line.mat\n<truncated 2477 bytes>\n}\n214: \n215:     // IGST\n216:     if (/igst/i.test(line)) {\n217:       const nums = line.match(/(\\d+(?:,\\d+)*(?:\\.\\d{1,2})?)/g);\n218:       if (nums && nums.length > 0) {\n219:         igst = cleanNumber(nums[nums.length - 1]);\n220:       }\n221:     }\n222:   }\n223: \n224:   // Clean extracted items to purge any metadata/GSTIN/phone lines\n225:   const itemsToUse = cleanExtractedItems(items);\n226: \n227:   // Compute subtotal if missing\n228:   const calculatedItemsSum = round2(itemsToUse.reduce((acc, it) => acc + (it.amount || 0), 0));\n229:   if (!subtotal) {\n230:     subtotal = calculatedItemsSum;\n231:   }\n232: \n233:   // Compute total_declared if missing\n234:   if (!total_declared) {\n235:     total_declared = round2(subtotal + cgst + sgst + igst);\n236:   }\n237: \n238:   // Bank details extraction if present\n239:   let bank_name = null;\n240:   let account_number = null;\n241:   let ifsc = null;\n242: \n243:   for (const line of lines) {\n244:     const bankMatch = line.match(/\\b(SBI|HDFC|ICICI|PNB|Axis|Bank of Baroda|Canara|Kotak)[\\w\\s]*\\b/i);\n245:     if (bankMatch && !bank_name) bank_name = bankMatch[0].trim();\n246: \n247:     const ifscMatch = line.match(/\\b[A-Z]{4}0[A-Z0-9]{6}\\b/i);\n248:     if (ifscMatch && !ifsc) ifsc = ifscMatch[0].toUpperCase();\n249: \n250:     const acMatch = line.match(/(?:a\\/c|account)[\\s#.:\\-_]+(\\d{9,18})/i);\n251:     if (acMatch && !account_number) account_number = acMatch[1];\n252:   }\n253: \n254:   return {\n255:     unreadable_fields,\n256:     vendor_name,\n257:     vendor_address: \"Address from scanned bill\",\n258:     gstin,\n259:     invoice_no,\n260:     date: date || new Date().toISOString().split(\"T\")[0],\n261:     items: itemsToUse,\n262:     subtotal,\n263:     cgst,\n264:     sgst,\n265:     igst,\n266:     total_declared,\n267:     bank_details: {\n268:       bank_name: bank_name || \"Bank on File\",\n269:       account_number: account_number || \"•••• •••• •••• 1024\",\n270:       ifsc: ifsc || \"SBIN••••••\"\n271:     },\n272:     raw_ocr_text: rawText\n273:   };\n274: }","truncated_fields":["content"]}
