[\\\\|\\\\]\\\\(\\\\)\\\\s]+$/g, \\\"\\\").trim();\\n    it.description = desc;\\n\\n    // Skip if description lacks at least 4 letters\\n    const letters = desc.match(/[a-zA-Z]/g) || [];\\n    if (letters.length < 4) continue;\\n\\n    // Skip if more than 20% of description is weird symbols/punctuation\\n    const symbols = desc.match(/[~|©\\\\[\\\\]=_{}@#$%^&*]/g) || [];\\n    if (desc.length > 0 && (symbols.length / desc.length) > 0.20) continue;\\n\\n    // Skip common footer/stamp terms\\n    const descLower = desc.toLowerCase();\\n    if ([\\\"signature\\\", \\\"authorised\\\", \\\"terms\\\", \\\"condition\\\", \\\"bank details\\\", \\\"e-way bill\\\"].some(term => descLower.includes(term))) {\\n      continue;\\n    }\\n\\n    // Clean description \n<truncated 1919 bytes>"}}],"truncated_fields":["tool_calls"]}
