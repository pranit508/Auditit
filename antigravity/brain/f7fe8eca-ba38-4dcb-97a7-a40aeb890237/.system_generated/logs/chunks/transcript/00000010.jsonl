        if gstin_pattern.search(desc) or phone_pattern.search(desc):\n39:             continue\n40: \n41:         # 2. Skip if the description is just a metadata label\n42:         if any(keyword in desc_lower for keyword in forbidden_keywords):\n43:             continue\n44: \n45:\n<truncated 665 bytes>\n0 and amt_num <= 0):\n59:             continue\n60: \n61:         # Post-Processing Column Swap Fallback:\n62:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n63:         # it means qty and rate were misaligned. Swap them:\n64:         if amt_num > 0 and qty_num == amt_num and rate_num in [1.0, 2.0, 1, 2]:\n65:             qty_num = 1.0\n66:             rate_num = amt_num\n67:             item[\"quantity\"] = 1.0\n68:             item[\"qty\"] = 1.0\n69:             item[\"unit_rate\"] = amt_num\n70:             item[\"rate\"] = amt_num\n71: \n72:         cleaned.append(item)\n73: \n74:     return cleaned\n75: \n76: def sanitize_invoice_data(data: dict) -> dict:\n77:     \"\"\"\n78:     Sanitizes extracted invoice data immediately before sending it to the frontend.\n79:     Enforces MANDATORY RULES:\n80:     1. Clean Supplier Name (Remove phone/email artifacts)\n81:     2. Filter out non-items from the items list (address words, short desc, non-positive qty/rate, corrupt totals)\n82:     \"\"\"\n83:     if not isinstance(data, dict):\n84:         return data\n85: \n86:     # 1. Clean Supplier Name (Remove phone/email artifacts)\n87:     supplier = data.get(\"vendor_name\", \"\") or data.get(\"supplier_name\", \"\") or \"\"\n88:     supplier_cleaned = re.sub(r'(Phone|Mobile|Tel|Email|Mob)[\\s:]*[\\+\\d\\s\\w@\\.\\-]+', '', supplier, flags=re.IGNORECASE).strip()\n89:     # Strip any trailing punctuation (commas, hyphens, colons) left behind\n90:     supplier_cleaned = re.sub(r'[\\s,\\-–—:|]+$', '', supplier_cleaned).strip()\n91:     data[\"vendor_name\"] = supplier_cleaned if supplier_cleaned else \"Supplier Name Unclear\"\n92:     data[\"supplier_name\"] = data[\"vendor_name\"]\n93: \n94:     # 2. Filter out non-items from the items list\n95:     filtered_items = []\n96:     \n97:     # Common address/metadata keywords that accidentally end up as descriptions\n98:     address_words = [\n99:         \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n100:         \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"state\", \"thirteen\", \"thousand\", ","truncated_fields":["content"]}
