for consistency (qty, rate, amount)\n89:     const normalizedItem = {\n90:       ...item,\n91:       quantity: qty,\n92:       qty: qty,\n93:       unit_rate: rate,\n94:       rate: rate,\n95:       total_amount: isNaN(billed) || billed <= 0 ? (qty * rate) : billed,\n96:       amount: isNaN(billed) || billed <= 0 ? (qty * rate) : billed,\n97:       description: finalDesc\n98:     };\n99: \n100:     cleaned.push(normalizedItem);","truncated_fields":["content"]}
