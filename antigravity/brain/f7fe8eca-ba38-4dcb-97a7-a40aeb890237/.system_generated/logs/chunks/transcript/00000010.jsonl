tive\n95:       if (qty <= 0 || rate <= 0) return false;\n96: \n97:       // If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n98:       if (billed > (qty * rate * 10) && billed > 100000) return false;\n99: \n100:       // Normalize properties","truncated_fields":["content"]}
