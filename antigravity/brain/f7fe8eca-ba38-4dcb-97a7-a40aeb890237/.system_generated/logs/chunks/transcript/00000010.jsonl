al: Optional[float] = None\n52:     cgst: Optional[float] = None\n53:     sgst: Optional[float] = None\n54:     igst: Optional[float] = None\n55:     declared_total: Optional[float] = None\n56: \n57: app = FastAPI(title=\"AUDIT IT - Bi\n<truncated 1767 bytes>\nundaries (S.No, Description, HSN/SAC, Quantity, Unit, Rate/Price, Amount).\n104: - CROSS-CHECK MATH INTERNALLY: For each row, verify that (quantity * unit_rate) roughly equals the row total amount. \n105:   * If quantity * rate does not equal the row amount, you likely swapped the Quantity and Rate columns, or confused the Item Code/HSN/S.No with Quantity. \n106:   * Never set Rate to trivial numbers like 1 or 2 when the item is an expensive product like a 'Tool Kit', unless that is explicitly the printed unit rate.\n107: - Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description.\"\"\"\n108: \n109:     genai_client = get_genai_client(x_api_key)\n110:     if not genai_client:\n111:         return JSONResponse(\n112:             status_code=400,\n113:             content={\"error\": \"Gemini API key is required.\"}\n114:         )\n115: \n116:     # Call Gemini (primary: gemini-2.5-flash; fallback to gemini-3.5-flash if 404/unavailable)\n117:     models_to_try = ['gemini-2.5-flash', 'gemini-3.5-flash', 'gemini-3.8-flash']\n118:     last_err = None\n119: \n120:     for model_name in models_to_try:\n121:         try:\n122:             response = genai_client.models.generate_content(\n123:                 model=model_name,\n124:                 contents=[\n125:                     types.Part.from_bytes(data=contents, mime_type=mime_type),\n126:                     prompt\n127:                 ],\n128:                 config=types.GenerateContentConfig(\n129:                     response_mime_type=\"application/json\",\n130:                     response_schema=ExtractedInvoice,\n131:                     temperature=0.0\n132:                 )\n133:             )\n134:             # Post-Processing Column Swap Fallback (Python)\n135:             try:\n136:                 parsed = json.loads(response.text)\n137:                 items = parsed.get(\"items\", [])\n138:                 for item in items:\n139:                     qty = item.get('quantity', 0)\n140:                     rate = item.get('unit_rate', 0)","truncated_fields":["content"]}
