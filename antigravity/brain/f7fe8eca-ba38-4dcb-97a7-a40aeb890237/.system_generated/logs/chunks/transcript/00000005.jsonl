he item parsing logic now accommodates variations in key names like \"quantity\"/\"qty\", \"unit_rate\"/\"rate\", and \"total_amount\"/\"amount\" to handle different invoice formats. The code is updated to populate both variations of these keys, ensuring seamless compatibility. Also, the supplier name extraction code now handles aliases \"vendor_name\" and \"supplier_name\" and cleans it, providing a default value if unclear. This is all integrated, ensuring compatibility with the user's function.\n\n\nThe server now applies invoice data sanitization before returning results, addressing inconsistencies and cleaning the data prior to frontend display. Subtotal recalculation is added based on the cleaned item data to ensure accuracy. The frontend processing is being checked to identify where the invoice processing logic is handled.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":"55","Path":"\"/Users/pranit405/.gemini/antigravity/scratch/audit-it/utils/privacyMasker.js\"","StartLine":"35"}}]}
{"step_index":423,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:52:44Z","content":"Created At: 2026-11-02T22:22:44+05:30\nCompleted At: 2026-11-02T22:22:44+05:30\nShowing lines 35-54 of 54\n35: }\n36: \n37: /**\n38:  * Pre-processes any raw text or object to ensure sensitive financial identifiers\n39:  * are sanitized before UI display or downstream AI requests.\n40:  */\n41: export function sanitizeInvoiceData(rawInvoice) {\n42:   const sanitized = JSON.parse(JSON.stringify(rawInvoice));\n43: \n44:   if (sanitized.bank_details) {\n45:     if (sanitized.bank_details.account_number) {\n46:       sanitized.bank_details.account_number = maskBankAccount(sanitized.bank_details.account_number);\n47:     }\n48:     if (sanitized.bank_details.ifsc) {\n49:       sanitized.bank_details.ifsc = maskIFSC(sanitized.bank_details.ifsc);\n50:     }\n51:   }\n52: \n53:   return sanitized;\n54: }"}
