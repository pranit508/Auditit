{"step_index":417,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:52:03Z","content":"Created At: 2026-11-02T22:22:03+05:30\nCompleted At: 2026-11-02T22:22:03+05:30\nShowing lines 1-60 of 154\n1: \"\"\"\n2: Gemini 2.5 Flash Tax Suggestions Generator\n3: Function: generate_tax_suggestions(audit_summary, calculated_tax)\n4: \"\"\"\n5: \n6: import json\n7: import os\n8: import urllib.request\n9: import urllib.error\n10: \n11: def format_rupees(amount):\n12:     \"\"\"Format numeric amount into Indian Currency display (e.g. ₹1,24,570.00).\"\"\"\n13:     if amount is None:\n14:         return \"₹0.00\"\n15:     num = float(amount)\n16:     is_neg = num < 0\n17:     abs_num = abs(num)\n18:     parts = f\"{abs_num:.2f}\".split(\".\")\n19:     int_part, dec_part = parts[0], parts[1]\n20:     if len(int_part) > 3:\n21:         last3 = int_part[-3:]\n22:         others = int_part[:-3]\n23:         res = \"\"\n24:         while len(others) > 2:\n25:             res = \",\" + others[-2:] + res\n26:             others = others[:-2]\n27:         int_part = others + res + \",\" + last3\n28:     return f\"{'-₹' if is_neg else '₹'}{int_part}.{dec_part}\"\n29: \n30: def generate_tax_suggestions(audit_summary: dict, calculated_tax: dict, api_key: str = None) -> dict:\n31:     \"\"\"\n32:     Generate tax suggestions for small retail shopkeepers using Gemini 2.5 Flash.\n33:     \n34:     Args:\n35:         audit_summary (dict): Financial data containing:\n36:             - total_turnover\n37:             - deemed_profit\n38:             - number_of_invoices_analyzed\n39:             - total_gst_paid_on_purchases\n40:             - invoices_missing_gstin\n41:             - disallowed_itc / eligible_itc\n42:         calculated_tax (dict): Code-calculated tax liability:\n43:             - deemed_net_profit\n44:             - estimated_tax_liability\n45:             - recommended_form\n46:             - tax_regime\n47:         api_key (str, optional): Google Gemini API Key. If omitted, checks GEMINI_API_KEY env.\n48:         \n49:     Returns:\n50:         dict: Contains 'suggestions' (list of 3 bullets), 'disclaimer', and 'raw_text'.\n51:     \"\"\"\n52:     if not api_key:\n53:         api_key = os.environ.get(\"GEMINI_API_KEY\", \"\")\n54: \n55:     if not audit_summary or audit_summary.get(\"total_turnover\", 0) == 0:\n56:         return {\n57:             \"suggestions\": [\n58:                 \"Document rejected by gatekeeper: not a commercial bill or invoice.\",\n59:                 \"Zero hallucination rule: no tax suggestions generated on non-bill media.\",\n60:                 \"Please upload a genuine invoice or enter bill details manually.\""}
