to stop the server.\\n\")\n46: \n47:     try:\n48:         httpd.serve_forever()\n49:     except KeyboardInterrupt:\n50:         print(\"\\n[AUDIT IT] Server stopped gracefully.\")\n51:         httpd.server_close()\n52: \n53: if __name__ == \"__main__\":\n54:     port = int(sys.argv[1]) if len(sys.argv) > 1 else PORT\n55:     run(port)"}
