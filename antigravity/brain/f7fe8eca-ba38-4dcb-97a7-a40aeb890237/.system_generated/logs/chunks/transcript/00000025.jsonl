tSgst) inputSgst.value = newSgst;\n801:       if (inputIgst) inputIgst.value = newIgst;\n802: \n803:       // Trigger re-audit immediately\n804:       if (onUpdateHeader) {\n805:         onUpdateHeader(\"gst_preset\", { cgst: newCgst, sgst: newSgst, igst: newIgst });\n806:       }\n807:     });\n808:   });\n809: \n810:   // Digital ratio slider\n811:   const sliderDigital = container.querySelector(\"#slider-digital-ratio\");\n812:   if (sliderDigital && onUpdateTaxSettings) {\n813:     sliderDigital.addEventListener(\"input\", (e) => {\n814:       const val = parseFloat(e.target.value) / 100;\n815:       onUpdateTaxSettings({ digitalRatio: val });"}
