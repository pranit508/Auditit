  { text: GEMINI_SYSTEM_INSTRUCTION },\n133:               {\n134:                 inline_data: {\n135:                   mime_type: mimeType,\n136:                   data: base64Data.split(\",\")[1]\n137:                 }\n138:               }\n139:             ]\n140:           }\n141:         ],\n142:         generationConfig: {\n143:           response_mime_type: \"application/json\"\n144:         }\n145:       };\n146: \n147:       const response = await fetch(url, {\n148:         method: \"POST\",\n149:         headers: { \"Content-Type\": \"application/json\" },\n150:         body: JSON.stringify(payload)\n151:       });\n152: \n153:       if (response.ok) {\n154:         const result = await response.json();\n155:         const rawText = result.candidates?.[0]?.content?.parts?.[0]?.text;\n156:         if (rawText) {\n157:           const parsed = JSON.parse(rawText);\n158:           // CRITICAL PARSING RULE: Apply cleanExtractedItems to response.items right after Gemini call\n159:           if (parsed.items && Array.isArray(parsed.items)) {\n160:             parsed.items = cleanExtractedItems(parsed.items);\n161:           }\n162:           parsed.uploaded_file_url = objectUrl;\n163:           parsed.file_type = mimeType;\n164:           parsed.file_name = file.name;\n165:           return sanitizeInvoiceData(parsed);\n166:         }\n167:       }\n168:     } catch (err) {\n169:       console.warn(\"Gemini multimodal call failed; continuing with client-side OCR:\", err);\n170:     }\n171:   }\n172: \n173:   // 2. Client-side Real OCR for PDFs\n174:   if (mimeType.includes(\"pdf\") && window.pdfjsLib) {\n175:     if (onProgress) onProgress(\"Extracting text from PDF document...\");\n176:     try {\n177:       const pdfText = await extractTextFromPdf(file);\n178:       if (pdfText && pdfText.trim().length > 10) {\n179:         const parsed = parseInvoiceText(pdfText, file.name);\n180:         parsed.uploaded_file_url = objectUrl;\n181:         parsed.file_type = mimeType;\n182:         parsed.file_name = file.name;\n183:         return sanitizeInvoiceData(parsed);\n184:       }\n185:     } catch (err) {\n186:       console.warn(\"PDF.js text extraction error:\", err);\n187:     }\n188:   }\n189: \n190:   // 3. Client-side Real OCR for Images using Tesseract.js"}
