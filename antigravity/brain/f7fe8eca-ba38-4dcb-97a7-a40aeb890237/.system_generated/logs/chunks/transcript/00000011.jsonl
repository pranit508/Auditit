:     # Common address/metadata keywords that accidentally end up as descriptions\n105:     address_words = [\n106:         \"plot\", \"sector\", \"industrial area\", \"bazaar\", \"road\", \"street\", \n107:         \"haryana\", \"delhi\", \"gstin\", \"gtin\", \"s\n<truncated 1494 bytes>\nqty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\", 0)\n137:         raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n138: \n139:         try:\n140:             billed = float(raw_billed or 0)\n141:             qty = float(raw_qty or 0)\n142:             rate = float(raw_rate or 0)\n143:         except (ValueError, TypeError):\n144:             continue\n145: \n146:         # Quantity and rate must be positive\n147:         if qty <= 0 or rate <= 0:\n148:             continue\n149: \n150:         # If billed total is astronomically different from qty * rate (like 42 * 14 = 588 vs 131001), skip\n151:         if billed > (qty * rate * 10) and billed > 100000:\n152:             continue\n153: \n154:         # Post-Processing Column Swap Fallback:\n155:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n156:         # it means qty and rate were misaligned. Swap them:\n157:         if billed > 0 and qty == billed and rate in [1, 2, 1.0, 2.0]:\n158:             qty = 1.0\n159:             rate = billed\n160: \n161:         # Clean description: Do not append units like 'NO', 'PCS', 'NOS', or serial numbers into the product description\n162:         desc_clean = re.sub(r'[\\s\\-,]+(NO|NOS|PCS|PIECES|PKT|PACKET|KG|BOX|SET)\\.?$', '', desc, flags=re.IGNORECASE).strip()\n163:         if desc_clean and len(desc_clean) >= 3:\n164:             desc = desc_clean\n165: \n166:         # Normalize fields for seamless compatibility\n167:         normalized = dict(item)\n168:         normalized[\"quantity\"] = qty\n169:         normalized[\"qty\"] = qty\n170:         no