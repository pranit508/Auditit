ms.filter(item => {\n70:       if (!item || typeof item !== \"object\") return false;\n71: \n72:       const desc = (item.description || item.item_name || \"\").trim();\n73:       const descLower = desc.toLowerCase();\n74: \n75:       // Reject if description matches address/words or is too short"}
