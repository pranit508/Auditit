scription\"] = desc\n127: \n128:         # Skip if description lacks at least 4 letters\n129:         if len(re.findall(r'[a-zA-Z]', desc)) < 4:\n130:             continue\n131: \n132:         # Skip if more than 20% of description is weird symbols/punctuation\n\n<truncated 722 bytes>\nesc\n146: \n147:         # Quantity and Rate sanity\n148:         try:\n149:             raw_qty = item.get(\"quantity\") if item.get(\"quantity\") is not None else item.get(\"qty\")\n150:             qty = float(str(raw_qty or 1).replace(\",\", \"\").strip())\n151:         except (ValueError, TypeError):\n152:             qty = 1.0\n153: \n154:         try:\n155:             raw_rate = item.get(\"unit_rate\") if item.get(\"unit_rate\") is not None else item.get(\"rate\", 0)\n156:             rate = float(str(raw_rate or 0).replace(\",\", \"\").strip())\n157:         except (ValueError, TypeError):\n158:             rate = 0.0\n159: \n160:         try:\n161:             raw_billed = item.get(\"total_amount\") if item.get(\"total_amount\") is not None else item.get(\"amount\")\n162:             billed = float(str(raw_billed if raw_billed is not None else (qty * rate)).replace(\",\", \"\").strip())\n163:         except (ValueError, TypeError):\n164:             billed = round(qty * rate, 2)\n165: \n166:         # Post-Processing Column Swap Fallback:\n167:         # If total matches qty exactly and rate is small (e.g. qty=535, rate=2, total=535), \n168:         # it means qty and rate were misaligned. Swap them:\n169:         if billed > 0 and qty == billed and rate in [1.0, 2.0, 1, 2]:\n170:             qty = 1.0\n171:             rate = billed\n172: \n173:         item[\"quantity\"] = qty\n174:         item[\"qty\"] = qty\n175:         item[\"unit_rate\"] = rate\n176:         item[\"rate\"] = rate\n177:         item[\"total_amount\"] = billed\n178:         item[\"amount\"] = billed\n179:         clean_items.append(item)\n180: \n181:     data[\"items\"] = clean_items\n182: \n183:     # 3. Ensure numeric fields strip commas cleanly\n184:     for key in [\"subtotal\", \"cgst\", \"sgst\", \"igst\", \"declared_total\"]:\n185:         val = data.get(key)\n186:         if val is not None and str(val).strip() != \"\" and str(val).lower() != \"null\":\n187:             try:\n188:                 data[key] = float(str(val).replace(\",\", \"\").strip())\n189:             except (ValueError, TypeError):\n190:                 pass","truncated_fields":["content"]}
