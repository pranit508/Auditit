{"step_index":451,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-02T16:54:50Z","content":"Created At: 2026-11-02T22:24:50+05:30\nCompleted At: 2026-11-02T22:24:50+05:30\nShowing lines 40-71 of 71\n40:     }\n41: \n42:     // 2. Skip if the description is just a metadata label\n43:     if (FORBIDDEN_KEYWORDS.some(keyword => descLower.includes(keyword))) {\n44:       console.warn(\"[AUDIT IT] Purged metadata item (Forbidden keyword detected):\", desc);\n45:       continue;\n46:     }\n47: \n48:     // 3. Skip invalid items with zero/negative rates or quantities\n49:     const qty = Number(item.quantity !== undefined ? item.quantity : item.qty);\n50:     const rate = Number(item.unit_rate !== undefined ? item.unit_rate : item.rate);\n51:     const amount = Number(item.amount);\n52: \n53:     // Normalize property names for consistency (qty, rate, amount)\n54:     const normalizedItem = {\n55:       ...item,\n56:       qty: isNaN(qty) ? 1 : qty,\n57:       rate: isNaN(rate) ? (amount > 0 && qty > 0 ? amount / qty : 0) : rate,\n58:       amount: isNaN(amount) ? (qty * rate) : amount,\n59:       description: desc\n60:     };\n61: \n62:     if (normalizedItem.qty <= 0 || (normalizedItem.rate <= 0 && normalizedItem.amount <= 0)) {\n63:       console.warn(\"[AUDIT IT] Purged item with non-positive qty or rate:\", item);\n64:       continue;\n65:     }\n66: \n67:     cleaned.push(normalizedItem);\n68:   }\n69: \n70:   return cleaned;\n71: }"}
