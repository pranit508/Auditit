nse, purges metadata items, and calculates precision totals\n45:         \"\"\"\n46:         content_length = int(self.headers.get(\"Content-Length\", 0))\n47:         post_data = self.rfile.read(content_length)\n48: \n49:         try:\n50:             body = json.\n<truncated 378 bytes>\n  if self.path == \"/api/clean-items\":\n59:             raw_items = body.get(\"items\", [])\n60:             cleaned = clean_extracted_items(raw_items)\n61:             self.send_response(200)\n62:             self.send_header(\"Content-Type\", \"application/json\")\n63:             self.end_headers()\n64:             self.wfile.write(json.dumps({\"success\": True, \"items\": cleaned, \"count\": len(cleaned)}).encode(\"utf-8\"))\n65:             return\n66: \n67:         elif self.path == \"/api/process-invoice\":\n68:             # Invoice processing route: apply clean_extracted_items right after extraction\n69:             invoice = body.get(\"invoice\", body)\n70:             items = invoice.get(\"items\", [])\n71:             \n72:             # Apply clean_extracted_items to response.items right after the Gemini call:\n73:             cleaned_items = clean_extracted_items(items)\n74:             invoice[\"items\"] = cleaned_items\n75: \n76:             # Recalculate subtotal from cleaned genuine items\n77:             calculated_subtotal = round(sum(\n78:                 float(it.get(\"quantity\") or it.get(\"qty\") or 1) * \n79:                 float(it.get(\"unit_rate\") or it.get(\"rate\") or 0)\n80:                 for it in cleaned_items\n81:             ), 2)\n82:             invoice[\"calculated_subtotal\"] = calculated_subtotal\n83: \n84:             self.send_response(200)\n85:             self.send_header(\"Content-Type\", \"application/json\")\n86:             self.end_headers()\n87:             self.wfile.write(json.dumps({\"success\": True, \"invoice\": invoice}).encode(\"utf-8\"))\n88:             return\n89: \n90:         else:\n91:             self.send_response(404)\n92:             self.send_header(\"Content-Type\", \"application/json\")\n93:             self.end_headers()\n94:             self.wfile.write(json.dumps({\"error\": f\"Endpoint {self.path} not found\"}).encode(\"utf-8\"))\n95: \n96:     def log_message(self, format, *args):\n97:         # Clean logging\n98:         sys.stderr.write(f\"[AUDIT IT] {self.address_string()} - {format % args}\\n\")\n99: \n100: def run(port=PORT):","truncated_fields":["content"]}
