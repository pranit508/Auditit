t_declared <= 0:\n310:             is_declared_suspicious = True\n311:         elif current_declared < (expected_total * 0.70) or current_declared > (expected_total * 1.50):\n312:             is_declared_suspicious = True\n313: \n314:     # If declared_total is suspiciously smaller than subtotal or matches fragment 774 or 20, reject the OCR hallucination:\n315:     if current_declared in [774, 774.0, 20, 20.0] or (calculated_subtotal > 0 and current_declared < (calculated_subtotal * 0.5)):\n316:         is_declared_suspicious = True\n317: \n318:     if word_total > 0:\n319:         # Cross-check against printed words confirms grand total\n320:         data[\"declared_total\"] = word_total"}
