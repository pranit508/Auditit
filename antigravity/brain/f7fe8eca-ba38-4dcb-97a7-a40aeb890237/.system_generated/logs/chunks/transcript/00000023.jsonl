\\.]+)?%?[\\\\s:]*[₹\\\\s]*([0-9,]+(?:\\\\.[0-9]{2})?)/i);\\n    if (igstMatch && !/subtotal|total\\\\s+in\\\\s+words/i.test(line)) {\\n      const amt = extractTaxAmountFromMatch(igstMatch, line);\\n      if (amt > 0) igst = amt;\\n    }\"","Target":"\"    // CGST\\n    if (/cgst/i.test(line) && !/subtotal|total in words/i.test(line)) {\\n      const nums = [];\\n      let m;\\n      const r = /(?:₹\\\\s*)?(\\\\d{1,3}(?:,\\\\d{2,3})*(?:\\\\.\\\\d{2})?)/g;\\n      while ((m = r.exec(line)) !== null) {\\n        if (m[1]) nums.push(parseIndianCurrency(m[1]));\\n      }\\n      if (nums.length > 0) {\\n        cgst = nums[nums.length - 1];\\n      }\\n    }\\n\\n    // SGST\\n    if (/sgst/i.test(line) && !/subtotal|total in words/i.test(line)) {\\n      const nums = [];\\n      let m;\\n      const r = /(?:₹\\\\s*)?(\\\\d{1,3}(?:,\\\\d{2,3})*(?:\\\\.\\\\d{2})?)/g;\\n      while ((m = r.exec(line)) !== null) {\\n        if (m[1]) nums.push(parseIndianCurrency(m[1]));\\n      }\\n      if (nums.length > 0) {\\n        sgst = nums[nums.length - 1];\\n      }\\n    }\\n\\n    // IGST\\n    if (/igst/i.test(line) && !/subtotal|total in words/i.test(line)) {\\n      const nums = [];\\n      let m;\\n      const r = /(?:₹\\\\s*)?(\\\\d{1,3}(?:,\\\\d{2,3})*(?:\\\\.\\\\d{2})?)/g;\\n      while ((m = r.exec(line)) !== null) {\\n        if (m[1]) nums.push(parseIndianCurrency(m[1]));\\n      }\\n      if (nums.length > 0) {\\n        igst = nums[nums.length - 1];\\n      }\\n    }\""}}]}
